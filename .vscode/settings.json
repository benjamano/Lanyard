{
    "editor.fontFamily": "'Monocraft', monospace",
    "editor.fontLigatures": true,
    "files.exclude": {
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/bin": true,
        "**/obj": true,
        "**/TestResults": true,
        "**/*.slnLaunch": true,
        "**/*.VisualStudio.json": true,
        "**/artifacts": true,
        "**/*.csproj.user": true,
        "**/.dotnet-home": true,
        "**/libman.json": true,
        "**/Releases": true,
        "**/publish": true,
        "**/build": true,
    },
    "files.autoSave": "afterDelay",
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true,
    "editor.wordWrap": "off",
    "editor.mouseWheelZoom": true,
    "editor.formatOnPaste": true,
    "editor.minimap.enabled": true
}