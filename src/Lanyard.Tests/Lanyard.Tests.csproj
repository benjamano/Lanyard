    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lanyard.Server\LanyardAPI\Lanyard.API.csproj" />
    <ProjectReference Include="..\Lanyard.Server\LanyardApp\Lanyard.App.csproj" />
    <ProjectReference Include="..\Lanyard.Infrastructure\Lanyard.Infrastructure.csproj" />
