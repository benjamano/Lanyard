{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Lanyard": {
    // Local Lanyard server. ReachSecret is intentionally unset here: the server tolerates a
    // missing Reach secret in Development and logs a warning on every request it lets through,
    // so local work needs no shared credential.
    "ServerUrl": "http://localhost:5115"
  }
}
