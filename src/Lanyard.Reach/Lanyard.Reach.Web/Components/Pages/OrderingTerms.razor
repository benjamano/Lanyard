@page "/order/terms"
@using Lanyard.Reach.Web.Services
@using Lanyard.Shared.DTO
@layout OrderingLayout
@inject ITenantContext TenantContext
@inject LanyardOrderingClient OrderingClient

@*
    Ordering terms and refund policy.

    One template, rendered from whichever company the hostname resolved to - a trader selling to
    consumers online has to identify itself, and that identity differs per tenant. Nothing here
    is hardcoded to Play2Day.

    Statically rendered: it is a document, and there is nothing to interact with.
*@

<PageTitle>Ordering terms</PageTitle>

@if (_legal is null)
{
    <div class="ordering__status-panel ordering__status-panel--error">
        <h1>Terms unavailable</h1>
        <p>We couldn't load the ordering terms. Please ask a member of staff.</p>
    </div>
}
else if (!_legal.IsComplete)
{
    @* Said plainly rather than rendering a document full of blanks, which would look like a
       bug and would not identify the trader to anybody. *@
    <div class="ordering__status-panel ordering__status-panel--error">
        <h1>Terms not published yet</h1>
        <p>@_legal.CompanyName hasn't finished setting up its ordering terms. Please ask a member of staff.</p>
    </div>
}
else
{
    <article class="terms">
        <h1>Ordering food</h1>

        <p>
            These terms apply when you order food using the QR code at your table. Your contract is
            with <strong>@_legal.LegalName</strong>@(string.IsNullOrWhiteSpace(_legal.CompanyNumber)
                ? "" : $", company number {_legal.CompanyNumber}"), registered at
            @_legal.RegisteredAddress.
        </p>

        <h2>Prices and payment</h2>
        <p>
            Prices are shown on the menu and include VAT. The total you see before you pay is the
            total you pay — we don't add service or booking fees. Payment is taken when you place
            your order and is handled by Stripe; we never see or store your card details.
        </p>

        <h2>When we start cooking</h2>
        <p>
            We begin preparing your order as soon as your payment is confirmed. Your order isn't
            accepted, and nothing is charged, until that happens.
        </p>

        <h2>Allergies and intolerances</h2>
        <p>
            Each dish lists the allergens it contains and any it may contain through
            cross-contamination. If you have an allergy or intolerance, please also speak to a
            member of staff before ordering — they can tell you how a dish is prepared and whether
            we can make it safely for you. Please don't rely on the notes box alone.
        </p>

        <h2>Collection</h2>
        <p>
            Orders are for collection at the counter. We'll hold your order for
            @_legal.CollectionHoldMinutes minutes after it's ready, after which we may dispose of it
            for food safety reasons and won't be able to refund it.
        </p>

        <h2>Changing your mind</h2>
        <p>
            Because food is prepared fresh to order, the 14-day right to cancel under the Consumer
            Contracts Regulations 2013 does not apply. If you need to change or cancel, speak to
            staff straight away — if we haven't started your order we'll usually be able to help.
        </p>

        <h1>Refunds</h1>

        <p><strong>We'll refund you in full if:</strong> we cancel your order, we can't make
        something you've paid for, or your order isn't of satisfactory quality and you tell staff
        before you leave.</p>

        <p><strong>We may not refund if:</strong> you change your mind after we've started
        preparing your order, or you don't collect it within @_legal.CollectionHoldMinutes minutes
        of it being ready.</p>

        <p><strong>How refunds work.</strong> Refunds are made in full to the card you paid with —
        we can't refund to a different card or in cash. Your bank usually takes 5–10 working days
        to show it.</p>

        @* Deliberately points at staff rather than promising something the system cannot do:
           refunds are all-or-nothing in software, so partial ones are handled in person. *@
        <p><strong>Part of an order.</strong> If only part of your order was wrong, speak to a
        member of staff at the venue.</p>

        <h2>Contact</h2>
        <p>
            @_legal.ContactEmail
            @if (!string.IsNullOrWhiteSpace(_legal.ContactPhone))
            {
                <text> · @_legal.ContactPhone</text>
            }
        </p>
    </article>
}

@code {
    private TenantLegalDetailsDto? _legal;

    protected override async Task OnInitializedAsync()
    {
        if (!TenantContext.IsResolved)
        {
            return;
        }

        _legal = await OrderingClient.GetLegalDetailsAsync(TenantContext.Tenant.CompanyId);
    }
}
