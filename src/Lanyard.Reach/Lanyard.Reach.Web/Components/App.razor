@using Lanyard.Reach.Web.Services
@inject ITenantContext TenantContext

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ordering.css" />
    <link rel="stylesheet" href="Lanyard.Reach.Web.styles.css" />
    <ImportMap />
    @*
        A tenant's own logo is the right favicon for their site: on a customer's phone this is a
        Play2Day tab, not a Lanyard one. Falls back to the Lanyard mark on any page where no
        tenant resolved. /tenant-logo is the same same-origin proxy the header already uses, so
        this costs no extra round trip to the Lanyard server.
    *@
    @if (TenantContext.IsResolved)
    {
        <link rel="icon" href="/tenant-logo" />
    }
    else
    {
        <link rel="icon" type="image/png" href="favicon.png" />
    }

    @*
        The tenant's colours, written server-side into custom properties on :root.

        Emitted here rather than fetched by the client so there is no flash of default branding,
        and so the WebAssembly island inherits the tenant's palette through ordinary CSS without
        an extra API call of its own. The foreground colour is chosen by contrast against the
        tenant's own brand colour, so a company with a pale brand does not end up with white
        text nobody can read.
    *@
    @if (TenantContext.IsResolved)
    {
        <style>
            :root {
                --brand-primary: @TenantContext.Tenant.ThemeColorHex;
                --brand-secondary: @TenantContext.Tenant.SecondaryColorHex;
                --brand-on-primary: @TenantContext.Tenant.OnPrimaryColorHex;
            }
        </style>
    }

    @* Stripe requires its script be loaded from their domain rather than bundled - it is how
       they ship PCI-relevant fixes without every site redeploying. *@
    <script src="https://js.stripe.com/v3/"></script>

    <HeadOutlet />
</head>

<body>
    @*
        No global @rendermode. Pages are statically rendered unless they opt in, which keeps the
        public marketing pages free of a per-visitor server circuit and lets the ordering flow
        pick WebAssembly independently.
    *@
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
