<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <!-- .NET 11 SDK: Web-SDK projects get Hot Reload browser-tools assets in Debug. This is a
         library consumed by Lanyard.App, and its copy of those assets has no endpoint in the
         app, which fails the Debug build. Lanyard.App generates its own. -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lanyard.Infrastructure\Lanyard.Infrastructure.csproj" />
    <ProjectReference Include="..\LanyardServices\Lanyard.Services.csproj" />
  </ItemGroup>

</Project>
