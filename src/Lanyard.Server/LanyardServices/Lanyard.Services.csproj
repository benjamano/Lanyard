<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.13.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lanyard.Shared\Lanyard.Shared.csproj" />
    <ProjectReference Include="..\..\Lanyard.Infrastructure\Lanyard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Repositories\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\ReleaseNotes\release-notes.json" />
    <!-- Open Fixture Library snapshot (MIT): the licence has to travel with the data. -->
    <EmbeddedResource Include="Services\Dmx\Ofl\ofl-snapshot.json.gz" LogicalName="Lanyard.Services.Services.Dmx.Ofl.ofl-snapshot.json.gz" />
    <EmbeddedResource Include="Services\Dmx\Ofl\open-fixture-library-LICENSE.txt" LogicalName="Lanyard.Services.Services.Dmx.Ofl.open-fixture-library-LICENSE.txt" />
    <!-- The handwriting-style face used for text printed onto party voucher and feedback artwork.
         Apache 2.0 (Resources\Fonts\Chewy-LICENSE.txt). -->
    <EmbeddedResource Include="Resources\Fonts\Chewy-Regular.ttf" LogicalName="Lanyard.Fonts.Chewy-Regular.ttf" />
    <!-- The white λ on transparency, stamped as a badge onto icons made from a company's logo. -->
    <EmbeddedResource Include="..\LanyardApp\wwwroot\icon-monochrome-512.png" LogicalName="Lanyard.AppIconBadge.png" Link="Services\Branding\icon-monochrome-512.png" />
  </ItemGroup>

</Project>
