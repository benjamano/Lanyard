@using Lanyard.Infrastructure.DTO.Charts
@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div class="category-donut-chart">
    @if (PlottableData.Count == 0)
    {
        <FluentText Color="Color.Default">No data available.</FluentText>
    }
    else
    {
        <FluentDonutChart Style="width:100%;height:100%;" ChartData="@PlottableData" InnerRadius="55" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<ChartCategoryValue> Data { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> SeriesColors { get; set; } = ChartPalette.Categorical;

    // A 0-value slice isn't visible anyway, so filtering it out before binding is safe.
    // Colors are assigned by each item's position in the original (unfiltered) Data list,
    // so a given category keeps the same color regardless of which other categories are
    // filtered out around it.
    private List<DonutDataPoint> PlottableData =>
        [.. Data
            .Select((x, i) => (Item: x, Color: SeriesColors[i % SeriesColors.Count]))
            .Where(x => x.Item.Value > 0)
            .Select(x => new DonutDataPoint
            {
                Legend = x.Item.Label,
                Data = x.Item.Value,
                Color = DataVizPalette.Custom,
                CustomColor = x.Color
            })];
}
