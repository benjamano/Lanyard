@using Lanyard.Infrastructure.DTO.Charts
@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div class="ranked-bar-chart">
    @if (PlottableData.Count == 0)
    {
        <FluentText Color="Color.Default">@EmptyMessage</FluentText>
    }
    else
    {
        <FluentHorizontalBarChart Style="width:100%;" ChartData="@SeriesData"
                                   Variant="HorizontalBarChartVariant.SingleBar" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<ChartCategoryValue> Data { get; set; } = [];

    [Parameter]
    public string? ValueSuffix { get; set; }

    [Parameter]
    public string SeriesColor { get; set; } = ChartPalette.Accent;

    [Parameter]
    public string EmptyMessage { get; set; } = "No data available.";

    // A 0-value bar isn't visible anyway, so filtering it out before binding is safe.
    private List<ChartCategoryValue> PlottableData =>
        [.. Data.Where(x => x.Value > 0)];

    // The SingleBar variant scales each bar's width against Total, so every bar
    // needs a shared Total (the largest value) to render proportionally to the rest.
    private double Total => PlottableData.Count == 0 ? 0 : PlottableData.Max(x => x.Value);

    private IReadOnlyList<HorizontalBarChartSeries> SeriesData =>
        [.. PlottableData.Select(x => new HorizontalBarChartSeries
        {
            ChartSeriesTitle = x.Label,
            ChartData =
            [
                new HorizontalBarChartDataPoint
                {
                    Legend = x.Label,
                    Data = x.Value,
                    Total = Total,
                    Color = DataVizPalette.Custom,
                    CustomColor = SeriesColor
                }
            ]
        })];
}
