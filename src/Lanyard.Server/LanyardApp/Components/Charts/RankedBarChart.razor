@using Lanyard.Infrastructure.DTO.Charts
@using Radzen
@using Radzen.Blazor

<div class="ranked-bar-chart">
    @if (PlottableData.Count == 0)
    {
        <FluentText Color="Color.Default">@EmptyMessage</FluentText>
    }
    else
    {
        <RadzenChart>
            <RadzenColumnSeries Data="@PlottableData" CategoryProperty="@nameof(ChartCategoryValue.Label)"
                                ValueProperty="@nameof(ChartCategoryValue.Value)" Fill="@SeriesColor" />
            <RadzenCategoryAxis Padding="60" LabelAutoRotation="0" />
            <RadzenValueAxis Formatter="@FormatValue">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Visible="false" />
        </RadzenChart>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<ChartCategoryValue> Data { get; set; } = [];

    [Parameter]
    public string? ValueSuffix { get; set; }

    [Parameter]
    public string SeriesColor { get; set; } = ChartPalette.Accent;

    [Parameter]
    public string EmptyMessage { get; set; } = "No data available.";

    // Radzen renders a 0-value bar as a degenerate, zero-height path and uses
    // that path string as the Blazor diffing key - two 0-value bars (or two
    // equal-value bars landing on the same rounded-rect geometry) produce an
    // identical path/key and crash the render with a "duplicate key"
    // exception (same class of bug as CategoryDonutChart's zero-slice case).
    // A 0-value bar isn't visible anyway, so filtering it out is safe.
    private List<ChartCategoryValue> PlottableData =>
        [.. Data.Where(x => x.Value > 0)];

    private string FormatValue(object value) => $"{value}{ValueSuffix}";
}
