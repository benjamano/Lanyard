@inherits FluentDialogInstance

@inject IDashboardService DashboardService
@inject NavigationManager NavigationManager

@* Name a new dashboard and pick what it starts from: blank, or one of the ready-made layouts.
   It opens in the designer straight away. *@

<FluentDialogBody>
    <TitleTemplate>New dashboard</TitleTemplate>

    <ChildContent>
        <div class="create-dashboard">
            <FluentTextInput Label="Name" @bind-Value="_name" Immediate="true" Required="true" Maxlength="100" Width="100%" Placeholder="Front desk" />
            <FluentTextArea Label="Description (optional)" @bind-Value="_description" Maxlength="500" Rows="2" Style="width: 100%;" />

            <div class="create-dashboard-label" id="create-dashboard-start">Start from</div>
            <div class="create-dashboard-templates" role="radiogroup" aria-labelledby="create-dashboard-start">
                @foreach (DashboardTemplate template in DashboardTemplates.All)
                {
                    bool selected = template.Key == _templateKey;
                    <button type="button"
                            class="create-dashboard-template @(selected ? "is-selected" : null)"
                            role="radio"
                            aria-checked="@(selected ? "true" : "false")"
                            @onclick="@(() => _templateKey = template.Key)">
                        <DashboardThumbnail Widgets="template.Preview" />
                        <span class="create-dashboard-template-name">
                            <FluentIcon Value="@template.Icon()" Width="16px" />
                            @template.Name
                        </span>
                        <span class="create-dashboard-template-description">@template.Description</span>
                    </button>
                }
            </div>

            @if (_error is string error)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@error</FluentMessageBar>
            }
        </div>
    </ChildContent>

    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())"
                      Loading="_creating" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="CreateAsync">
            Create and open
        </FluentButton>
        <FluentButton OnClick="@(() => DialogInstance.CancelAsync())">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    private string? _name;
    private string? _description;
    private string _templateKey = "blank";
    private string? _error;
    private bool _creating;

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (primary)
        {
            await CreateAsync();
        }
        else
        {
            await DialogInstance.CancelAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _creating)
        {
            return;
        }

        _creating = true;
        _error = null;

        DashboardTemplate template = DashboardTemplates.All.First(t => t.Key == _templateKey);
        Dashboard dashboard = new()
        {
            Name = _name.Trim(),
            Description = _description,
            FitToScreen = template.FitToScreen,
            RowHeight = template.RowHeight,
            Widgets = template.Build()
        };

        Result<Guid> result = await DashboardService.CreateDashboardAsync(dashboard);
        _creating = false;

        if (!result.IsSuccess)
        {
            _error = $"Couldn't create the dashboard: {result.Error}";
            return;
        }

        await DialogInstance.CloseAsync(result.Data);
        NavigationManager.NavigateTo($"/manage/dashboards/{result.Data}");
    }
}
