@using Lanyard.App.Components.Music
@using Lanyard.App.Components.Music.Schedule
@using NAudio.Wave

@implements IDisposable

@inject IMusicPlayerService _player

@* The same now-playing snapshot and browser-driven timeline as the Music page, so a dashboard
   left open on a wall screen doesn't re-render once a second either. *@
<FluentCard Height="100%">
    <div class="music-timeline-widget">
        @if (Widget.ClientId is not Guid clientId || clientId == Guid.Empty)
        {
            <FluentBadge Appearance="@BadgeAppearance.Filled" Size="@BadgeSize.ExtraLarge">Please select a Client to control</FluentBadge>
        }
        else if (_snapshot is { } snapshot)
        {
            <MusicScheduleStatusChip ClientId="clientId" AllowResume="AllowTrigger" />

            @if (Widget.ShowSongTitle)
            {
                <div class="music-timeline-widget-title">
                    @if (!snapshot.IsConnected)
                    {
                        <span class="is-muted">Kiosk offline</span>
                    }
                    else
                    {
                        @(snapshot.Song?.Name ?? "Nothing playing")
                    }
                </div>
            }

            <div class="music-timeline-widget-transport">
                <button type="button" class="widget-icon-button" aria-label="Previous" title="Previous (restarts the song if it's more than 3 seconds in)"
                        disabled="@(!CanControl)" @onclick="() => Run(_player.RestartOrPrevious(clientId))">
                    <FluentIcon Value="@(new Icons.Filled.Size24.Previous())" Color="Color.Default" />
                </button>
                <button type="button" class="widget-play-button" aria-label="@(IsPlaying ? "Pause" : "Play")" title="@(IsPlaying ? "Pause" : "Play")"
                        disabled="@(!CanControl)" @onclick="() => Run(_player.TogglePlay(clientId))">
                    <FluentIcon Value="@(IsPlaying ? (Icon)new Icons.Filled.Size24.Pause() : new Icons.Filled.Size24.Play())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
                <button type="button" class="widget-icon-button" aria-label="Next" title="Next"
                        disabled="@(!CanControl)" @onclick="() => Run(_player.Next(clientId))">
                    <FluentIcon Value="@(new Icons.Filled.Size24.Next())" Color="Color.Default" />
                </button>
            </div>

            <MusicProgress Snapshot="snapshot" ReadOnly="@(!CanControl)" />
        }
    </div>
</FluentCard>

@code {
    [Parameter]
    public required MusicTimelineWidget Widget { get; set; }

    [Parameter]
    public bool AllowTrigger { get; set; } = true;

    private MusicNowPlayingSnapshot? _snapshot;

    private bool IsPlaying => _snapshot is { IsConnected: true, State: PlaybackState.Playing };
    private bool CanControl => AllowTrigger && _snapshot?.IsConnected == true;

    protected override void OnInitialized()
    {
        _player.OnNowPlayingChanged += HandleNowPlayingChanged;
    }

    protected override void OnParametersSet()
    {
        _snapshot = Widget.ClientId is Guid id ? _player.GetSnapshot(id) : null;
    }

    private void HandleNowPlayingChanged(Guid clientId)
    {
        if (Widget.ClientId != clientId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _snapshot = _player.GetSnapshot(clientId);
            StateHasChanged();
        });
    }

    private async Task Run(Task<Result<bool>> command)
    {
        Result<bool> result = await command;
        if (!result.IsSuccess)
        {
            _toastService.ShowWarning(result.Error ?? "Couldn't reach the kiosk.");
        }
    }

    public void Dispose()
    {
        _player.OnNowPlayingChanged -= HandleNowPlayingChanged;
    }
}
