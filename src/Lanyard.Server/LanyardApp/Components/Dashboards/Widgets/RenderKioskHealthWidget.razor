@using Lanyard.Application.Services.Clients
@using Lanyard.App.Components.Clients
@using Humanizer;
@implements IDisposable

@inject IClientService _clientService
@inject IKioskHealthService _kioskHealthService

@* Known limitation: Client has no LocationId, so this roster is company-wide (the tenant filter
   scopes it to the viewer's company) rather than location-scoped. *@

<FluentCard Height="100%">
    @* Laid out with plain elements rather than FluentStack so the kiosk name can ellipsize
       instead of wrapping a word per line when the widget is sized narrow. *@
    <div class="kiosk-health-body">
        <div class="kiosk-health-header">
            <span class="kiosk-health-title">@(Widget.Title ?? "Kiosk Health")</span>
            <span class="kiosk-health-count">@(_onlineCount) / @(_totalCount) online</span>
        </div>

        @if (_displayedClients.Count == 0)
        {
            <div class="kiosk-health-empty">
                <FluentBadge Appearance="@BadgeAppearance.Filled" Color="@BadgeColor.Subtle">
                    @(Widget.OnlyShowOffline && _totalCount > 0 ? "All kiosks healthy" : "No kiosks registered")
                </FluentBadge>
            </div>
        }
        else
        {
            <div class="kiosk-health-list">
                @foreach (ClientConnectedWithCapabilitiesDTO client in _displayedClients)
                {
                    KioskHealthView? health = _health.GetValueOrDefault(client.Id);

                    <div class="kiosk-health-row">

                        <span class="kiosk-health-indicator">
                            @if (health?.Status == KioskHealthStatus.Degraded)
                            {
                                <FluentIcon Value="@(new Icons.Filled.Size20.Warning())" Color="Color.Warning" />
                            }
                            else if (KioskHealthDisplay.IsUp(health, client.IsCurrentlyConnected))
                            {
                                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Success" />
                            }
                            else if (health?.Status == KioskHealthStatus.Unresponsive)
                            {
                                <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Warning" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Filled.Size20.DismissCircle())" Color="Color.Error" />
                            }
                        </span>

                        <span class="kiosk-health-text">
                            <span class="kiosk-health-name" title="@client.Name">@client.Name</span>
                            <span class="kiosk-health-status" title="@string.Join("\n", KioskHealthDisplay.Details(health))">@DescribeStatus(client, health)</span>
                        </span>
                    </div>
                }
            </div>
        }
    </div>
</FluentCard>

@code {
    [Parameter]
    public required KioskHealthWidget Widget { get; set; }

    // Kiosk connectivity lives in an in-memory set on the hub with no change event to
    // subscribe to, so the roster is polled rather than pushed.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(15);

    private List<ClientConnectedWithCapabilitiesDTO> _displayedClients = new();
    private int _onlineCount;
    private int _totalCount;

    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellation;
    private bool _isRefreshing;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();

        _refreshCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(RefreshInterval);

        CancellationToken token = _refreshCancellation.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _refreshTimer.WaitForNextTickAsync(token))
                {
                    await LoadClientsAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Expected when the component is disposed.
            }
        });
    }

    protected override void OnParametersSet()
    {
        // OnlyShowOffline can change while the dashboard is open via the config dialog.
        ApplyFilter();
    }

    private async Task LoadClientsAsync()
    {
        if (_isRefreshing)
        {
            return;
        }

        _isRefreshing = true;

        try
        {
            Result<IEnumerable<ClientConnectedWithCapabilitiesDTO>> result = await _clientService.GetClientsWithCapabilitiesAsync();

            if (!result.IsSuccess || result.Data == null)
            {
                return;
            }

            Result<Dictionary<Guid, KioskHealthView>> healthResult = await _kioskHealthService.GetHealthAsync();

            // Without health the roster still shows hub connectivity, as it did before heartbeats.
            _health = healthResult.IsSuccess && healthResult.Data != null ? healthResult.Data : new();

            _allClients = result.Data
                .OrderBy(x => KioskHealthDisplay.SortOrder(_health.GetValueOrDefault(x.Id), x.IsCurrentlyConnected))
                .ThenBy(x => x.Name)
                .ToList();

            ApplyFilter();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private List<ClientConnectedWithCapabilitiesDTO> _allClients = new();
    private Dictionary<Guid, KioskHealthView> _health = new();

    private bool IsUp(ClientConnectedWithCapabilitiesDTO client) =>
        KioskHealthDisplay.IsUp(_health.GetValueOrDefault(client.Id), client.IsCurrentlyConnected);

    private void ApplyFilter()
    {
        _totalCount = _allClients.Count;
        _onlineCount = _allClients.Count(IsUp);

        // "Only show problems": degraded kiosks are up but still need attention.
        _displayedClients = Widget.OnlyShowOffline
            ? _allClients.Where(x => !IsUp(x) || _health.GetValueOrDefault(x.Id)?.Status == KioskHealthStatus.Degraded).ToList()
            : _allClients;
    }

    // A hard server kill never runs OnDisconnectedAsync, so LastDisconnectDate can be missing
    // or older than the last connection. Take whichever timestamp is newer and describe it as
    // "last seen" rather than claiming a precise downtime we cannot know.
    private static string DescribeStatus(ClientConnectedWithCapabilitiesDTO client, KioskHealthView? health)
    {
        switch (health?.Status)
        {
            case KioskHealthStatus.Healthy:
                return "healthy";
            case KioskHealthStatus.Degraded:
                return string.Join(", ", health.Reasons);
            case KioskHealthStatus.Unresponsive:
            case KioskHealthStatus.Offline:
                string silent = $"{KioskHealthDisplay.Label(health.Status).ToLowerInvariant()}, last heartbeat {KioskHealthDisplay.Ago(health.SinceLastHeartbeat ?? TimeSpan.Zero)}";

                // Tells staff whether the screens are likely still showing something.
                return KioskHealthDisplay.ShouldBePlayingOffline(health) ? $"{silent}, screens should be playing their offline copy" : silent;
        }

        if (client.IsCurrentlyConnected)
        {
            return "online";
        }

        DateTime? lastSeen = client.LastDisconnectDate;

        if (client.LastLogin is DateTime lastLogin && (lastSeen == null || lastLogin > lastSeen))
        {
            lastSeen = lastLogin;
        }

        if (lastSeen is not DateTime seenAt)
        {
            return "never connected";
        }

        TimeSpan elapsed = DateTime.UtcNow - seenAt;

        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return $"last seen {elapsed.Humanize(precision: 1, minUnit: Humanizer.Localisation.TimeUnit.Second)} ago";
    }

    public void Dispose()
    {
        _refreshCancellation?.Cancel();
        _refreshTimer?.Dispose();
        _refreshCancellation?.Dispose();
    }
}
