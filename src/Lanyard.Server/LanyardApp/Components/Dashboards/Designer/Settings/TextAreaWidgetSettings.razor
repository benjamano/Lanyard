@using Lanyard.App.Components.Dashboards.Widgets
@inherits WidgetSettingsBase<TextAreaWidget>

@* The Text widget's content, edited here rather than on the canvas, where a press starts a drag.
   The canvas shows the result as you type. *@

<div class="text-area-settings">
    <RenderTextAreaWidget Widget="W" PreviewMode="false" ContentChanged="@(() => OnChanged.InvokeAsync("Edited text"))" />
</div>
