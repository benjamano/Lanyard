@inherits WidgetSettingsBase<MyTrainingWidget>

<div class="widget-settings">
    <div class="widget-settings-note">Each person sees their own courses.</div>
    <FluentSwitch Value="@W.IncludeCompleted" ValueChanged="@(v => SetAsync(() => W.IncludeCompleted = v, v ? "Included completed courses" : "Left out completed courses"))" Label="Include completed courses" />
    <FluentNumberInput TValue="int" Value="@W.MaxItems" ValueChanged="@(v => SetAsync(() => W.MaxItems = Math.Clamp(v, 1, 50), "Changed how many courses show"))"
                       Min="1" Max="50" Label="Most courses to show" />
</div>
