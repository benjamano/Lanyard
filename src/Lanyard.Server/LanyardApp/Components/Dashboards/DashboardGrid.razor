@* Draws a dashboard's widgets on its 12-column grid. Every widget renders through
   DashboardWidgetHost and DashboardWidgetCatalog, so there's no per-type code here.

   On a phone-width container the grid collapses to one column, ordered by each widget's phone
   order and leaving out widgets hidden on phones. It's a container query rather than a media
   query, so the designer's phone preview collapses the same way inside a narrow frame. *@

@inject ICompanyFeatureService CompanyFeatures
@inject DashboardWidgetConfigurator WidgetConfigurator

<div class="dashboard-grid-container">
    <div class="dashboard-grid @(Fit ? "fit-to-screen" : null)" style="@GridStyle">
        @foreach ((DashboardWidget widget, int phoneOrder) in OrderedWidgets())
        {
            @* @key keeps each widget's component (and its live state) attached to the same widget
               when moving one changes the render order. *@
            <div @key="widget.Id"
                 class="dashboard-grid-item @(widget.HideOnPhone ? "hide-on-phone" : null)"
                 id="@($"widget-{widget.Id}")"
                 style="@GetWidgetStyle(widget, phoneOrder)">
                @if (!PreviewMode)
                {
                    <div class="dashboard-grid-item-tools">
                        <span class="dashboard-grid-item-name">@DashboardWidgetCatalog.NameOf(widget.Type)</span>
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Move left" IconStart="new Icons.Regular.Size16.ArrowLeft()" OnClick="@(() => Move(widget, -1, 0))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Move up" IconStart="new Icons.Regular.Size16.ArrowUp()" OnClick="@(() => Move(widget, 0, -1))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Move down" IconStart="new Icons.Regular.Size16.ArrowDown()" OnClick="@(() => Move(widget, 0, 1))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Move right" IconStart="new Icons.Regular.Size16.ArrowRight()" OnClick="@(() => Move(widget, 1, 0))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Narrower" IconStart="new Icons.Regular.Size16.SubtractCircle()" OnClick="@(() => Resize(widget, -1, 0))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Wider" IconStart="new Icons.Regular.Size16.AddCircle()" OnClick="@(() => Resize(widget, 1, 0))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Shorter" IconStart="new Icons.Regular.Size16.ArrowUpload()" OnClick="@(() => Resize(widget, 0, -1))" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Taller" IconStart="new Icons.Regular.Size16.ArrowDownload()" OnClick="@(() => Resize(widget, 0, 1))" />
                        @if (DashboardWidgetCatalog.Get(widget.Type)?.HasSettings == true)
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Settings" IconStart="new Icons.Regular.Size16.Settings()" OnClick="@(() => ConfigureAsync(widget))" />
                        }
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" Title="Remove" IconStart="new Icons.Regular.Size16.Delete()" OnClick="@(() => Remove(widget))" />
                    </div>
                }

                <DashboardWidgetHost Widget="widget" Live="PreviewMode" CompanyId="CompanyId" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<DashboardWidget> Widgets { get; set; } = [];

    // True on a live dashboard; false while it's being edited.
    [Parameter]
    public bool PreviewMode { get; set; }

    // The company that owns the dashboard. Kiosk displays render without a signed-in user, so
    // nothing filters their data by company - widgets that read company data scope to this.
    [Parameter]
    public int? CompanyId { get; set; }

    [Parameter]
    public int RowHeight { get; set; } = Dashboard.DefaultRowHeight;

    // Stretch the rows to fill the screen (a kiosk TV). Only the kiosk passes the dashboard's
    // setting through; the home screen scrolls like any other page.
    [Parameter]
    public bool FitToScreen { get; set; }

    // Widgets from a module the viewer's company doesn't have (CompanyFeatureCatalog.ForWidget)
    // are left out when viewing. The editor still shows them so an admin can see and remove them.
    // Until the lookup finishes every module counts as hidden, so a widget the company doesn't have
    // never gets to render (and load its data) in the meantime.
    private IReadOnlySet<CompanyFeature> _hiddenFeatures = System.Enum.GetValues<CompanyFeature>().ToHashSet();

    private bool Fit => FitToScreen && PreviewMode;

    // Checklists resolves the viewer's working location from their open time entry; its service applies that location's feature switch.
    private IEnumerable<DashboardWidget> VisibleWidgets => PreviewMode
        ? Widgets.Where(w => w is ChecklistsTodayWidget
            || CompanyFeatureCatalog.ForWidget(w.Type) is not CompanyFeature feature
            || !_hiddenFeatures.Contains(feature))
        : Widgets;

    private string GridStyle
    {
        get
        {
            int rowHeight = Math.Clamp(RowHeight <= 0 ? Dashboard.DefaultRowHeight : RowHeight, Dashboard.MinRowHeight, Dashboard.MaxRowHeight);
            int rows = Math.Max(1, DashboardLayoutEngine.RowCount(Widgets.Select(ToRect)));

            return $"--dashboard-row-height: {rowHeight}px; --dashboard-rows: {rows};";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _hiddenFeatures = await CompanyFeatures.GetHiddenFeaturesForCurrentUserAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyLayout(DashboardLayoutEngine.Normalize(Widgets.Select(ToRect)));
    }

    // Desktop order (top-to-bottom, then left-to-right) is the render order, and each widget's
    // place in the phone stack goes in as a CSS order: phone order first, then the rest as they
    // read on the desktop.
    private IEnumerable<(DashboardWidget Widget, int PhoneOrder)> OrderedWidgets()
    {
        List<DashboardWidget> desktop = [.. VisibleWidgets.OrderBy(w => w.GridY).ThenBy(w => w.GridX)];
        Dictionary<Guid, int> phone = PhoneOrder(desktop)
            .Select((w, index) => (w.Id, index))
            .ToDictionary(x => x.Id, x => x.index);

        return desktop.Select(w => (w, phone[w.Id]));
    }

    public static IEnumerable<DashboardWidget> PhoneOrder(IEnumerable<DashboardWidget> widgets) =>
        widgets
            .OrderBy(w => w.PhoneOrder is null ? 1 : 0)
            .ThenBy(w => w.PhoneOrder)
            .ThenBy(w => w.GridY)
            .ThenBy(w => w.GridX);

    private static WidgetRect ToRect(DashboardWidget widget) => new(widget.Id, widget.GridX, widget.GridY, widget.GridW, widget.GridH);

    private void ApplyLayout(IEnumerable<WidgetRect> layout)
    {
        Dictionary<Guid, DashboardWidget> byId = Widgets.ToDictionary(w => w.Id);

        foreach (WidgetRect rect in layout)
        {
            if (byId.TryGetValue(rect.Id, out DashboardWidget? widget))
            {
                widget.GridX = rect.X;
                widget.GridY = rect.Y;
                widget.GridW = rect.W;
                widget.GridH = rect.H;
            }
        }
    }

    private void Move(DashboardWidget widget, int dx, int dy) =>
        ApplyLayout(DashboardLayoutEngine.Move([.. Widgets.Select(ToRect)], widget.Id, widget.GridX + dx, widget.GridY + dy));

    private void Resize(DashboardWidget widget, int dw, int dh) =>
        ApplyLayout(DashboardLayoutEngine.Resize([.. Widgets.Select(ToRect)], widget.Id, widget.GridW + dw, widget.GridH + dh));

    private void Remove(DashboardWidget widget) => Widgets.Remove(widget);

    private async Task ConfigureAsync(DashboardWidget widget)
    {
        if (await WidgetConfigurator.ConfigureAsync(widget))
        {
            StateHasChanged();
        }
    }

    private static string GetWidgetStyle(DashboardWidget widget, int phoneOrder) =>
        $"grid-column: {widget.GridX + 1} / span {widget.GridW}; grid-row: {widget.GridY + 1} / span {widget.GridH}; --phone-order: {phoneOrder};";
}
