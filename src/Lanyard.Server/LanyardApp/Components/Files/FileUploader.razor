@using Lanyard.Infrastructure.Models
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IFileService _fileService
@inject INotificationService _toastService

<div class="file-uploader-wrapper w-100">
    <FluentInputFile Id="@Id" Mode="InputFileMode.SaveToTemporaryFolder" Multiple="true"
                     MaximumFileCount="@MaximumFileCount" MaximumFileSize="@MaximumFileSize" Accept="@Accept"
                     @bind-ProgressPercent="@ProgressPercent" OnCompleted="@OnCompletedAsync" Class="file-uploader-dropzone"
                     Padding="@Padding.Top5">
        <ChildContent>
            <label for="@Id">
                @if (PreviewUrl is not null)
                {
                    <img src="@PreviewUrl" alt="Current file preview" class="file-uploader-preview" />
                }
                else
                {
                    <FluentIcon Value="@(new @Icons.Regular.Size24.ArrowUpload())" />
                }
            </label>

            <div>
                @Label,
                or <label for="@Id">browse</label>
                for them.
                <br />
                <em>Maximum of @MaximumFileCount file@(MaximumFileCount > 1 ? "s" : "") allowed.</em>
                <br />
                <em>Maximum file size: @(MaximumFileSize / (1024 * 1024)) MB.</em>
            </div>
        </ChildContent>
    </FluentInputFile>
</div>

@code
{
    // Must be unique per page: two instances sharing this id break the <label for> association
    // and duplicate the DOM id, since HTML ids are not scoped per-component.
    [Parameter] public string Id { get; set; } = "my-file-uploader";
    [Parameter] public Guid? SelectedFolderId { get; set; }
    [Parameter] public EventCallback<FileMetadata> OnFileUploaded { get; set; }
    [Parameter] public string? Accept { get; set; }
    [Parameter] public long MaximumFileSize { get; set; } = 100 * 1024 * 1024;
    [Parameter] public string Label { get; set; } = "Upload files";
    [Parameter] public int MaximumFileCount { get; set; } = 4;

    // Purely parent-owned: this component has no opinion on what "current" means (an
    // already-saved value vs. one just uploaded this session), so callers that want a
    // preview pass a URL and update it themselves from OnFileUploaded's FileMetadata.
    [Parameter] public string? PreviewUrl { get; set; }

    int ProgressPercent = 0;
    FluentInputFileEventArgs[] Files = Array.Empty<FluentInputFileEventArgs>();

    private async Task OnCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        Files = files.ToArray();

        foreach (FluentInputFileEventArgs file in Files)
        {
            if (file.ErrorMessage != null)
            {
                _toastService.ShowError($"Error uploading {file.Name}: {file.ErrorMessage}");
                continue;
            }

            using FileStream fileStream = file.LocalFile!.OpenRead();
            using StreamContent streamContent = new StreamContent(fileStream);

            IFormFile formFile = new FormFile(
                baseStream: fileStream,
                baseStreamOffset: 0,
                length: fileStream.Length,
                name: "file",
                fileName: file.Name
            )
            {
                Headers = new HeaderDictionary(),
                ContentType = file.ContentType
            };

            Result<FileMetadata> result = await _fileService.UploadFileAsync(formFile, SelectedFolderId, CancellationToken.None);

            if (result.Success == true && result.Data != null)
            {
                await OnFileUploaded.InvokeAsync(result.Data);
            }
            else
            {
                _toastService.ShowError($"Failed to upload {file.Name}: {result.Error}");
            }
        }

        await Task.Delay(3000);
        ProgressPercent = 0;
    }
}