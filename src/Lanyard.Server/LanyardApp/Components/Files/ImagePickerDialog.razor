@using Lanyard.Infrastructure.DTO.Files
@using Lanyard.App.Components.Files.Browser

@* The course editor's Insert image: pick a picture from Files, or upload one. Closes with its id. *@
<FluentDialogBody>
    <ChildContent>
        <FilePickerPanel Kind="FileTypeGroup.Image" OnPicked="OnPickedAsync" />
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="CancelAsync">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private Task OnPickedAsync(FileListItem file) => Dialog.CloseAsync(file.Id);

    private Task CancelAsync() => Dialog.CancelAsync();
}
