@using Lanyard.App.Components.Files

@* Upload into the open folder. Closes with how many files were added. *@
<FluentDialogBody>
    <ChildContent>
        <div class="files-upload-dialog">
            <p class="files-upload-dialog-to">Into <strong>@FolderName</strong></p>
            <FileUploader Id="files-upload-dialog-input" SelectedFolderId="FolderId" MaximumFileCount="20"
                          Label="Drop files here" OnFileUploaded="OnUploaded" />
            @if (_uploaded.Count > 0)
            {
                <ul class="files-upload-dialog-done" aria-live="polite">
                    @foreach (FileMetadata file in _uploaded)
                    {
                        <li>
                            <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())" Color="Color.Success" />
                            @file.FileName
                        </li>
                    }
                </ul>
            }
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="() => Dialog.CloseAsync(_uploaded.Count)">Done</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter] public Guid? FolderId { get; set; }

    [Parameter] public string FolderName { get; set; } = "Files";

    [CascadingParameter] public required IDialogInstance Dialog { get; set; }

    private readonly List<FileMetadata> _uploaded = [];

    private void OnUploaded(FileMetadata file) => _uploaded.Add(file);
}
