            <h2 class="files-details-title">Details</h2>
            <button type="button" class="files-icon-button" aria-label="Close details" @onclick="CloseDetails">
                <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Default" />
            </button>
        </div>

        switch (_details)
        {
            case FileSelection { File: var file, Index: var index }:
                <FileDetailsPanel @key="file.Id" File="file" CanManage="CanManage"
                                  OnPreview="() => PreviewAsync(index)"
                                  OnShowFolder="() => GoAsync(new FilesLocation(FilesView.Folder, file.FolderId))"
                                  ShowFolderLink="Location.View != FilesView.Folder"
                                  OnRename="() => RenameFileAsync(file)"
                                  OnMove="() => MoveAsync([file.Id], [], file.FileName, file.FolderId)"
                                  OnDelete="() => DeleteAsync([file.Id], [], [file.FileName])" />
                break;
            case FolderSelection { Folder: var folder }:
                <div class="files-details-body">
                    <div class="files-details-preview is-folder">
                        <FluentIcon Value="@(new Icons.Filled.Size24.Folder())" Color="Color.Default" />
                    </div>
                    <h3 class="files-details-name">@folder.Name</h3>
                    <dl class="files-details-facts">
                        <dt>Contains</dt><dd>@FileBrowserFormat.FolderSummary(folder)</dd>
                        <dt>Size</dt><dd>@FileTypeInfo.FormatSize(folder.Bytes) <span class="files-details-note">(not counting subfolders)</span></dd>
                        <dt>Created</dt><dd>@FileBrowserFormat.When(folder.CreatedAt)</dd>
                    </dl>

                    @if (CanManage)
                    {
                        <div class="files-details-share">
                            <FluentSwitch Value="folder.IsSharedWithStaff" ValueChanged="(bool on) => SetSharedAsync(folder, on)" Label="Share with staff" />
                            <p class="files-details-note">
                                @if (folder.IsSharedWithStaff)
                                {
                                    <text>Every staff member can see and download what's in this folder and its subfolders. They can't change anything.</text>
                                }
                                else if (folder.IsSharedEffective)
                                {
                                    <text>Shared already, because a folder above it is shared.</text>
                                }
                                else
                                {
                                    <text>Only Admins and people with CanManageFiles can see this folder.</text>
                                }
                            </p>
                        </div>
                    }

                    <div class="files-details-actions">
                        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.FolderOpen())" OnClick="() => GoAsync(new FilesLocation(FilesView.Folder, folder.Id))">Open</FluentButton>
                        @if (CanManage)
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.Rename())" OnClick="() => RenameFolderAsync(folder)">Rename</FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowMove())" OnClick="() => MoveAsync([], [folder.Id], folder.Name, folder.ParentFolderId)">Move</FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" OnClick="() => DeleteAsync([], [folder.Id], [folder.Name])">Delete</FluentButton>
                        }
                    </div>
                </div>
                break;
        }
    };
}
