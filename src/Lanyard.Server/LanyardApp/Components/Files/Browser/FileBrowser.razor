        {
            _uploadModule = await _js.InvokeAsync<IJSObjectReference>("import", "./js/fileUploads.js");
            _self = DotNetObjectReference.Create(this);
            _uploader = await _uploadModule.InvokeAsync<IJSObjectReference>("attach", _root, _self,
                new { folderId = CurrentFolderId?.ToString(), folderName = CurrentFolderName });
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
