    private void ReportBulk(Result<BulkOperationResult> result, string success)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            _toast.ShowWarning(result.Error ?? "That didn't work.");
            return;
        }

        BulkOperationResult done = result.Data;

        if (done.Failures.Count == 0)
            _toast.ShowSuccess(success);
        else if (done.Succeeded == 0 && done.Failures.Count == 1)
            _toast.ShowWarning($"\"{done.Failures[0].Name}\": {done.Failures[0].Reason}");
        else
            _toast.ShowWarning($"{done.Succeeded} done. {done.Failures.Count} couldn't be: {string.Join(" ", done.Failures.Take(3).Select(x => $"\"{x.Name}\": {x.Reason}"))}");

        foreach (string note in done.Notes)
            _toast.ShowInfo(note);
    }

