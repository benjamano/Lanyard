    private async Task MoveAsync(IReadOnlyList<Guid> fileIds, IReadOnlyList<Guid> folderIds, string what, Guid? currentFolder)
    {
        if (_tree is null)
            await LoadTreeAsync();

        DialogResult result = await _dialogService.ShowDialogAsync<MoveItemsDialog>(options =>
        {
            options.Header.Title = "Move to";
            options.Width = "min(480px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(MoveItemsDialog.Folders), _tree!);
            options.Parameters.Add(nameof(MoveItemsDialog.MovingFolderIds), folderIds);
            options.Parameters.Add(nameof(MoveItemsDialog.CurrentFolderId), currentFolder);
            options.Parameters.Add(nameof(MoveItemsDialog.What), $"“{what}”");
        });

        if (result.Cancelled || result.Value is not MoveItemsDialog.MoveTarget target)
            return;

        Result<BulkOperationResult> moved = await _library.MoveAsync(fileIds, folderIds, target.FolderId, CancellationToken.None);
        string destination = target.FolderId is Guid id ? _tree!.FirstOrDefault(x => x.Id == id)?.Name ?? "the folder" : "Files";

        ReportBulk(moved, $"Moved to {destination}");
        await RefreshAsync();
    }

    private async Task DeleteAsync(IReadOnlyList<Guid> fileIds, IReadOnlyList<Guid> folderIds, IReadOnlyList<string> names)
    {
        DialogResult confirm = await _dialogService.ShowDialogAsync<DeleteItemsDialog>(options =>
        {
            options.Header.Title = "Delete";
            options.Width = "min(480px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(DeleteItemsDialog.Names), names);
            options.Parameters.Add(nameof(DeleteItemsDialog.FileIds), fileIds);
            options.Parameters.Add(nameof(DeleteItemsDialog.FolderCount), folderIds.Count);
            options.Parameters.Add(nameof(DeleteItemsDialog.FolderIds), folderIds);
        });

        if (confirm.Cancelled || confirm.Value is not true)
            return;

        Result<BulkOperationResult> deleted = await _library.MoveToBinAsync(fileIds, folderIds, CancellationToken.None);
        ReportBulk(deleted, names.Count == 1 ? $"\"{names[0]}\" is in the Recycle bin" : $"{names.Count} items are in the Recycle bin");

        // Deleting the folder that's open takes you to the one above it.
        if (Location.FolderId is Guid open && folderIds.Contains(open))
        {
            await GoUpAsync();
            await Task.WhenAll(LoadTreeAsync(), LoadStorageAsync());
            return;
        }

        await RefreshAsync();
    }

