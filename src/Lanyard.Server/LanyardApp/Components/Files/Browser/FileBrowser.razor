    // Each finished file refreshes the view, but a batch of 30 refreshes once, just after the last.
    [JSInvokable]
    public Task OnUploadFinished(UploadTray.UploadItem item)
    {
        _uploadRefresh?.Cancel();
        _uploadRefresh?.Dispose();
        _uploadRefresh = new CancellationTokenSource();
        CancellationToken token = _uploadRefresh.Token;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(700, token);
                await RefreshAsync();
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
                // A later upload finished first and took over the refresh.
            }
        });

        return Task.CompletedTask;
    }

    // A dropped folder: find or make each folder on the path ("Summer/Posters") under the parent,
    // and return the last one's id. Null when it couldn't be made.
    [JSInvokable]
    public async Task<string?> EnsureFolderPath(string? parentId, string path)
    {
        // Only managers get the uploader, but a JS-invokable method is reachable from the browser.
        if (!CanManage)
            return null;

        Guid? parent = Guid.TryParse(parentId, out Guid parsed) ? parsed : null;
        Result<IReadOnlyList<FolderNode>> tree = await _library.GetTreeAsync(sharedOnly: false, CancellationToken.None);
        List<FolderNode> folders = tree.Data?.ToList() ?? [];

        foreach (string segment in path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            FolderNode? existing = folders.FirstOrDefault(x => x.ParentFolderId == parent && FileNameRules.SameName(x.Name, segment));

            if (existing is not null)
            {
                parent = existing.Id;
                continue;
            }

            Result<Folder> created = await _fileService.CreateFolderAsync(segment, parent, CancellationToken.None);

            if (!created.IsSuccess || created.Data is null)
                return null;

            folders.Add(new FolderNode(created.Data.Id, created.Data.Name, parent, false, false, 0, 0, 0, created.Data.CreatedAt));
            parent = created.Data.Id;
        }

        return parent?.ToString();
    }

    private async Task CancelUploadAsync(int id) => await CallUploaderAsync("cancel", id);

    private async Task RetryUploadAsync(int id) => await CallUploaderAsync("retry", id);

