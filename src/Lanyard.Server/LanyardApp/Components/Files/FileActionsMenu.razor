@using Lanyard.Infrastructure.Models
@using Lanyard.App.Components.Manager

@inject HttpClient Http
@inject IFileService _fileService
@inject INotificationService _toastService
@inject NavigationManager Navigation

<FluentButton IconEnd="@(new Icons.Regular.Size20.ArrowDownload())" OnClick="DownloadFile"></FluentButton>
<FluentButton IconEnd="@(new Icons.Regular.Size20.ArrowMove())" OnClick="ShowMoveDialogAsync"></FluentButton>
<FluentButton IconEnd="@(new Icons.Regular.Size20.Rename())" OnClick="ShowRenameDialogAsync"></FluentButton>
<FluentButton IconEnd="@(new Icons.Regular.Size20.BinRecycle())" OnClick="DeleteFile"></FluentButton>

<FluentDialog @ref="_renameDialog" Modal="true">
    <FluentDialogBody>
        <TitleTemplate>Rename File</TitleTemplate>
        <ChildContent>
            <FluentTextInput @bind-Value="renameValue" Label="New Name" Style="width: 100%;" />
        </ChildContent>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ConfirmRenameAsync">Rename</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CloseRenameDialogAsync">Cancel</FluentButton>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

<FluentDialog @ref="_moveDialog" Modal="true">
    <FluentDialogBody>
        <TitleTemplate>Move File</TitleTemplate>
        <ChildContent>
            <FolderTree @ref="_moveFolderTree" SelectedFolderId="moveTargetFolderId" SelectedFolderIdChanged="OnMoveTargetFolderChanged" />
        </ChildContent>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ConfirmMoveAsync">Move</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CloseMoveDialogAsync">Cancel</FluentButton>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

@code {
    [Parameter] public FileMetadata File { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnFileDeleted { get; set; }
    [Parameter] public EventCallback<FileMetadata> OnFileRenamed { get; set; }
    [Parameter] public EventCallback<FileMetadata> OnFileMoved { get; set; }

    private FluentDialog? _renameDialog;
    private string renameValue = string.Empty;
    private string renameValueExtensions = string.Empty;

    private FluentDialog? _moveDialog;
    private FolderTree? _moveFolderTree;
    private Guid? moveTargetFolderId;

    private async Task DeleteFile()
    {
        DialogResult confirmResult = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.DisplayName), File.FileName);
        });

        if (confirmResult.Cancelled)
        {
            return;
        }

        Result<bool> result = await _fileService.DeleteFileAsync(File.Id, CancellationToken.None);

        if (result?.Success == true)
        {
            await OnFileDeleted.InvokeAsync(File.Id);
        }
        else
        {
            _toastService.ShowError($"Failed to delete file, {result?.Error}");
        }
    }

    private void DownloadFile()
    {
        Navigation.NavigateTo($"api/Files/download/{File.Id}", forceLoad: true);
    }

    private async Task ShowMoveDialogAsync()
    {
        moveTargetFolderId = File.FolderId;

        if (_moveFolderTree is not null)
        {
            await _moveFolderTree.RefreshAsync(moveTargetFolderId);
        }

        await _moveDialog!.ShowAsync();
    }

    private async Task CloseMoveDialogAsync()
    {
        await _moveDialog!.HideAsync();
    }

    private void OnMoveTargetFolderChanged(Guid? folderId)
    {
        moveTargetFolderId = folderId;
    }

    private async Task ConfirmMoveAsync()
    {
        Result<FileMetadata> result = await _fileService.MoveFileAsync(File.Id, moveTargetFolderId, CancellationToken.None);

        if (result?.Success == true && result.Data != null)
        {
            await OnFileMoved.InvokeAsync(result.Data);
            await CloseMoveDialogAsync();
        }
        else
        {
            _toastService.ShowError($"Failed to move file, {result?.Error}");
        }
    }

    private async Task ShowRenameDialogAsync()
    {
        renameValueExtensions = Path.GetExtension(File.FileName);
        renameValue = Path.GetFileNameWithoutExtension(File.FileName);
        await _renameDialog!.ShowAsync();
    }

    private async Task CloseRenameDialogAsync()
    {
        await _renameDialog!.HideAsync();
    }

    private async Task ConfirmRenameAsync()
    {
        if (!string.IsNullOrWhiteSpace(renameValue))
        {
            string fullName = renameValue + renameValueExtensions;

            Result<FileMetadata> result = await _fileService.RenameFileAsync(File.Id, fullName, CancellationToken.None);

            if (result?.Success == true && result.Data != null)
            {
                await OnFileRenamed.InvokeAsync(result.Data);
                await CloseRenameDialogAsync();
            }
            else
            {
                _toastService.ShowError($"Failed to rename file, {result?.Error}");
            }
        }
        else
        {
            _toastService.ShowError("Invalid file name!");
        }
    }
}
