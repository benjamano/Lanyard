@using Lanyard.Application.Services.Scheduling
@using Lanyard.Infrastructure.DTO.Scheduling

@inject IYoungWorkerService _youngWorkerService

@* Managers and Admins only (the user editor's Rota tab). Staff never see their date of birth here. *@
<div class="young-worker-editor">
    <FluentText Style="color: var(--colorNeutralForeground3);">
        For staff under 18. Lanyard keeps their rota within the UK young worker limits: 8 hours a day, 40 a week,
        a 30 minute break on shifts over 4.5 hours, 12 hours off between days, 48 hours off a week, and no night work.
        Only managers see the date of birth, and it's deleted on their 18th birthday.
    </FluentText>

    @if (!isLoaded)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
            <FluentSpinner />
            <FluentText>Loading...</FluentText>
        </FluentStack>
    }
    else if (loadError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">@loadError</FluentMessageBar>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Wrap="true">
            @if (status is null)
            {
                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative">Not marked as under 18</FluentBadge>
            }
            else
            {
                @if (status.SchoolLeavingDate > Today)
                {
                    <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">Under school leaving age until @Format(status.SchoolLeavingDate)</FluentBadge>
                }
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">Under 18 until @Format(status.EighteenthBirthday)</FluentBadge>
                <FluentText Style="color: var(--colorNeutralForeground3);">
                    Set@(status.UpdatedByName is string name ? $" by {name}" : "") on @Format(RotaTime.LocalDate(status.UpdateDate))
                </FluentText>
            }
        </FluentStack>

        <div class="young-worker-fields">
            <div>
                <FluentDatePicker TValue="DateTime?" @bind-Value="dateOfBirth" Label="Date of birth" Culture="@RotaFormat.Uk" Width="100%" />
                <div class="young-worker-hint">@Hint</div>
            </div>
        </div>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true">
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Save())"
                          Disabled="@isBusy" OnClick="@SaveAsync">
                @(isBusy ? "Saving..." : "Save")
            </FluentButton>
            @if (status is not null)
            {
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@isBusy" OnClick="@ClearAsync">
                    Clear
                </FluentButton>
            }
        </FluentStack>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required string UserId { get; set; }

    private bool isLoaded;
    private string? loadError;
    private YoungWorkerStatusView? status;
    private DateTime? dateOfBirth;
    private bool isBusy;

    private static DateOnly Today => RotaTime.Today(DateTime.UtcNow);

    private static string Format(DateOnly day) => day.ToString("d MMM yyyy", RotaFormat.Uk);

    // What the date entered means, worked out as it's typed.
    private string Hint
    {
        get
        {
            if (dateOfBirth is not DateTime entered)
            {
                return "Only for staff under 18. Leave it empty for everyone else.";
            }

            DateOnly born = DateOnly.FromDateTime(entered);

            if (!YoungWorkerAge.IsUnder18On(born, Today))
            {
                return "They're 18 or over, so nothing needs to be kept.";
            }

            DateOnly school = YoungWorkerAge.SchoolLeavingDate(born);

            return school > Today
                ? $"Under 18 until {Format(YoungWorkerAge.EighteenthBirthday(born))}. Under school leaving age until {Format(school)}: until then Lanyard won't roster them automatically or let them pick up shifts."
                : $"Under 18 until {Format(YoungWorkerAge.EighteenthBirthday(born))}.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task<(LocationScope? Scope, string? ActingUserId)> ResolveCallerAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();
        Result<string> currentUser = await _securityService.GetCurrentUserIdAsync();

        if (!scopeResult.IsSuccess || scopeResult.Data is null || !currentUser.IsSuccess || string.IsNullOrEmpty(currentUser.Data))
        {
            _toastService.ShowError($"Failed to resolve your location: {scopeResult.Error ?? currentUser.Error}");
            return (null, null);
        }

        return (scopeResult.Data, currentUser.Data);
    }

    private async Task LoadAsync()
    {
        isLoaded = false;

        (LocationScope? scope, string? actingUserId) = await ResolveCallerAsync();

        if (scope is null || actingUserId is null)
        {
            loadError = "Couldn't work out who you are.";
            isLoaded = true;
            return;
        }

        Result<YoungWorkerStatusView?> result = await _youngWorkerService.GetAsync(scope, UserId, actingUserId);

        loadError = result.IsSuccess ? null : result.Error;
        Show(result.IsSuccess ? result.Data : null);
        isLoaded = true;
    }

    private void Show(YoungWorkerStatusView? view)
    {
        status = view;
        dateOfBirth = view?.DateOfBirth.ToDateTime(TimeOnly.MinValue);
    }

    private Task SaveAsync() => SaveDateAsync(dateOfBirth is DateTime entered ? DateOnly.FromDateTime(entered) : null);

    private Task ClearAsync() => SaveDateAsync(null);

    private async Task SaveDateAsync(DateOnly? born)
    {
        isBusy = true;

        (LocationScope? scope, string? actingUserId) = await ResolveCallerAsync();

        if (scope is null || actingUserId is null)
        {
            isBusy = false;
            return;
        }

        Result<YoungWorkerStatusView?> result = await _youngWorkerService.SaveAsync(scope, UserId, born, actingUserId);

        isBusy = false;

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to save: {result.Error}");
            return;
        }

        Show(result.Data);
        _toastService.ShowSuccess(result.Data is null ? "Date of birth removed." : "Date of birth saved.");
    }
}
