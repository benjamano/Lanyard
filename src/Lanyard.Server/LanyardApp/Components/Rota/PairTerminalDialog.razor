<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Margin="@Margin.End2" Value="@(new Icons.Regular.Size24.Tablet())" />
            <FluentText As="@TextTag.H3">Pair this device</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <div class="pair-dialog">
            <FluentText>
                Do this on the tablet that will stay at the venue. It becomes a clock-in terminal: staff tap their name and
                enter their PIN, or scan its code with their phone.
            </FluentText>

            <FluentTextInput @bind-Value="name" Label="Terminal name" Placeholder="Front desk tablet" Width="100%" Required="true" />

            @if (Locations.Count > 1)
            {
                <FluentSelect TOption="TerminalLocationOption" TValue="string" Items="@Locations" OptionText="@(x => x.Name)"
                              OptionValue="@(x => x.Id.ToString())" @bind-Value="locationId" Label="Location" Width="100%" />
            }
            else if (Locations.Count == 1)
            {
                <FluentText>Location: <strong>@Locations[0].Name</strong></FluentText>
            }

            <FluentCheckbox @bind-Value="signOut" Label="Sign me out on this device afterwards" />
            <FluentText Class="pair-hint">
                Recommended - otherwise anyone at the tablet could use your account.
            </FluentText>

            @if (error is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@error</FluentMessageBar>
            }
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@ConfirmAsync">Pair this device</FluentButton>
        <FluentButton OnClick="@(() => Dialog.CancelAsync())">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter, EditorRequired]
    public required List<TerminalLocationOption> Locations { get; set; }

    private string name = "Front desk tablet";
    private string? locationId;
    private bool signOut = true;
    private string? error;

    protected override void OnInitialized()
    {
        locationId = Locations.FirstOrDefault()?.Id.ToString();
    }

    private async Task ConfirmAsync()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            error = "Give the terminal a name.";
            return;
        }

        if (!int.TryParse(locationId, out int id))
        {
            error = "Choose a location.";
            return;
        }

        await Dialog.CloseAsync(new PairTerminalRequest(name.Trim(), id, signOut));
    }
}
