@inject IStaffAvailabilityService _availabilityService

@* A person's weekly availability: when they can't, or would rather, work. Used on My Shifts (their
   own) and in the user editor (a manager's view of someone else). *@
<div class="availability">
    @if (loadError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">@loadError</FluentMessageBar>
    }
    else if (rows is null)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" HorizontalGap="8px">
            <FluentSpinner />
            <FluentText>Loading...</FluentText>
        </FluentStack>
    }
    else
    {
        <div class="availability-header">
            <FluentText Class="availability-intro">
                @if (ForManager)
                {
                    <text>When they can't work, or would rather work, each week. Rota suggestions leave them out at times they can't work, and you're warned if you put them on one.</text>
                }
                else
                {
                    <text>Tell your managers when you can't work, or would rather work, each week. They see it when they build the rota.</text>
                }
            </FluentText>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="@(() => OpenAsync(null))">
                Add a time
            </FluentButton>
        </div>

        <section class="availability-wish" aria-labelledby="availability-wish-title">
            <div class="availability-wish-text">
                <span id="availability-wish-title" class="availability-wish-title">@(ForManager ? "How much they'd like to work" : "How much I'd like to work")</span>
                <span class="availability-wish-hint">
                    @(ForManager
                        ? "Optional. Suggestions and Auto-build put people who'd go past this behind everyone else, but they can still be picked. Their contract maximum still applies."
                        : "Optional. Your managers try not to give you more than this each week, but it isn't a promise. Leave a box empty for no limit.")
                </span>
            </div>
            <div class="availability-wish-fields">
                <FluentNumberInput TValue="int?" @bind-Value="wishShifts" Label="At most shifts a week" Min="1" Max="14" Width="100%" />
                <FluentNumberInput TValue="double?" @bind-Value="wishHours" Label="At most hours a week" Min="1" Max="100" Width="100%" />
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@(isBusy || !WishChanged)" OnClick="@SaveWishAsync">Save</FluentButton>
            </div>
            @if (wishMessage is not null)
            {
                <FluentText Class="availability-wish-saved" role="status">@wishMessage</FluentText>
            }
        </section>

        @if (actionError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@actionError</FluentMessageBar>
        }

        @if (rows.Count == 0)
        {
            <FluentCard Height="auto">
                <FluentText>@(ForManager ? "They haven't said when they can't work." : "You haven't said when you can't work. Without it, you could be put on any shift.")</FluentText>
            </FluentCard>
        }
        else
        {
            <ul class="availability-list">
                @foreach (StaffAvailability row in rows)
                {
                    <li class="availability-item">
                        <div class="availability-main">
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="@(row.Kind == AvailabilityKind.Unavailable ? BadgeColor.Warning : BadgeColor.Success)">
                                @(row.Kind == AvailabilityKind.Unavailable ? "Can't work" : "Prefers")
                            </FluentBadge>
                            <span class="availability-when">@StaffAvailabilityRules.Describe(row)</span>
                            @if (!string.IsNullOrWhiteSpace(row.Notes))
                            {
                                <span class="availability-note">@row.Notes</span>
                            }
                        </div>
                        <div class="availability-actions">
                            @if (confirmingRemoveId == row.Id)
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary" Color="Color.Error" Size="ButtonSize.Small" Disabled="@isBusy" OnClick="@(() => RemoveAsync(row.Id))">Remove</FluentButton>
                                <FluentButton Size="ButtonSize.Small" Disabled="@isBusy" OnClick="@(() => confirmingRemoveId = null)">Keep</FluentButton>
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="@(new Icons.Regular.Size20.Edit())"
                                              Title="@($"Edit {StaffAvailabilityRules.Describe(row)}")" OnClick="@(() => OpenAsync(row))" />
                                <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="@(new Icons.Regular.Size20.Delete())"
                                              Title="@($"Remove {StaffAvailabilityRules.Describe(row)}")" OnClick="@(() => confirmingRemoveId = row.Id)" />
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    // Whose availability. Their own unless ForManager.
    [Parameter, EditorRequired]
    public required string UserId { get; set; }

    [Parameter]
    public bool ForManager { get; set; }

    private List<StaffAvailability>? rows;
    private string? loadError;
    private string? actionError;
    private Guid? confirmingRemoveId;
    private bool isBusy;

    private LocationScope? scope;
    private string? actingUserId;

    private int? wishShifts;
    private double? wishHours;
    private int? savedShifts;
    private double? savedHours;
    private string? wishMessage;

    private bool WishChanged => wishShifts != savedShifts || wishHours != savedHours;

    protected override async Task OnParametersSetAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();
        Result<string> actingUser = await _securityService.GetCurrentUserIdAsync();

        if (!scopeResult.IsSuccess || scopeResult.Data is null || !actingUser.IsSuccess || string.IsNullOrEmpty(actingUser.Data))
        {
            loadError = "Couldn't confirm who you are - try reloading the page.";
            return;
        }

        scope = scopeResult.Data;
        actingUserId = actingUser.Data;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Result<List<StaffAvailability>> result = await _availabilityService.GetAsync(scope!, UserId, actingUserId!);

        if (!result.IsSuccess || result.Data is null)
        {
            loadError = result.Error;
            return;
        }

        loadError = null;
        rows = result.Data;

        Result<StaffWorkPreference?> wish = await _availabilityService.GetPreferenceAsync(scope!, UserId, actingUserId!);

        if (wish.IsSuccess)
        {
            savedShifts = wishShifts = wish.Data?.MaxShiftsPerWeek;
            savedHours = wishHours = wish.Data?.MaxHoursPerWeek is decimal hours ? (double)hours : null;
        }
    }

    private async Task SaveWishAsync()
    {
        actionError = null;
        wishMessage = null;
        isBusy = true;

        Result<StaffWorkPreference?> result = await _availabilityService.SavePreferenceAsync(scope!, UserId,
            wishShifts, wishHours is double hours ? (decimal)hours : null, actingUserId!);

        isBusy = false;

        if (!result.IsSuccess)
        {
            actionError = result.Error;
            return;
        }

        savedShifts = wishShifts = result.Data?.MaxShiftsPerWeek;
        savedHours = wishHours = result.Data?.MaxHoursPerWeek is decimal saved ? (double)saved : null;
        wishMessage = result.Data is null ? "Saved: no limit." : "Saved.";
    }

    private async Task OpenAsync(StaffAvailability? existing)
    {
        actionError = null;

        DialogResult result = await _dialogService.ShowDialogAsync<AvailabilityDialog>(options =>
        {
            options.Width = "440px";
            options.Modal = true;
            options.Parameters.Add(nameof(AvailabilityDialog.UserId), UserId);
            options.Parameters.Add(nameof(AvailabilityDialog.Existing), existing);
            options.Parameters.Add(nameof(AvailabilityDialog.ForManager), ForManager);
        });

        if (!result.Cancelled)
        {
            await LoadAsync();
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        isBusy = true;
        Result<bool> result = await _availabilityService.RemoveAsync(scope!, id, actingUserId!);
        isBusy = false;
        confirmingRemoveId = null;

        if (!result.IsSuccess)
        {
            actionError = result.Error;
            return;
        }

        await LoadAsync();
    }
}
