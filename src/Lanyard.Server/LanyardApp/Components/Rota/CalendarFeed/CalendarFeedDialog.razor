<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.CalendarAdd())" Margin="@Margin.End2" />
            <FluentText As="@TextTag.H4" Weight="TextWeight.Semibold" Color="Color.Default">
                Add your shifts to your calendar
            </FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <CalendarFeedPanel />
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Dialog.CloseAsync())">Close</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }
}
