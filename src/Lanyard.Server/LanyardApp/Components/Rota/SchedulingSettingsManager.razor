@using System.Globalization
@using Lanyard.Application.Services.Scheduling
@using Lanyard.Infrastructure.DTO.Scheduling

@inject ISchedulingSettingsService _schedulingSettingsService

<div class="scheduling-settings">
    <FluentCard Height="auto" Class="mt-2">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">Rota Settings</FluentText>

            @if (settings is null)
            {
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentSpinner />
                    <FluentText>Loading...</FluentText>
                </FluentStack>
            }
            else
            {
                <div class="settings-fields">
                    <div class="settings-field">
                        <FluentSelect TOption="MonthOption" TValue="string" Items="@months" OptionText="@(x => x.Name)"
                                      OptionValue="@(x => x.Number.ToString())" @bind-Value="financialYearStartMonth"
                                      Label="Holiday year starts in" Width="100%" />
                        <div class="settings-hint">Time-off allowances reset on this date. The UK tax year starts on 6 April.</div>
                    </div>
                    <div class="settings-field">
                        <FluentNumberInput TValue="int" Label="Day of the month" @bind-Value="financialYearStartDay" Width="100%" />
                    </div>
                    <div class="settings-field">
                        <FluentNumberInput TValue="double" Label="Hours in a working day" @bind-Value="hoursPerDay" Width="100%" />
                        <div class="settings-hint">Used to show holiday allowances in days as well as hours.</div>
                    </div>
                    <div class="settings-field">
                        <FluentNumberInput TValue="int" Label="Clock-in window (minutes)" @bind-Value="clockInWindowMinutes" Width="100%" />
                        <div class="settings-hint">How long before a shift starts, and after it ends, staff can clock in for it on a terminal.</div>
                    </div>
                    <div class="settings-field">
                        <FluentSwitch @bind-Value="sendShiftReminders" Label="Email staff a reminder before each shift" />
                        <FluentNumberInput TValue="int" Label="Shift reminder lead time (hours)" @bind-Value="shiftReminderLeadHours" Width="100%"
                                           Disabled="@(!sendShiftReminders)" />
                        <div class="settings-hint">How far ahead of a shift the reminder goes out. A shift published inside that time isn't reminded again, since the rota email has just told them.</div>
                    </div>
                </div>

                <FluentDivider Class="my-3" />

                <div class="settings-section">
                    <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size400">Payroll export</FluentText>
                    <div class="settings-hint">Used by Export on the Timesheets page: the one-click pay period dates, and whether breaks are taken off paid time.</div>
                </div>

                <div class="settings-fields">
                    <div class="settings-field">
                        <FluentSelect TOption="ChoiceOption<PayPeriodFrequency>" TValue="string" Items="@payPeriodOptions" OptionText="@(x => x.Name)"
                                      OptionValue="@(x => ((int)x.Value).ToString())" @bind-Value="payPeriod"
                                      Label="Pay period" Width="100%" />
                    </div>

                    @if (SelectedPayPeriod == PayPeriodFrequency.Monthly)
                    {
                        <div class="settings-field">
                            <FluentNumberInput TValue="int" Label="Period starts on day" @bind-Value="payPeriodStartDay" Width="100%" />
                            <div class="settings-hint">1 is a calendar month. 26 runs from the 26th to the 25th. Up to 28, so every month has it.</div>
                        </div>
                    }
                    else
                    {
                        <div class="settings-field">
                            <FluentDatePicker TValue="DateTime?" @bind-Value="payPeriodAnchor" Label="First day of any pay period" Culture="@RotaFormat.Uk" Width="100%" />
                            <div class="settings-hint">Any past or future period works - Lanyard counts the periods from it.</div>
                        </div>
                    }

                    <div class="settings-field">
                        <FluentSelect TOption="ChoiceOption<BreakDeductionRule>" TValue="string" Items="@breakRuleOptions" OptionText="@(x => x.Name)"
                                      OptionValue="@(x => ((int)x.Value).ToString())" @bind-Value="breakRule"
                                      Label="Breaks in the payroll export" Width="100%" />
                        <div class="settings-hint">Clocked hours on the timesheet never change. The export shows clocked and paid time side by side.</div>
                    </div>

                    @if (SelectedBreakRule == BreakDeductionRule.FixedOverThreshold)
                    {
                        <div class="settings-field">
                            <FluentNumberInput TValue="int" Label="Minutes to take off" @bind-Value="breakMinutes" Width="100%" />
                        </div>
                        <div class="settings-field">
                            <FluentNumberInput TValue="double" Label="On any day over (hours)" @bind-Value="breakAfterHours" Width="100%" />
                            <div class="settings-hint">The UK legal minimum is a 20 minute break when working more than 6 hours.</div>
                        </div>
                    }
                </div>

                @if (PeriodExample is string example)
                {
                    <FluentText Class="settings-example">@example</FluentText>
                }

                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Save())"
                              Disabled="@isSaving" OnClick="@SaveAsync">
                    @(isSaving ? "Saving..." : "Save Settings")
                </FluentButton>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Height="auto" Class="mt-3">
        <ContractRequirementEditor CompanyId="@CompanyId" Title="Default contract requirements" />
    </FluentCard>
</div>

@code {
    [Parameter, EditorRequired]
    public required int CompanyId { get; set; }

    private record MonthOption(int Number, string Name);

    private record ChoiceOption<T>(T Value, string Name);

    private static readonly List<ChoiceOption<PayPeriodFrequency>> payPeriodOptions =
    [
        new(PayPeriodFrequency.Monthly, "Monthly"),
        new(PayPeriodFrequency.Weekly, "Weekly"),
        new(PayPeriodFrequency.Fortnightly, "Fortnightly"),
        new(PayPeriodFrequency.FourWeekly, "Every four weeks")
    ];

    private static readonly List<ChoiceOption<BreakDeductionRule>> breakRuleOptions =
    [
        new(BreakDeductionRule.None, "Don't take breaks off"),
        new(BreakDeductionRule.RotaBreak, "Take off the rota break of each shift"),
        new(BreakDeductionRule.FixedOverThreshold, "Take off a set break on long days")
    ];

    private static readonly List<MonthOption> months = Enumerable.Range(1, 12)
        .Select(m => new MonthOption(m, CultureInfo.GetCultureInfo("en-GB").DateTimeFormat.GetMonthName(m)))
        .ToList();

    private CompanySchedulingSettings? settings;
    private string financialYearStartMonth = "4";
    private int financialYearStartDay = 6;
    private double hoursPerDay = 8;
    private int shiftReminderLeadHours = 24;
    private bool sendShiftReminders = true;
    private int clockInWindowMinutes = 60;
    private string payPeriod = "0";
    private int payPeriodStartDay = 1;
    private DateTime? payPeriodAnchor;
    private string breakRule = "0";
    private int breakMinutes = 20;
    private double breakAfterHours = 6;

    private PayPeriodFrequency SelectedPayPeriod =>
        int.TryParse(payPeriod, out int value) && System.Enum.IsDefined((PayPeriodFrequency)value) ? (PayPeriodFrequency)value : PayPeriodFrequency.Monthly;

    private BreakDeductionRule SelectedBreakRule =>
        int.TryParse(breakRule, out int value) && System.Enum.IsDefined((BreakDeductionRule)value) ? (BreakDeductionRule)value : BreakDeductionRule.None;

    // "Current pay period: 26 Sept – 25 Oct 2026", from what's on screen, before saving.
    private string? PeriodExample
    {
        get
        {
            CompanySchedulingSettings draft = new()
            {
                CompanyId = CompanyId,
                PayPeriod = SelectedPayPeriod,
                PayPeriodStartDay = payPeriodStartDay,
                PayPeriodAnchorDate = payPeriodAnchor is DateTime anchor ? DateOnly.FromDateTime(anchor) : null
            };

            if (!PayPeriodCalculator.IsConfigured(draft) || (draft.PayPeriod == PayPeriodFrequency.Monthly && payPeriodStartDay is < 1 or > 28))
            {
                return null;
            }

            PayPeriod current = PayPeriodCalculator.Containing(draft, RotaTime.Today(DateTime.UtcNow));
            return $"Current pay period: {RotaDisplayExtensions.RangeLabel(current.From, current.To)}";
        }
    }
    private bool isSaving;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        settings = null;

        Result<CompanySchedulingSettings> result = await _schedulingSettingsService.GetSettingsAsync(CompanyId);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load rota settings: {result.Error}");
            settings = new CompanySchedulingSettings { CompanyId = CompanyId };
        }
        else
        {
            settings = result.Data;
        }

        financialYearStartMonth = settings.FinancialYearStartMonth.ToString();
        financialYearStartDay = settings.FinancialYearStartDay;
        hoursPerDay = (double)settings.HoursPerDay;
        shiftReminderLeadHours = settings.ShiftReminderLeadHours;
        sendShiftReminders = settings.SendShiftReminders;
        clockInWindowMinutes = settings.ClockInWindowMinutes;
        payPeriod = ((int)settings.PayPeriod).ToString();
        payPeriodStartDay = settings.PayPeriodStartDay;
        payPeriodAnchor = settings.PayPeriodAnchorDate?.ToDateTime(TimeOnly.MinValue);
        breakRule = ((int)settings.BreakDeduction).ToString();
        breakMinutes = settings.BreakDeductionMinutes;
        breakAfterHours = (double)settings.BreakDeductionAfterHours;
    }

    private async Task SaveAsync()
    {
        isSaving = true;

        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess || scopeResult.Data is null)
        {
            isSaving = false;
            _toastService.ShowError($"Failed to resolve your location: {scopeResult.Error}");
            return;
        }

        CompanySchedulingSettings toSave = new()
        {
            CompanyId = CompanyId,
            FinancialYearStartMonth = int.TryParse(financialYearStartMonth, out int month) ? month : 4,
            FinancialYearStartDay = financialYearStartDay,
            HoursPerDay = (decimal)hoursPerDay,
            ShiftReminderLeadHours = shiftReminderLeadHours,
            SendShiftReminders = sendShiftReminders,
            ClockInWindowMinutes = clockInWindowMinutes,
            PayPeriod = SelectedPayPeriod,
            PayPeriodStartDay = payPeriodStartDay,
            PayPeriodAnchorDate = payPeriodAnchor is DateTime anchor ? DateOnly.FromDateTime(anchor) : null,
            BreakDeduction = SelectedBreakRule,
            BreakDeductionMinutes = breakMinutes,
            BreakDeductionAfterHours = (decimal)breakAfterHours
        };

        Result<CompanySchedulingSettings> result = await _schedulingSettingsService.SaveSettingsAsync(scopeResult.Data, toSave);

        isSaving = false;

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to save rota settings: {result.Error}");
            return;
        }

        _toastService.ShowSuccess("Rota settings saved.");
        await LoadAsync();
    }
}
