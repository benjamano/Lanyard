@using Lanyard.App.Components.Kiosk

<FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" Height="100%">
    <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size900">@DisplayText</FluentText>
</FluentStack>

@code {
    [Parameter, EditorRequired]
    public ProjectionProgramStep Step { get; set; } = default!;

    // Live values for data-bound parameters, from the runner. Null renders fixed/fallback text only.
    [Parameter]
    public IReadOnlyDictionary<Guid, string>? BoundValues { get; set; }

    // Rendered with @, so Razor encodes it: bound text is never treated as markup.
    private string? DisplayText => ProjectionStepValues.Get(Step, KioskTemplateConstants.ParameterNames.Text, BoundValues);
}
