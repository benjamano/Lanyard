@implements IDisposable
@using Lanyard.App.Components.Kiosk.Templates
@using Lanyard.App.Components.Pages.Staff.Dashboards

@inject IProjectionProgramRunnerService _programRunner
@inject ILogger<KioskDisplay> _logger

@if (CurrentProjectionStep?.Template?.Name == KioskTemplateConstants.TemplateNames.ShowText)
{
    <KioskShowTextTemplate Step="CurrentProjectionStep" />
}
else if (CurrentProjectionStep?.Template?.Name == KioskTemplateConstants.TemplateNames.PlayVideo)
{
    <KioskPlayVideoTemplate Step="CurrentProjectionStep" />
}
else if (CurrentProjectionStep?.Template?.Name == KioskTemplateConstants.TemplateNames.Dashboard)
{
    <RenderDashboardTemplate Step="CurrentProjectionStep" />
}
else if (CurrentProjectionStep?.Template?.Name == KioskTemplateConstants.TemplateNames.LiveCapture)
{
    <KioskLiveCaptureTemplate Step="CurrentProjectionStep" ClientId="ClientId" ViewerToken="@ViewerToken" />
}

@code {
    [Parameter]
    public ProjectionProgram projectionProgram { get; set; } = new() { Name = "" };

    [Parameter]
    public Guid ClientId { get; set; }

    [Parameter]
    public int DisplayIndex { get; set; }

    [Parameter]
    public string? ViewerToken { get; set; }

    [Parameter]
    public bool RepeatInfinitely { get; set; } = true;

    [Parameter]
    public int RepeatCount { get; set; } = 0;

    [Parameter]
    public bool IsTemporaryTrigger { get; set; }

    [Parameter]
    public EventCallback<ProjectionProgramStep?> OnCurrentStepChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnPauseChanged { get; set; }

    public ProjectionProgramStep CurrentProjectionStep { get; set; } = new();

    // This component no longer owns the step loop - IProjectionProgramRunnerService does, as a
    // singleton the rest of the app can see and control. The runner and this circuit live in the
    // same process, so the subscription below is a plain in-process event, not another SignalR hop.
    private Guid? _runId;
    private IReadOnlyList<ProjectionProgramStep> _steps = [];

    protected override void OnInitialized()
    {
        _programRunner.OnProgramStepAdvanced += HandleStepAdvanced;
        _programRunner.OnProgramPauseChanged += HandlePauseChanged;
    }

    public async Task StartProcessingAsync()
    {
        Result<Guid> startResult = await _programRunner.StartAsync(
            ClientId, DisplayIndex, projectionProgram.Id, RepeatInfinitely, RepeatCount, IsTemporaryTrigger);

        if (!startResult.IsSuccess)
        {
            _logger.LogWarning("Failed to start projection program {ProgramId} for client {ClientId} display {DisplayIndex}: {Error}", projectionProgram.Id, ClientId, DisplayIndex, startResult.Error);

            _toastService.ShowError($"Failed to start projection program: {startResult.Error}");

            return;
        }

        _runId = startResult.Data;

        // The runner raises its first step-advanced event from a background task that can beat
        // StartAsync's return, so paint from the run's current state rather than relying on
        // having been subscribed in time to catch it.
        ProjectionRunState? state = _programRunner.GetRunningState(ClientId, DisplayIndex);

        if (state is not null)
        {
            _steps = state.Steps;

            await ApplyStepAsync(state.CurrentStepIndex);
        }
    }

    private void HandleStepAdvanced(Guid clientId, int displayIndex, int stepIndex)
    {
        if (clientId != ClientId || displayIndex != DisplayIndex)
        {
            return;
        }

        _ = ApplyStepAsync(stepIndex);
    }

    private void HandlePauseChanged(Guid clientId, int displayIndex, bool isPaused)
    {
        if (clientId != ClientId || displayIndex != DisplayIndex)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();

            await OnPauseChanged.InvokeAsync(isPaused);
        });
    }

    private async Task ApplyStepAsync(int stepIndex)
    {
        if (_steps.Count == 0)
        {
            _steps = _programRunner.GetRunningState(ClientId, DisplayIndex)?.Steps ?? [];
        }

        if (stepIndex < 0 || stepIndex >= _steps.Count)
        {
            return;
        }

        ProjectionProgramStep step = _steps[stepIndex];

        // A Delay step holds, it doesn't render - whatever the previous step put on screen stays.
        if (string.Equals(step.Template?.Name, KioskTemplateConstants.TemplateNames.Delay, StringComparison.Ordinal))
        {
            return;
        }

        CurrentProjectionStep = step;

        await InvokeAsync(async () =>
        {
            StateHasChanged();

            await OnCurrentStepChanged.InvokeAsync(step);
        });
    }

    public void Dispose()
    {
        _programRunner.OnProgramStepAdvanced -= HandleStepAdvanced;
        _programRunner.OnProgramPauseChanged -= HandlePauseChanged;

        // Passing the run id makes this a no-op if a newer kiosk circuit has already taken over
        // this display - on a page reload the replacing circuit can start before this one disposes.
        if (_runId is not null)
        {
            _programRunner.Stop(ClientId, DisplayIndex, _runId);
        }
    }
}
