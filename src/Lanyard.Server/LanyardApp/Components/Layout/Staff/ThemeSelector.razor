@inject IThemeService ThemeService

<FluentStack Orientation="@Orientation.Horizontal" HorizontalAlignment="@HorizontalAlignment.Start"
             VerticalAlignment="@VerticalAlignment.Center" Width="fit-content">
    <FluentButton Appearance="ButtonAppearance.Transparent" IconOnly="true" Class="fluent-header-hover"
                  BackgroundColor="transparent" OnClick="ToggleDarkMode">

        <FluentIcon Class="hidden-if-light" Color="@Color.Default" Value="@(new Icons.Filled.Size20.WeatherSunny())" />

        <FluentIcon Class="hidden-if-dark" Color="@Color.Lightweight"
                    Value="@(new Icons.Filled.Size20.WeatherMoon())" />
    </FluentButton>
</FluentStack>

@code {
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isDarkMode = await ThemeService.IsDarkModeAsync();

                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleDarkMode()
    {
        await ThemeService.SwitchThemeAsync();

        isDarkMode = !isDarkMode;
    }
}
