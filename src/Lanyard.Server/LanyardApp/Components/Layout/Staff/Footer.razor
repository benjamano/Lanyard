@using Lanyard.Shared.DTO;

@implements IDisposable

@inject AppInfo AppInfo
@inject AuthenticationStateProvider AuthenticationStateProvider

<FluentGrid AdaptiveRendering="true" Spacing="0">
    <FluentGridItem HiddenWhen="GridItemHidden.SmAndDown" Xs="12">
        <footer>
            <FluentCard Appearance="CardAppearance.Subtle" Class="rounded-0">
                <FluentStack VerticalAlignment="VerticalAlignment.Center"
                             HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    @* <span class="mb-0">© @DateTime.UtcNow.Year The Lanyard Development Team</span> *@
                    <span class="mb-0">© @DateTime.UtcNow.Year Benjamin Mercer</span>

                    @if (!string.IsNullOrWhiteSpace(_locationName))
                    {
                        <span class="mb-0">@_locationName</span>
                    }

                    <FluentStack Width="auto" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        <span>v@(AppInfo.Version)</span>
                        <a href="/privacy">Privacy Policy</a>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </footer>
    </FluentGridItem>
    <AuthorizeView>
        <Authorized>
            <FluentGridItem Xs="12" HiddenWhen="GridItemHidden.MdAndUp">
                <div class="mt-5 pb-3"></div>
                <MobileNavMenu />
            </FluentGridItem>
        </Authorized>
    </AuthorizeView>
</FluentGrid>

@code {
    private string? _locationName;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    // The event fires off the renderer's synchronisation context, so the reload has to be
    // marshalled back onto it - same pattern as MainLayout's branding refresh.
    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(LoadLocationNameAsync);
    }

    // Deliberately not OnInitializedAsync: GetScopeAsync reads the auth state and hits the
    // database, neither of which behaves during prerendering.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadLocationNameAsync();
    }

    private async Task LoadLocationNameAsync()
    {
        string? name = null;

        try
        {
            Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

            // A failed scope just means nobody is logged in yet (or their claim is stale) -
            // the footer stays as it was rather than showing an error.
            if (scopeResult.Success)
            {
                name = scopeResult.Data?.LocationDisplayName;
            }
        }
        catch { }

        if (name == _locationName)
        {
            return;
        }

        _locationName = name;

        StateHasChanged();
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
