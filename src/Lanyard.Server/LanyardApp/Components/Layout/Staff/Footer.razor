@using Lanyard.Shared.DTO;

@inject AppInfo AppInfo

<FluentGrid AdaptiveRendering="true" Spacing="0">
    <FluentGridItem HiddenWhen="GridItemHidden.SmAndDown" Xs="12">
        <footer>
            <FluentCard Appearance="CardAppearance.Subtle" Class="rounded-0">
                <FluentStack VerticalAlignment="VerticalAlignment.Center"
                             HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    @* <span class="mb-0">© @DateTime.UtcNow.Year The Lanyard Development Team</span> *@
                    <span class="mb-0">© @DateTime.UtcNow.Year Benjamin Mercer</span>

                    <FluentStack Width="auto" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        <span>v@(AppInfo.Version)</span>
                        <a href="/privacy">Privacy Policy</a>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </footer>
    </FluentGridItem>
    <AuthorizeView>
        <Authorized>
            <FluentGridItem Xs="12" HiddenWhen="GridItemHidden.MdAndUp">
                <div class="mt-5 pb-3"></div>
                <MobileNavMenu />
            </FluentGridItem>
        </Authorized>
    </AuthorizeView>
</FluentGrid>