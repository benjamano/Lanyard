@implements IDisposable

@inject Lanyard.App.Services.ChatUnreadTracker ChatUnread
@inject ICompanyFeatureService CompanyFeatures

@* No NotAuthorized branch: the bar itself (not just its content) should not render at all
   until the user is signed in - a fixed-position bar with just a "Login" link on it is
   redundant clutter, especially on the login page itself. *@
<AuthorizeView>
    <Authorized>
        <FluentCard Appearance="CardAppearance.Subtle" Class="rounded-0 position-fixed bottom-0 start-0 end-0 z-100 p-0"
                    Height="auto">
            <FluentAppBar Orientation="Orientation.Horizontal" Class="w-100" PopoverShowSearch="true">
                <div class="d-flex align-items-center w-100">
                    <div style="flex: 1;">
                        @* Chat took Account's place here; Account is still in the menu. Without chat,
                           Account comes back so the left slot isn't left empty. *@
                        @if (Has(CompanyFeature.Chat))
                        {
                            <FluentAppBarItem Href="/chat" Match="NavLinkMatch.Prefix"
                                              IconRest="new Icons.Regular.Size28.Chat()" IconActive="new Icons.Filled.Size28.Chat()"
                                              Text="Chat" Count="@ChatUnread.Count" />
                        }
                        else
                        {
                            <FluentAppBarItem Href="/account/manage" Match="NavLinkMatch.All"
                                              IconRest="new Icons.Regular.Size28.Person()" IconActive="new Icons.Filled.Size28.Person()"
                                              Text="Account" />
                        }
                    </div>
                    <div class="d-flex align-items-center justify-content-center">
                        <FluentAppBarItem Href="/" Match="NavLinkMatch.All" IconRest="new Icons.Regular.Size28.Home()"
                                          IconActive="new Icons.Filled.Size28.Home()" Text="Home" />

                        @if (Has(CompanyFeature.StaffScheduling))
                        {
                            <FluentAppBarItem Href="/rota" Match="NavLinkMatch.All"
                                              IconRest="new Icons.Regular.Size28.CalendarLtr()" IconActive="new Icons.Filled.Size28.CalendarLtr()"
                                              Text="Shifts" />
                        }
                        @if (Has(CompanyFeature.Training))
                        {
                            <FluentAppBarItem Href="/training" Match="NavLinkMatch.Prefix"
                                              IconRest="new Icons.Regular.Size28.Book()" IconActive="new Icons.Filled.Size28.Book()"
                                              Text="Training" />
                        }

                        @* <FluentAppBarItem Href="/messages"
                            Match="NavLinkMatch.All"
                            Count="3"
                            IconRest="new Icons.Regular.Size28.Mail()"
                            IconActive="new Icons.Filled.Size28.Mail()"
                            Text="Messages" /> *@
                    </div>
                    <div style="flex: 1;" class="d-flex justify-content-end">
                        <FluentAppBarItem OnClick="@(_ => Logout())"
                                          IconRest="new Icons.Regular.Size28.ArrowExit()"
                                          IconActive="new Icons.Filled.Size28.ArrowExit()" Text="Logout" />
                    </div>
                </div>
            </FluentAppBar>
        </FluentCard>
    </Authorized>
</AuthorizeView>

@code {
    // Modules this user's company doesn't have - see NavMenu.razor.
    private IReadOnlySet<CompanyFeature> _hiddenFeatures = new HashSet<CompanyFeature>();

    private bool Has(CompanyFeature feature) => !_hiddenFeatures.Contains(feature);

    protected override async Task OnInitializedAsync()
    {
        _hiddenFeatures = await CompanyFeatures.GetHiddenFeaturesForCurrentUserAsync();

        if (Has(CompanyFeature.Chat))
        {
            ChatUnread.Changed += OnChatUnreadChanged;
            await ChatUnread.StartAsync();
        }
    }

    private void OnChatUnreadChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ChatUnread.Changed -= OnChatUnreadChanged;

    // Kept off Href deliberately - see the matching comment in NavMenu.razor. /api/auth/logout is a
    // controller endpoint with no @page, so routing the click through Blazor's interactive router
    // makes it push a routeless URL into history before falling back to a full browser navigation.
    private void Logout() => _navigationManager.NavigateTo("/api/auth/logout", forceLoad: true);
}
