@using Lanyard.App.Components.Dialogs
@using Lanyard.Shared.DTO
@using Lanyard.Application.Services.Scheduling
@implements IDisposable

@inject NavigationManager NavigationManager
@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@inject IReleaseNotesService ReleaseNotesService
@inject ITimeOffService TimeOffService
@inject ITimeOffEventBus TimeOffEventBus

<FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween"
             HorizontalAlignment="HorizontalAlignment.Stretch" Height="100%">
    <FluentNav UseSingleExpanded="true" Density="NavDensity.Medium">
        @if (CompanyLogoUrl is not null)
        {
            <FluentStack Width="auto">
                <CompanyLogo Url="@CompanyLogoUrl" />
            </FluentStack>

            <FluentDivider />
        }

        @if (_isAuthenticated)
        {
            <FluentNavItem Href="/" IconRest="@(new Icons.Regular.Size20.Home())"
                           IconActive="@(new Icons.Filled.Size20.Home())" Match="NavLinkMatch.All">
                Home
            </FluentNavItem>

            <FluentNavItem Href="/training" IconRest="@(new Icons.Regular.Size20.BookOpen())"
                           IconActive="@(new Icons.Filled.Size20.BookOpen())">
                My Training
            </FluentNavItem>

            <FluentNavItem Href="/rota" IconRest="@(new Icons.Regular.Size20.CalendarLtr())"
                           IconActive="@(new Icons.Filled.Size20.CalendarLtr())" Match="NavLinkMatch.All">
                My Shifts
            </FluentNavItem>

            <FluentNavItem Href="/rota/time-off" IconRest="@(new Icons.Regular.Size20.CalendarPerson())"
                           IconActive="@(new Icons.Filled.Size20.CalendarPerson())">
                Time Off
            </FluentNavItem>

            @if (_canPostAnnouncements)
            {
                <FluentNavItem Href="/manage/announcements" IconRest="@(new Icons.Regular.Size20.Megaphone())"
                               IconActive="@(new Icons.Filled.Size20.Megaphone())">
                    Announcements
                </FluentNavItem>
            }

            @if (_isManager)
            {
                <FluentNavSectionHeader Title="Management" />

                @if (_canManageFiles)
                {
                    <FluentNavItem Href="/files" IconRest="@(new Icons.Regular.Size20.Folder())"
                                   IconActive="@(new Icons.Filled.Size20.Folder())">
                        File Manager
                    </FluentNavItem>
                }

                <FluentNavCategory Title="Manage" IconRest="@(new Icons.Regular.Size20.Settings())"
                                   IconActive="@(new Icons.Filled.Size20.Settings())">
                    @if (_isAdmin)
                    {
                        <FluentNavItem Href="/manage/companies-locations">Companies &amp; Locations</FluentNavItem>
                    }

                    <FluentNavItem Href="/manage/onboarding">Onboarding</FluentNavItem>
                    <FluentNavItem Href="/manage/staff-documents/types">Staff Document Types</FluentNavItem>
                    <FluentNavItem Href="/manage/roles">Roles</FluentNavItem>
                    <FluentNavItem Href="/manage/users">Users</FluentNavItem>
                </FluentNavCategory>

                <FluentNavCategory Title="Training" IconRest="@(new Icons.Regular.Size20.BookOpen())"
                                   IconActive="@(new Icons.Filled.Size20.BookOpen())">
                    <FluentNavItem Href="/manage/training" Match="NavLinkMatch.All">Dashboard</FluentNavItem>
                    <FluentNavItem Href="/manage/training/courses">Courses</FluentNavItem>
                </FluentNavCategory>

                <FluentNavCategory Title="Rota" data-pending-count="@PendingCountAttribute" Tooltip="@PendingTooltip" IconRest="@(new Icons.Regular.Size20.People())"
                                   IconActive="@(new Icons.Filled.Size20.People())">
                    <FluentNavItem Href="/manage/rota" Match="NavLinkMatch.All">Rota Builder</FluentNavItem>
                    <FluentNavItem Href="/manage/rota/timesheets">Timesheets</FluentNavItem>
                    <FluentNavItem Href="/manage/rota/time-off" Match="NavLinkMatch.All" Tooltip="@PendingTooltip">
                        <span class="nav-item-with-count">
                            Time Off Requests
                            @if (_pendingTimeOff > 0)
                            {
                                <FluentCounterBadge Count="@_pendingTimeOff" OverflowCount="99" aria-label="@PendingTooltip" />
                            }
                        </span>
                    </FluentNavItem>
                    <FluentNavItem Href="/manage/rota/time-off/types">Time Off Types</FluentNavItem>
                    <FluentNavItem Href="/manage/rota/terminals">Clock-In Terminals</FluentNavItem>
                    <FluentNavItem Href="/manage/rota/positions">Positions</FluentNavItem>
                    <FluentNavItem Href="/manage/rota/settings">Rota Settings</FluentNavItem>
                </FluentNavCategory>
            }

            @if (_isAdmin)
            {
                <FluentNavSectionHeader Title="Clients" />

                <FluentNavCategory Title="Clients" IconRest="@(new Icons.Regular.Size20.Laptop())"
                                   IconActive="@(new Icons.Filled.Size20.Laptop())">
                    <FluentNavItem Href="/manage/clients" IconRest="@(new Icons.Regular.Size20.LaptopSettings())"
                                   IconActive="@(new Icons.Filled.Size20.LaptopSettings())">
                        Clients
                    </FluentNavItem>
                    <FluentNavItem Href="/music">
                        Music
                    </FluentNavItem>
                    <FluentNavItem Href="/manage/projectionprograms"
                                   IconRest="@(new Icons.Regular.Size20.ProjectionScreenTextSparkle())"
                                   IconActive="@(new Icons.Filled.Size20.ProjectionScreenTextSparkle())">Projection</FluentNavItem>
                    <FluentNavItem Href="/manage/projectioncontrol"
                                   IconRest="@(new Icons.Regular.Size20.ProjectionScreenText())"
                                   IconActive="@(new Icons.Filled.Size20.ProjectionScreenText())">Projection Control</FluentNavItem>
                    <FluentNavItem Href="/automation" IconRest="@(new Icons.Regular.Size20.SettingsCogMultiple())"
                                   IconActive="@(new Icons.Filled.Size20.SettingsCogMultiple())">Automation</FluentNavItem>

                    @if (_canManageDmx)
                    {
                        <FluentNavItem Href="/dmx">DMX Control</FluentNavItem>
                    }
                </FluentNavCategory>
            }

            <FluentNavSectionHeader Title="Dashboards" />
            <FluentNavItem Href="/manage/dashboards" IconRest="@(new Icons.Regular.Size20.DataArea())"
                           IconActive="@(new Icons.Filled.Size20.DataArea())">Dashboards</FluentNavItem>
        }
    </FluentNav>

    <div class="w-100">
        @if (_latestRelease is not null)
        {
            <FluentDivider />

            <FluentNav Padding="@Padding.Bottom0">
                <FluentCard Appearance="CardAppearance.Subtle" Padding="@Padding.Bottom1">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
                            <FluentIcon Value="@(new Icons.Regular.Size16.MegaphoneLoud())" />
                            <FluentText Weight="TextWeight.Bold">What's new in v@(_latestRelease.Version)</FluentText>
                        </FluentStack>
                        <FluentText Class="whats-new-summary" Title="@_latestRelease.Summary">@_latestRelease.Summary
                        </FluentText>
                        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@OpenReleaseNotesAsync">
                            More info
                        </FluentButton>
                    </FluentStack>
                </FluentCard>
            </FluentNav>
        }

        <FluentDivider />

        <FluentNav Margin="Margin.Top2" Density="NavDensity.Medium" Padding="@Padding.All3">
            @if (_isAuthenticated)
            {
                <FluentNavItem Href="/account/manage" IconRest="@(new Icons.Regular.Size20.Person())"
                               IconActive="@(new Icons.Filled.Size20.Person())">
                    @_displayName
                </FluentNavItem>
                <FluentNavItem OnClick="Logout" IconRest="@(new Icons.Regular.Size20.SignOut())"
                               IconActive="@(new Icons.Filled.Size20.SignOut())">
                    Logout
                </FluentNavItem>
            }
            else
            {
                <FluentNavItem Href="/login" IconRest="@(new Icons.Regular.Size20.ArrowEnter())"
                               IconActive="@(new Icons.Filled.Size20.ArrowEnter())">
                    Login
                </FluentNavItem>
            }
        </FluentNav>
    </div>
</FluentStack>

@code {
    [Parameter] public string? CompanyLogoUrl { get; set; }

    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isManager;
    private bool _canControlMusic;
    private bool _canManageDmx;
    private bool _canManageFiles;
    private bool _canPostAnnouncements;
    private string? _displayName;
    private ReleaseNote? _latestRelease;
    private IEnumerable<ReleaseNote> _releaseNotes = [];
    private int _pendingTimeOff;

    // The category header only takes plain text, so its badge is drawn by a global style from this
    // attribute (see "Nav category badges" in App.razor) - otherwise the count would be hidden
    // whenever the Rota group is collapsed. Null leaves the attribute off, and with it the badge.
    private string? PendingCountAttribute => _pendingTimeOff switch
    {
        0 => null,
        > 99 => "99+",
        _ => _pendingTimeOff.ToString()
    };

    private string? PendingTooltip => _pendingTimeOff switch
    {
        0 => null,
        1 => "1 time-off request waiting for approval",
        _ => $"{_pendingTimeOff} time-off requests waiting for approval"
    };

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
        System.Security.Claims.ClaimsPrincipal user = state.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isAdmin = user.IsInRole("Admin");
        _isManager = _isAdmin || user.IsInRole("Manager");
        _canControlMusic = _isAdmin || user.IsInRole("CanControlMusic");
        _canManageDmx = _isAdmin || user.IsInRole("CanManageDmxSystems");
        _canManageFiles = _isAdmin || user.IsInRole("CanManageFiles");
        _canPostAnnouncements = _isAdmin || user.IsInRole("CanPostAnnouncements");

        if (_isAuthenticated)
        {
            string? name = await SecurityService.GetCurrentUserName();
            _displayName = name?.Length > 20 ? name[..20] + "…" : name;

            if (_isManager)
            {
                await RefreshPendingTimeOffAsync();

                // Live: a request made on someone's phone, or decided on the requests page, updates
                // the count here without a reload.
                TimeOffEventBus.OnChanged += OnTimeOffChanged;
            }

            Result<IEnumerable<ReleaseNote>> releaseNotesResult = await ReleaseNotesService.GetReleaseNotesAsync();
            if (releaseNotesResult.IsSuccess)
            {
                _releaseNotes = releaseNotesResult.Data ?? [];
                _latestRelease = _releaseNotes.OrderByDescending(x => x.ReleaseDate).ThenByDescending(x => Version.Parse(x.Version)).FirstOrDefault();
            }
        }
    }

    private async Task RefreshPendingTimeOffAsync()
    {
        Result<LocationScope> scope = await _currentLocationContext.GetScopeAsync();

        if (!scope.IsSuccess || scope.Data is null)
        {
            return;
        }

        Result<string> me = await SecurityService.GetCurrentUserIdAsync();
        Result<int> count = await TimeOffService.CountPendingForNavAsync(scope.Data, me.IsSuccess ? me.Data : null);
        _pendingTimeOff = count.IsSuccess ? count.Data : 0;
    }

    // Raised on whichever circuit made the change; recounting is one small query, so every open
    // manager nav simply recounts rather than working out whether the location is theirs.
    private void OnTimeOffChanged(int locationId)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshPendingTimeOffAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => TimeOffEventBus.OnChanged -= OnTimeOffChanged;

    // /api/auth/logout is a controller endpoint, not an @page, so it must not be reached through
    // Href: Blazor's interactive router intercepts the anchor click, pushes the URL into history,
    // finds no matching route, and only then falls back to a forced browser navigation - leaving
    // the still-authenticated layout rendered at a URL that has no route for the duration of the
    // round trip. forceLoad bypasses the router so the browser hits the endpoint in one hop.
    private void Logout() => NavigationManager.NavigateTo("/api/auth/logout", forceLoad: true);

    private async Task OpenReleaseNotesAsync()
    {
        await _dialogService.ShowDialogAsync<ReleaseNotesDialog>(options =>
        {
            options.Header.Title = "What's New";
            options.Width = "600px";
            options.Modal = true;
            options.Parameters.Add(nameof(ReleaseNotesDialog.Releases), _releaseNotes);
        });
    }
}
