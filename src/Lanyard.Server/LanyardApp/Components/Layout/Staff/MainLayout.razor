@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime

<FluentProviders />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <AuthorizeView>
                <Authorized>
                    <FluentLayoutHamburger Visible="true" />
                    <FluentSpacer Width="10px"></FluentSpacer>
                </Authorized>
            </AuthorizeView>

            <FluentLink Href="/" Class="nav-brand">
                <FluentText Weight="TextWeight.Bold" Size="TextSize.Size500" Style="color:white;">
                    <span>
                        Lan<span class="nav-brand-flip">y</span>ard
                    </span>
                </FluentText>
            </FluentLink>

            <FluentSpacer />

            <ThemeSelector />
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Height="auto">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Margin="@Margin.All3">
        <AutoLogoutManager />
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalGap="0" Style="padding: 3rem 1rem; max-width: 480px; margin: 0 auto; text-align: center;">

                    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error"
                                Style="margin-bottom: 1rem;" />

                    <FluentText Size="TextSize.Size800" Style="margin-bottom: 0.5rem; display: block;">
                        Something went wrong
                    </FluentText>

                    <FluentText Size="TextSize.Size400" Color="Color.Default"
                                Style="margin-bottom: 1.5rem; display: block;">
                        An unexpected error occurred. Try refreshing the page or come back later.
                    </FluentText>

                    <FluentMessageBar Intent="MessageBarIntent.Error"
                                      Style="text-align: left; width: 100%; margin-bottom: 1.5rem;">
                        @ex.Message
                    </FluentMessageBar>

                    <FluentStack HorizontalGap="8">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Recover">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Slot="start" />
                            Try again
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      OnClick="@(() => NavigationManager.NavigateTo("/", true))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Slot="start" />
                            Go home
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Height="auto">
        <Footer />
    </FluentLayoutItem>
</FluentLayout>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // SetThemeAsync(color, isExact) re-derives the full ThemeSettings (incl. Mode)
            // from FluentUI's "current effective mode", which isn't hydrated from storage
            // yet at this point in the lifecycle and would silently reset a saved dark-mode
            // choice back to system-preference. Read the persisted mode ourselves and apply
            // it explicitly alongside the brand color so this call can't clobber it.
            string? storedMode = await JSRuntime.InvokeAsync<string?>("lanyardGetStoredThemeMode");

            ThemeMode mode = storedMode switch
            {
                "dark" => ThemeMode.Dark,
                "light" => ThemeMode.Light,
                _ => ThemeMode.System
            };

            await ThemeService.SetThemeAsync(new ThemeSettings(BrandConstants.PrimaryColorHex, 0, 0, mode, true));
        }
        catch { }
    }

    private void Recover() => _errorBoundary?.Recover();
}
