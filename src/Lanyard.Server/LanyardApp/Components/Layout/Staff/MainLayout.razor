@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IThemeService ThemeService

<FluentProviders />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Top">
            <AuthorizeView>
                <Authorized>
                    <FluentLayoutHamburger Visible="true" />
                    <FluentSpacer Width="10px"></FluentSpacer>
                </Authorized>
            </AuthorizeView>

            <FluentLink Href="/" Class="nav-brand">
                <FluentText Weight="TextWeight.Bold" Size="TextSize.Size500" Style="color:white;">
                    <span>
                        Lan<span class="nav-brand-flip">y</span>ard
                    </span>
                </FluentText>
            </FluentLink>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Height="auto">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Margin="@Margin.All3">
        <AutoLogoutManager />
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalGap="0" Style="padding: 3rem 1rem; max-width: 480px; margin: 0 auto; text-align: center;">

                    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error"
                                Style="margin-bottom: 1rem;" />

                    <FluentText Size="TextSize.Size800" Style="margin-bottom: 0.5rem; display: block;">
                        Something went wrong
                    </FluentText>

                    <FluentText Size="TextSize.Size400" Color="Color.Default"
                                Style="margin-bottom: 1.5rem; display: block;">
                        An unexpected error occurred. Try refreshing the page or come back later.
                    </FluentText>

                    <FluentMessageBar Intent="MessageBarIntent.Error"
                                      Style="text-align: left; width: 100%; margin-bottom: 1.5rem;">
                        @ex.Message
                    </FluentMessageBar>

                    <FluentStack HorizontalGap="8">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Recover">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Slot="start" />
                            Try again
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      OnClick="@(() => NavigationManager.NavigateTo("/", true))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Slot="start" />
                            Go home
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Height="auto">
        <Footer />
    </FluentLayoutItem>
</FluentLayout>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    // ThemeSelector.razor only mounts on the Account page, so a brand-new session
    // rendered FluentUI's own factory-default blue on every other page until the
    // user happened to visit Account, at which point ThemeSelector's own default
    // kicked in and got persisted - after that it looked fine from then on, which
    // made the bug easy to miss. MainLayout renders on every authenticated page,
    // so applying the same "no explicit choice yet" default here instead makes it
    // the very first thing a new session sees, everywhere, not just after a detour
    // through Account.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            string? storedColour = await ThemeService.GetBrandColorAsync();

            // GetBrandColorAsync() never actually returns null/empty - with no explicit
            // choice yet it returns FluentUI's own factory-default blue (#0f6cbd).
            bool hasExplicitChoice = !string.IsNullOrEmpty(storedColour)
                && !string.Equals(storedColour, "#0f6cbd", StringComparison.OrdinalIgnoreCase);

            if (!hasExplicitChoice)
            {
                await ThemeService.SetThemeAsync("#CC6633", true);
            }
        }
        catch { }
    }

    private void Recover() => _errorBoundary?.Recover();
}
