@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager NavigationManager
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<FluentProviders />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <AuthorizeView>
                <Authorized>
                    <FluentLayoutHamburger Visible="true" />
                    <FluentSpacer Width="10px"></FluentSpacer>
                </Authorized>
            </AuthorizeView>

            <FluentLink Href="/" Class="nav-brand">
                <FluentText Weight="TextWeight.Bold" Size="TextSize.Size500" Style="color:white;">
                    <span>
                        Lan<span class="nav-brand-flip">y</span>ard
                    </span>
                </FluentText>
            </FluentLink>

            <FluentSpacer />

            <FluentStack Width="auto">
                <ThemeSelector />
            </FluentStack>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Height="auto">
        <AuthorizeView>
            <Authorized>
                <NavMenu CompanyLogoUrl="@_companyLogoUrl" />
            </Authorized>
        </AuthorizeView>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Margin="@Margin.All3">
        <AutoLogoutManager />
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalGap="0" Style="padding: 3rem 1rem; max-width: 480px; margin: 0 auto; text-align: center;">

                    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error"
                                Style="margin-bottom: 1rem;" />

                    <FluentText Size="TextSize.Size800" Style="margin-bottom: 0.5rem; display: block;">
                        Something went wrong
                    </FluentText>

                    <FluentText Size="TextSize.Size400" Color="Color.Default"
                                Style="margin-bottom: 1.5rem; display: block;">
                        An unexpected error occurred. Try refreshing the page or come back later.
                    </FluentText>

                    <FluentMessageBar Intent="MessageBarIntent.Error"
                                      Style="text-align: left; width: 100%; margin-bottom: 1.5rem;">
                        @ex.Message
                    </FluentMessageBar>

                    <FluentStack HorizontalGap="8">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Recover">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Slot="start" />
                            Try again
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      OnClick="@(() => NavigationManager.NavigateTo("/", true))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Slot="start" />
                            Go home
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Height="auto">
        <Footer />
    </FluentLayoutItem>
</FluentLayout>

@code {
    private ErrorBoundary? _errorBoundary;
    private string? _companyLogoUrl;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(ApplyBrandingAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ApplyBrandingAsync();
    }

    private async Task ApplyBrandingAsync()
    {
        string accentColor = BrandConstants.PrimaryColorHex;
        _companyLogoUrl = null;

        try
        {
            Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

            if (scopeResult.Success && scopeResult.Data is { CompanyId: int companyId })
            {
                Result<CompanyBrandingInfo> branding = await _companyLocationService.GetCompanyBrandingAsync(companyId);

                if (branding.Success && branding.Data is not null)
                {
                    accentColor = BrandConstants.ResolveAccentColor(branding.Data.ThemeColorHex);

                    _companyLogoUrl = branding.Data.LogoFileId is Guid logoFileId
                        ? $"/api/companies/{companyId}/logo?v={logoFileId:N}"
                        : null;
                }
            }
        }
        catch { }

        try
        {
            string? storedMode = await JSRuntime.InvokeAsync<string?>("lanyardGetStoredThemeMode");

            ThemeMode mode = storedMode switch
            {
                "dark" => ThemeMode.Dark,
                "light" => ThemeMode.Light,
                _ => ThemeMode.System
            };

            await ThemeService.SetThemeAsync(new ThemeSettings(accentColor, 0, 0, mode, true));
        }
        catch { }

        StateHasChanged();
    }

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
