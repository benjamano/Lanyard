@inherits LayoutComponentBase
@implements IDisposable

@using Lanyard.App.Components.Notifications

@inject NavigationManager NavigationManager
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Lanyard.Application.Services.Demo.IDemoGuard DemoGuard

<FluentProviders />

<FluentLayout NavigationDeferredLoading="true">
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <AuthorizeView>
                <Authorized>
                    <FluentLayoutHamburger Visible="true" />
                    <FluentSpacer Width="10px"></FluentSpacer>
                </Authorized>
            </AuthorizeView>

            <FluentLink Href="/" Class="nav-brand">
                <FluentText Weight="TextWeight.Bold" Size="TextSize.Size500" Style="color:white;">
                    <span>
                        Lanλard
                    </span>
                </FluentText>
            </FluentLink>

            <FluentSpacer />

            <FluentStack Width="auto" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                @* Footer.razor already shows the signed-in location, but its grid item is
                   HiddenWhen="SmAndDown", so on a phone nothing tells you which location you are in -
                   which is exactly where a wrongly-scoped Training list is hardest to diagnose. This
                   fills that gap only, and hides itself once the footer takes over (see the
                   .header-location media query in MainLayout.razor.css). *@
                @if (_locationDisplayName is not null)
                {
                    <AuthorizeView>
                        <Authorized>
                            <div class="header-location" title="@($"You are signed in to {_locationDisplayName}")">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Location())" Color="Color.Custom"
                                            CustomColor="white" />
                                @* Names are "Company Location", so they get long - capped and ellipsised
                                   rather than allowed to push the theme toggle off the header. *@
                                <span class="header-location-name">@_locationDisplayName</span>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                }

                @* Signed-out visitors (the public homepage, mostly) get a way in from every page
                   except the login page itself. *@
                @if (!IsLoginPage)
                {
                    <AuthorizeView>
                        <NotAuthorized>
                            <div class="header-login">
                                <FluentAnchorButton Href="/login" Appearance="ButtonAppearance.Outline"
                                                    IconStart="@(new Icons.Regular.Size20.ArrowEnter().WithColor("white"))">
                                    Log in
                                </FluentAnchorButton>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                }

                <ThemeSelector />
            </FluentStack>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Height="auto">
        <AuthorizeView>
            <Authorized>
                <NavMenu CompanyLogoUrl="@_companyLogoUrl" />
            </Authorized>
        </AuthorizeView>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Margin="@(IsLoginPage || _isPublicHome ? Margin.All0 : Margin.All3)">
        <AutoLogoutManager />
        <AuthorizeView>
            <Authorized>
                <DeviceSync />
                <InstallAppPrompt AppName="@_installLinks.AppName" IconHref="@_installLinks.AppleTouchIconHref" />
            </Authorized>
        </AuthorizeView>
        @if (_isDemoSession)
        {
            <div class="demo-banner">
                <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">
                    You're exploring the Lanyard demo. Other visitors share it, and it resets to fresh sample
                    data every night at 4am UK time.
                    <a href="/api/auth/logout" class="demo-banner-leave">Leave the demo</a>
                </FluentMessageBar>
            </div>
        }
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalGap="0" Style="padding: 3rem 1rem; max-width: 480px; margin: 0 auto; text-align: center;">

                    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error"
                                Style="margin-bottom: 1rem;" />

                    <FluentText Size="TextSize.Size800" Style="margin-bottom: 0.5rem; display: block;">
                        Something went wrong
                    </FluentText>

                    <FluentText Size="TextSize.Size400" Color="Color.Default"
                                Style="margin-bottom: 1.5rem; display: block;">
                        An unexpected error occurred. Try refreshing the page or come back later.
                    </FluentText>

                    <FluentMessageBar Intent="MessageBarIntent.Error"
                                      Style="text-align: left; width: 100%; margin-bottom: 1.5rem;">
                        @ex.Message
                    </FluentMessageBar>

                    <FluentStack HorizontalGap="8">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Recover">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Slot="start" />
                            Try again
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      OnClick="@(() => NavigationManager.NavigateTo("/", true))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Slot="start" />
                            Go home
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Height="auto" Style="@(IsLoginPage ? "padding:0" : null)">
        <Footer />
    </FluentLayoutItem>
</FluentLayout>

@code {
    private ErrorBoundary? _errorBoundary;
    private string? _companyLogoUrl;
    private AppInstallLinks _installLinks = AppInstallLinks.Default;
    private string? _locationDisplayName;

    // The login page's background image should bleed to the viewport edges - the standard
    // 3-unit content margin (used everywhere else) would otherwise leave a visible gap around it.
    private bool IsLoginPage => NavigationManager.Uri.Contains("/login");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // "/" for a signed-out visitor is the public homepage (see RouteAuthorizationGate), which has
    // its own full-bleed hero, so it drops the content margin like the login page does.
    private bool _isPublicHome;

    // Signed in to the public demo company: shows the banner above every page.
    private bool _isDemoSession;

    protected override async Task OnParametersSetAsync()
    {
        bool isRoot = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Length == 0;
        bool isAuthenticated = AuthenticationStateTask is not null
            && (await AuthenticationStateTask).User.Identity?.IsAuthenticated == true;

        _isPublicHome = isRoot && !isAuthenticated;
        _isDemoSession = isAuthenticated && await DemoGuard.IsDemoSessionAsync();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(ApplyBrandingAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ApplyBrandingAsync();
    }

    private async Task ApplyBrandingAsync()
    {
        // Login.razor owns the theme on this route (it reflects whichever company was picked
        // there) - applying the authenticated-user/default branding here on a fresh load of
        // /login would immediately stomp on that choice back to the default accent color.
        if (IsLoginPage)
        {
            return;
        }

        string accentColor = BrandConstants.PrimaryColorHex;
        _companyLogoUrl = null;
        _locationDisplayName = null;
        int? brandedCompanyId = null;
        _installLinks = AppInstallLinks.Default;

        try
        {
            Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

            _locationDisplayName = scopeResult.Success ? scopeResult.Data?.LocationDisplayName : null;

            if (scopeResult.Success && scopeResult.Data is { CompanyId: int companyId })
            {
                Result<CompanyBrandingInfo> branding = await _companyLocationService.GetCompanyBrandingAsync(companyId);

                if (branding.Success && branding.Data is not null)
                {
                    accentColor = BrandConstants.ResolveAccentColor(branding.Data.ThemeColorHex);

                    _companyLogoUrl = branding.Data.LogoFileId is Guid logoFileId
                        ? $"/api/companies/{companyId}/logo?v={logoFileId:N}"
                        : null;

                    brandedCompanyId = companyId;
                    _installLinks = AppInstallLinks.For(branding.Data);
                }
            }
        }
        catch { }

        try
        {
            string? storedMode = await JSRuntime.InvokeAsync<string?>("lanyardGetStoredThemeMode");

            ThemeMode mode = storedMode switch
            {
                "dark" => ThemeMode.Dark,
                "light" => ThemeMode.Light,
                _ => ThemeMode.System
            };

            await ThemeService.SetThemeAsync(new ThemeSettings(accentColor, 0, 0, mode, true));
            await JSRuntime.InvokeVoidAsync("lanyardSetStatusBarColor", accentColor);

            if (brandedCompanyId is int appCompanyId)
            {
                await JSRuntime.InvokeVoidAsync("lanyardSetAppCompany", appCompanyId, _installLinks.ManifestHref, _installLinks.AppleTouchIconHref, _installLinks.AppName);
            }
        }
        catch { }

        StateHasChanged();
    }

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
