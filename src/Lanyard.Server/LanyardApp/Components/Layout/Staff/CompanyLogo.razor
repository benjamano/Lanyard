@if (Url is not null)
{
    <FluentStack Padding="@Padding.All2" HorizontalAlignment="@HorizontalAlignment.Center">
        <img src="@Url" alt="Company logo" class="company-logo" onerror="this.style.display='none'" />
    </FluentStack>
}

@code {
    [Parameter] public string? Url { get; set; }
}
