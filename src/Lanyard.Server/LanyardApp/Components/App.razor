@using Lanyard.Application.Services.Authentication
@using System.Globalization

@inject NavigationManager NavigationManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lanyard CRM and SM</title>
    <meta name="description" content="Lanyard is an internal staff platform for training, scheduling, and venue control." />
    <meta property="og:title" content="Lanyard" />
    <meta property="og:description" content="Lanyard is an internal staff platform for training, scheduling, and venue control." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.png" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />

    <link rel="icon" type="image/png" href="favicon.png" />
    <link
    href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css"]"
    rel="stylesheet" />
    <link href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" rel="stylesheet">
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["video-stream.js"]"></script>
    <script src="@Assets["js/autoLogout.js"]"></script>
    <script src="@Assets["js/dmxKeybinds.js"]"></script>
    <script src="@Assets["js/viewportWatcher.js"]"></script>
    <script src="@Assets["js/trainingScrollGate.js"]"></script>
    <script src="@Assets["js/courseImageEditor.js"]"></script>
    <link rel="stylesheet" href="@Assets["Lanyard.App.styles.css"]" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />

    <style>
        html[data-app-booting] body {
        visibility: hidden;
        }

        html[data-app-booting] #app-splash {
        visibility: visible;
        }

        html:not([data-app-booting]) #app-splash {
        display: none;
        }

        #app-splash {
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        background-color: #ffffff;
        }

        html[data-app-theme="dark"] #app-splash {
        background-color: #292929;
        }

        .app-splash-spinner {
        width: 2.5rem;
        height: 2.5rem;
        border: 3px solid rgba(127, 127, 127, .25);
        border-top-color: #0d6efd;
        border-radius: 50%;
        animation: app-splash-spin .8s linear infinite;
        }

        @@keyframes app-splash-spin {
        to {
        transform: rotate(360deg);
        }
        }

        @@media (prefers-reduced-motion: reduce) {
        .app-splash-spinner {
        animation: none;
        }
        }
    </style>

    <style>
        /* FluentLayoutItem's Content area can't be reached by scoped CSS - every
        element between MainLayout.razor's own template and this one is a Fluent
        library component, none of which carry MainLayout's scope attribute (nor
        is there a plain wrapping element anywhere in the chain for a ::deep
        anchor). MobileNavMenu is `position: fixed`, so it takes no space in the
        document flow and never pushes scrolled content up to clear it - without
        this, a long page's last ~60px (including a FluentCard's own bottom
        border) ends up flush against, or effectively hidden behind, the fixed
        mobile nav bar. */
        @@media (max-width: 767.98px) {
        [area="content"] {
        padding-bottom: 80px;
        }
        }
    </style>

    <script src="@Assets["js/bootCloak.js"]"></script>

    @if (NavigationManager.Uri.Contains("/", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="manifest" href="manifest.webmanifest" />
        <meta name="theme-color" content="#0d6efd" />
    }
</head>

<body>
    <div id="app-splash" aria-hidden="true">
        <div class="app-splash-spinner"></div>
    </div>

    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/imask@7.6.1/dist/imask.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="_content/Blazored.TextEditor/quill-blot-formatter.min.js"></script>
    <script src="_content/Blazored.TextEditor/Blazored-BlazorQuill.js"></script>

    @if (NavigationManager.Uri.Contains("localhost", StringComparison.OrdinalIgnoreCase))
    {
        <script src="/_framework/aspnetcore-browser-refresh.js"></script>
    }

    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <ReconnectModal />
    @if (NavigationManager.Uri.Contains("/", StringComparison.OrdinalIgnoreCase))
    {
        <script src="@Assets["js/registerServiceWorker.js"]"></script>
    }

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
</body>

</html>

@inject ISecurityService SecurityService

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    protected override async Task OnInitializedAsync()
    {
        Result<UserProfile> result = await SecurityService.GetCurrentUserProfileAsync();

        if (result.IsSuccess && !string.IsNullOrEmpty(result.Data?.PreferredCulture))
        {
            CultureInfo culture = new CultureInfo(result.Data.PreferredCulture);
            CultureInfo.DefaultThreadCurrentCulture = culture;
            CultureInfo.DefaultThreadCurrentUICulture = culture;
        }
    }
}
