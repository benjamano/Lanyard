@using Lanyard.Application.Services.Authentication

@inject NavigationManager NavigationManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lanyard CRM and SM</title>
    <meta name="description" content="Lanyard is an internal staff platform for training, scheduling, and venue control." />
    <meta property="og:title" content="Lanyard" />
    <meta property="og:description" content="Lanyard is an internal staff platform for training, scheduling, and venue control." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.png" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />

    <link rel="icon" type="image/png" href="favicon.png" />
    <link
    href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css"]"
    rel="stylesheet" />
    <link href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" rel="stylesheet">
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["video-stream.js"]"></script>
    <script src="@Assets["js/autoLogout.js"]"></script>
    <script src="@Assets["js/dmxKeybinds.js"]"></script>
    <script src="@Assets["js/viewportWatcher.js"]"></script>
    <script src="@Assets["js/lanyardPush.js"]"></script>
    <script src="@Assets["js/lanyardInstall.js"]"></script>
    <script src="@Assets["js/trainingScrollGate.js"]"></script>
    <script src="@Assets["js/courseImageEditor.js"]"></script>
    <script src="@Assets["js/kioskWidgetEditor.js"]"></script>
    <link rel="stylesheet" href="@Assets["Lanyard.App.styles.css"]" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />

    <style>
        html[data-app-booting] body {
        visibility: hidden;
        }

        html[data-app-booting] #app-splash {
        visibility: visible;
        }

        html:not([data-app-booting]) #app-splash {
        display: none;
        }

        #app-splash {
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        background-color: #ffffff;
        }

        html[data-app-theme="dark"] #app-splash {
        background-color: #292929;
        }

        .app-splash-spinner {
        width: 2.5rem;
        height: 2.5rem;
        border: 3px solid rgba(127, 127, 127, .25);
        border-top-color: @BrandConstants.PrimaryColorHex;
        border-radius: 50%;
        animation: app-splash-spin .8s linear infinite;
        }

        @@keyframes app-splash-spin {
        to {
        transform: rotate(360deg);
        }
        }

        @@media (prefers-reduced-motion: reduce) {
        .app-splash-spinner {
        animation: none;
        }
        }
    </style>

    <style>
        /* FluentLayoutItem's Content area can't be reached by scoped CSS - every
        element between MainLayout.razor's own template and this one is a Fluent
        library component, none of which carry MainLayout's scope attribute (nor
        is there a plain wrapping element anywhere in the chain for a ::deep
        anchor). MobileNavMenu is `position: fixed`, so it takes no space in the
        document flow and never pushes scrolled content up to clear it - without
        this, a long page's last ~60px (including a FluentCard's own bottom
        border) ends up flush against, or effectively hidden behind, the fixed
        mobile nav bar. */
        @@media (max-width: 767.98px) {
        [area="content"] {
        padding-bottom: 80px;
        }
        }
    </style>

    <style>
        /* Nothing may make the whole page scroll sideways on a phone. The Content layout item
        is the scroll box, so any one element wider than it drags every page element along -
        the header, titles and all - rather than just itself. Global because these are all
        Fluent-rendered elements that scoped CSS can't reach.

        FluentDataGrid renders as a CSS grid whose fr columns never shrink below their
        content, so a grid with a few columns is wider than a phone. It scrolls inside its
        own box instead of moving the page. */
        table.fluent-data-grid {
        max-width: 100%;
        overflow-x: auto;
        }

        @@media (max-width: 767.98px) {
        /* FluentTabs' strip neither wraps nor scrolls, so later tabs overflow the edge
        (My Shifts' four tabs are ~480px). Wrap onto a second row so every tab stays
        visible without a sideways swipe. */
        fluent-tablist {
        flex-wrap: wrap;
        }

        /* The projection program/template editors are three side-by-side splitter panes;
        at phone width each pane is a few characters wide. Stack them instead - the drag
        handles mean nothing in a column, so they go. */
        .fluent-multi-splitter[orientation] {
        flex-direction: column;
        height: auto !important;
        }

        .fluent-multi-splitter > .fluent-multi-splitter-pane {
        flex: 0 0 auto !important;
        width: 100%;
        }

        .fluent-multi-splitter > .fluent-multi-splitter-bar {
        display: none;
        }
        }
    </style>

    <style>
        /* Theme-aware colour swatch. The app's light/dark toggle is the data-theme attribute
        on the body element (set by Fluent's IThemeService), which scoped .razor.css can never
        reach - CSS isolation stamps its scope attribute onto every selector in a chain, the
        body included, so a body-anchored dark rule in a .razor.css silently never matches. An element sets both
        `--swatch-light` and `--swatch-dark` inline (the palette values are per-item data,
        not styling) and this global rule picks whichever the current theme calls for. */
        .theme-colour,
        .theme-colour-swatch {
        --theme-colour: var(--swatch-light);
        }

        [data-theme="dark"] .theme-colour,
        [data-theme="dark"] .theme-colour-swatch {
        --theme-colour: var(--swatch-dark);
        }

        /* .theme-colour only resolves --theme-colour (for a scoped stylesheet to use as a border,
        tint, etc.); .theme-colour-swatch also paints it as the background. */
        .theme-colour-swatch {
        background: var(--theme-colour);
        }

        /* Nav category badges. FluentNavCategory only takes a plain-text Title, so a count on a
        category header (e.g. Rota's time-off requests waiting for approval) is set as a
        data-pending-count attribute, which lands on the category's button, and drawn here to
        match FluentCounterBadge. Global because the button is rendered by Fluent, so NavMenu's
        scoped CSS can't reach it. The badge sits just before the expand chevron. */
        button.fluent-navcategoryitem[data-pending-count]::after {
        content: attr(data-pending-count);
        order: 1;
        margin-inline-start: auto;
        box-sizing: border-box;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 10000px;
        background: var(--colorBrandBackground);
        color: var(--colorNeutralForegroundOnBrand, #fff);
        font-size: 12px;
        font-weight: 600;
        line-height: 20px;
        text-align: center;
        }

        button.fluent-navcategoryitem[data-pending-count] .expand-icon {
        order: 2;
        margin-inline-start: 0;
        }
    </style>

    <script src="@Assets["js/bootCloak.js"]"></script>

    <link rel="manifest" href="manifest.webmanifest" />
    @* iPhone/iPad home-screen install: its own icon (iOS ignores manifest icons) and name, and
       standalone mode, which is what lets a home-screen Lanyard receive push notifications. *@
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Lanyard" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="@BrandConstants.PrimaryColorHex" />
    <script src="@Assets["js/statusBarColor.js"]"></script>
</head>

<body>
    <div id="app-splash" aria-hidden="true">
        <div class="app-splash-spinner"></div>
    </div>

    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["js/blazorStart.js"]"></script>
    @* Not unused: FluentNumberInput and Fluent's masked date/time inputs need window.IMask. Without
       it they fetch it from unpkg.com, which the CSP blocks, and the page fails to render. *@
    <script src="https://cdn.jsdelivr.net/npm/imask@7.6.1/dist/imask.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="_content/Blazored.TextEditor/quill-blot-formatter.min.js"></script>
    <script src="_content/Blazored.TextEditor/Blazored-BlazorQuill.js"></script>
    <script src="@Assets["js/lanyardChat.js"]"></script>

    @if (NavigationManager.Uri.Contains("localhost", StringComparison.OrdinalIgnoreCase))
    {
        <script src="/_framework/aspnetcore-browser-refresh.js"></script>
    }

    <ReconnectModal />
    <script src="@Assets["js/registerServiceWorker.js"]"></script>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
</body>

</html>


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // The per-user culture is applied by the request-localization middleware from the culture
    // cookie (see UserCultureCookie) - nothing to look up here. The previous implementation
    // queried the user's profile on every request and set CultureInfo.DefaultThreadCurrentCulture,
    // a process-wide static, so whoever loaded a page last set the date format for everyone.
}
