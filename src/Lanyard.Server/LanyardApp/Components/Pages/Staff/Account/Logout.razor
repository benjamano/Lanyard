@page "/logout"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@inject NavigationManager Navigation

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "keepNotifications")]
    public bool KeepNotifications { get; set; }

    protected override void OnInitialized()
    {
        // Navigate to the API logout endpoint, which calls SignOutAsync() in a real
        // HTTP request/response cycle so the auth cookie is properly cleared.
        string target = Navigation.GetUriWithQueryParameters(
            "/api/auth/logout",
            new Dictionary<string, object?>
            {
                ["returnUrl"] = string.IsNullOrEmpty(ReturnUrl) ? null : ReturnUrl,
                ["keepNotifications"] = KeepNotifications ? true : null
            });

        Navigation.NavigateTo(target, forceLoad: true);
    }
}
