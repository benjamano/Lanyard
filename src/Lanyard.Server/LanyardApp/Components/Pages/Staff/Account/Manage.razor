@page "/account/manage"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Lanyard.App.Components.Accounts
@using Lanyard.App.Components.Layout.Staff
@using Lanyard.Application.Services.Authentication

@inject INotificationService ToastService

<PageTitle>Account Management</PageTitle>

<div class="account-manage-page">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="20px">
        <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size800" Color="Color.Default">Account Management</FluentText>

        <FluentCard Width="100%">
            <div class="account-manage-section">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Your Details</FluentText>
                <YourDetailsCard @ref="yourDetailsCard" />
            </div>
        </FluentCard>

        <FluentCard Width="100%">
            <div class="account-manage-section">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Contact Details</FluentText>
                <ContactDetailsCard @ref="contactDetailsCard" />
            </div>
        </FluentCard>

        <FluentCard Width="100%">
            <div class="account-manage-section">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Home Screen</FluentText>
                <HomeScreenCard @ref="homeScreenCard" />
            </div>
        </FluentCard>

        <FluentCard Width="100%">
            <div class="account-manage-section">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Security</FluentText>
                <FluentButton Appearance="ButtonAppearance.Outline"
                            IconStart="@(new Icons.Regular.Size20.Key())"
                            OnClick="OpenChangePasswordDialog">
                    Change Password
                </FluentButton>
            </div>
        </FluentCard>

        <FluentCard Width="100%">
            <div class="account-manage-section">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Two-Factor Authentication</FluentText>
                <TwoFactorCard />
            </div>
        </FluentCard>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8px">
            <FluentButton Appearance="ButtonAppearance.Primary"
                        IconStart="@(new Icons.Regular.Size20.Save())"
                        OnClick="SaveDetails">
                Save Changes
            </FluentButton>
        </FluentStack>
    </FluentStack>
</div>

@code{
    private YourDetailsCard? yourDetailsCard;
    private ContactDetailsCard? contactDetailsCard;
    private HomeScreenCard? homeScreenCard;

    private async Task SaveDetails()
    {
        if (yourDetailsCard is not null)
        {
            await yourDetailsCard.HandleSave();
        }

        if (contactDetailsCard is not null)
        {
            await contactDetailsCard.HandleSave();
        }

        if (homeScreenCard is not null)
        {
            await homeScreenCard.HandleSave();
        }
    }

    private async Task OpenChangePasswordDialog()
    {
        Result<UserProfile> getResult = await _securityService.GetCurrentUserProfileAsync();

        if (!getResult.IsSuccess || getResult.Data is null)
        {
            ToastService.ShowError("Unable to load user profile.");
            return;
        }

        await _dialogService.ShowDialogAsync<ChangePasswordDialog>(options =>
        {
            options.Header.Title = "Change Password";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ChangePasswordDialog.Content), getResult.Data);
        });
    }
}