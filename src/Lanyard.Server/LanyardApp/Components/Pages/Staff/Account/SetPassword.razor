@page "/set-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Set Your Password</PageTitle>

<div class="set-password-page">
    <FluentCard Class="set-password-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            @if (!isValidInvite)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@errorMessage</FluentMessageBar>
                <FluentText>Contact an administrator to request a new link.</FluentText>
            }
            else if (isComplete)
            {
                <FluentMessageBar Intent="MessageBarIntent.Success">
                    Password set! You can now log in as <strong>@username</strong>.
                </FluentMessageBar>
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => _navigationManager.NavigateTo("/login"))">
                    Continue to Login
                </FluentButton>
            }
            else
            {
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">Set Your Password</FluentText>
                <FluentText>Setting a password for <strong>@username</strong></FluentText>

                @if (!string.IsNullOrEmpty(submitError))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@submitError</FluentMessageBar>
                }

                <EditForm Model="@model" OnValidSubmit="HandleSetPassword">
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                        <FluentTextInput @bind-Value="model.NewPassword"
                                         Label="New Password"
                                         Required="true"
                                         Placeholder="Enter new password"
                                         TextInputType="TextInputType.Password"
                                         Class="set-password-input"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))"
                                         MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Slot="start" />
                        </FluentTextInput>

                        <FluentTextInput @bind-Value="model.ConfirmPassword"
                                         Label="Confirm Password"
                                         Required="true"
                                         TextInputType="TextInputType.Password"
                                         Placeholder="Confirm new password"
                                         Class="set-password-input"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))"
                                         MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Slot="start" />
                        </FluentTextInput>

                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      Type="ButtonType.Submit"
                                      Disabled="@isSubmitting"
                                      IconStart="@(new Icons.Regular.Size20.Key())">
                            @if (isSubmitting)
                            {
                                <FluentSpinner Class="set-password-spinner" />
                                <span class="ms-2">Setting...</span>
                            }
                            else
                            {
                                <span>Set Password</span>
                            }
                        </FluentButton>
                    </FluentStack>
                </EditForm>
            }
        </FluentStack>
    </FluentCard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isValidInvite;
    private bool isComplete;
    private bool isSubmitting;
    private string username = string.Empty;
    private string errorMessage = string.Empty;
    private string? submitError;
    private SetPasswordModel model = new();

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "This link is missing required information.";
            return;
        }

        Result<string> result = await _securityService.GetUsernameForSetPasswordAsync(UserId);
        if (!result.IsSuccess || result.Data is null)
        {
            errorMessage = result.Error ?? "This link is invalid or has expired.";
            return;
        }

        username = result.Data;
        isValidInvite = true;
    }

    private async Task HandleSetPassword()
    {
        isSubmitting = true;
        submitError = null;
        StateHasChanged();

        try
        {
            Result<bool> result = await _securityService.SetPasswordFromTokenAsync(UserId!, Token!, model.NewPassword);

            if (result.IsSuccess)
            {
                isComplete = true;
            }
            else
            {
                submitError = result.Error;

                // A confirmed-invalid/expired token means retrying with the same link cannot work.
                if (submitError is not null && submitError.Contains("invalid or has expired"))
                {
                    isValidInvite = false;
                    errorMessage = submitError;
                }
            }
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private class SetPasswordModel
    {
        [Required(ErrorMessage = "New password is required.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm password is required.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
