@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@inject NavigationManager Navigation
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime

<PageTitle>Login</PageTitle>

@if (CompanyId is null)
{
    <AuthPageShell Title="Please select your company">
        <ChildContent>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">
                    @ErrorMessage
                </FluentMessageBar>
            }

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10"
                         HorizontalAlignment="HorizontalAlignment.Stretch" Class="company-picker">
                @if (!CompanyOptions.Any())
                {
                    <FluentText>Loading companies...</FluentText>
                }
                else
                {
                    @foreach (LoginCompanyOption company in CompanyOptions)
                    {
                        <FluentButton Appearance="ButtonAppearance.Outline" Class="company-picker-button"
                                      OnClick="@(() => SelectCompany(company.CompanyId))">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                         VerticalAlignment="VerticalAlignment.Center">
                                @if (company.LogoFileId is not null)
                                {
                                    <img src="@($"/api/companies/{company.CompanyId}/logo")" alt="@($"{company.Name} logo")"
                                         class="company-picker-logo" onerror="this.style.display='none'" />
                                }
                                <FluentText>@company.Name</FluentText>
                            </FluentStack>
                        </FluentButton>
                    }
                }
            </FluentStack>
        </ChildContent>
    </AuthPageShell>
}
else
{
    <AuthPageShell Title="Please Login" BackgroundImageUrl="@BackgroundImageUrl">
        <HeaderContent>
            <a href="@BackLinkHref" class="login-back-link" title="Choose a different company"
               aria-label="Choose a different company">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowLeft())" />
            </a>

            @if (SelectedAccentColor is not null)
            {
                <div class="login-accent-bar" style="@AccentBarStyle"></div>
            }

            @if (SelectedLogoUrl is not null)
            {
                <img src="@SelectedLogoUrl" alt="Company logo" class="login-company-logo" onerror="this.style.display='none'" />
            }
        </HeaderContent>
        <ChildContent>
            <div class="login-fields">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">
                        @ErrorMessage
                    </FluentMessageBar>
                }

                <form method="post" class="col-12" action="/api/auth/login-form">
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <input type="hidden" name="company" value="@CompanyId" />

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6"
                                 HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentTextInput Name="username" Label="Username or Email" Required="true"
                                         Placeholder="Enter your username or email" Class="login-full-width">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                        </FluentTextInput>

                        <FluentTextInput Name="password" Label="Password" TextInputType="TextInputType.Password"
                                         Required="true" Placeholder="Enter your password" Class="login-full-width">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Slot="start" />
                        </FluentTextInput>

                        @if (LocationOptions.Any())
                        {
                            <FluentSelect Id="locationId" Name="locationId" Label="Location" Required="true"
                                          Placeholder="Select your location" TValue="int" TOption="LoginLocationOption"
                                          ValueChanged="@(item => OnLocationChanged(item))" Class="login-full-width"
                                          Items="@LocationOptions.AsQueryable()" OptionText="@(option => option.DisplayName)"
                                          OptionValue="@(option => option.LocationId)" />
                        }
                        else
                        {
                            <FluentText>Loading Companies...</FluentText>
                        }

                        @* The checkbox has no Name, so it isn't posted itself - the hidden input carries its
                           state. It's ticked from the first render, so a submit before the circuit connects
                           still keeps the user signed in. *@
                        <FluentCheckbox @bind-Value="_rememberMe" Label="Keep me signed in" />
                        <input type="hidden" name="rememberMe" value="@(_rememberMe ? "true" : "false")" />

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center"
                                     Class="login-submit-row">
                            <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                          BackgroundColor="@SelectedAccentColor"
                                          Color="@(SelectedAccentColor is null ? null : "white")">
                                <FluentIcon Icon="Icons.Filled.Size20.ArrowEnter" Slot="start" />
                                Login
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </form>

                <FluentText Align="TextAlign.Center" Size="TextSize.Size200" Class="login-privacy-link">
                    <a href="/privacy">Privacy Policy</a>
                </FluentText>
            </div>
        </ChildContent>
    </AuthPageShell>
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "company")]
    public int? CompanyId { get; set; }

    // This page prerenders, then initialises again on the interactive circuit. The company picker
    // list, or the chosen company's branding and locations, are carried across from the prerender
    // pass so the interactive pass renders the same data without re-querying it (and without the
    // picker briefly collapsing back to "Loading companies..."). It is all public, pre-login data.
    // LoadedForCompanyId is the guard: the skip only applies while the company in the query string
    // still matches what the state was loaded for, so switching company in-circuit reloads as normal.
    // StateLoaded is only set once a load fully succeeded, so a failed prerender-time lookup is
    // retried on the interactive pass instead of being persisted as "done".
    // SkipLastSnapshot: after a circuit pause/resume the page reloads fresh rather than reusing the
    // last snapshot - only the prerender -> interactive hand-off is worth bridging.
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public bool StateLoaded { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public int? LoadedForCompanyId { get; set; }

    // Set when the company in the query string was rejected (stale/deactivated id) and the page
    // fell back to the picker. CompanyId is re-bound from the URL on every parameter set, so the
    // skip path needs this to reproduce the fallback without re-querying.
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public bool RequestedCompanyRejected { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public List<LoginLocationOption> LocationOptions { get; set; } = [];

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public List<LoginCompanyOption> CompanyOptions { get; set; } = [];

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public string? SelectedAccentColor { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public string? SelectedLogoUrl { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public string? BackgroundImageUrl { get; set; }

    // Which logo the installed app's icon should use - see OnAfterRenderAsync.
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public Guid? SelectedLogoFileId { get; set; }

    // On by default: staff mostly log in from their own phone, where the installed app should
    // stay signed in. Untick on a shared computer so closing the browser signs you out.
    private bool _rememberMe = true;

    // Chosen in OnParametersSetAsync, applied in OnAfterRenderAsync - see the comment there.
    private string? _pendingThemeColor;
    private string? _appliedThemeColor;
    private int? _appliedAppCompanyId;

    private string AccentBarStyle => $"background-color:{SelectedAccentColor};";

    private string BackLinkHref => BuildLoginUrl(null);

    // OnParametersSetAsync, not OnInitializedAsync: both login steps are the same routed
    // component, so moving between them only changes the "company" query string - Blazor
    // reuses this instance and re-invokes parameter binding rather than recreating it.
    protected override async Task OnParametersSetAsync()
    {
        // The [PersistentState] binder supplies null on the first parameter set when there is
        // nothing to restore (the prerender pass), overriding the field initialisers.
        CompanyOptions ??= [];
        LocationOptions ??= [];

        if (StateLoaded && LoadedForCompanyId == CompanyId)
        {
            // Data already in hand for this company (restored from the prerender pass, or loaded
            // earlier in this circuit). Only the theme still needs applying - see OnAfterRenderAsync.
            if (RequestedCompanyRejected)
            {
                CompanyId = null;
            }

            _pendingThemeColor = CompanyId is null
                ? BrandConstants.PrimaryColorHex
                : BrandConstants.ResolveAccentColor(SelectedAccentColor);
            return;
        }

        int? requestedCompanyId = CompanyId;

        // Reset per-company state before the first await so a switch never shows (or submits) the
        // previous company's locations or branding while the new company's are still loading.
        StateLoaded = false;
        RequestedCompanyRejected = false;
        LocationOptions = [];
        SelectedAccentColor = null;
        SelectedLogoUrl = null;
        SelectedLogoFileId = null;
        BackgroundImageUrl = null;

        if (CompanyId is null)
        {
            StateLoaded = await LoadCompanyOptionsAsync();
            LoadedForCompanyId = null;
            _pendingThemeColor = BrandConstants.PrimaryColorHex;
            return;
        }

        Result<CompanyBrandingInfo> branding = await _companyLocationService.GetCompanyBrandingAsync(CompanyId.Value);

        if (!branding.IsSuccess)
        {
            // Stale/invalid company id in the URL - fall back to the company picker.
            CompanyId = null;
            RequestedCompanyRejected = true;
            StateLoaded = await LoadCompanyOptionsAsync();
            LoadedForCompanyId = requestedCompanyId;
            _pendingThemeColor = BrandConstants.PrimaryColorHex;
            return;
        }

        SelectedAccentColor = branding.Data!.ThemeColorHex;
        SelectedLogoUrl = branding.Data!.LogoFileId is Guid ? $"/api/companies/{CompanyId}/logo" : null;
        SelectedLogoFileId = branding.Data!.LogoFileId;
        BackgroundImageUrl = branding.Data!.BackgroundImageFileId is Guid ? $"/api/companies/{CompanyId}/background" : null;

        // Reflects the chosen company's brand color in the page's overall Fluent theme (not
        // just the accent bar/submit button), using whatever light/dark mode is already active.
        _pendingThemeColor = BrandConstants.ResolveAccentColor(SelectedAccentColor);

        Result<List<LoginLocationOption>> result = await _companyLocationService.GetLoginLocationOptionsAsync(CompanyId);

        if (result.IsSuccess)
        {
            LocationOptions = result.Data!;
            LoadedForCompanyId = requestedCompanyId;
            StateLoaded = true;
        }
    }

    // ThemeService.SetThemeAsync goes through JS interop, and this page is statically prerendered
    // before the interactive circuit exists. Calling it from OnParametersSetAsync threw
    // "JavaScript interop calls cannot be issued at this time" on every single render of /login;
    // MainLayout's ErrorBoundary caught that and rendered its error content, so the prerendered
    // HTML shipped "Something went wrong" and only got replaced by the real page a beat later when
    // the circuit connected and the component re-ran successfully. That was the error flash people
    // saw after logging out.
    //
    // So the colour is chosen during parameter binding and applied here, where interop is legal.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Picking a company only changes the query string in-circuit, so App.razor's <head> still
        // links whatever manifest the page first loaded with. Swap it to this company's logo icons,
        // so "Install app"/"Add to Home Screen" from here uses them.
        if (CompanyId is int appCompanyId && StateLoaded && appCompanyId != _appliedAppCompanyId)
        {
            _appliedAppCompanyId = appCompanyId;
            AppInstallLinks installLinks = AppInstallLinks.For(appCompanyId, SelectedLogoFileId);
            await JSRuntime.InvokeVoidAsync("lanyardSetAppCompany", appCompanyId, installLinks.ManifestHref, installLinks.AppleTouchIconHref);
        }

        if (_pendingThemeColor is null || _pendingThemeColor == _appliedThemeColor)
        {
            return;
        }

        _appliedThemeColor = _pendingThemeColor;

        await ThemeService.SetThemeAsync(_pendingThemeColor);
        await JSRuntime.InvokeVoidAsync("lanyardSetStatusBarColor", _pendingThemeColor);
    }

    private async Task<bool> LoadCompanyOptionsAsync()
    {
        Result<List<LoginCompanyOption>> result = await _companyLocationService.GetLoginCompanyOptionsAsync();

        if (!result.IsSuccess)
        {
            return false;
        }

        CompanyOptions = result.Data!;
        return true;
    }

    private void SelectCompany(int companyId)
    {
        Navigation.NavigateTo(BuildLoginUrl(companyId));
    }

    private void OnLocationChanged(int locationId)
    {
        LoginLocationOption? option = LocationOptions.FirstOrDefault(x => x.LocationId == locationId);

        SelectedAccentColor = option?.ThemeColorHex;
        SelectedLogoUrl = option?.LogoFileId is Guid ? $"/api/companies/{option.CompanyId}/logo" : null;
    }

    private string BuildLoginUrl(int? companyId)
    {
        return Navigation.GetUriWithQueryParameters("/login", new Dictionary<string, object?>
        {
            ["company"] = companyId,
            ["returnUrl"] = string.IsNullOrEmpty(ReturnUrl) ? null : ReturnUrl
        });
    }
}
