@page "/automation"
@attribute [Authorize(Roles = "Admin")]
@using Lanyard.Application.Services
@using Lanyard.Infrastructure.Enum
@using Lanyard.Infrastructure.Models
@using Lanyard.Infrastructure.DTO
@using Lanyard.Infrastructure.DataAccess
@using Lanyard.Shared.Enum
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Lanyard.App.Components.Manager

@inject IAutomationRuleService _ruleService
@inject IAutomationLogService _logService
@inject IAutomationEngineService _engineService
@inject IClientService _clientService
@inject INotificationService _toastService
@inject IDialogService _dialogService
@inject IDbContextFactory<ApplicationDbContext> _dbContextFactory

<PageTitle>Automation</PageTitle>

<FluentCard Height="auto">
    <FluentStack Orientation="Orientation.Horizontal" class="w-100" id="toolbar-automation">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Orientation="Orientation.Horizontal">
            <FluentSwitch @bind-Value="_engineEnabled" @bind-Value:after="OnEngineToggleChangedAsync">
                Engine: @(_engineEnabled ? "Enabled" : "Disabled")
            </FluentSwitch>
        </FluentStack>
        <div class="d-flex gap-2 flex-shrink-0">
            <FluentButton Appearance="ButtonAppearance.Outline"
                          IconEnd="new Icons.Regular.Size20.Add()"
                          OnClick="OpenAddRuleDialogAsync">
                New Rule
            </FluentButton>
            <HelpButton AreaKey="@HelpRegistry.Automation" />
        </div>
    </FluentStack>

    @* A flex list, not a FluentDataGrid: fixed grid columns truncated every rule name on a phone and
       pushed the switch and buttons off the side of the screen. *@
    @if (!_rules.Any())
    {
        <div class="automation-rules-empty">No automation rules configured.</div>
    }
    else
    {
        <div class="automation-rules-list">
            @foreach (AutomationRule rule in _rules)
            {
                <div class="automation-rules-item" @key="rule.Id">
                    <div class="automation-rules-info">
                        <div class="automation-rules-name">@rule.Name</div>
                        <div class="automation-rules-meta">@GetClientName(rule.TriggerClientId) &middot; @DescribeTrigger(rule)</div>
                    </div>
                    <div class="automation-rules-controls">
                        <FluentSwitch Value="@rule.IsEnabled"
                                      Title="@(rule.IsEnabled ? "Switch this rule off" : "Switch this rule on")"
                                      aria-label="@($"{rule.Name} enabled")"
                                      ValueChanged="@((bool isEnabled) => OnRuleEnabledToggleChangedAsync(rule, isEnabled))" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="@(rule.IsEnabled ? "Run now (test)" : "Switch the rule on to test it")"
                                      aria-label="@($"Test {rule.Name} now")"
                                      IconStart="@(new Icons.Regular.Size20.Play())"
                                      Loading="@(_testingRuleId == rule.Id)"
                                      Disabled="@(!rule.IsEnabled || _testingRuleId != null)"
                                      OnClick="@(() => TestRuleAsync(rule))" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="Edit rule" aria-label="@($"Edit {rule.Name}")"
                                      IconStart="@(new Icons.Regular.Size20.Edit())"
                                      OnClick="@(() => OpenEditRuleDialogAsync(rule))" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="Duplicate rule" aria-label="@($"Duplicate {rule.Name}")"
                                      IconStart="@(new Icons.Regular.Size20.Copy())"
                                      Disabled="@(_duplicatingRuleId != null)"
                                      OnClick="@(() => DuplicateRuleAsync(rule))" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="Delete rule" aria-label="@($"Delete {rule.Name}")"
                                      IconStart="@(new Icons.Regular.Size20.Delete())"
                                      OnClick="@(() => ConfirmDeleteRuleAsync(rule))" />
                    </div>
                </div>
            }
        </div>
    }
</FluentCard>

<FluentDivider Class="my-2" />

<FluentCard Height="auto">
    <FluentStack Orientation="Orientation.Horizontal" class="w-100" id="toolbar-log">
        <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">Execution Log</FluentText>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Orientation="Orientation.Horizontal">
            <FluentSwitch @bind-Value="_showFailuresOnly" @bind-Value:after="StateHasChanged">
                Failures only
            </FluentSwitch>
        </FluentStack>
    </FluentStack>

    @* A list rather than a grid, for the same reason as the rules above: five fixed columns didn't fit
       on a phone. *@
    @if (!FilteredExecutions.Any())
    {
        <div class="automation-rules-empty">No execution log entries found.</div>
    }
    else
    {
        <div class="automation-rules-list">
            @foreach (AutomationRuleExecution execution in FilteredExecutions)
            {
                <div class="automation-rules-item" @key="execution.Id">
                    <div class="automation-rules-info">
                        <button type="button" class="automation-log-name"
                                title="Show what happened"
                                aria-label="@($"Show what happened when {execution.RuleName} ran")"
                                @onclick="@(() => OpenExecutionDetailDialogAsync(execution))">
                            @execution.RuleName
                        </button>
                        <div class="automation-rules-meta">
                            @execution.TriggerEvent &middot; @GetClientName(execution.TriggerClientId) &middot; @RotaTime.ToVenueLocal(execution.ExecutedAt).ToString("d MMM yyyy HH:mm")
                        </div>
                    </div>
                    <div class="automation-rules-controls">
                        @if (execution.IsTestRun)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" title="Run by hand with Run now (test)">Test</FluentBadge>
                        }
                        @if (execution.SkipReason != null)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" title="@execution.SkipReason">Skipped</FluentBadge>
                        }
                        else if (execution.OverallSuccess)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Success" aria-label="Worked" title="Worked" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size20.DismissCircle())" Color="Color.Error" aria-label="Failed" title="Failed" />
                        }
                    </div>
                </div>
            }
        </div>
    }
</FluentCard>

@code {
#nullable enable

    private IEnumerable<AutomationRule> _rules = [];
    private IEnumerable<ClientConnectedDTO> _clients = [];
    private IEnumerable<AutomationRuleExecution> _executions = [];
    private bool _engineEnabled;
    private bool _showFailuresOnly;
    private Guid? _duplicatingRuleId;
    private Guid? _testingRuleId;

    private IEnumerable<AutomationRuleExecution> FilteredExecutions =>
        _showFailuresOnly
            // A skipped rule did what it was told (not run), so it isn't a failure.
            ? _executions.Where(e => !e.OverallSuccess && e.SkipReason == null)
            : _executions;

    protected override async Task OnInitializedAsync()
    {
        await using ApplicationDbContext ctx = await _dbContextFactory.CreateDbContextAsync();
        AppSetting? engineSetting = await ctx.AppSettings
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.Key == "AutomationEngine.Enabled");
        _engineEnabled = engineSetting?.Value == "true";

        // Independent reads (each opens its own DbContext) - overlap them rather than paying
        // three round-trips back to back.
        await Task.WhenAll(LoadClientsAsync(), LoadRulesAsync(), LoadExecutionsAsync());
    }

    private async Task LoadRulesAsync()
    {
        Result<IEnumerable<AutomationRule>> result = await _ruleService.GetRulesAsync();
        if (result.IsSuccess)
        {
            _rules = result.Data ?? [];
        }
        else
        {
            _toastService.ShowError($"Failed to load rules: {result.Error}");
        }
    }

    private async Task LoadClientsAsync()
    {
        Result<IEnumerable<ClientConnectedDTO>> result = await _clientService.GetClientsAsync();
        if (result.IsSuccess)
        {
            _clients = result.Data ?? [];
        }
    }

    private async Task LoadExecutionsAsync()
    {
        Result<IEnumerable<AutomationRuleExecution>> result = await _logService.GetRecentExecutionsAsync(50);
        if (result.IsSuccess)
        {
            _executions = result.Data ?? [];
        }
        else
        {
            _toastService.ShowError($"Failed to load execution log: {result.Error}");
        }
    }

    private string GetClientName(Guid clientId)
    {
        return _clients.FirstOrDefault(c => c.Id == clientId)?.Name ?? clientId.ToString();
    }

    private static string DescribeTrigger(AutomationRule rule)
    {
        int conditionCount = rule.Conditions.Count(c => c.IsActive);

        return conditionCount switch
        {
            0 => DescribeTriggerOnly(rule),
            1 => $"{DescribeTriggerOnly(rule)}, only if 1 condition",
            _ => $"{DescribeTriggerOnly(rule)}, only if {conditionCount} conditions"
        };
    }

    private static string DescribeTriggerOnly(AutomationRule rule)
    {
        switch (rule.TriggerType)
        {
            case AutomationTriggerType.ClientIdle:
                return $"Idle for {rule.IdleThresholdMinutes} min";

            case AutomationTriggerType.Scheduled:
                string time = rule.ScheduledTimeOfDay?.ToString("HH:mm") ?? "?";
                if (!AutomationScheduleDays.TryParse(rule.ScheduledDaysOfWeek, out List<DayOfWeek> days) || days.Count == 7)
                {
                    return $"Daily at {time}";
                }

                string dayList = string.Join(", ", days.OrderBy(d => (int)d).Select(d => d.ToString()[..3]));
                return $"{dayList} at {time}";

            case AutomationTriggerType.TimeRemainingBelow:
                return $"Time left drops below {rule.TriggerThreshold}s";

            case AutomationTriggerType.ScoreThreshold:
                string who = (rule.TriggerScoreScope, rule.TriggerTeam) switch
                {
                    (AutomationScoreScope.Team, null) => "A team",
                    (AutomationScoreScope.Team, Team team) => $"{team} team",
                    (_, null) => "A player",
                    (_, Team team) => $"A {team.ToString().ToLowerInvariant()} player"
                };
                return $"{who} reaches {rule.TriggerThreshold}";

            case AutomationTriggerType.GameEnded:
                return rule.TriggerTeam is Team winningTeam ? $"Game ends, {winningTeam} wins" : "Game ends with a winner";

            default:
                return $"Game status: {rule.TriggerEvent}";
        }
    }

    private async Task OnEngineToggleChangedAsync()
    {
        _engineService.SetEnabled(_engineEnabled);

        await using ApplicationDbContext ctx = await _dbContextFactory.CreateDbContextAsync();
        AppSetting? setting = await ctx.AppSettings
            .FirstOrDefaultAsync(s => s.Key == "AutomationEngine.Enabled");
        if (setting is null)
        {
            ctx.AppSettings.Add(new AppSetting
            {
                Id = Guid.NewGuid(),
                Key = "AutomationEngine.Enabled",
                Value = _engineEnabled ? "true" : "false",
                CreateDate = DateTime.UtcNow
            });
        }
        else
        {
            setting.Value = _engineEnabled ? "true" : "false";
        }
        await ctx.SaveChangesAsync();

        string message = _engineEnabled ? "Automation engine enabled" : "Automation engine disabled";
        _toastService.ShowSuccess(message);
    }

    private async Task OnRuleEnabledToggleChangedAsync(AutomationRule rule, bool isEnabled)
    {
        Result<AutomationRule> result = await _ruleService.SetRuleEnabledAsync(rule.Id, isEnabled);
        if (result.IsSuccess)
        {
            rule.IsEnabled = isEnabled;
            _toastService.ShowSuccess(isEnabled ? "Rule enabled." : "Rule disabled.");
        }
        else
        {
            _toastService.ShowError(result.Error ?? "Failed to update rule.");
        }
    }

    private async Task OpenAddRuleDialogAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<AddEditAutomationRuleDialog>(options =>
        {
            options.Width = "600px";
            options.Modal = true;
        });

        if (result.Value is true)
        {
            await LoadRulesAsync();
        }
    }

    private async Task OpenEditRuleDialogAsync(AutomationRule rule)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<AddEditAutomationRuleDialog>(options =>
        {
            options.Width = "600px";
            options.Modal = true;
            options.Parameters.Add(nameof(AddEditAutomationRuleDialog.Content), rule);
        });

        if (result.Value is true)
        {
            await LoadRulesAsync();
        }
    }

    private async Task DuplicateRuleAsync(AutomationRule rule)
    {
        if (_duplicatingRuleId != null)
        {
            return;
        }

        _duplicatingRuleId = rule.Id;

        try
        {
            Result<AutomationRule> result = await _ruleService.DuplicateRuleAsync(rule.Id);

            if (!result.IsSuccess || result.Data is not AutomationRule copy)
            {
                _toastService.ShowError(result.Error ?? "Couldn't copy the rule.");
                return;
            }

            await LoadRulesAsync();
            _toastService.ShowSuccess($"Copied as \"{copy.Name}\". It's switched off until you turn it on.");

            // Straight into the copy, so it can be renamed and changed before it's switched on.
            AutomationRule? reloaded = _rules.FirstOrDefault(r => r.Id == copy.Id);

            if (reloaded != null)
            {
                await OpenEditRuleDialogAsync(reloaded);
            }
        }
        finally
        {
            _duplicatingRuleId = null;
        }
    }

    private async Task TestRuleAsync(AutomationRule rule)
    {
        if (_testingRuleId != null || !rule.IsEnabled)
        {
            return;
        }

        Result<List<AutomationActionDescription>> described = await _ruleService.DescribeActionsAsync(rule.Id);

        if (!described.IsSuccess || described.Data is not List<AutomationActionDescription> descriptions)
        {
            _toastService.ShowError(described.Error ?? "Couldn't read the rule's actions.");
            return;
        }

        DialogResult confirm = await _dialogService.ShowDialogAsync<ConfirmAutomationTestRunDialog>(options =>
        {
            options.Width = "560px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmAutomationTestRunDialog.Rule), rule);
            options.Parameters.Add(nameof(ConfirmAutomationTestRunDialog.KioskName), GetClientName(rule.TriggerClientId));
            options.Parameters.Add(nameof(ConfirmAutomationTestRunDialog.EngineEnabled), _engineEnabled);
            options.Parameters.Add(nameof(ConfirmAutomationTestRunDialog.Actions), descriptions);
        });

        if (confirm.Cancelled || confirm.Value is not bool checkConditions)
        {
            return;
        }

        _testingRuleId = rule.Id;
        StateHasChanged();

        try
        {
            Result<AutomationTestRunResult> result = await _ruleService.TestRunRuleAsync(rule.Id, checkConditions);

            await LoadExecutionsAsync();

            if (!result.IsSuccess || result.Data is not AutomationTestRunResult run)
            {
                _toastService.ShowError(result.Error ?? "The test couldn't run.");
                return;
            }

            _testingRuleId = null;
            StateHasChanged();

            await _dialogService.ShowDialogAsync<AutomationTestRunResultDialog>(options =>
            {
                options.Width = "560px";
                options.Modal = true;
                options.Parameters.Add(nameof(AutomationTestRunResultDialog.RuleName), rule.Name);
                options.Parameters.Add(nameof(AutomationTestRunResultDialog.Result), run);
                options.Parameters.Add(nameof(AutomationTestRunResultDialog.Descriptions), descriptions);
            });
        }
        finally
        {
            _testingRuleId = null;
        }
    }

    private async Task ConfirmDeleteRuleAsync(AutomationRule rule)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.DisplayName), rule.Name);
        });

        if (!result.Cancelled)
        {
            Result<bool> deleteResult = await _ruleService.DeleteRuleAsync(rule.Id);
            if (deleteResult.IsSuccess)
            {
                await LoadRulesAsync();
                _toastService.ShowSuccess("Rule deleted.");
            }
            else
            {
                _toastService.ShowError(deleteResult.Error ?? "Delete failed.");
            }
        }
    }

    private async Task OpenExecutionDetailDialogAsync(AutomationRuleExecution execution)
    {
        await _dialogService.ShowDialogAsync<ExecutionLogDetailDialog>(options =>
        {
            options.Header.Title = $"Execution: {execution.RuleName}";
            options.Width = "600px";
            options.Modal = true;
            options.Parameters.Add(nameof(ExecutionLogDetailDialog.Content), execution);
        });
    }
}
