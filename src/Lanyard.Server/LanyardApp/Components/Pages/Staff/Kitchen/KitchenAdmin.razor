    private async Task DeactivateItemAsync(MenuItem item)
    {
        Result<bool> result = await _menuService.DeactivateItemAsync(item.Id);

        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            _toastService.ShowError(result.Error ?? "Couldn't remove that dish.");
        }
    }

    private async Task AddTableAsync()
    {
        if (_selectedLocation is null || string.IsNullOrWhiteSpace(_newTableLabel))
        {
            return;
        }

        Result<QrTableToken> result = await _tableTokenService.SaveAsync(new QrTableToken
        {
            LocationId = _selectedLocation.Id,
            Label = _newTableLabel,
            Token = string.Empty
        });

        if (result.IsSuccess)
        {
            _newTableLabel = string.Empty;
            await ReloadAsync();
        }
        else
        {
            _toastService.ShowError(result.Error ?? "Couldn't add that table.");
        }
    }

    private async Task RotateTableAsync(QrTableToken table)
    {
        // Confirmed because the consequence is physical: whatever is stuck to that table stops
        // working the moment this runs, and somebody has to walk round with a new printout.
        DialogResult confirmation = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Reissue table code";
            options.Width = "450px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message),
                $"Reissue the code for '{table.Label}'? The printed code will stop working and must be replaced.");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Reissue");
        });

        if (confirmation.Cancelled || confirmation.Value is not true)
        {
            return;
        }

        Result<QrTableToken> result = await _tableTokenService.RotateTokenAsync(table.Id);

        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            _toastService.ShowError(result.Error ?? "Couldn't reissue that code.");
        }
    }

    private async Task DeactivateTableAsync(QrTableToken table)
    {
        Result<bool> result = await _tableTokenService.DeactivateAsync(table.Id);

        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            _toastService.ShowError(result.Error ?? "Couldn't remove that table.");
        }
    }

    private static string Money(int cents) => $"£{cents / 100m:0.00}";
