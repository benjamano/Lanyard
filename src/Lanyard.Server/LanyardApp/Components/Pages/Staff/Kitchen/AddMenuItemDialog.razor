@using Lanyard.App.Components.Files
@using Lanyard.Infrastructure.Models
@using Lanyard.Shared.Enum

@*
    Shown through IDialogService rather than declared inline on the page. An inline
    <FluentDialog Hidden="false"> renders into the page markup but never becomes visible in
    Fluent v5 - the dialog service is what actually attaches it to the dialog provider.
*@

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
            <FluentIcon Value="@(new Icons.Regular.Size24.Food())" />
            <FluentText Weight="TextWeight.Semibold" Size="@TextSize.Size700">Add a dish</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentTextInput @bind-Value="Name" Label="Name" Class="w-100" />
            <FluentTextInput @bind-Value="Description" Label="Description (optional)" Class="w-100" />

            @* Entered in pounds, stored as integer pence. The conversion happens once, on save,
               so nothing downstream ever holds a fractional price. *@
            <FluentNumberInput @bind-Value="Price" Label="Price (£)" Step="0.10M" Class="w-100" />

            <FileUploader Id="menu-item-image-uploader" Accept=" image/*"
                          MaximumFileSize="@(5 * 1024 * 1024)" MaximumFileCount="1"
                          OnFileUploaded="OnImageUploaded" Label="Photo (optional)"
                          PreviewUrl="@_imagePreviewUrl" />

            @* Selling food at a distance means declaring allergens before the customer buys, so
               this is not optional - a dish stays off the customer menu until it is confirmed. *@
            <FluentText As="@TextTag.H5" Class="menu-item-allergens-heading">Allergens</FluentText>
            <FluentText Class="menu-item-allergens-note">
                Tick everything this dish contains. Leaving them all unticked means "contains none
                of the fourteen" — it is a declaration, not a way to skip this.
            </FluentText>

            @* Twenty-eight checkboxes made the dialog taller than a laptop screen, pushing the
               confirm box and Save button off the bottom. One scroll region keeps them in view. *@
            <div class="menu-item-allergens-scroll">
                <div class="menu-item-allergens">
                    @foreach (Allergen allergen in AllergenExtensions.All)
                    {
                        <FluentCheckbox Value="@Contains(allergen)"
                                        ValueChanged="@((bool v) => SetContains(allergen, v))"
                                        Label="@allergen.DisplayName()" />
                    }
                </div>

                <FluentText Class="menu-item-allergens-note">
                    May contain (cross-contamination) — a different claim from "contains", so kept separate.
                </FluentText>

                <div class="menu-item-allergens">
                    @foreach (Allergen allergen in AllergenExtensions.All)
                    {
                        <FluentCheckbox Value="@MayContain(allergen)"
                                        ValueChanged="@((bool v) => SetMayContain(allergen, v))"
                                        Label="@allergen.DisplayName()" />
                    }
                </div>
            </div>

            <FluentCheckbox @bind-Value="AllergensConfirmed"
                            Label="I confirm this dish's allergens are correct" />
            <FluentText Class="menu-item-allergens-note">
                Until this is ticked the dish stays off the customer menu and can't be ordered.
            </FluentText>

            @if (_error is not null)
            {
                <FluentText Color="Color.Error">@_error</FluentText>
            }
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SaveAsync">Save</FluentButton>
        <FluentButton OnClick="@CancelAsync">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter] public int CategoryId { get; set; }

    [Parameter] public int SortOrder { get; set; }

    [CascadingParameter] public required IDialogInstance Dialog { get; set; }

    private string Name { get; set; } = string.Empty;
    private string? Description { get; set; }
    private decimal Price { get; set; }
    private Allergen ContainsAllergens { get; set; } = Allergen.None;
    private Allergen MayContainAllergens { get; set; } = Allergen.None;
    private bool AllergensConfirmed { get; set; }

    private bool Contains(Allergen allergen) => ContainsAllergens.HasFlag(allergen);

    private bool MayContain(Allergen allergen) => MayContainAllergens.HasFlag(allergen);

    private void SetContains(Allergen allergen, bool selected) =>
        ContainsAllergens = selected ? ContainsAllergens | allergen : ContainsAllergens & ~allergen;

    private void SetMayContain(Allergen allergen, bool selected) =>
        MayContainAllergens = selected ? MayContainAllergens | allergen : MayContainAllergens & ~allergen;

    private Guid? _imageFileId;
    private string? _imagePreviewUrl;
    private string? _error;

    private void OnImageUploaded(FileMetadata file)
    {
        _imageFileId = file.Id;
        _imagePreviewUrl = $"/api/files/download/{file.Id}";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            _error = "Give the dish a name.";

            return;
        }

        if (Price < 0)
        {
            _error = "Price can't be negative.";

            return;
        }

        await Dialog.CloseAsync(new MenuItem
        {
            CategoryId = CategoryId,
            Name = Name,
            Description = Description,
            // Rounded rather than truncated: 4.99 arriving as 4.9899999 must become 499p, not 498p.
            PriceCents = (int)Math.Round(Price * 100m, MidpointRounding.AwayFromZero),
            ImageFileId = _imageFileId,
            IsAvailable = true,
            SortOrder = SortOrder,
            ContainsAllergens = ContainsAllergens,
            MayContainAllergens = MayContainAllergens,
            AllergensConfirmed = AllergensConfirmed
        });
    }

    private async Task CancelAsync() => await Dialog.CancelAsync();
}
