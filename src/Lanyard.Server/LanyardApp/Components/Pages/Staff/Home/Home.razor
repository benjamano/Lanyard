@page "/"

@* Anonymous at the endpoint so a signed-out visitor gets the public homepage rather than a
   redirect to login. Everything behind it is still signed-in only: StaffHome (and every
   service it calls) is only rendered inside <Authorized>. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@using Lanyard.App.Components.Home
@using Lanyard.App.Components.Public

<AuthorizeView>
    <Authorized>
        <StaffHome />
    </Authorized>
    <NotAuthorized>
        <PublicLanding />
    </NotAuthorized>
</AuthorizeView>
