@page "/"

@attribute [Authorize]

@using Lanyard.App.Components.ClockIn
@using Lanyard.App.Components.Home
@using Lanyard.App.Components.Layout.Staff
@using Lanyard.App.Components.Training
@using Lanyard.App.Components.Dashboards
@using Lanyard.Application.Services.Authentication
@using Microsoft.AspNetCore.Authorization

@inject ISecurityService _securityService
@inject IDashboardService _dashboardService
@inject ILogger<Home> _logger

<PageTitle>Staff Home</PageTitle>

@if (_homeScreenDashboard is not null)
{
    <div class="mx-3">
        @if (_homeScreenWidgets.Count > 0)
        {
            <DashboardGrid Widgets="_homeScreenWidgets" PreviewMode="true" />
        }
        else
        {
            <FluentCard Appearance="CardAppearance.Filled">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size600">
                        Your home screen dashboard has no widgets yet
                    </FluentText>
                    <FluentText>
                        "@_homeScreenDashboard.Name" is set as
                        @(_homeScreenIsOrganisationDefault ? "everyone's home screen" : "your home screen"),
                        but nothing has been added to it.
                    </FluentText>
                    <FluentLink Href="/account/manage">
                        Change your home screen
                    </FluentLink>
                </FluentStack>
            </FluentCard>
        }
    </div>
}
else
{
<div class="mx-3">
    <FluentGrid AdaptiveRendering="true" Spacing="2">
        <FluentGridItem HiddenWhen="@GridItemHidden.SmAndUp" Sm="12" Xs="12">
            <FluentCard Appearance="@CardAppearance.Outline" Padding="@Padding.Top0" Height="100%">
                <CompanyLogo Url="@_companyLogoUrl" />
            </FluentCard>
            @* <FluentDivider /> *@
        </FluentGridItem>
        <FluentGridItem Lg="4" Md="6" Sm="12" Xs="12">
            <GreetingCard>
                @if (_showPreviewContent)
                {
                    <FluentText Weight="TextWeight.Semibold" Color="Color.Info" Class="mt-2">Preview Mode, Dummy data in
                        use</FluentText>
                }
            </GreetingCard>
        </FluentGridItem>
            <FluentGridItem Lg="4" Md="6" Sm="12" Xs="12">
                @if (_showPreviewContent)
                {
                    <MyTasksToday />
                }
                else
                {
                    @* <FluentStack HorizontalAlignment="HorizontalAlignment.Center"
            VerticalAlignment="VerticalAlignment.Center"
                                 Class="h-100 gap-3">
                        <FluentButton IconStart="new Icons.Regular.Size24.SearchSparkle()" Appearance="ButtonAppearance.Primary"
                                      @onclick="() => _showPreviewContent = true">
                            Show Preview Content
                        </FluentButton>
                    </FluentStack> *@
                    <OutstandingTrainingCard />
                }
            </FluentGridItem>
            <FluentGridItem Lg="4" Md="6" Sm="12" Xs="12" HiddenWhen="GridItemHidden.MdAndDown">
                <DigitalClock />
            </FluentGridItem>
        </FluentGrid>
        @if (_showPreviewContent)
        {
            <FluentGrid Spacing="3">
                <FluentGridItem Lg="7" Md="12" Sm="12" Xs="12">
                    <FluentCard Appearance="CardAppearance.Filled" Height="100%">
                        <ClockinPortable />
                    </FluentCard>
                </FluentGridItem>
                <FluentGridItem Lg="3" Md="5" Sm="12" Xs="12">
                    <FluentCard Appearance="CardAppearance.Filled" Height="100%">
                        <UpcomingShifts />
                    </FluentCard>
                </FluentGridItem>
                <FluentGridItem Lg="2" Md="7" Sm="12" Xs="12">
                    <FluentCard Appearance="CardAppearance.Filled" Height="100%">
                        <ShiftCalendar />
                    </FluentCard>
                </FluentGridItem>
            </FluentGrid>
        }
    </div>
}

@code {
    private bool _showPreviewContent = false;
    private string? _companyLogoUrl = null;

    private Dashboard? _homeScreenDashboard;
    private List<DashboardWidget> _homeScreenWidgets = [];
    private bool _personalDashboardUnavailable = false;
    private bool _homeScreenIsOrganisationDefault = false;

    protected override async Task OnInitializedAsync()
    {
        Task logoTask = GetCurrentCompanyLogoUrlAsync();
        Task homeScreenTask = LoadHomeScreenDashboardAsync();

        await Task.WhenAll(logoTask, homeScreenTask);
    }

    // Fired here rather than in OnInitializedAsync so the user sees it exactly once - that method
    // also runs during prerender, where a toast is discarded.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _personalDashboardUnavailable)
        {
            _toastService.ShowInfo(_homeScreenIsOrganisationDefault
                ? "Your home screen dashboard is no longer available, showing the dashboard set for everyone instead."
                : "Your home screen dashboard is no longer available, showing the standard home page.");
        }
    }

    private async Task LoadHomeScreenDashboardAsync()
    {
        Result<string> userIdResult = await _securityService.GetCurrentUserIdAsync();

        if (!userIdResult.IsSuccess || string.IsNullOrEmpty(userIdResult.Data))
        {
            _logger.LogWarning("Failed to resolve the current user for the home screen dashboard: {Error}", userIdResult.Error);
            return;
        }

        // Resolves the user's own choice, then the organisation-wide default an Admin or Manager
        // set, then nothing - all in the service, so the account page and this one cannot drift.
        Result<HomeScreenDashboardSelection> selectionResult = await _dashboardService.GetHomeScreenDashboardAsync(userIdResult.Data);

        if (!selectionResult.IsSuccess || selectionResult.Data is null)
        {
            _logger.LogWarning("Failed to load the home screen dashboard setting: {Error}", selectionResult.Error);
            return;
        }

        // Set when the user had picked a dashboard that has since been deleted. The selection has
        // already fallen through to the organisation default (or to nothing) - this only decides
        // whether to explain why they are not seeing what they chose.
        _personalDashboardUnavailable = selectionResult.Data.PersonalDashboardUnavailable;
        _homeScreenIsOrganisationDefault = selectionResult.Data.IsOrganisationDefault;

        if (selectionResult.Data.DashboardId is not Guid dashboardId)
        {
            return;
        }

        Result<Dashboard> dashboardResult = await _dashboardService.GetDashboardAsync(dashboardId);

        // GetHomeScreenDashboardAsync has already rejected an inactive dashboard, but
        // GetDashboardAsync deliberately does not filter the dashboard row on IsActive (unlike
        // GetDashboardsAsync), so the check is repeated here rather than assumed.
        if (!dashboardResult.IsSuccess || dashboardResult.Data is not { IsActive: true } dashboard)
        {
            _logger.LogWarning("Home screen dashboard {DashboardId} is no longer available: {Error}", dashboardId, dashboardResult.Error);
            return;
        }

        // GetDashboardAsync already excludes soft-deleted widgets; the filter is kept as a guard.
        _homeScreenWidgets = dashboard.Widgets.Where(x => x.IsActive).ToList();
        _homeScreenDashboard = dashboard;
    }

    private async Task GetCurrentCompanyLogoUrlAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.Success || scopeResult.Data is not { CompanyId: int companyId })
        {
            _logger.LogWarning("Failed to resolve the current location scope for the home page logo: {Error}", scopeResult.Error);
            return;
        }

        Result<CompanyBrandingInfo> branding = await _companyLocationService.GetCompanyBrandingAsync(companyId);

        if (!branding.Success || branding.Data is null)
        {
            _logger.LogWarning("Failed to get company branding for company {CompanyId}: {Error}", companyId, branding.Error);
            return;
        }

        _companyLogoUrl = branding.Data.LogoFileId is Guid logoFileId
            ? $"/api/companies/{companyId}/logo?v={logoFileId:N}"
            : null;
    }
}