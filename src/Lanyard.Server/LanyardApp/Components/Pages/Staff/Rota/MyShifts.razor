@page "/rota"
@page "/rota/time-off"
@page "/rota/open"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Lanyard.App.Components.Rota
@using Lanyard.App.Components.Rota.TimeOff
@using Lanyard.App.Components.Rota.Claims
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

<PageTitle>My Shifts</PageTitle>

<div class="p-2">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
        <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size700">My Shifts</FluentText>
        <FluentTabs @bind-ActiveTabId="activeTabId">
            <FluentTab Id="shifts" Header="Upcoming shifts" IconStart="@(new Icons.Regular.Size20.CalendarLtr())">
                <div class="pt-3">
                    <MyShiftsList @ref="shiftsList" WeeksAhead="6" />
                </div>
            </FluentTab>
            <FluentTab Id="open" Header="Up for grabs" IconStart="@(new Icons.Regular.Size20.PeopleSwap())" DeferredLoading="true">
                <div class="pt-3">
                    <UpForGrabsPanel OnChanged="@(() => shiftsList?.ReloadAsync() ?? Task.CompletedTask)" />
                </div>
            </FluentTab>
            <FluentTab Id="hours" Header="My hours" IconStart="@(new Icons.Regular.Size20.Clock())" DeferredLoading="true">
                <div class="pt-3">
                    <MyHoursList Weeks="3" />
                </div>
            </FluentTab>
            <FluentTab Id="time-off" Header="Time off" IconStart="@(new Icons.Regular.Size20.CalendarPerson())" DeferredLoading="true">
                <div class="pt-3">
                    <MyTimeOffPanel />
                </div>
            </FluentTab>
        </FluentTabs>
    </FluentStack>
</div>

@code {
    private string? activeTabId;
    private MyShiftsList? shiftsList;

    // /rota/time-off opens straight on the Time off tab (it's what the nav's "Time Off" link and any
    // "your request was decided" link point at). /rota and /rota/time-off are the same component,
    // so moving between them reuses this instance without re-initialising it - the tab follows the
    // address on every navigation instead. Clicking a tab doesn't navigate, so it never snaps back.
    protected override void OnInitialized()
    {
        activeTabId = TabFor(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        string tab = TabFor(e.Location);

        if (tab != activeTabId)
        {
            activeTabId = tab;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private static string TabFor(string uri)
    {
        string path = new Uri(uri).AbsolutePath.TrimEnd('/');

        return path.EndsWith("/time-off", StringComparison.OrdinalIgnoreCase) ? "time-off"
            : path.EndsWith("/open", StringComparison.OrdinalIgnoreCase) ? "open"
            : "shifts";
    }

    public void Dispose() => _navigationManager.LocationChanged -= OnLocationChanged;
}
