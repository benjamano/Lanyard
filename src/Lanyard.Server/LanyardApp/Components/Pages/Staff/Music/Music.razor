@page "/music"
@attribute [Authorize(Roles = MusicRoles.Use)]

@using Lanyard.App.Components.Music
@using Lanyard.App.Components.Dialogs
@using Lanyard.Application.Services.Tenancy
@using Microsoft.AspNetCore.Authorization

@inject IMusicPlayerService _player
@inject IMusicService _musicService
@inject IPlaylistService _playlistService
@inject IMusicLibraryEvents _libraryEvents
@inject ITenantContext _tenant
@inject IJSRuntime JS

@implements IAsyncDisposable

<PageTitle>Music</PageTitle>

<div class="music-page" @ref="_pageRoot">
    <header class="music-page-header">
        <h1 class="music-page-title">Music</h1>
        <div class="music-page-links">
            <AuthorizeView Roles="Admin,Manager">
                <a class="music-page-link" href="/manage/music-schedule">
                    <FluentIcon Value="@(new Icons.Regular.Size16.CalendarClock())" Color="Color.Default" /> Schedule
                </a>
                <a class="music-page-link" href="/manage/audio-clips">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Megaphone())" Color="Color.Default" /> Audio clips
                </a>
            </AuthorizeView>
            <HelpButton AreaKey="@HelpRegistry.Music" Topic="player" />
        </div>
    </header>

    @if (!_loaded)
    {
        <div class="music-loading" aria-busy="true" aria-label="Loading music">
            <div class="music-skeleton is-strip"></div>
            <div class="music-layout">
                <div class="music-skeleton is-card"></div>
                <div class="music-skeleton is-list"></div>
            </div>
        </div>
    }
    else if (_kiosks.Count == 0)
    {
        <div class="music-page-empty">
            <FluentIcon Value="@(new Icons.Regular.Size48.Speaker2())" Color="Color.Default" />
            <h2>No kiosks yet</h2>
            <p>Music plays through a kiosk's speakers. Once a kiosk is paired in <a href="/manage/clients">Clients</a>, you can control it here.</p>
        </div>
    }
    else
    {
        <MusicKioskStrip Kiosks="_kiosks" Snapshots="_snapshots" SelectedId="_selectedKioskId" OnSelect="SelectKioskAsync" />

        <div class="music-layout">
            <div class="music-player-column" @ref="_cardHost">
                @if (SelectedSnapshot is { } snapshot)
                {
                    <MusicNowPlayingCard Snapshot="snapshot" KioskName="@SelectedKioskName" PlaylistName="PlaylistNameFor" />
                }
            </div>

            <div class="music-library-column">
                <MusicPlaylistPicker Playlists="_playlists" SelectedPlaylistId="_selectedPlaylistId"
                                     PlayingPlaylistId="SelectedSnapshot?.PlaylistId" CanEdit="_canEdit"
                                     OnSelect="SelectPlaylistAsync" OnCreate="CreatePlaylistAsync" />

                <MusicTrackList Playlist="SelectedPlaylist" Tracks="_tracks"
                                PlayingSongId="SelectedSnapshot?.Song?.Id" PlayingPlaylistId="SelectedSnapshot?.PlaylistId"
                                IsPlaying="@(SelectedSnapshot?.IsConnected == true && SelectedSnapshot.State == NAudio.Wave.PlaybackState.Playing)"
                                CanEdit="_canEdit" LibraryVersion="_libraryVersion"
                                OnPlaySong="PlaySongAsync" OnPlayAll="PlayAllAsync"
                                OnRename="RenamePlaylistAsync" OnDelete="DeletePlaylistAsync"
                                OnAddToPlaylist="AddToPlaylistAsync" OnRemove="RemoveFromPlaylistAsync" OnMove="MoveSongAsync" />
            </div>
        </div>

        @if (SelectedSnapshot is { } barSnapshot)
        {
            <MusicCompactBar @ref="_compactBar" Snapshot="barSnapshot" KioskName="@SelectedKioskName" OnExpand="ScrollToPlayerAsync" />
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IJSObjectReference? _module;
    private bool _loaded;
    private bool _canEdit;

    private IReadOnlyList<MusicKiosk> _kiosks = [];
    private Dictionary<Guid, MusicNowPlayingSnapshot> _snapshots = [];
    private Guid? _selectedKioskId;

    private IReadOnlyList<PlaylistOverview> _playlists = [];
    private Guid? _selectedPlaylistId;
    private IReadOnlyList<PlaylistTrack>? _tracks;
    private int _libraryVersion;

    private ElementReference _cardHost;
    private ElementReference _pageRoot;
    private (Guid?, Guid?)? _revealed;
    private MusicCompactBar? _compactBar;
    private bool _barObserved;

    // Changes arrive from the player and the library on their own threads, often several at once
    // (a song change brings a state change with it). They're gathered into one render.
    private int _refreshQueued;
    private readonly HashSet<Guid> _changedPlaylists = [];
    private bool _playlistListChanged;
    private bool _kioskListChanged;
    private readonly object _changesLock = new();

    private MusicNowPlayingSnapshot? SelectedSnapshot =>
        _selectedKioskId is Guid id ? _snapshots.GetValueOrDefault(id) : null;

    private string SelectedKioskName => _kiosks.FirstOrDefault(x => x.Id == _selectedKioskId)?.Name ?? "";

    private PlaylistOverview? SelectedPlaylist => _playlists.FirstOrDefault(x => x.Id == _selectedPlaylistId);

    private string? PlaylistNameFor(Guid id) => _playlists.FirstOrDefault(x => x.Id == id)?.Name;

    // Everything loads after the first render: the page is prerendered, and loading during
    // prerender would run every query twice and can't read the remembered kiosk anyway.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            return;
        }

        // Keep the chosen kiosk and playlist in view in their sideways-scrolling rows.
        if (_loaded && _module is not null && _revealed != (_selectedKioskId, _selectedPlaylistId))
        {
            _revealed = (_selectedKioskId, _selectedPlaylistId);
            try
            {
                await _module.InvokeVoidAsync("revealSelected", _pageRoot);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_loaded && !_barObserved && _compactBar is not null && _module is not null)
        {
            _barObserved = true;
            try
            {
                await _module.InvokeVoidAsync("observeCard", _cardHost, _compactBar.Element);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/musicPlayer.js");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (AuthState is not null)
        {
            ClaimsPrincipal user = (await AuthState).User;
            _canEdit = MusicRoles.ManagePlaylists.Split(',').Any(user.IsInRole);
        }

        _player.OnNowPlayingChanged += HandleNowPlayingChanged;
        _libraryEvents.Changed += HandleLibraryChanged;

        await LoadKiosksAsync();

        string? remembered = await _module.InvokeAsync<string?>("load", "selectedClientId");
        _selectedKioskId = Guid.TryParse(remembered, out Guid rememberedId) && _kiosks.Any(x => x.Id == rememberedId)
            ? rememberedId
            : _kiosks.FirstOrDefault()?.Id;

        await LoadPlaylistsAsync();

        // Open on what the kiosk is playing, if it's playing a playlist; otherwise the first one.
        _selectedPlaylistId = SelectedSnapshot?.PlaylistId is Guid playing && _playlists.Any(x => x.Id == playing)
            ? playing
            : _playlists.FirstOrDefault()?.Id;

        await LoadTracksAsync();

        _loaded = true;
        StateHasChanged();
    }

    private async Task LoadKiosksAsync()
    {
        Result<IReadOnlyList<MusicKiosk>> result = await _musicService.GetKiosksAsync();

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError(result.Error ?? "Couldn't load kiosks.");
            return;
        }

        _kiosks = result.Data;
        RefreshSnapshots();
    }

    private void RefreshSnapshots()
    {
        // Every kiosk that connects is registered with the player, so one it has no state for is
        // one that hasn't connected since the server started: offline.
        _snapshots = _player.GetSnapshots(_kiosks.Select(x => x.Id)).ToDictionary(x => x.ClientId);
    }

    private async Task LoadPlaylistsAsync()
    {
        Result<IReadOnlyList<PlaylistOverview>> result = await _playlistService.GetPlaylistOverviewsAsync();

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError(result.Error ?? "Couldn't load playlists.");
            return;
        }

        _playlists = result.Data;

        if (_selectedPlaylistId is Guid id && _playlists.All(x => x.Id != id))
        {
            // Deleted (here or somewhere else): fall back to the library.
            _selectedPlaylistId = null;
            _tracks = null;
        }
    }

    private async Task LoadTracksAsync()
    {
        if (_selectedPlaylistId is not Guid id)
        {
            _tracks = null;
            return;
        }

        Result<IReadOnlyList<PlaylistTrack>> result = await _playlistService.GetPlaylistTracksAsync(id);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError(result.Error ?? "Couldn't load the playlist.");
            _tracks = [];
            return;
        }

        _tracks = result.Data;
    }

    #region Live updates

    private void HandleNowPlayingChanged(Guid clientId)
    {
        if (_kiosks.All(x => x.Id != clientId))
        {
            // A kiosk the page doesn't know (just paired, or another company's).
            lock (_changesLock)
            {
                _kioskListChanged = true;
            }
        }

        QueueRefresh();
    }

    private void HandleLibraryChanged(int companyId, Guid? playlistId)
    {
        if (_tenant.CompanyId != companyId)
        {
            return;
        }

        lock (_changesLock)
        {
            _playlistListChanged = true;
            if (playlistId is Guid id)
            {
                _changedPlaylists.Add(id);
            }
            else
            {
                _libraryVersion++;
            }
        }

        QueueRefresh();
    }

    private void QueueRefresh()
    {
        if (Interlocked.Exchange(ref _refreshQueued, 1) == 1)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await Task.Delay(120);
            Interlocked.Exchange(ref _refreshQueued, 0);

            bool reloadKiosks, reloadPlaylists, reloadTracks;
            lock (_changesLock)
            {
                reloadKiosks = _kioskListChanged;
                reloadPlaylists = _playlistListChanged;
                reloadTracks = _selectedPlaylistId is Guid id && _changedPlaylists.Contains(id);
                _kioskListChanged = false;
                _playlistListChanged = false;
                _changedPlaylists.Clear();
            }

            try
            {
                if (reloadKiosks)
                {
                    await LoadKiosksAsync();
                }
                else
                {
                    RefreshSnapshots();
                }

                if (reloadPlaylists)
                {
                    await LoadPlaylistsAsync();
                }

                if (reloadTracks)
                {
                    await LoadTracksAsync();
                }

                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
                // The page closed while the change was on its way.
            }
        });
    }

    #endregion

    #region Kiosks and playlists

    private async Task SelectKioskAsync(Guid kioskId)
    {
        _selectedKioskId = kioskId;
        RefreshSnapshots();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("save", "selectedClientId", kioskId.ToString());
        }
    }

    private async Task SelectPlaylistAsync(Guid? playlistId)
    {
        _selectedPlaylistId = playlistId;
        _tracks = null;
        await LoadTracksAsync();
    }

    private async Task ScrollToPlayerAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollIntoView", _cardHost);
        }
    }

    // A command needs a kiosk that's online; says so if there isn't one.
    private bool TryGetControllableKiosk(out Guid kioskId)
    {
        kioskId = _selectedKioskId ?? Guid.Empty;

        if (SelectedSnapshot is not { IsConnected: true })
        {
            _toastService.ShowWarning(_selectedKioskId is null
                ? "Choose a kiosk at the top first."
                : $"{SelectedKioskName} is offline, so it can't play anything right now.");
            return false;
        }

        return true;
    }

    private async Task PlaySongAsync(Guid songId)
    {
        if (!TryGetControllableKiosk(out Guid kioskId))
        {
            return;
        }

        Result<bool> result = await _player.PlaySong(kioskId, songId, _selectedPlaylistId);
        if (!result.IsSuccess)
        {
            _toastService.ShowWarning(result.Error ?? "Couldn't play that song.");
        }
    }

    private async Task PlayAllAsync(bool shuffle)
    {
        if (_selectedPlaylistId is not Guid playlistId || !TryGetControllableKiosk(out Guid kioskId))
        {
            return;
        }

        Result<bool> result;
        if (shuffle)
        {
            result = await _player.ShufflePlay(kioskId, playlistId);
        }
        else
        {
            // "Play" means in order, from the top.
            if (_player.GetShuffleEnabled(kioskId))
            {
                await _player.ToggleShuffle(kioskId);
            }

            result = await _player.Play(kioskId, playlistId);
        }

        if (!result.IsSuccess)
        {
            _toastService.ShowWarning(result.Error ?? "Couldn't play the playlist.");
        }
    }

    private async Task CreatePlaylistAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<PlaylistDetailsDialog>(options =>
        {
            options.Width = "min(480px, 95vw)";
            options.Modal = true;
        });

        if (!result.Cancelled && result.Value is Guid id)
        {
            await LoadPlaylistsAsync();
            await SelectPlaylistAsync(id);
        }
    }

    private async Task RenamePlaylistAsync()
    {
        if (SelectedPlaylist is not { } playlist)
        {
            return;
        }

        DialogResult result = await _dialogService.ShowDialogAsync<PlaylistDetailsDialog>(options =>
        {
            options.Width = "min(480px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(PlaylistDetailsDialog.PlaylistId), playlist.Id);
            options.Parameters.Add(nameof(PlaylistDetailsDialog.InitialName), playlist.Name);
            options.Parameters.Add(nameof(PlaylistDetailsDialog.InitialDescription), playlist.Description);
        });

        if (!result.Cancelled)
        {
            await LoadPlaylistsAsync();
        }
    }

    private async Task DeletePlaylistAsync()
    {
        if (SelectedPlaylist is not { } playlist)
        {
            return;
        }

        DialogResult confirm = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Delete playlist";
            options.Width = "min(450px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message),
                $"Delete \"{playlist.Name}\"? Its songs stay in the library. A kiosk playing it carries on until you pick something else.");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Delete");
        });

        if (confirm.Cancelled || confirm.Value is not true)
        {
            return;
        }

        Result<bool> deleted = await _playlistService.DeletePlaylistAsync(playlist.Id);
        if (!deleted.IsSuccess)
        {
            _toastService.ShowWarning(deleted.Error ?? "Couldn't delete the playlist.");
            return;
        }

        _toastService.ShowSuccess($"Deleted \"{playlist.Name}\"");
        _selectedPlaylistId = null;
        _tracks = null;
        await LoadPlaylistsAsync();
    }

    private async Task AddToPlaylistAsync(MusicTrackList.MusicRow row)
    {
        await _dialogService.ShowDialogAsync<AddToPlaylistDialog>(options =>
        {
            options.Width = "min(440px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(AddToPlaylistDialog.SongId), row.SongId);
            options.Parameters.Add(nameof(AddToPlaylistDialog.SongName), row.Name);
            options.Parameters.Add(nameof(AddToPlaylistDialog.ExcludePlaylistId), _selectedPlaylistId);
        });
    }

    private async Task RemoveFromPlaylistAsync(MusicTrackList.MusicRow row)
    {
        if (SelectedPlaylist is not { } playlist)
        {
            return;
        }

        DialogResult confirm = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Remove song";
            options.Width = "min(450px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message), $"Remove \"{row.Name}\" from \"{playlist.Name}\"? It stays in the library.");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Remove");
        });

        if (confirm.Cancelled || confirm.Value is not true)
        {
            return;
        }

        Result<bool> removed = await _playlistService.RemoveSongFromPlaylistAsync(playlist.Id, row.SongId);
        if (!removed.IsSuccess)
        {
            _toastService.ShowWarning(removed.Error ?? "Couldn't remove the song.");
            return;
        }

        // The library event refreshes the list too; doing it now makes it feel instant.
        _tracks = _tracks?.Where(x => x.SongId != row.SongId).ToList();
        await LoadPlaylistsAsync();
    }

    private async Task MoveSongAsync((Guid SongId, int Index) move)
    {
        if (_selectedPlaylistId is not Guid playlistId || _tracks is null)
        {
            return;
        }

        // Show the new order straight away; the saved order follows via the library event.
        List<PlaylistTrack> reordered = _tracks.ToList();
        PlaylistTrack? moving = reordered.FirstOrDefault(x => x.SongId == move.SongId);
        if (moving is null)
        {
            return;
        }

        reordered.Remove(moving);
        reordered.Insert(Math.Clamp(move.Index, 0, reordered.Count), moving);
        _tracks = reordered;

        Result<bool> moved = await _playlistService.MoveSongAsync(playlistId, move.SongId, move.Index);
        if (!moved.IsSuccess)
        {
            _toastService.ShowWarning(moved.Error ?? "Couldn't move the song.");
            await LoadTracksAsync();
        }
    }

    #endregion

    public async ValueTask DisposeAsync()
    {
        _player.OnNowPlayingChanged -= HandleNowPlayingChanged;
        _libraryEvents.Changed -= HandleLibraryChanged;

        try
        {
            if (_module is not null)
            {
                if (_compactBar is not null)
                {
                    await _module.InvokeVoidAsync("unobserveCard", _compactBar.Element);
                }

                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
