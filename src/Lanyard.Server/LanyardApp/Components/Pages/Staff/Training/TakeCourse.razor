@page "/training/{AssignmentId:guid}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.DTO.Training

@inject ICourseAssignmentService _courseAssignmentService
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@(assignment?.Course?.Name ?? "Training")</PageTitle>

@if (isLoading || assignment is null)
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
        <FluentSpinner />
    </FluentStack>
}
else
{
    <FluentCard Height="auto">
        <FluentText Typo="Typography.PaneHeader">@assignment.Course!.Name</FluentText>

        <div class="take-course-wizard-host">
            <FluentWizard @ref="wizardRef" StepperPosition="@stepperPosition" Height="@wizardHeight"
                          OnFinish="HandleFinishAsync">
                <Steps>
                    @foreach (CourseSection courseSection in assignment.Course.Sections)
                    {
                        <FluentWizardStep Label="@courseSection.Title">
                            <div class="take-course-section-body">
                                @((MarkupString)courseSection.BodyHtml)
                            </div>
                        </FluentWizardStep>
                    }
                    <FluentWizardStep Label="Quiz">
                        @if (assignment.Course.Questions.Count == 0)
                        {
                            <FluentText>This course doesn't have a quiz yet.</FluentText>
                        }
                        else
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="24px">
                                @if (quizSubmitted && lastGradeResult is not null)
                                {
                                    @if (lastGradeResult.Passed)
                                    {
                                        <FluentMessageBar Intent="MessageBarIntent.Success">
                                            You passed with a score of @lastGradeResult.ScorePercent%.
                                        </FluentMessageBar>
                                    }
                                    else
                                    {
                                        <FluentMessageBar Intent="MessageBarIntent.Warning">
                                            You scored @lastGradeResult.ScorePercent% - you need @assignment.Course.PassMarkPercent% to
                                            pass. Review the marked questions below and try again.
                                        </FluentMessageBar>
                                    }
                                }

                                <div class="quiz-progress-host">
                                    <FluentText Weight="TextWeight.Semibold">
                                        Question @(currentQuestionIndex + 1) of @assignment.Course.Questions.Count
                                    </FluentText>
                                    <FluentProgressBar Min="0" Max="@assignment.Course.Questions.Count"
                                                        Value="@(currentQuestionIndex + 1)" />
                                </div>

                                @{
                                    CourseQuestion question = assignment.Course.Questions[currentQuestionIndex];
                                }

                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
                                    <FluentStack Orientation="Orientation.Horizontal"
                                                 VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
                                        <FluentText Weight="TextWeight.Semibold">@question.QuestionText</FluentText>
                                        @if (quizSubmitted)
                                        {
                                            <FluentIcon
                                            Value="@(WasQuestionCorrect(question.Id) ? (Icon)new Icons.Filled.Size20.CheckmarkCircle() : new Icons.Filled.Size20.DismissCircle())"
                                            Color="@(WasQuestionCorrect(question.Id) ? Color.Success : Color.Error)" />
                                        }
                                    </FluentStack>
                                    <FluentRadioGroup TValue="Guid" Orientation="Orientation.Vertical"
                                                      Value="@GetSelectedOptionId(question.Id)"
                                                      ValueChanged="@((Guid v) => SetSelectedOptionId(question.Id, v))"
                                                      Disabled="@(quizSubmitted && lastGradeResult!.Passed)">
                                        @foreach (CourseQuestionOption option in GetDisplayOptions(question))
                                        {
                                            <FluentRadio Value="@option.Id" Label="@option.OptionText" />
                                        }
                                    </FluentRadioGroup>
                                </FluentStack>

                                @if (quizSubmitted && lastGradeResult is not null && !lastGradeResult.Passed)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="RetryQuiz">
                                        Retry
                                    </FluentButton>
                                }
                            </FluentStack>
                        }
                    </FluentWizardStep>
                </Steps>
                <ButtonTemplate>
                    @{
                        int stepIndex = context;
                        bool isQuizStep = stepIndex == assignment.Course.Sections.Count;
                        bool hasQuestions = assignment.Course.Questions.Count > 0;
                        bool onLastQuestion = !hasQuestions || currentQuestionIndex == assignment.Course.Questions.Count - 1;
                        bool showPrevious = isQuizStep ? (currentQuestionIndex > 0 || stepIndex > 0) : stepIndex > 0;
                    }
                    <div>
                        @if (showPrevious)
                        {
                            <FluentButton OnClick="@(() => HandleWizardPreviousAsync(stepIndex))">Previous</FluentButton>
                        }
                    </div>
                    <FluentSpacer />
                    <div>
                        @if (isQuizStep && !onLastQuestion)
                        {
                            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="GoToNextQuestion">Next</FluentButton>
                        }
                        else if (isQuizStep)
                        {
                            <FluentButton Appearance="ButtonAppearance.Primary"
                                          OnClick="@(() => wizardRef!.FinishAsync(false))">Done</FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="ButtonAppearance.Primary"
                                          OnClick="@(() => wizardRef!.GoToStepAsync(stepIndex + 1, false))">Next</FluentButton>
                        }
                    </div>
                </ButtonTemplate>
            </FluentWizard>
        </div>
    </FluentCard>
}

@code {
    [Parameter]
    public Guid AssignmentId { get; set; }

    protected StepperPosition stepperPosition = StepperPosition.Left;

    // On mobile the stepper moves to the Top and the page itself scrolls, so there's no "side"
    // stepper affordance to keep a constant height for - a fixed calc(100vh - ...) height there
    // just clips content taller than the viewport instead of letting the card grow with it.
    private string wizardHeight => stepperPosition == StepperPosition.Top ? "auto" : "calc(100vh - 260px)";

    private CourseAssignment? assignment;
    private bool isLoading;
    private string currentUserId = string.Empty;
    private readonly Dictionary<Guid, Guid> selectedAnswers = [];
    private bool quizSubmitted;
    private QuizGradeResult? lastGradeResult;
    private int currentQuestionIndex;
    private FluentWizard? wizardRef;
    private readonly Dictionary<Guid, List<CourseQuestionOption>> shuffledOptionsByQuestionId = [];
    private readonly Random optionShuffleRandom = new();

    private DotNetObjectReference<TakeCourse>? _viewportRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _viewportRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("viewportWatcher.init", _viewportRef, 768);
        }
    }

    [JSInvokable]
    public void OnViewportChanged(bool isNarrow)
    {
        stepperPosition = isNarrow ? StepperPosition.Top : StepperPosition.Left;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("viewportWatcher.dispose");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) {}

        _viewportRef?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        Result<string> currentUserResult = await _securityService.GetCurrentUserIdAsync();

        if (!currentUserResult.IsSuccess || currentUserResult.Data is null)
        {
            _toastService.ShowError("Could not determine the current user.");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        currentUserId = currentUserResult.Data;

        Result<CourseAssignment> startResult = await _courseAssignmentService.StartAssignmentAsync(AssignmentId, currentUserId);

        if (!startResult.IsSuccess)
        {
            _toastService.ShowError($"Failed to open training: {startResult.Error}");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        Result<CourseAssignment> loadResult = await _courseAssignmentService.GetAssignmentAsync(AssignmentId, currentUserId);

        if (!loadResult.IsSuccess || loadResult.Data is null)
        {
            _toastService.ShowError($"Failed to load training: {loadResult.Error}");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        assignment = loadResult.Data;
        isLoading = false;
    }

    private async Task HandleFinishAsync()
    {
        if (assignment?.Course is null || assignment.Course.Questions.Count == 0)
        {
            _toastService.ShowError("This course can't be completed until it has quiz questions.");
            return;
        }

        Result<QuizGradeResult> result = await _courseAssignmentService.SubmitQuizAttemptAsync(AssignmentId, currentUserId,
selectedAnswers);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to submit quiz: {result.Error}");
            return;
        }

        lastGradeResult = result.Data;
        quizSubmitted = true;

        if (lastGradeResult.Passed)
        {
            await _dialogService.ShowDialogAsync<CourseCompletedDialog>(options =>
            {
                options.Header.Title = "Course Completed";
                options.Width = "min(420px, 95vw)";
                options.Modal = true;
                options.Parameters.Add(nameof(CourseCompletedDialog.CourseName), assignment.Course.Name);
            });
        }
    }

    private void RetryQuiz()
    {
        selectedAnswers.Clear();
        quizSubmitted = false;
        lastGradeResult = null;
        currentQuestionIndex = 0;
    }

    private async Task HandleWizardPreviousAsync(int stepIndex)
    {
        bool isQuizStep = assignment?.Course is not null && stepIndex == assignment.Course.Sections.Count;

        if (isQuizStep && currentQuestionIndex > 0)
        {
            currentQuestionIndex--;
            return;
        }

        if (wizardRef is not null)
        {
            await wizardRef.GoToStepAsync(stepIndex - 1, false);
        }
    }

    private void GoToNextQuestion()
    {
        if (assignment?.Course is not null && currentQuestionIndex < assignment.Course.Questions.Count - 1)
        {
            currentQuestionIndex++;
        }
    }

    private List<CourseQuestionOption> GetDisplayOptions(CourseQuestion question)
    {
        if (!shuffledOptionsByQuestionId.TryGetValue(question.Id, out List<CourseQuestionOption>? options))
        {
            options = [.. question.Options];

            for (int i = options.Count - 1; i > 0; i--)
            {
                int j = optionShuffleRandom.Next(i + 1);
                (options[i], options[j]) = (options[j], options[i]);
            }

            shuffledOptionsByQuestionId[question.Id] = options;
        }

        return options;
    }

    private Guid GetSelectedOptionId(Guid questionId) =>
        selectedAnswers.TryGetValue(questionId, out Guid optionId) ? optionId : Guid.Empty;

    private void SetSelectedOptionId(Guid questionId, Guid optionId)
    {
        selectedAnswers[questionId] = optionId;
    }

    private bool WasQuestionCorrect(Guid questionId) =>
        lastGradeResult?.QuestionResults.FirstOrDefault(x => x.QuestionId == questionId)?.WasCorrect ?? false;
}
