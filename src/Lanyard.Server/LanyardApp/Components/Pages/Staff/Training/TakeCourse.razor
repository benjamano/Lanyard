@page "/training/{AssignmentId:guid}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.DTO.Training

@inject ICourseAssignmentService _courseAssignmentService

<PageTitle>@(assignment?.Course?.Name ?? "Training")</PageTitle>

@if (isLoading || assignment is null || assignment.Course is null)
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
        <FluentSpinner />
    </FluentStack>
}
else
{
    <FluentCard>
        <FluentText As="TextTag.H4" Size="TextSize.Size500">@assignment.Course!.Name</FluentText>

        <CourseWizardRunner Course="assignment.Course" EnableScrollGate="true"
                             GradeQuizAsync="GradeAsync" OnPassed="ShowCompletedDialogAsync"
                             OnSectionTransition="HandleSectionTransition" />
    </FluentCard>
}

@code {
    [Parameter]
    public Guid AssignmentId { get; set; }

    private CourseAssignment? assignment;
    private bool isLoading;
    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        Result<string> currentUserResult = await _securityService.GetCurrentUserIdAsync();

        if (!currentUserResult.IsSuccess || currentUserResult.Data is null)
        {
            _toastService.ShowError("Could not determine the current user.");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        currentUserId = currentUserResult.Data;

        Result<CourseAssignment> startResult = await _courseAssignmentService.StartAssignmentAsync(AssignmentId, currentUserId);

        if (!startResult.IsSuccess)
        {
            _toastService.ShowError($"Failed to open training: {startResult.Error}");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        Result<CourseAssignment> loadResult = await _courseAssignmentService.GetAssignmentAsync(AssignmentId, currentUserId);

        if (!loadResult.IsSuccess || loadResult.Data is null)
        {
            _toastService.ShowError($"Failed to load training: {loadResult.Error}");
            isLoading = false;
            _navigationManager.NavigateTo("/training");
            return;
        }

        assignment = loadResult.Data;
        isLoading = false;
    }

    private Task _pendingSectionTransition = Task.CompletedTask;

    private void HandleSectionTransition(Guid? departedSectionId, Guid? arrivedSectionId, DateTime transitionTimeUtc)
    {
        // Fire-and-forget from the caller's perspective (must not block wizard
        // navigation) - but each write gets its own DbContext, so two transitions
        // fired close together (fast clicking) can otherwise race: the "arrived"
        // insert for a section may not have committed yet when the very next
        // transition's "departed" write runs its find-or-create check, sees no row,
        // and falls back to inserting its own row stamped at that later moment - a
        // false near-zero-duration record that wins over the real, still-in-flight
        // arrival. Chaining every write onto the previous one forces them to apply
        // in the order the transitions actually happened, without ever blocking
        // this method's caller. transitionTimeUtc is captured by CourseWizardRunner
        // at the moment the transition was detected, not when this queued write
        // finally executes, so queuing delay never skews the recorded timestamp.
        _pendingSectionTransition = ChainSectionTransitionAsync(_pendingSectionTransition, departedSectionId, arrivedSectionId, transitionTimeUtc);
    }

    private async Task ChainSectionTransitionAsync(Task previous, Guid? departedSectionId, Guid? arrivedSectionId, DateTime transitionTimeUtc)
    {
        try
        {
            await previous;
        }
        catch
        {
            // A prior transition's failure shouldn't block this one from being recorded.
        }

        await _courseAssignmentService.RecordSectionTransitionAsync(AssignmentId, currentUserId, departedSectionId, arrivedSectionId, transitionTimeUtc);
    }

    private async Task<QuizGradeResult?> GradeAsync(Dictionary<Guid, Guid> answers)
    {
        if (assignment?.Course is null || assignment.Course.Questions.Count == 0)
        {
            _toastService.ShowError("This course can't be completed until it has quiz questions.");
            return null;
        }

        Result<QuizGradeResult> result = await _courseAssignmentService.SubmitQuizAttemptAsync(AssignmentId, currentUserId, answers);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to submit quiz: {result.Error}");
            return null;
        }

        return result.Data;
    }

    private async Task ShowCompletedDialogAsync(QuizGradeResult result)
    {
        await _dialogService.ShowDialogAsync<CourseCompletedDialog>(options =>
        {
            options.Header.Title = "Course Completed";
            options.Width = "min(420px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(CourseCompletedDialog.CourseName), assignment!.Course!.Name);
            options.Parameters.Add(nameof(CourseCompletedDialog.AssignmentId), AssignmentId);
        });
    }
}
