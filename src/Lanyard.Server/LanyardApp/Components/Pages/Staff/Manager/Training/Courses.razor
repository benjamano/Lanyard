@page "/manage/training/courses"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.Application.Services.Training
@using Lanyard.App.Components.Manager

@inject ICourseService _courseService
@inject INotificationService _toastService
@inject NavigationManager _navigationManager

<PageTitle>Training Courses</PageTitle>

<FluentCard Height="auto">
    <FluentStack Orientation="Orientation.Horizontal" Class="w-100" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
        <FluentText As="TextTag.H4" Size="TextSize.Size500">Training Courses</FluentText>

        @* Admins are the only role that can read across locations, so the switch is theirs alone.
           It defaults to off: the list should reflect the location you actually signed in to. *@
        @if (currentScope?.IsAdmin == true)
        {
            <FluentStack VerticalAlignment="VerticalAlignment.Center" Orientation="Orientation.Horizontal"
                         Width="auto" Class="ms-auto">
                <FluentSwitch @bind-Value="allLocations" @bind-Value:after="LoadCoursesAsync">
                    Show all locations
                </FluentSwitch>
            </FluentStack>
        }

        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.FormNew())"
                      Class="@(currentScope?.IsAdmin == true ? null : "ms-auto")"
                      Disabled="@scopeFailed" OnClick="CreateCourseAsync">
            New Course
        </FluentButton>

        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.QuestionCircle())"
                      OnClick="@(() => _navigationManager.NavigateTo("/manage/training/help?topic=courses"))">
            Help
        </FluentButton>
    </FluentStack>

    @if (scopeFailed)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="my-4">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                We couldn't work out which location you're working in, so your courses can't be
                listed. This is usually temporary - try again, or sign out and back in.
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="LoadCoursesAsync">
                Reload
            </FluentButton>
        </FluentStack>
    }
    else if (isLoading)
    {
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
            <FluentSpinner />
        </FluentStack>
    }
    else
    {
        @if (allLocations && currentScope?.IsAdmin == true)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info" Class="my-2">
                Showing courses from every location, not just
                @(currentScope.LocationDisplayName ?? "the location you signed in to").
            </FluentMessageBar>
        }

        @* Five columns don't fit a phone, and the Edit/Delete buttons were already being clipped at
           four - so the grid keeps a workable minimum width and the page scrolls it sideways
           instead of squeezing columns until their contents are unreachable. *@
        <div class="courses-grid-scroll" style="overflow-x: auto;">
            @* The action column is fixed rather than fractional: the Edit and Delete buttons are 96px
               each, and as a fraction it shrank below that and clipped Delete once Location was added. *@
            <FluentDataGrid ShowHover="true" Items="@courses.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr 240px"
                            Class="w-100" Style="min-width: 860px;" RowSize="@DataGridRowSize.Medium">
                <ChildContent>
                    <PropertyColumn Property="x => x.Name" Title="Course" Sortable="true" />
                    <PropertyColumn Property="x => x.PassMarkPercent" Title="Pass Mark %" />
                    <PropertyColumn Property="@(x => x.AutoAssignOnUserCreation ? "Yes" : "No")" Title="Auto-assign" />
                    @* "Unassigned" is a real state: a course created before locations existed, or by an
                       Admin who never picked one, has a null LocationId and no location can see it. *@
                    <PropertyColumn Property="@(x => x.Location == null ? "Unassigned" : x.Location.GetDisplayName())"
                                    Title="Location" />
                    <TemplateColumn Title="">
                        @* A course shared from another location is readable but not writable, so it
                           opens as a read-only view and Delete is off - the service would reject it. *@
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      IconStart="@(CanWrite(context)
                                                   ? new Icons.Regular.Size20.Edit()
                                                   : (Icon)new Icons.Regular.Size20.Eye())"
                                      OnClick="@(() => EditCourse(context.Id))">@(CanWrite(context) ? "Edit" : "View")
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.BinRecycle())"
                                      Disabled="@(!CanWrite(context))"
                                      OnClick="@(() => DeleteCourseAsync(context.Id, context.Name))">Delete</FluentButton>
                    </TemplateColumn>
                </ChildContent>
                <EmptyContent>
                    @* "Nothing here" and "nothing here for this location" are different problems, and
                       courses with no location set at all only ever appear with the switch on. *@
                    @if (currentScope?.IsAdmin == true && !allLocations)
                    {
                        <span>
                            No courses for @(currentScope.LocationDisplayName ?? "this location") - turn on
                            "Show all locations" to see courses owned elsewhere, or click "New Course" to build one.
                        </span>
                    }
                    else
                    {
                        <span>No courses yet - click "New Course" to build one.</span>
                    }
                </EmptyContent>
            </FluentDataGrid>
        </div>
    }
</FluentCard>

@code {
    private List<Course> courses = [];
    private bool isLoading;
    private bool scopeFailed;
    private bool allLocations;
    private int loadSequence;
    private LocationScope? currentScope;

    // Mirrors the service's write rule: Admins write anything; everyone else only writes
    // courses owned by their own location. Shared courses from a sibling location list here
    // (read access) but every write against them is rejected server-side.
    private bool CanWrite(Course course) =>
        currentScope is not null
        && (currentScope.IsAdmin || course.LocationId == currentScope.LocationId);

    protected override async Task OnInitializedAsync()
    {
        await LoadCoursesAsync();
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the list would just render as
            // permanently empty, indistinguishable from genuinely having no courses.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task LoadCoursesAsync()
    {
        // Flipping the switch twice in quick succession starts a second load before the first has
        // returned; without this token the slower one could win and leave the rows disagreeing with
        // the switch and banner. Only the most recent load is allowed to publish its result.
        int sequence = ++loadSequence;

        isLoading = true;

        LocationScope? scope = await ResolveScopeAsync();

        if (sequence != loadSequence)
        {
            return;
        }

        if (scope is null)
        {
            courses = [];
            isLoading = false;
            return;
        }

        Result<List<Course>> result = await _courseService.GetCoursesAsync(scope, allLocations);

        if (sequence != loadSequence)
        {
            return;
        }

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load courses: {result.Error}");
            courses = [];
        }
        else
        {
            courses = result.Data;
        }

        isLoading = false;
    }

    private async Task CreateCourseAsync()
    {
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            return;
        }

        Result<Course> result = await _courseService.SaveCourseAsync(new Course
        {
            Id = Guid.Empty,
            Name = "New Course",
            PassMarkPercent = 80,
            // SaveCourseAsync honours the supplied LocationId for an Admin and ignores it for
            // everyone else. Without this an Admin's new course was created with no location at
            // all, so it immediately failed the location filter and disappeared from this list.
            LocationId = scope.LocationId
        }, scope);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to create course: {result.Error}");
            return;
        }

        _navigationManager.NavigateTo($"/manage/training/courses/{result.Data.Id}");
    }

    private void EditCourse(Guid courseId)
    {
        _navigationManager.NavigateTo($"/manage/training/courses/{courseId}");
    }

    private async Task DeleteCourseAsync(Guid courseId, string courseName)
    {
        DialogResult confirmResult = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.DisplayName), courseName);
        });

        if (confirmResult.Cancelled)
        {
            return;
        }

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            return;
        }

        Result<bool> result = await _courseService.DeleteCourseAsync(courseId, scope);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to delete course: {result.Error}");
            return;
        }

        _toastService.ShowSuccess("Course deleted.");
        await LoadCoursesAsync();
    }
}
