@page "/manage/training"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.App.Components.Manager.Training

<PageTitle>Training Dashboard</PageTitle>

<FluentCard Height="auto">
    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center">
        <FluentText As="TextTag.H4" Size="TextSize.Size500">Training Dashboard</FluentText>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.QuestionCircle())"
                      OnClick="@(() => _navigationManager.NavigateTo($"/manage/training/help?topic={HelpTopicForActiveTab}"))">
            Help
        </FluentButton>
    </FluentStack>

    <FluentTabs @bind-ActiveTabId="activeTabId" Orientation="Orientation.Horizontal" Size="TabsSize.Medium">
        <FluentTab Id="dash-by-course" Header="By Course" IconStart="@(new Icons.Regular.Size16.Board())">
            <ByCourseTrainingTab />
        </FluentTab>
        <FluentTab Id="dash-by-person" Header="By Person" IconStart="@(new Icons.Regular.Size16.Person())" DeferredLoading="true">
            <ByPersonTrainingTab />
        </FluentTab>
        <FluentTab Id="dash-auto-assign" Header="Auto-assign rules" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" DeferredLoading="true">
            <AutoAssignRulesTab />
        </FluentTab>
        <FluentTab Id="dash-timing" Header="Timing" IconStart="@(new Icons.Regular.Size16.Timer())" DeferredLoading="true">
            <TimingReportsTab />
        </FluentTab>
        <FluentTab Id="dash-analytics" Header="Analytics" IconStart="@(new Icons.Regular.Size16.ChartMultiple())" DeferredLoading="true">
            <AnalyticsReportsTab />
        </FluentTab>
    </FluentTabs>
</FluentCard>

@code {
    private string? activeTabId;

    // Maps each dashboard tab to the Training Help topic that documents it.
    private string HelpTopicForActiveTab => activeTabId switch
    {
        "dash-by-course" or "dash-by-person" or "dash-auto-assign" => "assigning",
        "dash-timing" or "dash-analytics" => "reports",
        _ => "overview"
    };
}
