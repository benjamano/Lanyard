@page "/manage/training/courses/{CourseId:guid}"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.Application.Services.Training
@using Lanyard.App.Components.Manager
@using Lanyard.App.Components.Files

@inject ICourseService _courseService
@inject IToastService _toastService
@inject NavigationManager _navigationManager
@inject IJSRuntime JS

<PageTitle>Edit Course</PageTitle>

@if (isLoading || course is null)
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
        <FluentSpinner />
    </FluentStack>
}
else
{
    <FluentCard Height="auto" Class="mb-3">
        <FluentGrid Class="w-100" Spacing="3">
            <FluentGridItem Xs="3">
                <FluentStack HorizontalGap="6">
                    <div style="width: 60%;">
                        <FluentTextInput Width="100%" @bind-Value="course.Name" Label="Course Name"
                                         Appearance="TextInputAppearance.Outline" Required="true" />
                    </div>
                    <div style="width: 40%;">
                        <FluentNumberInput TValue="int" Width="100%" @bind-Value="course.PassMarkPercent"
                                           Label="Pass Mark %" Min="1" Max="100" />
                    </div>
                </FluentStack>
                <div class="w-100">
                    <FluentTextArea Width="100%" @bind-Value="course.Description" Label="Description"
                                    Appearance="TextAreaAppearance.Outline" />
                </div>
                <div class="recurrence-field-host">
                    <FluentNumberInput TValue="int?" Width="100%" @bind-Value="course.RecurrenceMonths"
                                       Label="Recurs every (months)" Min="1" Placeholder="Does not recur" />
                </div>
            </FluentGridItem>
        </FluentGrid>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Class="mt-2">
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Save())"
                          Loading="@isSavingCourse" OnClick="SaveCourseMetaAsync">
                Save Course Details
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Eye())"
                          OnClick="OpenPreview">
                Preview
            </FluentButton>
        </FluentStack>
    </FluentCard>

    <FluentCard Height="640px">
        <FluentMultiSplitter Height="100%">
            <FluentMultiSplitterPane Size="30%" Class="px-2">
                <FluentStack Orientation="Orientation.Vertical" Class="h-100 overflow-y-auto" VerticalGap="18px">
                    <FluentText As="TextTag.H4" Size="TextSize.Size500">Sections</FluentText>
                    @foreach (CourseSection courseSection in course.Sections.OrderBy(x => x.SortOrder))
                    {
                        <div class="reorder-item" draggable="true"
                             @ondragstart="@(() => draggedSection = courseSection)"
                             @ondragover="@(() => { })" @ondragover:preventDefault="true"
                             @ondrop="@(() => OnSectionDropAsync(courseSection))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ReOrderDotsVertical())" Class="reorder-handle" />
                            <FluentButton
                                Appearance="@(selectedSection?.Id == courseSection.Id ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                Class="reorder-item-button" OnClick="@(() => SelectSection(courseSection))">
                                @courseSection.Title
                            </FluentButton>
                        </div>
                    }
                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.FormNew())"
                                  OnClick="StartNewSection">
                        Add Section
                    </FluentButton>

                    <FluentDivider Class="my-3" />

                    <FluentText As="TextTag.H4" Size="TextSize.Size500">Quiz Questions</FluentText>
                    @foreach (CourseQuestion question in course.Questions.OrderBy(x => x.SortOrder))
                    {
                        <div class="reorder-item" draggable="true"
                             @ondragstart="@(() => draggedQuestion = question)"
                             @ondragover="@(() => { })" @ondragover:preventDefault="true"
                             @ondrop="@(() => OnQuestionDropAsync(question))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ReOrderDotsVertical())" Class="reorder-handle" />
                            <FluentButton
                                Appearance="@(selectedQuestion?.Id == question.Id ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                Class="reorder-item-button" OnClick="@(() => SelectQuestion(question))">
                                @question.QuestionText
                            </FluentButton>
                        </div>
                    }
                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.FormNew())"
                                  OnClick="StartNewQuestion">
                        Add Question
                    </FluentButton>
                </FluentStack>
            </FluentMultiSplitterPane>

            <FluentMultiSplitterPane Size="70%" Class="px-3">
                @if (selectedSection is not null)
                {
                    <FluentStack Orientation="Orientation.Vertical" Class="h-100 overflow-y-auto" VerticalGap="18px">
                        <FluentTextInput Class="w-100" @bind-Value="selectedSection.Title" Label="Section Title"
                                         Appearance="TextInputAppearance.Outline" Required="true" />
                        <div class="quill-editor-host" @ref="quillEditorHostRef">
                            <BlazoredTextEditor @ref="sectionEditor" Placeholder="Section content...">
                                <ToolbarContent>
                                    <span class="ql-formats">
                                        <select class="ql-header">
                                            <option value="1"></option>
                                            <option value="2"></option>
                                            <option value="3"></option>
                                            <option selected></option>
                                        </select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button type="button" class="ql-image-insert" @onclick="OpenImagePickerAsync"
                                                title="Insert image">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Image())" />
                                        </button>
                                    </span>
                                </ToolbarContent>
                                <EditorContent></EditorContent>
                            </BlazoredTextEditor>
                        </div>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Save())"
                                          Loading="@isSavingSection" OnClick="SaveSelectedSectionAsync">
                                Save
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.BinRecycle())"
                                          Disabled="@(selectedSection.Id == Guid.Empty)" OnClick="DeleteSelectedSectionAsync">
                                Delete
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                }
                else if (selectedQuestion is not null)
                {
                    <FluentStack Orientation="Orientation.Vertical" Class="h-100 overflow-y-auto" VerticalGap="6px">
                        <FluentTextArea Class="w-100" @bind-Value="selectedQuestion.QuestionText" Label="Question"
                                        Appearance="TextAreaAppearance.Outline" Required="true" />

                        <div class="option-radio-host">
                            <FluentRadioGroup Orientation="Orientation.Vertical" TValue="Guid" @bind-Value="correctOptionId"
                                              Class="w-100" Margin="@Margin.Top0">
                                @foreach (CourseQuestionOption option in selectedQuestion.Options)
                                {
                                    <FluentRadio Value="@option.Id">
                                        <LabelTemplate>
                                            <FluentStack Orientation="Orientation.Horizontal"
                                                         VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
                                                <FluentTextInput Class="w-100" @bind-Value="option.OptionText"
                                                                 Placeholder="Option text" />
                                                <FluentButton Appearance="ButtonAppearance.Outline"
                                                              IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                                              OnClick="@(() => RemoveOption(option))" />
                                            </FluentStack>
                                        </LabelTemplate>
                                    </FluentRadio>
                                }
                            </FluentRadioGroup>
                        </div>

                        <div class="question-actions-group">
                            <div class="question-actions-add">
                                <FluentButton Appearance="ButtonAppearance.Outline"
                                              IconStart="@(new Icons.Regular.Size20.FormNew())" OnClick="AddOption">
                                    Add Option
                                </FluentButton>
                            </div>

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                                <FluentButton Appearance="ButtonAppearance.Primary"
                                              IconStart="@(new Icons.Regular.Size20.Save())" Loading="@isSavingQuestion"
                                              OnClick="SaveSelectedQuestionAsync">
                                    Save
                                </FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Outline"
                                              IconStart="@(new Icons.Regular.Size20.BinRecycle())"
                                              Disabled="@(selectedQuestion.Id == Guid.Empty)" OnClick="DeleteSelectedQuestionAsync">
                                    Delete
                                </FluentButton>
                            </FluentStack>
                        </div>
                    </FluentStack>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                                 VerticalAlignment="VerticalAlignment.Center" Height="100%">
                        <FluentText>Select a section or question, or add a new one.</FluentText>
                    </FluentStack>
                }
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </FluentCard>
}

@code {
    [Parameter]
    public Guid CourseId { get; set; }

    private Course? course;
    private CourseSection? selectedSection;
    private CourseQuestion? selectedQuestion;
    private BlazoredTextEditor? sectionEditor;
    private ElementReference quillEditorHostRef;
    private Guid? loadedSectionEditorId;
    private CourseSection? draggedSection;
    private CourseQuestion? draggedQuestion;
    private bool isLoading;
    private bool isSavingCourse;
    private bool isSavingSection;
    private bool isSavingQuestion;

    private Guid correctOptionId
    {
        get => selectedQuestion?.Options.FirstOrDefault(x => x.IsCorrect)?.Id ?? Guid.Empty;
        set
        {
            if (selectedQuestion is null)
            {
                return;
            }

            foreach (CourseQuestionOption option in selectedQuestion.Options)
            {
                option.IsCorrect = option.Id == value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCourseAsync();
    }

    // BlazoredTextEditor (v1.1.3, confirmed via assembly reflection) does not accept its
    // initial content as a bound parameter - content must be pushed in via LoadHTMLContent()
    // after the component has mounted. Without this, re-opening an existing section would
    // show a blank editor and silently wipe out the saved BodyHtml on the next Save.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (selectedSection is not null && sectionEditor is not null && loadedSectionEditorId != selectedSection.Id)
        {
            try
            {
                await sectionEditor.LoadHTMLContent(selectedSection.BodyHtml);
                loadedSectionEditorId = selectedSection.Id;
            }
            catch (JSException)
            {
                // The BlazoredTextEditor's underlying Quill instance may not have finished
                // its own JS-side registration on the render pass immediately after it mounts.
                // Don't mark as loaded - retry on the next render pass instead of crashing.
                StateHasChanged();
            }
        }
    }

    private async Task LoadCourseAsync()
    {
        isLoading = true;

        Result<Course> result = await _courseService.GetCourseAsync(CourseId);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load course: {result.Error}");
            isLoading = false;
            _navigationManager.NavigateTo("/manage/training/courses");
            return;
        }

        course = result.Data;
        isLoading = false;
    }

    private async Task OpenPreview()
    {
        await JS.InvokeVoidAsync("open", $"/manage/training/courses/{CourseId}/preview", "_blank");
    }

    private async Task OpenImagePickerAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ImagePickerDialog>(options =>
        {
            options.Header.Title = "Insert Image";
            options.Width = "min(900px, 95vw)";
            options.Modal = true;
        });

        if (!result.Cancelled && result.Value is Guid fileId)
        {
            // BlazoredTextEditor.InsertImage falls back to inserting at document position
            // 0 whenever the Quill editor doesn't currently have DOM focus - which it
            // never does right after this dialog closes. courseImageEditor.js restores
            // focus to the last cursor position before inserting instead.
            await JS.InvokeVoidAsync("courseImageEditor.insertImageAtCursor", quillEditorHostRef, $"/api/files/download/{fileId}");
        }
    }

    private async Task SaveCourseMetaAsync()
    {
        if (course is null)
        {
            return;
        }

        isSavingCourse = true;

        Result<Course> result = await _courseService.SaveCourseAsync(course);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to save course: {result.Error}");
        }
        else
        {
            _toastService.ShowSuccess("Course details saved.");
        }

        isSavingCourse = false;
    }

    private async Task OnSectionDropAsync(CourseSection targetSection)
    {
        if (course is null || draggedSection is null || draggedSection.Id == targetSection.Id)
        {
            draggedSection = null;
            return;
        }

        List<CourseSection> ordered = [.. course.Sections.OrderBy(x => x.SortOrder)];
        int fromIndex = ordered.FindIndex(x => x.Id == draggedSection.Id);
        int toIndex = ordered.FindIndex(x => x.Id == targetSection.Id);
        draggedSection = null;

        if (fromIndex < 0 || toIndex < 0)
        {
            return;
        }

        CourseSection moved = ordered[fromIndex];
        ordered.RemoveAt(fromIndex);
        ordered.Insert(toIndex, moved);

        for (int i = 0; i < ordered.Count; i++)
        {
            ordered[i].SortOrder = i;
        }

        Result<bool> result = await _courseService.ReorderSectionsAsync(CourseId, [.. ordered.Select(x => x.Id)]);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to reorder sections: {result.Error}");
            await LoadCourseAsync();
        }
    }

    private async Task OnQuestionDropAsync(CourseQuestion targetQuestion)
    {
        if (course is null || draggedQuestion is null || draggedQuestion.Id == targetQuestion.Id)
        {
            draggedQuestion = null;
            return;
        }

        List<CourseQuestion> ordered = [.. course.Questions.OrderBy(x => x.SortOrder)];
        int fromIndex = ordered.FindIndex(x => x.Id == draggedQuestion.Id);
        int toIndex = ordered.FindIndex(x => x.Id == targetQuestion.Id);
        draggedQuestion = null;

        if (fromIndex < 0 || toIndex < 0)
        {
            return;
        }

        CourseQuestion moved = ordered[fromIndex];
        ordered.RemoveAt(fromIndex);
        ordered.Insert(toIndex, moved);

        for (int i = 0; i < ordered.Count; i++)
        {
            ordered[i].SortOrder = i;
        }

        Result<bool> result = await _courseService.ReorderQuestionsAsync(CourseId, [.. ordered.Select(x => x.Id)]);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to reorder questions: {result.Error}");
            await LoadCourseAsync();
        }
    }

    private void SelectSection(CourseSection section)
    {
        selectedQuestion = null;
        selectedSection = CloneSection(section);
    }

    private void StartNewSection()
    {
        selectedQuestion = null;
        loadedSectionEditorId = null;
        selectedSection = new CourseSection
        {
            Id = Guid.Empty,
            CourseId = CourseId,
            Title = "New Section",
            BodyHtml =
string.Empty
        };
    }

    private async Task SaveSelectedSectionAsync()
    {
        if (selectedSection is null)
        {
            return;
        }

        isSavingSection = true;

        if (sectionEditor is not null)
        {
            selectedSection.BodyHtml = await sectionEditor.GetHTML();
        }

        Result<CourseSection> result = await _courseService.SaveSectionAsync(selectedSection);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to save section: {result.Error}");
            isSavingSection = false;
            return;
        }

        _toastService.ShowSuccess("Section saved.");
        await LoadCourseAsync();
        selectedSection = course!.Sections.FirstOrDefault(x => x.Id == result.Data.Id) is { } saved ? CloneSection(saved) :
null;
        loadedSectionEditorId = null;
        isSavingSection = false;
    }

    private async Task DeleteSelectedSectionAsync()
    {
        if (selectedSection is null || selectedSection.Id == Guid.Empty)
        {
            return;
        }

        DialogResult confirmResult = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.DisplayName), selectedSection.Title);
        });

        if (confirmResult.Cancelled)
        {
            return;
        }

        Result<bool> result = await _courseService.DeleteSectionAsync(selectedSection.Id);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to delete section: {result.Error}");
            return;
        }

        _toastService.ShowSuccess("Section deleted.");
        selectedSection = null;
        loadedSectionEditorId = null;
        await LoadCourseAsync();
    }

    private void SelectQuestion(CourseQuestion question)
    {
        selectedSection = null;
        loadedSectionEditorId = null;
        selectedQuestion = CloneQuestion(question);
    }

    private void StartNewQuestion()
    {
        selectedSection = null;
        loadedSectionEditorId = null;

        selectedQuestion = new CourseQuestion
        {
            Id = Guid.Empty,
            CourseId = CourseId,
            QuestionText = "New question",
            Options =
            [
                new CourseQuestionOption { Id = Guid.NewGuid(), QuestionId = Guid.Empty, OptionText = "Correct answer", IsCorrect = true
},
                new CourseQuestionOption { Id = Guid.NewGuid(), QuestionId = Guid.Empty, OptionText = "Wrong answer", IsCorrect = false
}
            ]
        };
    }

    private void AddOption()
    {
        selectedQuestion?.Options.Add(new CourseQuestionOption
        {
            Id = Guid.NewGuid(),
            QuestionId = selectedQuestion.Id,
            OptionText = string.Empty,
            IsCorrect = false
        });
    }

    private void RemoveOption(CourseQuestionOption option)
    {
        selectedQuestion?.Options.Remove(option);
    }

    private async Task SaveSelectedQuestionAsync()
    {
        if (selectedQuestion is null)
        {
            return;
        }

        isSavingQuestion = true;

        for (int i = 0; i < selectedQuestion.Options.Count; i++)
        {
            selectedQuestion.Options[i].SortOrder = i;
        }

        Result<CourseQuestion> result = await _courseService.SaveQuestionAsync(selectedQuestion);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to save question: {result.Error}");
            isSavingQuestion = false;
            return;
        }

        _toastService.ShowSuccess("Question saved.");
        await LoadCourseAsync();
        selectedQuestion = course!.Questions.FirstOrDefault(x => x.Id == result.Data.Id) is { } saved ? CloneQuestion(saved) :
null;
        isSavingQuestion = false;
    }

    private async Task DeleteSelectedQuestionAsync()
    {
        if (selectedQuestion is null || selectedQuestion.Id == Guid.Empty)
        {
            return;
        }

        DialogResult confirmResult = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.DisplayName), selectedQuestion.QuestionText);
        });

        if (confirmResult.Cancelled)
        {
            return;
        }

        Result<bool> result = await _courseService.DeleteQuestionAsync(selectedQuestion.Id);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to delete question: {result.Error}");
            return;
        }

        _toastService.ShowSuccess("Question deleted.");
        selectedQuestion = null;
        await LoadCourseAsync();
    }

    private static CourseSection CloneSection(CourseSection section)
    {
        return new CourseSection
        {
            Id = section.Id,
            CourseId = section.CourseId,
            Title = section.Title,
            BodyHtml = section.BodyHtml,
            SortOrder = section.SortOrder,
            IsActive = section.IsActive
        };
    }

    private static CourseQuestion CloneQuestion(CourseQuestion question)
    {
        return new CourseQuestion
        {
            Id = question.Id,
            CourseId = question.CourseId,
            QuestionText = question.QuestionText,
            SortOrder = question.SortOrder,
            IsActive = question.IsActive,
            Options = [.. question.Options.Select(x => new CourseQuestionOption
            {
                Id = x.Id,
                QuestionId = x.QuestionId,
                OptionText = x.OptionText,
                IsCorrect = x.IsCorrect,
                SortOrder = x.SortOrder,
                IsActive = x.IsActive
            })]
        };
    }
}
