@page "/manage/training/help"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.App.Components.Manager.Training.Help

<PageTitle>Training Help</PageTitle>

<FluentCard Height="auto">
    <FluentText As="TextTag.H4" Size="TextSize.Size500">Training Help</FluentText>

    <FluentTabs @bind-ActiveTabId="activeTabId" Orientation="Orientation.Horizontal" Size="TabsSize.Medium">
        <FluentTab Id="help-overview" Header="Overview" IconStart="@(new Icons.Regular.Size16.Info())">
            <OverviewHelpTab />
        </FluentTab>
        <FluentTab Id="help-courses" Header="Creating Courses" IconStart="@(new Icons.Regular.Size16.Board())" DeferredLoading="true">
            <CreatingCoursesHelpTab />
        </FluentTab>
        <FluentTab Id="help-assigning" Header="Assigning Training" IconStart="@(new Icons.Regular.Size16.PersonAdd())" DeferredLoading="true">
            <AssigningTrainingHelpTab />
        </FluentTab>
        <FluentTab Id="help-reports" Header="Tracking Completion" IconStart="@(new Icons.Regular.Size16.ChartMultiple())" DeferredLoading="true">
            <TrackingCompletionHelpTab />
        </FluentTab>
        <FluentTab Id="help-locations" Header="Multi-Location Rules" IconStart="@(new Icons.Regular.Size16.Location())" DeferredLoading="true">
            <MultiLocationHelpTab />
        </FluentTab>
    </FluentTabs>
</FluentCard>

@code {
    [SupplyParameterFromQuery(Name = "topic")]
    public string? Topic { get; set; }

    private string? activeTabId;

    protected override void OnParametersSet()
    {
        // Only seed from the query string once - after that, tab clicks own this field via
        // @bind-ActiveTabId, and re-applying Topic on every render would snap the tab back.
        activeTabId ??= Topic switch
        {
            "courses" => "help-courses",
            "assigning" => "help-assigning",
            "reports" => "help-reports",
            "locations" => "help-locations",
            _ => "help-overview"
        };
    }
}
