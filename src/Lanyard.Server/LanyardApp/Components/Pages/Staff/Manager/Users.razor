@page "/manage/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]
@using Lanyard.App.Components.Manager
@using Lanyard.Application.Services.Authentication

<PageTitle>User Management</PageTitle>

<FluentCard Height="auto">
    <FluentStack Orientation="Orientation.Horizontal" class="w-100" id="toolbar-fluent-components">
        <FluentText As="@TextTag.H3">Users</FluentText>

        <FluentStack Margin="@Margin.StartAuto" Width="auto" HorizontalGap="6"
                     VerticalAlignment="@VerticalAlignment.Center">
            <FluentTextInput Placeholder="Search..." AutoComplete="off" @bind-Value="@searchValue" Immediate="true"
                             @bind-Value:after=HandleSearchInput />

            <FluentButton Appearance="ButtonAppearance.Outline" IconEnd="new Icons.Regular.Size20.PersonAdd()"
                          OnClick="OpenRegisterUserDialog">Register a New User
            </FluentButton>
        </FluentStack>
    </FluentStack>

    <div class="users-grid-wrapper">
        <FluentDataGrid Pagination="@pagination" ShowHover="true" TGridItem="UserProfile"
                        Items="@filteredUsers.AsQueryable()" GridTemplateColumns="1fr 1.2fr 1.2fr 1fr"
                        OnRowClick="@((row) => OpenUserActionsDialog(row.Item!))"
                        Style="width: 100%;" Class="users-grid">
            <EmptyContent>
                No Users Found
            </EmptyContent>
            <ChildContent>
                <PropertyColumn Property="@(r => r.UserName ?? string.Empty)" Title="Username" Sortable="true"
                                Class="users-col-username" />
                <PropertyColumn Property="@(r => r.GetName() ?? string.Empty)" Title="Name" Sortable="true"
                                IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(r => r.Email ?? "Not Set")" Title="Email Address" Sortable="true"
                                Class="users-col-email" />
                <PropertyColumn Property="@(r => IsLockedOut(r) ? "Locked" : r.PasswordSetDate == null ? "Invite Pending" : "Active")"
                                Title="Status" Sortable="true" />
            </ChildContent>
        </FluentDataGrid>
    </div>

    <FluentPaginator State="@pagination" />
</FluentCard>

@code {
    private IEnumerable<UserProfile> users = Enumerable.Empty<UserProfile>();
    private IEnumerable<UserProfile> filteredUsers = Enumerable.Empty<UserProfile>();
    private string? searchValue = string.Empty;

    // Held as a field rather than constructed inline in the markup - the search box re-renders the
    // grid on every keystroke, and a new PaginationState each render resets the page the user is on.
    private readonly PaginationState pagination = new() { ItemsPerPage = 15 };

    protected async override Task OnInitializedAsync()
    {
        await GetUsers();
    }

    private async Task GetUsers()
    {
        users = await _securityService.GetActiveUsersAsync();

        ApplyFilter();
    }

    // Bound to the search box. A new search changes how many pages there are, so whatever page the
    // user was on no longer means anything - go back to the first. GetUsers() deliberately does not
    // do this: refreshing after an edit or a delete should leave the user where they were.
    private async Task HandleSearchInput()
    {
        ApplyFilter();

        await pagination.SetCurrentPageIndexAsync(0);
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchValue))
        {
            searchValue = string.Empty;
            filteredUsers = users;
        }
        else
        {
            string term = searchValue.Trim().ToLower();

            filteredUsers = users
                .Where(u =>
                    string.Join(" ",
                        u.GetName(),
                        u.Email
                    ).ToLower().Contains(term)
                )
                .ToList();
        }

        StateHasChanged();
    }

    private async Task OpenRegisterUserDialog()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<RegisterUserDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
        });

        if (result.Value is true)
        {
            await GetUsers();
        }
    }

    // The dialog performs its own actions (edit, password, unlock, delete, etc.) directly against
    // the services - it doesn't report back what happened, so just refresh unconditionally once
    // it's closed. Cheap query, and covers every action a tab could have taken.
    private async Task OpenUserActionsDialog(UserProfile user)
    {
        await _dialogService.ShowDialogAsync<UserActionsDialog>(options =>
        {
            options.Header.Title = user.GetName();
            options.Width = "min(520px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(UserActionsDialog.Content), user);
        });

        await GetUsers();
    }

    // LockoutEnabled must also be true to match ASP.NET Identity's own IsLockedOutAsync check -
    // an account with lockout disabled can still carry a stale LockoutEnd from before it was
    // disabled, and would otherwise show as "Locked" without actually being blocked from signing in.
    private static bool IsLockedOut(UserProfile user) =>
        user.LockoutEnabled && user.LockoutEnd is DateTimeOffset end && end > DateTimeOffset.UtcNow;
}