@page "/manage/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]
@using Lanyard.App.Components.Accounts
@using Lanyard.App.Components.Manager
@using Lanyard.Application.Services.Authentication
@using Lanyard.Application.Services.Gdpr

@inject INotificationService ToastService
@inject IGdprService _gdprService

<PageTitle>User Management</PageTitle>

<FluentCard Height="auto">
    <FluentStack Orientation="Orientation.Horizontal" class="w-100" id="toolbar-fluent-components">
        <FluentText As="@TextTag.H3">Users</FluentText>

        <FluentStack Margin="@Margin.StartAuto" Width="auto" HorizontalGap="6"
                     VerticalAlignment="@VerticalAlignment.Center">
            <FluentTextInput Placeholder="Search..." AutoComplete="off" @bind-Value="@searchValue" Immediate="true"
                             @bind-Value:after=HandleSearchInput />

            <FluentButton Appearance="ButtonAppearance.Outline" IconEnd="new Icons.Regular.Size20.PersonAdd()"
                          OnClick="OpenRegisterUserDialog">Register a New User
            </FluentButton>
        </FluentStack>
    </FluentStack>

    <FluentDataGrid Pagination="@pagination"
                    Items="@filteredUsers.AsQueryable()" GridTemplateColumns="1fr 1fr 1fr 1fr 1fr"
                    Style="width: 100%;">
        <EmptyContent>
            No Users Found
        </EmptyContent>
        <ChildContent>
            <PropertyColumn Property="@(r => r.UserName ?? string.Empty)" Title="Username" Sortable="true" />
            <PropertyColumn Property="@(r => r.GetName() ?? string.Empty)" Title="Name" Sortable="true"
                            IsDefaultSortColumn="true" />
            <PropertyColumn Property="@(r => r.Email ?? "Not Set")" Title="Email Address" Sortable="true" />
            <PropertyColumn Property="@(r => IsLockedOut(r) ? "Locked" : r.PasswordSetDate == null ? "Invite Pending" : "Active")"
                            Title="Status" Sortable="true" />
            <TemplateColumn Title="Actions">
                <div class="d-flex align-items-center">
                    <FluentIcon Icon="Icons.Regular.Size20.Edit" Color="Color.Primary"
                                OnClick="@(() => OpenEditUserDialog(context))" title="Edit User" />
                    <FluentIcon Icon="Icons.Regular.Size20.Delete" Color="Color.Error"
                                OnClick="@(() => ConfirmDeleteUser(context))" />
                    <FluentIcon Icon="Icons.Regular.Size20.Key" Color="Color.Primary"
                                OnClick="@(() => OpenChangePasswordDialog(context))" />
                    <FluentIcon Icon="Icons.Regular.Size20.MailArrowClockwise" Color="Color.Primary"
                                OnClick="@(() => SendSetPasswordLink(context))"
                                title="@(context.PasswordSetDate is null ? "Resend Invite" : "Send Password Reset Email")" />
                    @if (IsLockedOut(context))
                    {
                        <FluentIcon Icon="Icons.Regular.Size20.LockOpen" Color="Color.Warning"
                                    OnClick="@(() => UnlockUser(context))" title="Unlock Account" />
                    }
                    <AuthorizeView Roles="Admin" Context="authContext">
                        <Authorized>
                            <FluentIcon Icon="Icons.Regular.Size20.PersonDelete" Color="Color.Error"
                                        OnClick="@(() => ConfirmGdprEraseUser(context))" title="Delete User Data (GDPR)" />
                        </Authorized>
                    </AuthorizeView>
                </div>
            </TemplateColumn>
        </ChildContent>
    </FluentDataGrid>

    <FluentPaginator State="@pagination" />
</FluentCard>

@code {
    private IEnumerable<UserProfile> users = Enumerable.Empty<UserProfile>();
    private IEnumerable<UserProfile> filteredUsers = Enumerable.Empty<UserProfile>();
    private string? searchValue = string.Empty;

    // Held as a field rather than constructed inline in the markup - the search box re-renders the
    // grid on every keystroke, and a new PaginationState each render resets the page the user is on.
    private readonly PaginationState pagination = new() { ItemsPerPage = 15 };

    protected async override Task OnInitializedAsync()
    {
        await GetUsers();
    }

    private async Task GetUsers()
    {
        users = await _securityService.GetActiveUsersAsync();

        ApplyFilter();
    }

    // Bound to the search box. A new search changes how many pages there are, so whatever page the
    // user was on no longer means anything - go back to the first. GetUsers() deliberately does not
    // do this: refreshing after an edit or a delete should leave the user where they were.
    private async Task HandleSearchInput()
    {
        ApplyFilter();

        await pagination.SetCurrentPageIndexAsync(0);
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchValue))
        {
            searchValue = string.Empty;
            filteredUsers = users;
        }
        else
        {
            string term = searchValue.Trim().ToLower();

            filteredUsers = users
                .Where(u =>
                    string.Join(" ",
                        u.GetName(),
                        u.Email
                    ).ToLower().Contains(term)
                )
                .ToList();
        }

        StateHasChanged();
    }

    private async Task OpenRegisterUserDialog()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<RegisterUserDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
        });

        if (result.Value is true)
        {
            await GetUsers();
        }
    }

    private async Task ConfirmDeleteUser(UserProfile user)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Content), user);
        });

        if (!result.Cancelled)
        {
            await _securityService.DeleteUserAsync(user.Id);
            await GetUsers();
        }
    }

    private async Task ConfirmGdprEraseUser(UserProfile user)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Erase User Data (GDPR)";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Content), user);
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Message),
                $"This will permanently remove {user.GetName()}'s personal data and delete their account. " +
                "Content they authored will be kept but no longer attributed to them. This cannot be undone.");
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.ConfirmLabel), "Erase Data");
        });

        if (!result.Cancelled)
        {
            Result<bool> eraseResult = await _gdprService.EraseUserDataAsync(user.Id);

            if (!eraseResult.IsSuccess)
            {
                ToastService.ShowError(eraseResult.Error ?? "Failed to erase user data.");
            }

            await GetUsers();
        }
    }

    private async Task OpenEditUserDialog(UserProfile user)
    {
        if (user is null)
        {
            ToastService.ShowError("Unable to load user profile.");
            return;
        }

        DialogResult result = await _dialogService.ShowDialogAsync<EditUserDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(EditUserDialog.Content), user);
        });

        if (result.Value is true)
        {
            await GetUsers();
        }
    }

    private async Task OpenChangePasswordDialog(UserProfile user)
    {
        if (user is null)
        {
            ToastService.ShowError("Unable to load user profile.");
            return;
        }

        await _dialogService.ShowDialogAsync<ChangePasswordDialog>(options =>
        {
            options.Header.Title = "Change Password";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ChangePasswordDialog.Content), user);
        });
    }

    // LockoutEnabled must also be true to match ASP.NET Identity's own IsLockedOutAsync check -
    // an account with lockout disabled can still carry a stale LockoutEnd from before it was
    // disabled, and would otherwise show as "Locked" without actually being blocked from signing in.
    private static bool IsLockedOut(UserProfile user) =>
        user.LockoutEnabled && user.LockoutEnd is DateTimeOffset end && end > DateTimeOffset.UtcNow;

    private async Task UnlockUser(UserProfile user)
    {
        Result<bool> result = await _securityService.UnlockUserAsync(user.Id);

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess($"{user.GetName()}'s account has been unlocked.");
        }
        else
        {
            ToastService.ShowError(result.Error ?? "Failed to unlock account.");
        }

        await GetUsers();
    }

    private async Task SendSetPasswordLink(UserProfile user)
    {
        bool wasPending = user.PasswordSetDate is null;
        Result<bool> result = await _securityService.SendSetPasswordLinkAsync(user.Id);

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(wasPending
                ? $"Invite resent to {user.Email}."
                : $"Password reset email sent to {user.Email}.");
        }
        else
        {
            ToastService.ShowError($"Failed to send email: {result.Error}");
        }

        await GetUsers();
    }
}