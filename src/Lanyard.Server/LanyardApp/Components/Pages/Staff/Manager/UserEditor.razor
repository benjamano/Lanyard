@page "/manage/users/{UserId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]

@using System.ComponentModel.DataAnnotations
@using Lanyard.Application.Services.Authentication
@using Lanyard.Application.Services.Gdpr
@using Lanyard.Application.Services.StaffDocuments
@using Lanyard.Application.Services.Locations
@using Lanyard.App.Components.Manager
@using Lanyard.App.Components.Rota

@inject IGdprService _gdprService
@inject INotificationService ToastService
@inject IStaffDocumentService _staffDocumentService
@inject IStaffDocumentTypeService _staffDocumentTypeService

<PageTitle>@(user?.GetName() ?? "User")</PageTitle>

@if (isLoadingUser)
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
        <FluentSpinner />
    </FluentStack>
}
else if (user is null)
{
    <FluentCard Height="auto">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                @(loadError ?? "That user could not be found.")
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                          OnClick="@(() => _navigationManager.NavigateTo("/manage/users"))">
                Back to Users
            </FluentButton>
        </FluentStack>
    </FluentCard>
}
else
{
    <div class="user-editor-page">
    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                  Class="mb-2" OnClick="@(() => _navigationManager.NavigateTo("/manage/users"))">
        Back to Users
    </FluentButton>

    <FluentCard Height="auto" Class="user-editor-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Class="mb-3">
            <FluentText As="@TextTag.H3">@user.GetName()</FluentText>
            <FluentText Style="color: var(--neutral-foreground-hint);">
                @(user.Email ?? "No email set") &bull; @StatusText
            </FluentText>
        </FluentStack>

        <FluentTabs>
            <FluentTab Header="Details" IconStart="new Icons.Regular.Size20.Edit()">
                <EditForm EditContext="@_detailsEditContext" OnValidSubmit="HandleSaveDetails">
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6" Class="user-editor-tab-content">
                        <FluentTextInput @bind-Value="detailsModel.FirstName" Label="First Name" Required="true"
                                         Message="@_detailsEditContext.GetValidationMessage(() => detailsModel.FirstName)"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                        </FluentTextInput>
                        <FluentTextInput @bind-Value="detailsModel.LastName" Label="Last Name" Required="true"
                                         Message="@_detailsEditContext.GetValidationMessage(() => detailsModel.LastName)"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                        </FluentTextInput>
                        <FluentTextInput @bind-Value="detailsModel.PhoneNumber" Label="Phone Number"
                                         TextInputType="TextInputType.Telephone"
                                         Message="@_detailsEditContext.GetValidationMessage(() => detailsModel.PhoneNumber)"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Phone())" Slot="start" />
                        </FluentTextInput>

                        <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                      Disabled="@isSavingDetails" IconStart="@(new Icons.Regular.Size20.Save())">
                            @(isSavingDetails ? "Saving..." : "Save")
                        </FluentButton>
                    </FluentStack>
                </EditForm>
            </FluentTab>

            <FluentTab Header="Password" IconStart="new Icons.Regular.Size20.Key()">
                <EditForm Model="@passwordModel" OnValidSubmit="HandleChangePassword">
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6" Class="user-editor-tab-content">
                        <FluentTextInput @bind-Value="passwordModel.NewPassword" Label="New Password" Required="true"
                                         TextInputType="TextInputType.Password"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Slot="start" />
                        </FluentTextInput>
                        <FluentTextInput @bind-Value="passwordModel.ConfirmPassword" Label="Confirm Password" Required="true"
                                         TextInputType="TextInputType.Password"
                                         MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Slot="start" />
                        </FluentTextInput>

                        <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                      Disabled="@isChangingPassword" IconStart="@(new Icons.Regular.Size20.Key())">
                            @(isChangingPassword ? "Changing..." : "Change Password")
                        </FluentButton>
                    </FluentStack>
                </EditForm>
            </FluentTab>

            <FluentTab Header="Account" IconStart="new Icons.Regular.Size20.PersonSettings()">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Class="user-editor-tab-content">
                    <FluentText>Status: <strong>@StatusText</strong></FluentText>

                    @if (IsLockedOut)
                    {
                        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="new Icons.Regular.Size20.LockOpen()"
                                      Disabled="@isUnlocking" OnClick="@UnlockAsync">
                            @(isUnlocking ? "Unlocking..." : "Unlock Account")
                        </FluentButton>
                    }

                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="new Icons.Regular.Size20.MailArrowClockwise()"
                                  Disabled="@isSendingEmail" OnClick="@SendSetPasswordLinkAsync">
                        @(isSendingEmail ? "Sending..." : (user.PasswordSetDate is null ? "Resend Invite" : "Send Password Reset Email"))
                    </FluentButton>
                </FluentStack>
            </FluentTab>

            <FluentTab Header="Documents" IconStart="new Icons.Regular.Size20.DocumentBulletList()">
                <div class="documents-tab-content">
                    @if (isLoadingDocuments)
                    {
                        <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                            <FluentSpinner />
                            <FluentText>Loading...</FluentText>
                        </FluentStack>
                    }
                    else if (documentTypes is null || documentTypes.Count == 0)
                    {
                        <FluentText Style="color: var(--neutral-foreground-hint);">
                            No document types have been configured yet. An admin or manager can add some under
                            Manage &gt; Staff Document Types.
                        </FluentText>
                    }
                    else
                    {
                        @if (staffDocuments is null || staffDocuments.Count == 0)
                        {
                            <FluentText Style="color: var(--neutral-foreground-hint);">No documents uploaded yet.</FluentText>
                        }
                        else
                        {
                            <div class="documents-list">
                                @foreach (StaffDocument doc in staffDocuments)
                                {
                                    <div class="documents-list-item">
                                        <div class="documents-list-info">
                                            <div class="documents-list-name">@doc.StaffDocumentType!.Name</div>
                                            <div class="documents-list-meta">
                                                Uploaded @doc.UploadedDate.ToString("d MMM yyyy")
                                                @if (doc.ExpiryDate is not null)
                                                {
                                                    <span> &middot; Expires @doc.ExpiryDate.Value.Date.ToString("d MMM yyyy")</span>
                                                }
                                                @if (doc.ReminderDate is not null)
                                                {
                                                    <span> &middot; Reminder @doc.ReminderDate.Value.Date.ToString("d MMM yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="documents-list-actions">
                                            <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Title="Download"
                                                          OnClick="@(() => DownloadDocument(doc.FileMetadataId))" />
                                            <FluentButton IconStart="@(new Icons.Regular.Size16.Delete())" Title="Delete"
                                                          OnClick="@(() => DeleteDocumentAsync(doc.Id))" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowUpload())"
                                      OnClick="OpenUploadDialog">
                            Upload Document
                        </FluentButton>
                    }
                </div>
            </FluentTab>

            <FluentTab Header="Rota" IconStart="new Icons.Regular.Size20.CalendarLtr()">
                <div class="rota-tab-content">
                    @if (isLoadingDocuments)
                    {
                        <FluentSpinner />
                    }
                    else
                    {
                        <UserRotaProfileTab UserId="@user.Id" CompanyId="@userCompanyId" />
                    }
                </div>
            </FluentTab>

            <FluentTab Header="Danger Zone" IconStart="new Icons.Regular.Size20.ShieldError()">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Class="user-editor-tab-content">
                    <AuthorizeView Roles="Admin" Context="authContext">
                        <Authorized>
                            <FluentButton Appearance="ButtonAppearance.Outline" Color="Color.Error"
                                          IconStart="new Icons.Regular.Size20.PersonDelete()"
                                          Disabled="@isErasing" OnClick="@ConfirmGdprEraseAsync">
                                @(isErasing ? "Erasing..." : "Delete User Data (GDPR)")
                            </FluentButton>
                        </Authorized>
                    </AuthorizeView>

                    <FluentButton Appearance="ButtonAppearance.Outline" Color="Color.Error"
                                  IconStart="new Icons.Regular.Size20.Delete()"
                                  Disabled="@isDeleting" OnClick="@ConfirmDeleteAsync">
                        @(isDeleting ? "Deleting..." : "Delete User")
                    </FluentButton>
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    </FluentCard>
    </div>
}

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private UserProfile? user;
    private bool isLoadingUser = true;
    private string? loadError;

    private DetailsModel detailsModel = new();
    private EditContext _detailsEditContext = default!;
    private PasswordModel passwordModel = new();

    private bool isSavingDetails;
    private bool isChangingPassword;
    private bool isUnlocking;
    private bool isSendingEmail;
    private bool isErasing;
    private bool isDeleting;

    private bool isLoadingDocuments = true;
    private int? userCompanyId;
    private List<StaffDocumentType>? documentTypes;
    private List<StaffDocument>? staffDocuments;

    // LockoutEnabled must also be true to match ASP.NET Identity's own IsLockedOutAsync check -
    // an account with lockout disabled can still carry a stale LockoutEnd from before it was
    // disabled, and would otherwise show as "Locked" without actually being blocked from signing in.
    private bool IsLockedOut =>
        user is not null && user.LockoutEnabled && user.LockoutEnd is DateTimeOffset end && end > DateTimeOffset.UtcNow;

    private string StatusText =>
        IsLockedOut ? "Locked" : user?.PasswordSetDate is null ? "Invite Pending" : "Active";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();

        if (user is not null)
        {
            await LoadDocumentsAsync();
        }
    }

    private async Task LoadUserAsync()
    {
        isLoadingUser = true;

        Result<UserProfile> result = await _securityService.GetUserByIdAsync(UserId);

        if (!result.IsSuccess || result.Data is null)
        {
            loadError = result.Error;
            user = null;
            isLoadingUser = false;
            return;
        }

        user = result.Data;

        detailsModel.FirstName = user.FirstName ?? string.Empty;
        detailsModel.LastName = user.LastName ?? string.Empty;
        detailsModel.PhoneNumber = user.PhoneNumber;

        _detailsEditContext = new EditContext(detailsModel);

        isLoadingUser = false;
    }

    private async Task LoadDocumentsAsync()
    {
        if (user is null)
        {
            isLoadingDocuments = false;
            return;
        }

        isLoadingDocuments = true;

        Result<CompanyBrandingInfo> brandingResult = await _companyLocationService.GetCompanyBrandingForUserAsync(user.Id);

        // Also feeds the Rota tab - a user in no company (or two) has no single company to
        // resolve positions, contracts and allowances against.
        userCompanyId = brandingResult.IsSuccess ? brandingResult.Data?.CompanyId : null;

        if (!brandingResult.IsSuccess || brandingResult.Data is null)
        {
            documentTypes = [];
            isLoadingDocuments = false;
            return;
        }

        Result<List<StaffDocumentType>> typesResult = await _staffDocumentTypeService.GetDocumentTypesAsync(brandingResult.Data.CompanyId);
        Result<List<StaffDocument>> documentsResult = await _staffDocumentService.GetStaffDocumentsForUserAsync(user.Id);

        documentTypes = typesResult.IsSuccess ? typesResult.Data : [];
        staffDocuments = documentsResult.IsSuccess ? documentsResult.Data : [];

        isLoadingDocuments = false;
    }

    private async Task OpenUploadDialog()
    {
        if (user is null || documentTypes is null)
        {
            return;
        }

        DialogResult result = await _dialogService.ShowDialogAsync<UploadStaffDocumentDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(UploadStaffDocumentDialog.UserId), user.Id);
            options.Parameters.Add(nameof(UploadStaffDocumentDialog.DocumentTypes), documentTypes);
        });

        if (result.Value is true)
        {
            await LoadDocumentsAsync();
        }
    }

    private void DownloadDocument(Guid fileMetadataId)
    {
        _navigationManager.NavigateTo($"api/Files/download/{fileMetadataId}", forceLoad: true);
    }

    private async Task DeleteDocumentAsync(Guid staffDocumentId)
    {
        Result<bool> result = await _staffDocumentService.DeleteStaffDocumentAsync(staffDocumentId, CancellationToken.None);

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to delete document: {result.Error}");
            return;
        }

        ToastService.ShowSuccess("Document deleted.");
        await LoadDocumentsAsync();
    }

    private async Task HandleSaveDetails()
    {
        if (user is null)
        {
            return;
        }

        isSavingDetails = true;

        try
        {
            user.FirstName = detailsModel.FirstName;
            user.LastName = detailsModel.LastName;
            user.PhoneNumber = detailsModel.PhoneNumber;

            await _securityService.UpdateUserProfileAsync(user);

            ToastService.ShowSuccess("User details updated!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating user: {ex.Message}");
        }
        finally
        {
            isSavingDetails = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (user is null)
        {
            return;
        }

        isChangingPassword = true;

        try
        {
            Result<bool> result = await _securityService.ChangePasswordAsync(user.Id, passwordModel.NewPassword);

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess($"Password changed successfully for '{user.GetName()}'!");
                passwordModel = new();
            }
            else
            {
                ToastService.ShowError($"Failed to change password: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error changing password: {ex.Message}");
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private async Task UnlockAsync()
    {
        if (user is null)
        {
            return;
        }

        isUnlocking = true;

        Result<bool> result = await _securityService.UnlockUserAsync(user.Id);

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess($"{user.GetName()}'s account has been unlocked.");
            user.LockoutEnd = DateTimeOffset.UtcNow.AddSeconds(-1);
        }
        else
        {
            ToastService.ShowError(result.Error ?? "Failed to unlock account.");
        }

        isUnlocking = false;
    }

    private async Task SendSetPasswordLinkAsync()
    {
        if (user is null)
        {
            return;
        }

        isSendingEmail = true;

        bool wasPending = user.PasswordSetDate is null;
        Result<bool> result = await _securityService.SendSetPasswordLinkAsync(user.Id);

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(wasPending
                ? $"Invite resent to {user.Email}."
                : $"Password reset email sent to {user.Email}.");
        }
        else
        {
            ToastService.ShowError($"Failed to send email: {result.Error}");
        }

        isSendingEmail = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (user is null)
        {
            return;
        }

        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Are you sure?";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Content), user);
        });

        if (result.Cancelled)
        {
            return;
        }

        isDeleting = true;

        await _securityService.DeleteUserAsync(user.Id);

        _navigationManager.NavigateTo("/manage/users");
    }

    private async Task ConfirmGdprEraseAsync()
    {
        if (user is null)
        {
            return;
        }

        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Erase User Data (GDPR)";
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Content), user);
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Message),
                $"This will permanently remove {user.GetName()}'s personal data and delete their account. " +
                "Content they authored will be kept but no longer attributed to them. This cannot be undone.");
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.ConfirmLabel), "Erase Data");
        });

        if (result.Cancelled)
        {
            return;
        }

        isErasing = true;

        Result<bool> eraseResult = await _gdprService.EraseUserDataAsync(user.Id);

        if (!eraseResult.IsSuccess)
        {
            ToastService.ShowError(eraseResult.Error ?? "Failed to erase user data.");
            isErasing = false;
            return;
        }

        _navigationManager.NavigateTo("/manage/users");
    }

    private class DetailsModel
    {
        [Required(ErrorMessage = "First Name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last Name is required.")]
        public string LastName { get; set; } = string.Empty;

        [Phone(ErrorMessage = "Invalid phone number.")]
        public string? PhoneNumber { get; set; }
    }

    private class PasswordModel
    {
        [Required(ErrorMessage = "New password is required.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm password is required.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
