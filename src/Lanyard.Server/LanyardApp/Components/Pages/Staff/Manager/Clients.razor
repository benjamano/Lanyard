@page "/manage/clients"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Lanyard.App.Components.Manager
@using Lanyard.Application.Services.ClientReleases
@using Lanyard.App.Components.Clients
@using Lanyard.Application.Services.Clients
@using Lanyard.Shared.Contracts
@using Lanyard.Shared.Enum
@using Lanyard.Infrastructure.Enum
@using Lanyard.Application.Services.Tenancy
@using System.Globalization

@implements IAsyncDisposable

@inject IClientService _clientService
@inject IKioskClientListService _kioskClientList
@inject IKioskFleetEventBus _fleetEvents
@inject ITenantContext _tenantContext
@inject IJSRuntime _js
@inject IClientUpdatePolicyService _updatePolicyService
@inject IKioskHealthService _kioskHealthService
@inject INotificationService _toastService

<PageTitle>Clients</PageTitle>

<FluentCard Height="auto">
    <div class="clients-header">
        <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">
            Clients
        </FluentText>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="OpenPairKioskDialogAsync">Add kiosk</FluentButton>
    </div>
    @if (_versionCounts.Count > 0)
    {
        <div class="clients-version-summary">
            <span class="clients-muted">Kiosk versions</span>
            <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8px" VerticalGap="8px">
                @foreach (ClientVersionCount versionCount in _versionCounts)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint"
                                 Color="@(versionCount.Version is null ? BadgeColor.Subtle : BadgeColor.Informative)"
                                 Title="@($"{versionCount.Count} {(versionCount.Count == 1 ? "PC" : "PCs")} on {VersionLabel(versionCount.Version)}")">
                        @VersionLabel(versionCount.Version) · @versionCount.Count
                    </FluentBadge>
                }
            </FluentStack>
        </div>
    }
    @if (_legacySecretCount > 0 || _credentialCount > 0)
    {
        <div class="clients-version-summary">
            <span class="clients-muted">Kiosk sign-in</span>
            <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8px" VerticalGap="8px">
                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success"
                             Title="Kiosks that signed in with their own credential last time they connected">
                    Own credential · @_credentialCount
                </FluentBadge>
                @if (_legacySecretCount > 0)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning"
                                 Title="@SharedSecretTooltip">
                        Shared secret · @_legacySecretCount
                    </FluentBadge>
                }
            </FluentStack>
        </div>
    }
    <div class="clients-grid-wrapper" @ref="_gridWrapper">
        <FluentDataGrid ShowHover="true" Items="@_sortedClients" GridTemplateColumns="minmax(0, 0.6fr) minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1.3fr) minmax(0, 1fr) minmax(125px, 1.1fr) minmax(0, 1.1fr) 224px" Class="clients-grid">
            <ChildContent>
                <PropertyColumn Property="x => x.Id" Title="Client ID" Class="clients-col-id"/>
                <TemplateColumn Title="Name" Sortable="true" SortBy="@_sortByName">
                    <div class="clients-name-cell">
                        <span class="clients-name-text">@context.Name</span>
                        @if (context.LastAuthMethod == ClientAuthMethod.LegacySecret)
                        {
                            <span class="clients-signin-warning" title="@SharedSecretTooltip" role="img" aria-label="Signs in with the shared secret">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Color="Color.Warning" />
                            </span>
                        }
                    </div>
                </TemplateColumn>
                <PropertyColumn Property="x => x.MostRecentIpAddress" Title="IP Address" Class="clients-col-ip"/>
                <TemplateColumn Title="Version" Class="clients-col-version">
                    <div class="clients-version-cell">
                        <span class="@(context.ReportedClientVersion is null ? "clients-muted" : null)"
                              title="@VersionTooltip(context)">
                            @VersionLabel(context.ReportedClientVersion)
                        </span>
                        <ClientUpdateRingBadges Target="@TargetFor(context.Id)" />
                    </div>
                </TemplateColumn>
                <PropertyColumn IsDefaultSortColumn="true" InitialSortDirection="DataGridSortDirection.Descending" Sortable="true"
                                Property="x => x.LastLogin" Title="Last Login" Class="clients-col-lastlogin" />
                <TemplateColumn Title="Capabilities" Class="clients-col-capabilities">
                    @if (context.ProjectionEnabled)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Filled" Class="me-1">Projection</FluentBadge>
                    }

                    @if (context.DmxEnabled)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Filled" Class="me-1">DMX</FluentBadge>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Health" Class="clients-col-health">
                    <KioskHealthBadge Health="@_health.GetValueOrDefault(context.Id)" IsConnected="@context.IsCurrentlyConnected" />
                </TemplateColumn>
                <TemplateColumn Title="Session Length" Class="clients-col-session">
                    <KioskSessionClock ConnectedSinceUtc="@(context.IsCurrentlyConnected ? context.LastLogin : null)" />
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <FluentStack HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
                        <FluentButton Appearance="ButtonAppearance.Transparent" Title="Settings"
                                      IconStart="@(new Icons.Regular.Size20.Settings())"
                                      OnClick="() => OpenClientSettingsDialog(context.Id)" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="@(context.IsCurrentlyConnected ? "Restart" : "Restart (client is offline)")"
                                      IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                                      Disabled="@(!context.IsCurrentlyConnected)"
                                      OnClick="() => OpenRestartClientDialogAsync(context)" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="@(context.IsCurrentlyConnected ? "Diagnostics" : "Diagnostics (client is offline)")"
                                      IconStart="@(new Icons.Regular.Size20.DocumentSearch())"
                                      Disabled="@(!context.IsCurrentlyConnected)"
                                      OnClick="() => OpenDiagnosticsDialogAsync(context)" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="@(context.IsCurrentlyConnected ? "Screens" : "Screens (client is offline)")"
                                      IconStart="@(new Icons.Regular.Size20.Desktop())"
                                      Disabled="@(!context.IsCurrentlyConnected)"
                                      OnClick="() => OpenScreensDialogAsync(context)" />
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      Title="@(context.IsCurrentlyConnected ? "Self-test" : "Self-test (client is offline)")"
                                      IconStart="@(new Icons.Regular.Size20.Stethoscope())"
                                      Disabled="@(!context.IsCurrentlyConnected)"
                                      OnClick="() => OpenSelfTestDialogAsync(context)" />
                    </FluentStack>
                </TemplateColumn>
            </ChildContent>
            <LoadingContent>
                Loading...
            </LoadingContent>
        </FluentDataGrid>
    </div>

    @* Phone width: a fixed-column grid truncates the name and can't fit the version, so each
       client becomes a row with its details wrapping underneath instead. *@
    <div class="clients-phone-list">
        @foreach (ClientConnectedWithCapabilitiesDTO client in _sortedClients)
        {
            <div class="clients-phone-item">
                <div class="clients-phone-info">
                    <div class="clients-phone-name">@client.Name</div>
                    <div class="clients-phone-meta">
                        <span class="@(client.ReportedClientVersion is null ? "clients-muted" : null)">@VersionLabel(client.ReportedClientVersion)</span>
                        <ClientUpdateRingBadges Target="@TargetFor(client.Id)" />
                        @if (client.LastAuthMethod == ClientAuthMethod.LegacySecret)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Title="@SharedSecretTooltip">Shared secret</FluentBadge>
                        }
                        <span>·</span>
                        <KioskHealthBadge Health="@_health.GetValueOrDefault(client.Id)" IsConnected="@client.IsCurrentlyConnected" />
                        @if (client.LastLogin is DateTime lastLogin)
                        {
                            <span>·</span>
                            <span>Last login @FormatUkDateTime(lastLogin)</span>
                        }
                    </div>
                    @if (client.ProjectionEnabled || client.DmxEnabled)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Class="mt-1">
                            @if (client.ProjectionEnabled)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Filled">Projection</FluentBadge>
                            }
                            @if (client.DmxEnabled)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Filled">DMX</FluentBadge>
                            }
                        </FluentStack>
                    }
                </div>
                <div class="clients-phone-actions">
                    <FluentButton Appearance="ButtonAppearance.Transparent" Title="Settings"
                                  IconStart="@(new Icons.Regular.Size20.Settings())"
                                  OnClick="() => OpenClientSettingsDialog(client.Id)" />
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  Title="@(client.IsCurrentlyConnected ? "Restart" : "Restart (client is offline)")"
                                  IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                                  Disabled="@(!client.IsCurrentlyConnected)"
                                  OnClick="() => OpenRestartClientDialogAsync(client)" />
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  Title="@(client.IsCurrentlyConnected ? "Diagnostics" : "Diagnostics (client is offline)")"
                                  IconStart="@(new Icons.Regular.Size20.DocumentSearch())"
                                  Disabled="@(!client.IsCurrentlyConnected)"
                                  OnClick="() => OpenDiagnosticsDialogAsync(client)" />
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  Title="@(client.IsCurrentlyConnected ? "Screens" : "Screens (client is offline)")"
                                  IconStart="@(new Icons.Regular.Size20.Desktop())"
                                  Disabled="@(!client.IsCurrentlyConnected)"
                                  OnClick="() => OpenScreensDialogAsync(client)" />
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  Title="@(client.IsCurrentlyConnected ? "Self-test" : "Self-test (client is offline)")"
                                  IconStart="@(new Icons.Regular.Size20.Stethoscope())"
                                  Disabled="@(!client.IsCurrentlyConnected)"
                                  OnClick="() => OpenSelfTestDialogAsync(client)" />
                </div>
            </div>
        }
    </div>
</FluentCard>

@code {
    private IEnumerable<ClientConnectedWithCapabilitiesDTO> clients = Array.Empty<ClientConnectedWithCapabilitiesDTO>();

    // Sorted once per load and only replaced when something visible changed: the grid treats a
    // new Items instance as new rows and refetches them.
    private IQueryable<ClientConnectedWithCapabilitiesDTO> _sortedClients = Enumerable.Empty<ClientConnectedWithCapabilitiesDTO>().AsQueryable();

    private Dictionary<Guid, KioskHealthView> _health = new();

    private sealed record ClientVersionCount(string? Version, int Count);

    private List<ClientVersionCount> _versionCounts = [];

    // How the kiosks signed in on their latest connection. Kiosks that haven't connected since
    // per-kiosk credentials shipped aren't counted either way.
    private int _credentialCount;
    private int _legacySecretCount;

    private static readonly GridSort<ClientConnectedWithCapabilitiesDTO> _sortByName = GridSort<ClientConnectedWithCapabilitiesDTO>.ByAscending(x => x.Name);

    // The shared secret isn't accepted any more, so these kiosks last connected before it was
    // switched off and can't connect again until they're paired.
    private const string SharedSecretTooltip = "Last signed in with the old shared kiosk secret, which no longer works. Pair it again with Add kiosk.";

    // Update ring and target per client. Empty (no badges) if releases couldn't be loaded, which
    // must not stop the rest of the page working.
    private IReadOnlyDictionary<Guid, ClientUpdateTargetDTO> _targets = new Dictionary<Guid, ClientUpdateTargetDTO>();

    // What's on screen, for telling whether a refresh changed anything. Null until the first load.
    private IReadOnlyList<ClientRowSignature>? _rows;

    // Targets cost a release catalogue read, so they're only asked for again when what decides
    // them changed, after this page's own dialogs, or at least this often for newly promoted
    // releases.
    private static readonly TimeSpan TargetsMaxAge = TimeSpan.FromMinutes(5);
    private IReadOnlyList<(Guid Id, string? ReportedVersion, ClientUpdateRing Ring, string? PinnedVersion)> _targetInputs = [];
    private DateTime? _targetsLoadedUtc;

    // Connects, disconnects and setting changes arrive on IKioskFleetEventBus straight away.
    // Health that only changes with time (a kiosk going quiet, then offline) has no event, so a
    // slow poll picks it up: heartbeats come every 30 s and the first threshold is 90 s.
    private static readonly TimeSpan FallbackRefreshInterval = TimeSpan.FromSeconds(30);

    // A burst of events (the whole fleet reconnecting after a server restart) becomes one reload.
    private const int EventCoalesceMs = 750;

    private int? _companyId;
    private PeriodicTimer? _fallbackTimer;
    private CancellationTokenSource? _fallbackCancellation;
    private RenderCoalescer? _eventRefresh;
    private bool _subscribed;
    private bool _disposed;

    // One refresh at a time; anything asked for meanwhile runs once when it finishes.
    private bool _refreshing;
    private bool _refreshPending;
    private bool _forcePending;

    private ElementReference _gridWrapper;
    private IJSObjectReference? _clockModule;

    protected override async Task OnInitializedAsync()
    {
        _companyId = _tenantContext.CompanyId;

        await RefreshAsync(showErrors: true, force: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Here rather than in OnInitializedAsync, so a prerender never starts any of it.
        _eventRefresh = new RenderCoalescer(() => RefreshInBackgroundAsync(), EventCoalesceMs);
        _fleetEvents.OnChanged += OnFleetChanged;
        _subscribed = true;

        _fallbackCancellation = new CancellationTokenSource();
        _fallbackTimer = new PeriodicTimer(FallbackRefreshInterval);
        _ = RunFallbackRefreshAsync(_fallbackTimer, _fallbackCancellation.Token);

        try
        {
            _clockModule = await _js.InvokeAsync<IJSObjectReference>("import", "./js/kioskSessionClock.js");
            await _clockModule.InvokeVoidAsync("start", _gridWrapper);
        }
        catch (JSDisconnectedException)
        {
            // The tab closed while the module loaded.
        }
    }

    private void OnFleetChanged(int companyId)
    {
        if (companyId == _companyId)
        {
            _eventRefresh?.Request();
        }
    }

    private async Task RunFallbackRefreshAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshInBackgroundAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page is disposed.
        }
    }

    // From the timer and the event bus: on the page's own thread, and quiet, since a failing
    // database would otherwise raise a toast every 30 s.
    private async Task RefreshInBackgroundAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() => RefreshAsync());
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away between the check and the call.
        }
    }

    // Always on the page's own thread (an event handler, a lifecycle method or InvokeAsync), so the
    // flags and fields below are never touched by two threads at once.
    private async Task RefreshAsync(bool showErrors = false, bool force = false)
    {
        if (_refreshing)
        {
            _refreshPending = true;
            _forcePending |= force;
            return;
        }

        _refreshing = true;

        try
        {
            bool changed = await LoadAsync(showErrors, force);

            while (_refreshPending && !_disposed)
            {
                bool forceAgain = _forcePending;
                _refreshPending = false;
                _forcePending = false;

                changed |= await LoadAsync(showErrors: false, forceAgain);
            }

            if (changed && !_disposed)
            {
                StateHasChanged();
            }
        }
        finally
        {
            _refreshing = false;
        }
    }

    // One kiosk list read (shared with other open pages), then health and, when due, targets
    // worked out from it. True when something on screen changed.
    private async Task<bool> LoadAsync(bool showErrors, bool force)
    {
        Result<IReadOnlyList<ClientConnectedWithCapabilitiesDTO>> result = await _kioskClientList.GetClientsAsync(forceRefresh: force);

        if (!result.IsSuccess)
        {
            if (showErrors)
            {
                _toastService.ShowError($"Failed to load connected clients, {result.Error}");
            }

            return false;
        }

        IReadOnlyList<ClientConnectedWithCapabilitiesDTO> loaded = result.Data!;

        Result<Dictionary<Guid, KioskHealthView>> healthResult = await _kioskHealthService.GetHealthAsync(
            loaded.Select(x => new KioskHealthClient(x.Id, x.IsCurrentlyConnected, x.LastDisconnectDate)).ToList());

        // A failed health read keeps the last one rather than blanking every badge.
        Dictionary<Guid, KioskHealthView> health = healthResult.IsSuccess && healthResult.Data != null ? healthResult.Data : _health;

        IReadOnlyDictionary<Guid, ClientUpdateTargetDTO> targets = _targets;
        IReadOnlyList<(Guid Id, string? ReportedVersion, ClientUpdateRing Ring, string? PinnedVersion)> targetInputs = ClientsPageRows.TargetInputs(loaded);
        DateTime now = DateTime.UtcNow;

        if (force
            || _targetsLoadedUtc is not DateTime targetsLoadedUtc
            || now - targetsLoadedUtc >= TargetsMaxAge
            || !targetInputs.SequenceEqual(_targetInputs))
        {
            Result<IReadOnlyDictionary<Guid, ClientUpdateTargetDTO>> targetsResult = await _updatePolicyService.GetTargetsAsync(loaded);

            if (targetsResult.IsSuccess)
            {
                targets = targetsResult.Data!;
                _targetInputs = targetInputs;
                _targetsLoadedUtc = now;
            }
        }

        IReadOnlyList<ClientRowSignature> rows = ClientsPageRows.Build(loaded, health, targets);

        if (_rows is not null && rows.SequenceEqual(_rows))
        {
            return false;
        }

        _rows = rows;
        clients = loaded;
        _sortedClients = loaded.OrderBy(x => x.Name).ToList().AsQueryable();
        _health = health;
        _targets = targets;
        _versionCounts = BuildVersionCounts(loaded);
        _credentialCount = loaded.Count(x => x.LastAuthMethod == ClientAuthMethod.Credential);
        _legacySecretCount = loaded.Count(x => x.LastAuthMethod == ClientAuthMethod.LegacySecret);

        return true;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_subscribed)
        {
            _fleetEvents.OnChanged -= OnFleetChanged;
        }

        _eventRefresh?.Dispose();
        _fallbackCancellation?.Cancel();
        _fallbackTimer?.Dispose();
        _fallbackCancellation?.Dispose();

        if (_clockModule is not null)
        {
            try
            {
                await _clockModule.InvokeVoidAsync("stop");
                await _clockModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The tab is already gone, and the clock with it.
            }
        }
    }

    // Newest version first; clients that have never reported one ("Unknown") always go last.
    private static List<ClientVersionCount> BuildVersionCounts(IEnumerable<ClientConnectedWithCapabilitiesDTO> source)
    {
        List<ClientVersionCount> counts = source
            .GroupBy(x => x.ReportedClientVersion)
            .Select(g => new ClientVersionCount(g.Key, g.Count()))
            .ToList();

        counts.Sort((left, right) =>
        {
            if (left.Version is null || right.Version is null)
            {
                return (left.Version is null ? 1 : 0) - (right.Version is null ? 1 : 0);
            }

            return ClientVersionFormat.Compare(right.Version, left.Version);
        });

        return counts;
    }

    private ClientUpdateTargetDTO? TargetFor(Guid clientId) => _targets.TryGetValue(clientId, out ClientUpdateTargetDTO? target) ? target : null;

    private static string VersionLabel(string? version) => version is null ? "Unknown" : $"v{version}";

    private static string VersionTooltip(ClientConnectedWithCapabilitiesDTO client)
    {
        if (client.ReportedClientVersion is null || client.ClientVersionReportedAt is not DateTime reportedAt)
        {
            return "This PC hasn't reported a version. Kiosk software older than 1.0.41 doesn't send one.";
        }

        return $"Reported {FormatUkDateTime(reportedAt)}";
    }

    private static string FormatUkDateTime(DateTime utc) =>
        utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("en-GB"));

    private async Task OpenRestartClientDialogAsync(ClientConnectedWithCapabilitiesDTO client)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<RestartClientDialog>(options =>
        {
            options.Header.Title = "Restart Client";
            options.Width = "min(480px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(RestartClientDialog.ClientName), client.Name);
        });

        if (result.Cancelled || result.Value is not ClientRestartType restartType)
        {
            return;
        }

        Result<bool> restartResult = await _clientService.RestartClientAsync(client.Id, restartType);

        if (restartResult.IsSuccess)
        {
            _toastService.ShowSuccess(restartType == ClientRestartType.Computer
                ? $"{client.Name} accepted the restart, its PC will restart shortly."
                : $"{client.Name} accepted the restart, it will reconnect in a few seconds.");
        }
        else
        {
            _toastService.ShowError($"Failed to restart {client.Name}, {restartResult.Error}");
        }

        await RefreshAsync(showErrors: true, force: true);
    }

    private async Task OpenDiagnosticsDialogAsync(ClientConnectedWithCapabilitiesDTO client)
    {
        await _dialogService.ShowDialogAsync<ClientDiagnosticsDialog>(options =>
        {
            options.Header.Title = $"Diagnostics: {client.Name}";
            options.Width = "min(1100px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ClientDiagnosticsDialog.ClientId), client.Id);
            options.Parameters.Add(nameof(ClientDiagnosticsDialog.ClientName), client.Name);
        });
    }

    private async Task OpenScreensDialogAsync(ClientConnectedWithCapabilitiesDTO client)
    {
        await _dialogService.ShowDialogAsync<ClientScreensDialog>(options =>
        {
            options.Header.Title = $"Screens: {client.Name}";
            options.Width = "min(1100px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ClientScreensDialog.ClientId), client.Id);
            options.Parameters.Add(nameof(ClientScreensDialog.ClientName), client.Name);
        });
    }

    private async Task OpenPairKioskDialogAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<PairKioskDialog>(options =>
        {
            options.Header.Title = "Add kiosk";
            options.Width = "min(520px, 95vw)";
            options.Modal = true;
        });

        if (!result.Cancelled)
        {
            await RefreshAsync(showErrors: true, force: true);
        }
    }
    
    private async Task OpenSelfTestDialogAsync(ClientConnectedWithCapabilitiesDTO client)
    {
        await _dialogService.ShowDialogAsync<ClientSelfTestDialog>(options =>
        {
            options.Header.Title = $"Self-test: {client.Name}";
            options.Width = "min(900px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ClientSelfTestDialog.ClientId), client.Id);
            options.Parameters.Add(nameof(ClientSelfTestDialog.ClientName), client.Name);
        });
    }

    private async Task OpenClientSettingsDialog(Guid clientId)
    {
        await _dialogService.ShowDialogAsync<ClientSettingsDialog>(options =>
        {
            options.Header.Title = "Client Settings";
            // Wide enough for every tab heading on one line: when they overflow, the tab strip
            // scrolls and drags the open tab's content sideways with it.
            options.Width = "min(1000px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ClientSettingsDialog.ClientId), clientId);
        });

        await RefreshAsync(showErrors: true, force: true);
    }
}