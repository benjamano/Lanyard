@page "/dmx"

@using Lanyard.App.Components.Clients
@using Lanyard.App.Components.Dmx
@using Lanyard.App.Components.Dialogs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Lanyard.Infrastructure.Models.Dmx

@attribute [Authorize(Roles = "Admin, CanManageDmxSystems")]

@implements IAsyncDisposable

@inject IDmxDeskService _dmxDesk
@inject IDmxFixtureService _dmxFixtureService
@inject IDmxSceneService _dmxSceneService
@inject IJSRuntime JS

<PageTitle>DMX Desk</PageTitle>

<div class="dmx-page">
    <div class="dmx-toolbar" role="toolbar" aria-label="DMX desk">
        <div class="dmx-toolbar-kiosk">
            <ClientSelector InitialClientId="@initialClientId" OnClientSelected="SetSelectedClientAsync" />
        </div>

        <div class="dmx-segmented" role="radiogroup" aria-label="Output">
            <button type="button" role="radio" aria-checked="@(state.Output == DmxDeskOutput.Live)"
                    class="@(state.Output == DmxDeskOutput.Live ? "is-active is-live" : null)"
                    disabled="@NoClient" @onclick="GoLiveAsync"
                    title="The faders drive the lights">
                <span class="dmx-dot" aria-hidden="true"></span> Live
            </button>
            <button type="button" role="radio" aria-checked="@(state.Output == DmxDeskOutput.Blind)"
                    class="@(state.Output == DmxDeskOutput.Blind ? "is-active is-blind" : null)"
                    disabled="@NoClient" @onclick="GoBlindAsync"
                    title="Change the desk without the lights following">
                Blind
            </button>
        </div>

        <FluentButton Appearance="@(state.IsLocked ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                      IconStart="@(state.IsLocked ? new Icons.Filled.Size20.LockClosed() : new Icons.Regular.Size20.LockOpen())"
                      Disabled="@NoClient"
                      OnClick="ToggleLock"
                      Title="@(state.IsLocked ? "Unlock the faders" : "Lock the faders")"
                      aria-pressed="@(state.IsLocked ? "true" : "false")">
            <span class="dmx-toolbar-label">@(state.IsLocked ? "Locked" : "Lock")</span>
        </FluentButton>

        <label class="dmx-master" title="Grand master: scales every light's brightness, never position or colour">
            <span class="dmx-master-label">Master</span>
            <input type="range" min="0" max="255" value="@state.OutputState.GrandMaster"
                   disabled="@(NoClient || state.IsLocked)" aria-label="Grand master" @oninput="OnMasterInput" />
            <span class="dmx-master-value">@MasterPercent</span>
        </label>

        <FluentButton Appearance="@(state.OutputState.IsBlackout ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                      Class="@(state.OutputState.IsBlackout ? "dmx-blackout is-on" : "dmx-blackout")"
                      IconStart="new Icons.Regular.Size20.WeatherMoon()"
                      Disabled="@NoClient"
                      OnClick="ToggleBlackoutAsync"
                      aria-pressed="@(state.OutputState.IsBlackout ? "true" : "false")"
                      Title="@(state.OutputState.IsBlackout ? "Bring the lights back" : "Turn every light off at once")">
            <span class="dmx-toolbar-label">Blackout</span>
        </FluentButton>

        <FluentButton Appearance="ButtonAppearance.Outline"
                      IconStart="new Icons.Regular.Size20.Lightbulb()"
                      Disabled="@NoClient"
                      OnClick="OpenFixtureManager"
                      Title="Add, move and remove this kiosk's lights">
            <span class="dmx-toolbar-label">Fixtures</span>
        </FluentButton>

        <HelpButton AreaKey="@HelpRegistry.Dmx" Compact="true" />
    </div>

    @if (state.OutputState.IsBlackout)
    {
        <div class="dmx-banner dmx-banner--danger" role="status">
            <span><strong>Blackout is on.</strong> Every light is off. Faders still set what comes back.</span>
            <FluentButton Appearance="ButtonAppearance.Primary" Size="ButtonSize.Small" OnClick="ToggleBlackoutAsync">Bring lights back</FluentButton>
        </div>
    }

    @if (state.IsEditingStep)
    {
        <div class="dmx-banner dmx-banner--info" role="status">
            <span>
                <strong>Editing step @EditingStepPosition of @(state.EditingScene?.Name).</strong>
                Faders save to the step. @(state.Output == DmxDeskOutput.Live ? "Live: the lights show it too." : "Choose Live to see it on the lights.")
            </span>
            <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" OnClick="CloseSceneEditorAsync">Done editing</FluentButton>
        </div>
    }
    else if (state.Output == DmxDeskOutput.Blind)
    {
        <div class="dmx-banner dmx-banner--warning" role="status">
            <span><strong>Blind.</strong> The lights aren't following the desk. @(state.HasUnsentChanges ? "You have changes the lights haven't seen." : "Move faders, then send them when ready.")</span>
            <span class="dmx-banner-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" Size="ButtonSize.Small" Disabled="@(!state.HasUnsentChanges)" OnClick="SendToLightsAsync">Send to lights</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Disabled="@(!state.HasUnsentChanges)" OnClick="DiscardAsync">Discard changes</FluentButton>
            </span>
        </div>
    }

    @if (preview.IsActive)
    {
        <div class="dmx-banner dmx-banner--preview" role="status">
            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                          IconStart="@(preview.IsPlaying ? new Icons.Regular.Size20.Pause() : new Icons.Regular.Size20.Play())"
                          OnClick="preview.TogglePlay" aria-label="@(preview.IsPlaying ? "Pause preview" : "Play preview")" />
            <span><strong>Preview</strong> on screen only · step @(preview.StepIndex + 1) of @preview.Steps.Count</span>
            <input type="range" class="dmx-preview-scrub" min="0" max="@(preview.Steps.Count - 1)" value="@preview.StepIndex"
                   aria-label="Preview step" @oninput="OnScrub" />
            <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" OnClick="StopPreview">Stop preview</FluentButton>
        </div>
    }

    <div class="dmx-body">
        <section class="dmx-main @(tab == DeskTab.Scenes ? "is-phone-hidden" : null)">
            <div class="dmx-tabs" role="tablist" aria-label="Desk view">
                <button type="button" role="tab" aria-selected="@(tab == DeskTab.Fixtures)" class="@(tab == DeskTab.Fixtures ? "is-active" : null)" @onclick="() => tab = DeskTab.Fixtures">Fixtures</button>
                <button type="button" role="tab" aria-selected="@(tab == DeskTab.Channels)" class="@(tab == DeskTab.Channels ? "is-active" : null)" @onclick="() => tab = DeskTab.Channels">Channels</button>
                <button type="button" role="tab" aria-selected="@(tab == DeskTab.Scenes)" class="dmx-tabs-phone @(tab == DeskTab.Scenes ? "is-active" : null)" @onclick="() => tab = DeskTab.Scenes">Scenes</button>
            </div>

            <div class="dmx-main-content">
            @if (NoClient)
            {
                <div class="dmx-empty">
                    <FluentText Weight="TextWeight.Semibold">Choose a kiosk</FluentText>
                    <FluentText>Pick the kiosk whose lights you want to control. Kiosks that are off show as offline: you can still set up their fixtures and scenes.</FluentText>
                </div>
            }
            else if (tab == DeskTab.Channels)
            {
                <DmxChannelsView State="@state" Version="@(state.Version + previewVersion)"
                                 OverrideValues="@(preview.IsActive ? preview.Values : null)"
                                 Disabled="@(state.IsLocked || preview.IsActive)" />
            }
            else
            {
                <DmxFixturesView State="@state" Version="@(state.Version + previewVersion)"
                                 OverrideValues="@(preview.IsActive ? preview.Values : null)"
                                 OverrideView="@(preview.IsActive ? preview.ValuesView : null)"
                                 Disabled="@state.IsLocked"
                                 OnManageFixtures="OpenFixtureManager" />
            }
            </div>
        </section>

        <aside class="dmx-side @(tab == DeskTab.Scenes ? "is-phone-active" : null)">
            @if (openScene != null)
            {
                <DmxSceneEditor ClientId="@state.ClientId"
                                OpenScene="@openScene"
                                OnClose="CloseSceneEditorAsync"
                                OnSceneDeleted="OnSceneDeletedAsync"
                                OnEditingStepChanged="OnEditingStepChangedAsync"
                                IsEditModeEnabled="@(!state.IsLocked)"
                                OnSceneEdited="OnSceneEdited"
                                OnPreviewingStepsChanged="OnPreviewingStepsChanged"
                                PreviewingSceneId="@preview.SceneId" />
            }

            @* Always mounted, so scene keybinds keep working while the editor is open. *@
            <div class="@(openScene != null ? "dmx-side-hidden" : null)">
                <DmxSceneSelector ClientId="@state.ClientId"
                                  IsLocked="@state.IsLocked"
                                  DeletedSceneId="@deletedSceneId"
                                  EditedSceneId="@editedScene?.Id"
                                  EditedSceneVersion="@editedSceneVersion"
                                  OnOpenScene="OpenScene"
                                  CurrentlyOpenSceneId="@openScene?.Id" />
            </div>
        </aside>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "client")]
    public Guid? ClientQuery { get; set; }

    private enum DeskTab { Fixtures, Channels, Scenes }

    private DmxDeskState state = null!;
    private DmxScenePreview preview = null!;
    private int previewVersion;

    private DeskTab tab = DeskTab.Fixtures;
    private Guid? initialClientId;

    private DmxScene? openScene;
    private DmxScene? editedScene;
    private int editedSceneVersion;
    private Guid? deletedSceneId;

    private IJSObjectReference? _deskModule;
    private bool _interactive;

    // Live updates arrive at up to ~40 batches a second while a scene runs; one render per 50 ms
    // absorbs them.
    private const int RenderCoalesceMs = 50;
    private Timer? _renderTimer;
    private int _renderPending;

    private bool NoClient => state.ClientId == null;

    private string MasterPercent => $"{Math.Round(state.OutputState.GrandMaster / 2.55)}%";

    private int EditingStepPosition => state.EditingStep?.StepNumber ?? 0;

    protected override void OnInitialized()
    {
        state = new DmxDeskState(_dmxDesk, _dmxFixtureService, _dmxSceneService,
            work => InvokeAsync(work),
            message => _toastService.ShowError(message));
        preview = new DmxScenePreview(work => InvokeAsync(work));

        state.Changed += ScheduleRender;
        preview.Changed += OnPreviewChanged;

        _renderTimer = new Timer(_ =>
        {
            Interlocked.Exchange(ref _renderPending, 0);
            _ = InvokeAsync(StateHasChanged);
        }, null, Timeout.Infinite, Timeout.Infinite);

        initialClientId = ClientQuery;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _interactive = true;

        try
        {
            _deskModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dmxDesk.js");

            // Phones start locked, so a pocket can't change the lights.
            if (await _deskModule.InvokeAsync<bool>("prefersLock"))
            {
                state.IsLocked = true;
            }

            if (initialClientId == null && Guid.TryParse(await _deskModule.InvokeAsync<string?>("getLastClientId"), out Guid last))
            {
                initialClientId = last;
            }

            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnPreviewChanged()
    {
        previewVersion++;
        ScheduleRender();
    }

    private void ScheduleRender()
    {
        if (Interlocked.Exchange(ref _renderPending, 1) == 0)
        {
            try
            {
                _renderTimer?.Change(RenderCoalesceMs, Timeout.Infinite);
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }

    private async Task SetSelectedClientAsync(Guid? clientId)
    {
        if (clientId == state.ClientId)
        {
            return;
        }

        // The open scene, the step being edited and the preview all belong to the kiosk we're leaving.
        preview.Stop();
        openScene = null;

        await state.SetClientAsync(clientId);

        // Remembered in the URL (shareable, survives refresh) and for the next visit. Only once
        // interactive: during prerender NavigateTo becomes an HTTP redirect, to this same page.
        if (_interactive && ClientQuery != clientId)
        {
            _navigationManager.NavigateTo(_navigationManager.GetUriWithQueryParameter("client", clientId), replace: true);
        }

        if (_deskModule != null)
        {
            try
            {
                await _deskModule.InvokeVoidAsync("setLastClientId", clientId?.ToString());
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task GoLiveAsync()
    {
        if (state.Output == DmxDeskOutput.Live)
        {
            return;
        }

        if (state.HasUnsentChanges && !state.IsEditingStep)
        {
            DialogResult result = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
            {
                options.Header.Title = "Send your changes?";
                options.Width = "min(450px, calc(100vw - 32px))";
                options.Modal = true;
                options.Parameters.Add(nameof(ConfirmationDialog.Message), "The lights haven't seen the changes you made in Blind. Going Live sends them now. To go Live without them, press Discard changes first.");
                options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Send and go Live");
                options.Parameters.Add(nameof(ConfirmationDialog.CancelText), "Stay Blind");
            });

            if (result.Cancelled)
            {
                return;
            }

            await state.SetOutputAsync(DmxDeskOutput.Live, sendChanges: true);
            return;
        }

        await state.SetOutputAsync(DmxDeskOutput.Live);
    }

    private Task GoBlindAsync() => state.SetOutputAsync(DmxDeskOutput.Blind);

    private Task SendToLightsAsync() => state.SendBufferAsync();

    private Task DiscardAsync() => state.DiscardBlindChangesAsync();

    private void ToggleLock() => state.IsLocked = !state.IsLocked;

    private Task OnMasterInput(ChangeEventArgs e) =>
        byte.TryParse(e.Value?.ToString(), out byte level) ? state.SetGrandMasterAsync(level) : Task.CompletedTask;

    private Task ToggleBlackoutAsync() => state.SetBlackoutAsync(!state.OutputState.IsBlackout);

    private async Task OpenFixtureManager()
    {
        if (state.ClientId is not Guid clientId)
        {
            return;
        }

        await _dialogService.ShowDialogAsync<DmxFixtureManagerDialog>(options =>
        {
            options.Width = "min(700px, calc(100vw - 32px))";
            options.Modal = true;
            options.Parameters.Add(nameof(DmxFixtureManagerDialog.ClientId), clientId);
        });

        // The dialog's adds/edits/deletes don't otherwise reach the desk.
        await state.RefreshFixturesAsync();
    }

    private void OpenScene(DmxScene scene)
    {
        openScene = scene;
    }

    private async Task CloseSceneEditorAsync()
    {
        openScene = null;
        preview.Stop();
        await state.EditStepAsync(null, null);
    }

    private async Task OnSceneDeletedAsync(DmxScene scene)
    {
        deletedSceneId = scene.Id;

        if (openScene?.Id == scene.Id)
        {
            await CloseSceneEditorAsync();
        }
    }

    private Task OnEditingStepChangedAsync(DmxSceneStep? step) => state.EditStepAsync(openScene, step);

    private void OnSceneEdited(DmxScene scene)
    {
        editedScene = scene;
        editedSceneVersion++;
    }

    private void OnPreviewingStepsChanged(List<DmxSceneStep>? steps)
    {
        if (steps != null && openScene != null)
        {
            preview.Start(openScene.Id, steps, openScene.Loop);
        }
        else
        {
            preview.Stop();
        }
    }

    private void StopPreview() => preview.Stop();

    private void OnScrub(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index))
        {
            preview.ScrubTo(index);
        }
    }

    public async ValueTask DisposeAsync()
    {
        state.Changed -= ScheduleRender;
        preview.Changed -= OnPreviewChanged;
        _renderTimer?.Dispose();
        preview.Dispose();

        await state.DisposeAsync();

        if (_deskModule != null)
        {
            try
            {
                await _deskModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
