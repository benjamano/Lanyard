@page "/files"
@* Everyone signed in: people who manage files (Admin, CanManageFiles) get the whole library; other
   staff get the folders shared with staff, read-only. FileBrowser and IFileLibraryService enforce it. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Lanyard.App.Components.Files.Browser

<PageTitle>@(_canManage ? "Files" : "Shared files")</PageTitle>

<FileBrowser CanManage="_canManage" Location="_location" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "folder")] public Guid? Folder { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }

    private bool _canManage;
    private FilesLocation _location = FilesLocation.Home;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            ClaimsPrincipal user = (await AuthState).User;
            _canManage = user.IsInRole("Admin") || user.IsInRole("CanManageFiles");
        }
    }

    protected override void OnParametersSet() => _location = FilesLocation.FromQuery(Folder, View, Type, Search);
}
