@using System.Threading.Tasks
@using Lanyard.App.Components.Dialogs
@using Lanyard.App.Components.Music;
@using Lanyard.Application.Services
@using Lanyard.Application.Services.Authentication
@using Lanyard.Infrastructure.DataAccess
@using Lanyard.Infrastructure.Models;
@using Microsoft.EntityFrameworkCore

@inject INotificationService _toastService
@inject MusicPlayerService _player
@inject IPlaylistService _playlistService

@implements IDisposable

<div class="song-list-host">
<FluentCard Height="100%" Appearance="CardAppearance.Filled">
    <FluentStack Orientation="Orientation.Vertical" Class="song-list-stack">
        @if (_rows.Count > 0)
        {
            <div class="song-list-wrapper">
                <FluentDataGrid Items="@_rowsQueryable" GridTemplateColumns="100px 2fr 1.5fr 1fr 100px"
                                Style="width: 100%;"
                                Class="song-list-grid"
                                ShowHover="@(AllowPlaying && SelectedClientId != null)">
                    <ChildContent>
                        <TemplateColumn Title="#" Align="DataGridCellAlignment.End">
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                                @if (IsCurrentlyPlaying(context.Song!))
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Speaker2())" Color="Color.Primary"
                                                Style="cursor: pointer;" @onclick="() => PlaySong(context.Song!, context.Playlist!)" />
                                }

                                <AuthorizeView Roles="Admin,CanManagePlaylists" Context="context_">
                                    <Authorized>
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Primary"
                                                    Style="cursor: pointer;"
                                                    @onclick="@((MouseEventArgs e) => HandleAddSongClick(e, context.Song!))" />

                                        @if (context.PlaylistId != Guid.Empty)
                                        {
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Primary"
                                                        Style="cursor: pointer;"
                                                        @onclick="@((MouseEventArgs e) => HandleDeleteSongClick(e, context))" />
                                        }
                                    </Authorized>
                                </AuthorizeView>

                                <span style="text-align: right;">@(_rowNumbers.TryGetValue(context, out int rowNumber) ? rowNumber.ToString() : "")</span>
                            </div>
                        </TemplateColumn>

                        <TemplateColumn Title="Title">
                            <div style="display: flex; align-items: center;"
                                    @onclick="() => PlaySong(context.Song!, context.Playlist!)">
                                <FluentText Weight="@(IsCurrentlyPlaying(context.Song!) ? TextWeight.Bold : TextWeight.Regular)"
                                                Style="@(IsCurrentlyPlaying(context.Song!) ? "color: var(--accent-fill-rest);" : "")">
                                    @context.Song?.Name
                                </FluentText>
                            </div>
                        </TemplateColumn>

                        <TemplateColumn Title="Album" Class="song-list-col-album">
                            <div @onclick="() => PlaySong(context.Song!, context.Playlist!)">
                                <FluentText>@context.Song!.AlbumName</FluentText>
                            </div>
                        </TemplateColumn>

                        <TemplateColumn Title="Date Added" Class="song-list-col-date">
                            <div @onclick="() => PlaySong(context.Song!, context.Playlist!)">
                                <FluentText>@context.Song!.CreateDate.ToString("d")</FluentText>
                            </div>
                        </TemplateColumn>

                        <TemplateColumn Title="Length" Align="DataGridCellAlignment.Start">
                            <div @onclick="() => PlaySong(context.Song!, context.Playlist!)">
                                <FluentText>@TimeSpan.FromSeconds(context.Song!.DurationSeconds).ToString(@"mm\:ss")
                                </FluentText>
                            </div>
                        </TemplateColumn>
                    </ChildContent>
                </FluentDataGrid>
            </div>
        }
        else
            {
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
                             Style="height: 200px;">
                    <FluentText Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                        No songs available
                    </FluentText>
                </FluentStack>
            }
        </FluentStack>
    </FluentCard>
</div>

@code {
    [Parameter] public IEnumerable<PlaylistSongMember>? Songs { get; set; }
    [Parameter] public bool AllowPlaying { get; set; } = true;
    [Parameter] public Guid? SelectedClientId { get; set; }
    [Parameter] public EventCallback<PlaylistSongMember> OnSongRemoved { get; set; }

    private Guid? CurrentlyPlayingSongId;

    // The parent Music page re-renders once a second while a song plays (its timeline), and
    // Blazor re-renders this child every time because Songs is a reference type. The rows are
    // therefore materialised once per distinct Songs instance (each row's number used to be
    // found with Songs.ToList().IndexOf(...) - twice - per row, per render, on a lazy sort), and
    // ShouldRender only lets a render through when something this component shows has changed.
    private List<PlaylistSongMember> _rows = [];
    private IQueryable<PlaylistSongMember>? _rowsQueryable;
    private Dictionary<PlaylistSongMember, int> _rowNumbers = new(ReferenceEqualityComparer.Instance);
    private IEnumerable<PlaylistSongMember>? _lastSongs;
    private Guid? _lastSelectedClientId;
    private bool _lastAllowPlaying;
    private bool _renderPending = true;

    protected override void OnInitialized()
    {
        _player.OnSongChanged += UpdateCurrentSong;
    }

    protected override void OnParametersSet()
    {
        bool changed = false;

        if (!ReferenceEquals(Songs, _lastSongs))
        {
            _lastSongs = Songs;
            RebuildRows();
            changed = true;
        }

        if (SelectedClientId != _lastSelectedClientId || AllowPlaying != _lastAllowPlaying)
        {
            _lastSelectedClientId = SelectedClientId;
            _lastAllowPlaying = AllowPlaying;
            changed = true;
        }

        Guid? playingSongId = SelectedClientId == null ? null : _player.GetCurrentSong(SelectedClientId.Value)?.Id;

        if (playingSongId != CurrentlyPlayingSongId)
        {
            CurrentlyPlayingSongId = playingSongId;
            changed = true;
        }

        if (changed)
        {
            _renderPending = true;
        }
    }

    protected override bool ShouldRender()
    {
        bool render = _renderPending;
        _renderPending = false;
        return render;
    }

    private void RebuildRows()
    {
        _rows = Songs?.ToList() ?? [];
        _rowsQueryable = _rows.AsQueryable();
        _rowNumbers = new Dictionary<PlaylistSongMember, int>(ReferenceEqualityComparer.Instance);

        for (int i = 0; i < _rows.Count; i++)
        {
            _rowNumbers[_rows[i]] = i + 1;
        }
    }

    private void UpdateCurrentSong(Guid clientId, Guid? songid)
    {
        if (SelectedClientId != clientId)
        {
            return;
        }

        CurrentlyPlayingSongId = songid;
        _renderPending = true;
        InvokeAsync(StateHasChanged);
    }

    private bool IsCurrentlyPlaying(Song song)
    {
        return CurrentlyPlayingSongId.HasValue && CurrentlyPlayingSongId.Value == song.Id;
    }

    private async Task PlaySong(Song song, Playlist? playlist)
    {
        if (AllowPlaying == false)
        {
            return;
        }

        if (SelectedClientId == null)
        {
            _toastService.ShowWarning("Select a connected client first.");
            return;
        }

        await _player.Play(SelectedClientId.Value, song, playlist);
    }

    private async Task OpenAddSongToPlaylistDialog(Song song)
    {
        SongPlaylistSelection selection = new SongPlaylistSelection
        {
            Song = song,
            Playlist = null!
        };

        DialogResult result = await _dialogService.ShowDialogAsync<AddSongToPlaylistModal>(options =>
        {
            options.Header.Title = $"Add {song.Name} To Playlist";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(AddSongToPlaylistModal.Content), selection);
        });

        await HandleAddSongToPlaylist(song, result);
    }

    private async Task HandleAddSongToPlaylist(Song song, DialogResult result)
    {
        if (result.Cancelled || result.Value is not Playlist selectedPlaylist)
        {
            return;
        }

        if (selectedPlaylist is null)
        {
            _toastService.ShowWarning("Please select a playlist");
            return;
        }

        Result<bool> addResult = await _playlistService.AddSongToPlaylistAsync(song, selectedPlaylist.Id);

        if (!addResult.IsSuccess)
        {
            _toastService.ShowError($"Failed to add song: {addResult.Error}");
            return;
        }

        if (addResult.Data)
        {
            _toastService.ShowSuccess($"Added '{song.Name}' to '{selectedPlaylist.Name}'");
        }
        else
        {
            _toastService.ShowWarning($"'{song.Name}' is already in '{selectedPlaylist.Name}'");
        }
    }

    private async Task HandleAddSongClick(MouseEventArgs e, Song song)
    {
        await OpenAddSongToPlaylistDialog(song);
    }

    private async Task HandleDeleteSongClick(MouseEventArgs e, PlaylistSongMember member)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Remove Song";
            options.Width = "450px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message), $"Are you sure you want to remove '{member.Song?.Name}' from '{member.Playlist?.Name}'?");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Remove");
        });

        if (result.Cancelled || result.Value is not true)
        {
            return;
        }

        await RemoveSongFromPlaylist(member);
    }

    private async Task RemoveSongFromPlaylist(PlaylistSongMember member)
    {
        Result<bool> result = await _playlistService.RemoveSongFromPlaylistAsync(member.PlaylistId, member.SongId);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to remove song: {result.Error}");
            return;
        }

        Songs = Songs?.Where(x => !(x.SongId == member.SongId && x.PlaylistId == member.PlaylistId)).ToList();
        _lastSongs = Songs;
        RebuildRows();
        _renderPending = true;

        _toastService.ShowSuccess($"Removed '{member.Song?.Name}' from '{member.Playlist?.Name}'");

        await OnSongRemoved.InvokeAsync(member);
    }

    public void Dispose()
    {
        _player.OnSongChanged -= UpdateCurrentSong;
    }
}