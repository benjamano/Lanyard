@implements IAsyncDisposable
@inject IMusicService _musicService
@inject IJSRuntime JS

<section class="music-tracks" aria-label="@(Playlist?.Name ?? "All songs")">
    <header class="music-tracks-header">
        <MusicArtwork Seed="@(Playlist?.Id ?? AllSongsSeed)" Title="@Playlist?.Name"
                      Icon="@(Playlist is null ? new Icons.Regular.Size24.MusicNote2() : null)"
                      IsPlaying="@(Playlist is not null && Playlist.Id == PlayingPlaylistId && IsPlaying)"
                      Size="MusicArtwork.ArtworkSize.Large" />
        <div class="music-tracks-heading">
            <div class="music-section-label">@(Playlist is null ? "Library" : "Playlist")</div>
            <h2 class="music-tracks-title">@(Playlist?.Name ?? "All songs")</h2>
            @if (!string.IsNullOrWhiteSpace(Playlist?.Description))
            {
                <p class="music-tracks-description">@Playlist.Description</p>
            }
            <div class="music-tracks-meta">@Summary</div>
            <div class="music-tracks-actions">
                @if (Playlist is not null)
                {
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Filled.Size20.Play())"
                                  Disabled="@(Playlist.SongCount == 0)" OnClick="() => OnPlayAll.InvokeAsync(false)">Play</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.ArrowShuffle())"
                                  Disabled="@(Playlist.SongCount == 0)" OnClick="() => OnPlayAll.InvokeAsync(true)">Shuffle</FluentButton>
                    @if (CanEdit)
                    {
                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Edit())"
                                      Title="Rename playlist" aria-label="Rename playlist" OnClick="OnRename" />
                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Delete())"
                                      Title="Delete playlist" aria-label="Delete playlist" OnClick="OnDelete" />
                    }
                }
            </div>
        </div>
    </header>

    <div class="music-tracks-search">
        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Default" />
        <input type="search" placeholder="@(Playlist is null ? "Search the library" : "Search this playlist")"
               aria-label="Search songs" value="@_search" @oninput="OnSearchInput" />
    </div>

    @if (ReorderEnabled && _rows.Count > 1)
    {
        <p class="music-tracks-hint">Drag <FluentIcon Value="@(new Icons.Regular.Size16.ReOrderDotsVertical())" Color="Color.Default" /> to reorder, or use a song's <strong>⋯</strong> menu.</p>
    }

    <div class="music-track-list @(ReorderEnabled ? "can-reorder" : "")" role="list" @ref="_list">
        @if (Playlist is null)
        {
            <Virtualize @key="_libraryKey" TItem="MusicRow" ItemsProvider="LoadLibraryAsync" ItemSize="60" OverscanCount="8" Context="row">
                <ItemContent>@RenderRow(row)</ItemContent>
                <Placeholder><div class="music-track is-placeholder" role="listitem"><span></span><span></span></div></Placeholder>
                <EmptyContent>@RenderEmpty()</EmptyContent>
            </Virtualize>
        }
        else if (_rows.Count == 0)
        {
            @RenderEmpty()
        }
        else
        {
            <Virtualize TItem="MusicRow" Items="_rows" ItemSize="60" OverscanCount="8" Context="row">
                @RenderRow(row)
            </Virtualize>
        }
    </div>
</section>

@if (_menuRow is MusicRow menuRow)
{
    <div class="music-menu-backdrop" @onclick="CloseMenu"></div>
    <div class="music-menu" role="menu" aria-label="@menuRow.Name" @ref="_menu" @onkeydown="OnMenuKeyDown">
        <div class="music-menu-title">@menuRow.Name</div>
        <button type="button" role="menuitem" @onclick="() => MenuAsync(() => OnPlaySong.InvokeAsync(menuRow.SongId))">
            <FluentIcon Value="@(new Icons.Regular.Size20.Play())" Color="Color.Default" /> Play now
        </button>
        @if (CanEdit)
        {
            <button type="button" role="menuitem" @onclick="() => MenuAsync(() => OnAddToPlaylist.InvokeAsync(menuRow))">
                <FluentIcon Value="@(new Icons.Regular.Size20.AddSquare())" Color="Color.Default" /> Add to playlist…
            </button>
            @if (Playlist is not null)
            {
                @if (ReorderEnabled)
                {
                    <button type="button" role="menuitem" disabled="@(menuRow.Index == 0)"
                            @onclick="() => MenuAsync(() => OnMove.InvokeAsync((menuRow.SongId, menuRow.Index - 1)))">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowUp())" Color="Color.Default" /> Move up
                    </button>
                    <button type="button" role="menuitem" disabled="@(menuRow.Index >= _rows.Count - 1)"
                            @onclick="() => MenuAsync(() => OnMove.InvokeAsync((menuRow.SongId, menuRow.Index + 1)))">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowDown())" Color="Color.Default" /> Move down
                    </button>
                }
                <button type="button" role="menuitem" class="is-danger" @onclick="() => MenuAsync(() => OnRemove.InvokeAsync(menuRow))">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Color.Default" /> Remove from playlist
                </button>
            }
        }
        <button type="button" role="menuitem" class="music-menu-cancel" @onclick="CloseMenu">Cancel</button>
    </div>
}

@code {
    /// <summary>A song as a row shows it, from a playlist or the library.</summary>
    public sealed record MusicRow(Guid SongId, string Name, string AlbumName, double DurationSeconds, DateTime AddedUtc, int Index);

    private static readonly Guid AllSongsSeed = new("6b1d3c5e-0000-4000-8000-000000000001");

    /// <summary>The playlist shown; null shows the whole library.</summary>
    [Parameter] public PlaylistOverview? Playlist { get; set; }

    /// <summary>The playlist's songs in order (ignored for the library, which is paged).</summary>
    [Parameter] public IReadOnlyList<PlaylistTrack>? Tracks { get; set; }

    [Parameter] public Guid? PlayingSongId { get; set; }
    [Parameter] public Guid? PlayingPlaylistId { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Bumped by the page when the library itself changed, so the paged list reloads.</summary>
    [Parameter] public int LibraryVersion { get; set; }

    [Parameter] public EventCallback<Guid> OnPlaySong { get; set; }
    [Parameter] public EventCallback<bool> OnPlayAll { get; set; }
    [Parameter] public EventCallback OnRename { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<MusicRow> OnAddToPlaylist { get; set; }
    [Parameter] public EventCallback<MusicRow> OnRemove { get; set; }
    [Parameter] public EventCallback<(Guid SongId, int Index)> OnMove { get; set; }

    private List<MusicRow> _rows = [];
    private int? _libraryTotal;
    private string _search = "";
    private CancellationTokenSource? _searchDelay;
    private MusicRow? _menuRow;
    private ElementReference _menu;
    private ElementReference _list;
    // The library list is keyed on the search it shows, so a new search gets a fresh list rather
    // than refreshing one that may be mid-load (which could leave the old rows on screen).
    private string _appliedSearch = "";
    private int _libraryReloads;
    private string _libraryKey => $"{_libraryReloads}|{_appliedSearch}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<MusicTrackList>? _ref;
    private bool _reorderWired;
    private bool _positionMenu;

    private IReadOnlyList<PlaylistTrack>? _lastTracks;
    private Guid? _lastPlaylistId;
    private int _lastLibraryVersion;

    // Only re-render for what this list shows; the page re-renders for plenty that it doesn't.
    private object? _shownKey;
    private bool _changedHere = true;

    private bool ReorderEnabled => CanEdit && Playlist is not null && string.IsNullOrWhiteSpace(_search);

    private string Summary
    {
        get
        {
            if (Playlist is null)
            {
                return _libraryTotal is int total ? MusicPlaylistPicker.SongCount(total) : "Loading…";
            }

            string length = TimeSpan.FromSeconds(Playlist.TotalSeconds) switch
            {
                { TotalHours: >= 1 } t => $"{(int)t.TotalHours} h {t.Minutes} min",
                var t => $"{Math.Max(t.Minutes, Playlist.SongCount > 0 ? 1 : 0)} min"
            };

            return Playlist.SongCount == 0 ? "No songs yet" : $"{MusicPlaylistPicker.SongCount(Playlist.SongCount)} · {length}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Playlist?.Id != _lastPlaylistId)
        {
            _lastPlaylistId = Playlist?.Id;
            _search = "";
            _appliedSearch = "";
            _menuRow = null;
            _libraryTotal = null;
            _lastTracks = null;
            _changedHere = true;
        }

        if (Playlist is not null && !ReferenceEquals(Tracks, _lastTracks))
        {
            _lastTracks = Tracks;
            RebuildRows();
        }

        if (Playlist is null && (LibraryVersion != _lastLibraryVersion || _libraryTotal is null))
        {
            _lastLibraryVersion = LibraryVersion;
            _libraryReloads++;
            await LoadLibraryTotalAsync();
        }
    }

    // How many songs the library (or the current search) has, for the header. Asked separately
    // so the list's own loading never has to re-render anything.
    private async Task LoadLibraryTotalAsync()
    {
        Result<PagedResult<LibrarySong>> result = await _musicService.SearchSongsAsync(_appliedSearch, 0, 1);
        _libraryTotal = result.IsSuccess ? result.Data?.Total : null;
        _changedHere = true;
    }

    protected override bool ShouldRender()
    {
        object key = (Playlist, _rows, PlayingSongId, PlayingPlaylistId, IsPlaying, CanEdit);
        if (!_changedHere && Equals(key, _shownKey))
        {
            return false;
        }

        _shownKey = key;
        _changedHere = false;
        return true;
    }

    private void RebuildRows()
    {
        IEnumerable<PlaylistTrack> tracks = Tracks ?? [];
        int index = 0;
        List<MusicRow> all = tracks.Select(x => new MusicRow(x.SongId, x.Name, x.AlbumName, x.DurationSeconds, x.AddedUtc, index++)).ToList();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            string term = _search.Trim();
            all = all.Where(x => x.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase)
                || x.AlbumName.Contains(term, StringComparison.CurrentCultureIgnoreCase)).ToList();
        }

        _rows = all;
        _changedHere = true;
    }

    private async ValueTask<ItemsProviderResult<MusicRow>> LoadLibraryAsync(ItemsProviderRequest request)
    {
        Result<PagedResult<LibrarySong>> result = await _musicService.SearchSongsAsync(_appliedSearch, request.StartIndex, request.Count, request.CancellationToken);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError(result.Error ?? "Couldn't load the library.");
            return new ItemsProviderResult<MusicRow>([], 0);
        }

        List<MusicRow> rows = result.Data.Items
            .Select((x, i) => new MusicRow(x.Id, x.Name, x.AlbumName, x.DurationSeconds, x.CreateDate, request.StartIndex + i))
            .ToList();

        return new ItemsProviderResult<MusicRow>(rows, result.Data.Total);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _changedHere = true;

        if (Playlist is not null)
        {
            RebuildRows();
            return;
        }

        // Wait for a pause in typing before asking the server.
        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        CancellationToken token = _searchDelay.Token;

        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _appliedSearch = _search;
        await LoadLibraryTotalAsync();
    }

    private RenderFragment RenderRow(MusicRow row) => __builder =>
    {
        bool current = row.SongId == PlayingSongId && (Playlist is null || Playlist.Id == PlayingPlaylistId);
        <div class="music-track @(current ? "is-current" : "")" role="listitem" @key="row.SongId"
             data-song-id="@row.SongId" data-index="@row.Index">
            <button type="button" class="music-track-main" @onclick="() => OnPlaySong.InvokeAsync(row.SongId)"
                    aria-label="@($"Play {row.Name}")" aria-current="@(current ? "true" : null)">
                <span class="music-track-index">
                    @if (current && IsPlaying)
                    {
                        <span class="music-equaliser is-small"><i></i><i></i><i></i></span>
                    }
                    else
                    {
                        <span class="music-track-number">@(row.Index + 1)</span>
                        <FluentIcon Class="music-track-play-hint" Value="@(new Icons.Filled.Size16.Play())" Color="Color.Default" />
                    }
                </span>
                <span class="music-track-text">
                    <span class="music-track-name">@row.Name</span>
                    <span class="music-track-album">@row.AlbumName<span class="music-track-inline-length"> · @MusicProgress.FormatTime(row.DurationSeconds)</span></span>
                </span>
                <span class="music-track-added">@row.AddedUtc.ToLocalTime().ToString("d MMM yyyy")</span>
                <span class="music-track-length">@MusicProgress.FormatTime(row.DurationSeconds)</span>
            </button>
            @if (ReorderEnabled)
            {
                <span class="music-track-handle" data-drag-handle title="Drag to reorder" aria-hidden="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ReOrderDotsVertical())" Color="Color.Default" />
                </span>
            }
            <button type="button" class="music-icon-button music-track-more" aria-label="@($"More for {row.Name}")" aria-haspopup="menu"
                    title="More" @onclick="(e) => OpenMenu(row)">
                <FluentIcon Value="@(new Icons.Regular.Size20.MoreHorizontal())" Color="Color.Default" />
            </button>
        </div>
    };

    private RenderFragment RenderEmpty() => __builder =>
    {
        <div class="music-tracks-empty">
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <FluentIcon Value="@(new Icons.Regular.Size24.SearchInfo())" Color="Color.Default" />
                <div>No songs match “@_search”.</div>
            }
            else if (Playlist is not null)
            {
                <FluentIcon Value="@(new Icons.Regular.Size24.MusicNote2())" Color="Color.Default" />
                <div>No songs in this playlist yet.</div>
                @if (CanEdit)
                {
                    <div class="music-tracks-empty-hint">Open <strong>All songs</strong> and choose <strong>⋯ › Add to playlist</strong> on the songs you want.</div>
                }
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size24.MusicNote2())" Color="Color.Default" />
                <div>There are no songs in the library yet.</div>
                <div class="music-tracks-empty-hint">Upload audio files in the <a href="/files">File Manager</a> and they appear here.</div>
            }
        </div>
    };

    private void OpenMenu(MusicRow row)
    {
        _menuRow = row;
        _positionMenu = true;
        _changedHere = true;
    }

    private void CloseMenu()
    {
        _menuRow = null;
        _changedHere = true;
    }

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private async Task MenuAsync(Func<Task> action)
    {
        CloseMenu();
        await action();
    }

    [JSInvokable]
    public Task MoveSongTo(string songId, int index) =>
        Guid.TryParse(songId, out Guid id) ? OnMove.InvokeAsync((id, index)) : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_module is null)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/musicPlayer.js");
                _ref = DotNetObjectReference.Create(this);
            }

            if (ReorderEnabled && !_reorderWired)
            {
                _reorderWired = true;
                await _module.InvokeVoidAsync("initReorder", _list, _ref);
            }

            if (_positionMenu && _menuRow is not null)
            {
                _positionMenu = false;
                string selector = $"[data-song-id='{_menuRow.SongId}'] .music-track-more";
                await _module.InvokeVoidAsync("positionMenuFor", _menu, _list, selector);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _searchDelay?.Cancel();

        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _ref?.Dispose();
    }
}
