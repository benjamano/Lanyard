@using Lanyard.App.Components.Dialogs
@using Lanyard.Application.Services.Dmx
@using Lanyard.Infrastructure.DTO.Dmx
@using Lanyard.Infrastructure.Models.Dmx

@inject IDmxFixtureService _dmxFixtureService
@inject IDmxFixtureDefinitionService _definitionService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="new Icons.Regular.Size24.Lightbulb()" Margin="@Margin.End2" />
            <FluentText Size="@TextSize.Size500">Manage Fixtures</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <div class="fixture-manager">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="18px">
                <FluentText Size="TextSize.Size300">
                    Fixtures map a starting channel to a kind of light, so the preview can show it as a coloured light and Lanyard knows which channels it uses. Pick a generic type, or find your exact light in the Open Fixture Library.
                </FluentText>

                <FluentCard Appearance="CardAppearance.Subtle" Padding="@Padding.All3" Class="fixture-add-card">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                        <div class="fixture-form-row">
                            <FluentTextInput Label="Name" Value="@newName" ValueChanged="@(v => newName = v)" Class="fixture-name-input" />
                            <FluentNumberInput TValue="int" Label="Start Channel" Value="@newStartChannel" ValueChanged="@(v => newStartChannel = v)" Min="1" Max="512" Width="120px" />
                        </div>

                        <FluentRadioGroup TValue="FixtureSource" Label="Fixture type" Orientation="Orientation.Horizontal" @bind-Value="newSource" Class="fixture-source">
                            <FluentRadio Value="FixtureSource.Saved" Label="Saved types" />
                            <FluentRadio Value="FixtureSource.Library" Label="Open Fixture Library" />
                            <FluentRadio Value="FixtureSource.File" Label="Import a file" />
                        </FluentRadioGroup>

                        @switch (newSource)
                        {
                            case FixtureSource.Saved:
                                <FluentSelect TOption="Guid" TValue="Guid" Label="Type" @bind-Value="newModeId" Class="fixture-type-select">
                                    @foreach (DmxFixtureMode mode in savedModes)
                                    {
                                        <FluentOption Value="@mode.Id">@ModeLabel(mode)</FluentOption>
                                    }
                                </FluentSelect>
                                break;

                            case FixtureSource.Library:
                                <OflFixturePicker SelectionChanged="@(selection => librarySelection = selection)" />
                                break;

                            case FixtureSource.File:
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
                                    <FluentText Size="TextSize.Size200" Class="fixture-footprint-hint">
                                        For a light that isn't in the list yet: download its fixture file (the "Open Fixture Library JSON" format) from open-fixture-library.org and add it here.
                                    </FluentText>
                                    <FluentTextInput Label="Manufacturer" Value="@uploadManufacturer" ValueChanged="@(v => uploadManufacturer = v)" Immediate="true" Class="fixture-name-input" />
                                    <div class="fixture-upload">
                                        <FluentInputFile Id="ofl-fixture-upload" Mode="InputFileMode.Stream" Multiple="false"
                                                         MaximumFileCount="1" MaximumFileSize="@(OflFixtureParserMaxBytes)" Accept=".json,application/json"
                                                         Disabled="@(string.IsNullOrWhiteSpace(uploadManufacturer) || isSaving)"
                                                         OnFileUploaded="@OnFixtureFileUploadedAsync">
                                            <ChildContent>
                                                <label for="ofl-fixture-upload">
                                                    @(string.IsNullOrWhiteSpace(uploadManufacturer) ? "Enter the manufacturer first." : "Choose a .json fixture file, or drag it here.")
                                                </label>
                                            </ChildContent>
                                        </FluentInputFile>
                                    </div>
                                </FluentStack>
                                break;
                        }

                        @if (newSource != FixtureSource.File)
                        {
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                                <FluentButton IconStart="new Icons.Regular.Size20.AddCircle()"
                                              Appearance="ButtonAppearance.Primary"
                                              Disabled="@(string.IsNullOrWhiteSpace(newName) || isSaving || NewChannelCount == null || RunsPastUniverse(newStartChannel, NewChannelCount.Value))"
                                              OnClick="CreateFixture">
                                    Add Fixture
                                </FluentButton>
                                @if (NewChannelCount is int newCount)
                                {
                                    <FluentText Size="TextSize.Size200" Class="@(RunsPastUniverse(newStartChannel, newCount) ? "fixture-footprint-hint fixture-footprint-hint-error" : "fixture-footprint-hint")">
                                        @FootprintHint(newStartChannel, newCount)
                                    </FluentText>
                                }
                            </FluentStack>
                        }
                    </FluentStack>
                </FluentCard>

                @if (isLoading)
                {
                    <FluentProgressBar />
                }
                else if (fixtures.Count == 0)
                {
                    <FluentText Size="TextSize.Size400">No fixtures yet. Add one above to preview it as a light.</FluentText>
                }
                else
                {
                    <ul class="fixture-list">
                        @foreach (DmxFixture fixture in fixtures)
                        {
                            <li class="fixture-list-item" @key="fixture.Id">
                                @if (editingFixtureId == fixture.Id)
                                {
                                    <div class="fixture-list-body">
                                        <div class="fixture-form-row">
                                            <FluentTextInput Label="Name" Value="@editName" ValueChanged="@(v => editName = v)" Class="fixture-name-input" />
                                            <FluentNumberInput TValue="int" Label="Start Channel" Value="@editStartChannel" ValueChanged="@(v => editStartChannel = v)" Min="1" Max="512" Width="120px" />
                                            <FluentSelect TOption="Guid" TValue="Guid" Label="Type" @bind-Value="editModeId" Class="fixture-type-select">
                                                @foreach (DmxFixtureMode mode in ModeChoicesFor(fixture))
                                                {
                                                    <FluentOption Value="@mode.Id">@ModeLabel(mode)</FluentOption>
                                                }
                                            </FluentSelect>
                                        </div>
                                        <FluentText Size="TextSize.Size200" Class="@(RunsPastUniverse(editStartChannel, EditChannelCount) ? "fixture-footprint-hint fixture-footprint-hint-error" : "fixture-footprint-hint")">
                                            @FootprintHint(editStartChannel, EditChannelCount)
                                        </FluentText>
                                    </div>
                                    <div class="fixture-list-actions">
                                        <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="new Icons.Regular.Size20.Checkmark()" Title="Save" Tooltip="Save" Disabled="@(isSaving || (RunsPastUniverse(editStartChannel, EditChannelCount) && PlacementChanged(fixture)))" OnClick="SaveEditingFixture" />
                                        <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="new Icons.Regular.Size20.Dismiss()" Title="Cancel" Tooltip="Cancel" OnClick="@(() => editingFixtureId = null)" />
                                    </div>
                                }
                                else
                                {
                                    string? problem = PlacementProblem(fixture);

                                    <div class="fixture-list-body">
                                        <span class="fixture-list-name">@fixture.Name</span>
                                        <span class="fixture-list-meta">
                                            @ChannelRange(fixture) · @FixtureDescription(fixture)
                                        </span>
                                        @if (problem != null)
                                        {
                                            <span class="fixture-list-warning">
                                                <FluentIcon Value="new Icons.Regular.Size16.Warning()" Color="Color.Warning" />
                                                @problem
                                            </span>
                                        }
                                    </div>
                                    <div class="fixture-list-actions">
                                        <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="new Icons.Regular.Size20.Edit()" Title="Edit fixture" Tooltip="Edit fixture" OnClick="@(() => StartEditing(fixture))" />
                                        <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="new Icons.Regular.Size20.BinRecycle()" Title="Delete fixture" Tooltip="Delete fixture" OnClick="@(() => DeleteFixture(fixture))" />
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </FluentStack>
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CloseAsync">Close</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter]
    public required Guid ClientId { get; set; }

    private const int UniverseSize = 512;
    private const int OflFixtureParserMaxBytes = Lanyard.Application.Services.Dmx.Ofl.OflFixtureParser.MaxFileBytes;

    private enum FixtureSource
    {
        Saved,
        Library,
        File
    }

    // Built-in generic types first, then this company's imported/custom ones. Falls back to the
    // built-ins alone if definitions fail to load, so the dialog stays usable.
    private List<DmxFixtureMode> savedModes = BuiltInDmxFixtureDefinitions.Modes
        .Select(m => BuiltInDmxFixtureDefinitions.BuildMode(m.Id))
        .ToList();

    private FixtureSource newSource = FixtureSource.Saved;
    private OflPickerSelection? librarySelection;
    private string uploadManufacturer = string.Empty;

    private List<DmxFixture> fixtures = [];
    private bool isLoading = true;
    private bool isSaving;

    private string newName = string.Empty;
    private int newStartChannel = 1;
    private Guid newModeId = BuiltInDmxFixtureDefinitions.RgbModeId;

    private Guid? editingFixtureId;
    private string editName = string.Empty;
    private int editStartChannel = 1;
    private Guid editModeId = BuiltInDmxFixtureDefinitions.RgbModeId;

    protected override async Task OnInitializedAsync()
    {
        await LoadSavedModes();
        await LoadFixtures();
    }

    private int? NewChannelCount => newSource switch
    {
        FixtureSource.Saved => FindMode(newModeId)?.ChannelCount ?? 1,
        FixtureSource.Library => librarySelection?.ChannelCount,
        _ => null
    };

    private int EditChannelCount => FindMode(editModeId)?.ChannelCount ?? 1;

    private async Task LoadSavedModes()
    {
        Result<IReadOnlyList<DmxFixtureDefinition>> result = await _definitionService.GetDefinitionsAsync();

        if (!result.IsSuccess || result.Data == null)
        {
            _toastService.ShowError($"Failed to load fixture types: {result.Error}");
            return;
        }

        savedModes = result.Data
            .SelectMany(definition => definition.Modes
                .OrderBy(m => m.SortOrder)
                .Select(mode =>
                {
                    mode.Definition = definition;
                    return mode;
                }))
            .ToList();
    }

    private async Task LoadFixtures()
    {
        isLoading = true;

        Result<IEnumerable<DmxFixture>> result = await _dmxFixtureService.GetFixturesForClientAsync(ClientId);

        if (result.IsSuccess && result.Data != null)
        {
            fixtures = result.Data.ToList();
        }
        else
        {
            _toastService.ShowError($"Failed to load fixtures: {result.Error}");

            fixtures = [];
        }

        isLoading = false;
    }

    private async Task CreateFixture()
    {
        if (string.IsNullOrWhiteSpace(newName) || isSaving)
        {
            return;
        }

        isSaving = true;

        try
        {
            int? channelCount = NewChannelCount;

            if (channelCount == null)
            {
                return;
            }

            bool? allowOverlap = await ConfirmOverlapsAsync(newStartChannel, channelCount.Value, null);

            if (allowOverlap is null)
            {
                return;
            }

            Guid? modeId = await ResolveNewModeIdAsync();

            if (modeId == null)
            {
                return;
            }

            Result<DmxFixture> result = await _dmxFixtureService.CreateFixtureAsync(ClientId, newName, newStartChannel, modeId.Value, allowOverlap.Value);

            if (result.IsSuccess && result.Data != null)
            {
                fixtures.Add(result.Data);
                fixtures = fixtures.OrderBy(f => f.StartChannel).ToList();

                newName = string.Empty;
                newStartChannel = FirstFreeChannel(result.Data.StartChannel + channelCount.Value, channelCount.Value);

                _toastService.ShowSuccess("Fixture added successfully.");
            }
            else
            {
                _toastService.ShowError($"Failed to add fixture: {result.Error}");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    // A library fixture is copied into the company only now, when it's actually being patched.
    private async Task<Guid?> ResolveNewModeIdAsync()
    {
        if (newSource == FixtureSource.Saved)
        {
            return newModeId;
        }

        if (librarySelection == null)
        {
            return null;
        }

        Result<DmxFixtureDefinition> imported = await _definitionService.ImportFromLibraryAsync(librarySelection.OflKey);

        if (!imported.IsSuccess || imported.Data == null)
        {
            _toastService.ShowError($"Failed to add {librarySelection.Manufacturer} {librarySelection.Model}: {imported.Error}");
            return null;
        }

        DmxFixtureMode? mode = imported.Data.Modes.FirstOrDefault(m => m.Name == librarySelection.ModeName);

        if (mode == null)
        {
            _toastService.ShowError($"The {librarySelection.ModeName} mode couldn't be found.");
            return null;
        }

        // So it shows up under Saved types (and in the edit list) from now on.
        await LoadSavedModes();

        return mode.Id;
    }

    private async Task OnFixtureFileUploadedAsync(FluentInputFileEventArgs file)
    {
        if (file.Stream == null || file.ErrorMessage != null)
        {
            _toastService.ShowError($"Couldn't read {file.Name}: {file.ErrorMessage ?? "the file was empty."}");
            return;
        }

        isSaving = true;

        try
        {
            Result<DmxFixtureDefinition> imported = await _definitionService.ImportFromFileAsync(file.Stream, uploadManufacturer);

            if (!imported.IsSuccess || imported.Data == null)
            {
                _toastService.ShowError($"Couldn't add {file.Name}: {imported.Error}");
                return;
            }

            await LoadSavedModes();

            DmxFixtureMode? firstMode = imported.Data.Modes.OrderBy(m => m.SortOrder).FirstOrDefault();
            newModeId = firstMode?.Id ?? newModeId;
            newSource = FixtureSource.Saved;

            _toastService.ShowSuccess($"{imported.Data.Manufacturer} {imported.Data.Model} is now one of your saved types. Choose its mode, then add the fixture.");
        }
        catch (Exception)
        {
            // The service already turns bad files into a Fail; this is the browser connection dropping mid-upload.
            _toastService.ShowError($"Couldn't read {file.Name}. Try uploading it again.");
        }
        finally
        {
            await file.Stream.DisposeAsync();
            isSaving = false;
        }
    }

    private void StartEditing(DmxFixture fixture)
    {
        editingFixtureId = fixture.Id;
        editName = fixture.Name;
        editStartChannel = fixture.StartChannel;
        editModeId = fixture.FixtureModeId;
    }

    private async Task SaveEditingFixture()
    {
        DmxFixture? fixture = fixtures.FirstOrDefault(f => f.Id == editingFixtureId);

        if (fixture == null || isSaving)
        {
            editingFixtureId = null;

            return;
        }

        isSaving = true;

        try
        {
            bool placementChanged = fixture.StartChannel != editStartChannel || fixture.FixtureModeId != editModeId;
            bool allowOverlap = false;

            if (placementChanged)
            {
                bool? confirmed = await ConfirmOverlapsAsync(editStartChannel, EditChannelCount, fixture.Id);

                if (confirmed is null)
                {
                    return;
                }

                allowOverlap = confirmed.Value;
            }

            Result<bool> result = await _dmxFixtureService.UpdateFixtureAsync(fixture.Id, editName, editStartChannel, editModeId, allowOverlap);

            if (result.IsSuccess)
            {
                editingFixtureId = null;

                await LoadFixtures();

                _toastService.ShowSuccess("Fixture updated successfully.");
            }
            else
            {
                _toastService.ShowError($"Failed to update fixture: {result.Error}");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    // True: save as a deliberate double-patch. False: nothing overlaps. Null: the user backed out.
    private async Task<bool?> ConfirmOverlapsAsync(int startChannel, int channelCount, Guid? excludeFixtureId)
    {
        Result<IReadOnlyList<DmxFixtureOverlap>> overlapResult = await _dmxFixtureService.GetOverlapsAsync(ClientId, startChannel, channelCount, excludeFixtureId);

        if (!overlapResult.IsSuccess || overlapResult.Data == null || overlapResult.Data.Count == 0)
        {
            // Let the save itself report a failed check; it re-checks on the server anyway.
            return false;
        }

        string names = string.Join(", ", overlapResult.Data.Select(o => o.FirstSharedChannel == o.LastSharedChannel
            ? $"{o.FixtureName} (channel {o.FirstSharedChannel})"
            : $"{o.FixtureName} (channels {o.FirstSharedChannel}-{o.LastSharedChannel})"));

        DialogResult dialogResult = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Channels already in use";
            options.Width = "450px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message), $"This fixture would share channels with {names}. Both fixtures will respond to the same channels. Patch it anyway?");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Patch anyway");
        });

        return !dialogResult.Cancelled && dialogResult.Value is true ? true : null;
    }

    private async Task DeleteFixture(DmxFixture fixture)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<ConfirmationDialog>(options =>
        {
            options.Header.Title = "Delete Fixture";
            options.Width = "450px";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmationDialog.Message), $"Are you sure you want to delete '{fixture.Name}'? This action cannot be undone.");
            options.Parameters.Add(nameof(ConfirmationDialog.ConfirmText), "Delete");
        });

        if (!result.Cancelled && result.Value is true)
        {
            Result<bool> deleteResult = await _dmxFixtureService.DeleteFixtureAsync(fixture.Id);

            if (deleteResult.IsSuccess)
            {
                fixtures.Remove(fixture);

                _toastService.ShowSuccess($"Fixture '{fixture.Name}' deleted successfully.");
            }
            else
            {
                _toastService.ShowError($"Failed to delete fixture '{fixture.Name}': {deleteResult.Error}");
            }
        }
    }

    // The fixture's own mode stays selectable even if its definition was since removed.
    private IEnumerable<DmxFixtureMode> ModeChoicesFor(DmxFixture fixture) =>
        fixture.FixtureMode != null && savedModes.All(m => m.Id != fixture.FixtureModeId)
            ? savedModes.Prepend(fixture.FixtureMode)
            : savedModes;

    private DmxFixtureMode? FindMode(Guid modeId) =>
        savedModes.FirstOrDefault(m => m.Id == modeId)
        ?? fixtures.Select(f => f.FixtureMode).FirstOrDefault(m => m?.Id == modeId);

    // "RGB (3 ch)" for the generic types, "Cameo Flat Pro 18 · 5-channel (5 ch)" otherwise.
    private static string ModeLabel(DmxFixtureMode mode)
    {
        DmxFixtureDefinition? definition = mode.Definition
            ?? BuiltInDmxFixtureDefinitions.Definitions.FirstOrDefault(d => d.Id == mode.DefinitionId);

        if (definition == null || definition.Source == DmxFixtureDefinitionSource.BuiltIn)
        {
            return $"{definition?.Model ?? mode.Name} ({mode.ChannelCount} ch)";
        }

        return $"{definition.Manufacturer} {definition.Model} · {mode.Name} ({mode.ChannelCount} ch)";
    }

    private static string FixtureDescription(DmxFixture fixture)
    {
        if (fixture.FixtureMode == null)
        {
            return "Unknown type";
        }

        DmxFixtureDefinition? definition = fixture.FixtureMode.Definition;

        if (definition == null || definition.Source == DmxFixtureDefinitionSource.BuiltIn)
        {
            return ModeLabel(fixture.FixtureMode);
        }

        return $"{definition.Manufacturer} {definition.Model} · {fixture.FixtureMode.Name}";
    }

    private static int ChannelCount(DmxFixture fixture) => fixture.FixtureMode?.ChannelCount ?? 1;

    private static string ChannelRange(DmxFixture fixture)
    {
        int last = fixture.StartChannel + ChannelCount(fixture) - 1;

        return last == fixture.StartChannel ? $"Ch {fixture.StartChannel}" : $"Ch {fixture.StartChannel}-{last}";
    }

    private static bool RunsPastUniverse(int startChannel, int channelCount) =>
        startChannel + channelCount - 1 > UniverseSize;

    // Renaming a fixture that was saved before these checks existed is still allowed.
    private bool PlacementChanged(DmxFixture fixture) =>
        fixture.StartChannel != editStartChannel || fixture.FixtureModeId != editModeId;

    private static string FootprintHint(int startChannel, int channelCount)
    {
        int last = startChannel + channelCount - 1;

        if (last > UniverseSize)
        {
            return $"Needs channels {startChannel}-{last}, past the end of the universe ({UniverseSize}).";
        }

        return channelCount == 1 ? $"Uses channel {startChannel}." : $"Uses channels {startChannel}-{last}.";
    }

    // Fixtures saved before overlap checks existed (or double-patched on purpose) are flagged,
    // not changed.
    private string? PlacementProblem(DmxFixture fixture)
    {
        int last = fixture.StartChannel + ChannelCount(fixture) - 1;

        if (last > UniverseSize)
        {
            return $"Runs past channel {UniverseSize}";
        }

        List<string> sharedWith = fixtures
            .Where(other => other.Id != fixture.Id
                && other.StartChannel <= last
                && other.StartChannel + ChannelCount(other) - 1 >= fixture.StartChannel)
            .Select(other => other.Name)
            .ToList();

        return sharedWith.Count == 0 ? null : $"Shares channels with {string.Join(", ", sharedWith)}";
    }

    // The first start channel from `from` onwards where a fixture this wide fits without sharing
    // channels, wrapping round to channel 1; the user's own `from` if nothing is free.
    private int FirstFreeChannel(int from, int channelCount)
    {
        int lastStart = UniverseSize - channelCount + 1;

        IEnumerable<int> candidates = Enumerable.Range(Math.Clamp(from, 1, Math.Max(lastStart, 1)), Math.Max(lastStart - from + 1, 0))
            .Concat(Enumerable.Range(1, Math.Max(Math.Min(from, lastStart + 1) - 1, 0)));

        foreach (int start in candidates)
        {
            int last = start + channelCount - 1;
            bool clashes = fixtures.Any(f => f.StartChannel <= last && f.StartChannel + ChannelCount(f) - 1 >= start);

            if (!clashes)
            {
                return start;
            }
        }

        return Math.Clamp(from, 1, UniverseSize);
    }

    private async Task CloseAsync()
    {
        await Dialog.CloseAsync();
    }
}
