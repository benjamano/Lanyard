@using Lanyard.Application.Services

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="new Icons.Regular.Size24.WindowApps()" Margin="@Margin.End2"/>
            <FluentText Size="@TextSize.Size500">New DMX scene</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @* A plain form so Enter saves. The name is checked as you type, but no error shows until
           you've typed something or tried to save. *@
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <FluentTextInput Label="Scene name"
                             Value="@sceneName"
                             ValueChanged="@OnNameChanged"
                             Immediate="true"
                             Maxlength="@DmxSceneService.MaxSceneNameLength"
                             Placeholder="e.g. Party chase"
                             Style="width: 100%;" />
            @if (showError && Error != null)
            {
                <FluentText Size="TextSize.Size200" Style="color: var(--colorStatusDangerForeground1);">@Error</FluentText>
            }
            <button type="submit" hidden></button>
        </form>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(Error != null)" OnClick="@SaveAsync">Create</FluentButton>
        <FluentButton OnClick="@CancelAsync">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code
{
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private string sceneName = string.Empty;
    private bool showError;

    private string? Error => string.IsNullOrWhiteSpace(sceneName) ? "Give the scene a name."
        : sceneName.Trim().Length > DmxSceneService.MaxSceneNameLength ? $"Keep it to {DmxSceneService.MaxSceneNameLength} characters."
        : null;

    private void OnNameChanged(string? value)
    {
        sceneName = value ?? string.Empty;
        showError = true;
    }

    private async Task SaveAsync()
    {
        showError = true;

        if (Error == null)
        {
            await Dialog.CloseAsync(sceneName.Trim());
        }
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
}
