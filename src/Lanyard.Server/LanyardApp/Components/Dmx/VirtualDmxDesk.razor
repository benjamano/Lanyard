@implements IDisposable

@using Lanyard.Infrastructure.Models.Dmx

@inject IDmxService _dmxService
@inject IDmxSceneService _dmxSceneService
@inject IDmxFixtureService _dmxFixtureService
@inject INotificationService _toastService

<FluentCard Height="auto" Class="p-0 mt-2" Appearance="CardAppearance.Default">
    @if (PreviewingSceneSteps != null && PreviewingSceneSteps.Count > 0)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px" Class="p-3">
            <DmxFixturePreview Fixtures="@fixtures" ChannelValues="@scenePreviewChannelValues" />

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                <FluentButton IconStart="@(isScenePreviewPlaying ? new Icons.Regular.Size20.Pause() : new Icons.Regular.Size20.Play())"
                                Appearance="ButtonAppearance.Transparent"
                                OnClick="TogglePreviewPlayback"
                                Tooltip="@(isScenePreviewPlaying ? "Pause" : "Play")"/>
                <FluentSlider TValue="int"
                                Min="0"
                                Max="@(PreviewingSceneSteps.Count - 1)"
                                Value="@ClampedScenePreviewStepIndex"
                                ValueChanged="@((int index) => ScrubToPreviewStep(index))"
                                Style="flex: 1;"/>
                <FluentText Size="TextSize.Size300">Step @(ClampedScenePreviewStepIndex + 1) / @PreviewingSceneSteps.Count</FluentText>
            </FluentStack>
        </FluentStack>
    }
    else if (ShowFixturePreview && !IsEditingStep)
    {
        <DmxFixturePreview Fixtures="@fixtures" ChannelValues="@channelValuesAsBytes" />
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" HorizontalAlignment="HorizontalAlignment.Left"
                            Style="overflow-x: auto; scrollbar-width: auto;"
                            Class="p-4 ps-0 pt-0">
                @foreach (KeyValuePair<int, int> channel in channelValues)
                {
                    <FluentCard @key="channel.Key" Height="auto" Appearance="CardAppearance.Subtle" Padding="@Padding.All1">
                        <FluentStack Orientation="Orientation.Vertical"
                                    HorizontalAlignment="HorizontalAlignment.Center"
                                    VerticalGap="2"
                                    VerticalAlignment="VerticalAlignment.Center">
                            <FluentSlider Label="@channel.Key.ToString()"
                                            Message="@channel.Value.ToString()"
                                            Orientation="Orientation.Vertical"
                                            Disabled="@(ClientId == null || !IsEditModeEnabled)"
                                            TValue="@int"
                                            Value="@(channel.Value)"
                                            Min="0"
                                            Max="255"
                                            ValueChanged="(int newValue) => UpdateChannelValue(newValue, channel.Key)"
                                            Style="height: 300px; Width: 40px;"
                                            ImmediateDelay="20"
                                            Class="d-flex flex-column gap-3">
                            </FluentSlider>
                            <FluentButton IconStart="new Icons.Regular.Size20.Dismiss()"
                                            Appearance="ButtonAppearance.Default"
                                            OnClick="() => UpdateChannelValue(0, channel.Key)"
                                            Disabled="@(ClientId == null || !IsEditModeEnabled)"
                                            Class="mt-2" />
                        </FluentStack>
                    </FluentCard>
                }
            </FluentStack>
        </FluentStack>
    }
</FluentCard>

@code {
    [Parameter]
    public Guid? ClientId { get; set; }

    [Parameter]
    public bool IsEditModeEnabled { get; set; } = false;

    [Parameter]
    public bool IsBlindModeEnabled { get; set; } = false;

    [Parameter]
    public DmxSceneStep? EditingStep { get; set; }

    [Parameter]
    public bool ShowFixturePreview { get; set; } = false;

    // Set by DmxDesk (sourced from DmxSceneEditor's "Preview Scene" toggle) whenever a scene is
    // being previewed. Takes priority over ShowFixturePreview/the slider grid so the scene's
    // simulated look renders inline in the main desk area using the exact same DmxFixturePreview
    // component as the live preview, instead of a separate smaller copy in the scene editor's sidebar.
    [Parameter]
    public Guid? PreviewingSceneId { get; set; }

    [Parameter]
    public List<DmxSceneStep>? PreviewingSceneSteps { get; set; }

    [Parameter]
    public bool PreviewSceneLoop { get; set; } = true;

    // Key: Channel number (1â€“512), Value: Channel value (0â€“255)
    private Dictionary<int, int> channelValues = new();

    // Presentation-only view of channelValues for DmxFixtureColorMapper, which reads bytes;
    // kept separate so the slider editor's int dictionary is untouched. Maintained alongside
    // channelValues at every write site rather than recomputed on access -- a computed property
    // here would reallocate all ~512 entries on every single-channel live update.
    private Dictionary<int, byte> channelValuesAsBytes = new();

    private List<DmxFixture> fixtures = [];
    private Guid? _loadedFixturesClientId;

    private Guid? _loadedPreviewSceneId;
    private bool isScenePreviewPlaying;
    private int scenePreviewStepIndex;
    private Dictionary<int, byte> scenePreviewChannelValues = new();
    private CancellationTokenSource? _scenePreviewCts;

    // scenePreviewStepIndex is only re-clamped inside the running playback loop; if a step is
    // deleted (via the scene editor's grid) while paused, the raw index can briefly point past
    // the now-shorter PreviewingSceneSteps until the next play/scrub. Rendering always goes
    // through this instead of the raw field so the scrubber/label never show an out-of-range step.
    private int ClampedScenePreviewStepIndex => PreviewingSceneSteps == null || PreviewingSceneSteps.Count == 0
        ? 0
        : Math.Clamp(scenePreviewStepIndex, 0, PreviewingSceneSteps.Count - 1);

    // When a step is selected the desk is a per-step editor: values load from and
    // save to that step's DmxSceneStepChannelValue rows, never the live universe
    // (unless the operator drops blind mode to preview it live).
    private bool IsEditingStep => EditingStep != null;

    // Tracks what the desk is currently bound to so we only reload on a real change.
    private Guid? _loadedStepId;
    private Guid? _loadedClientId;
    private bool _hasLoaded;
    private bool? _previousBlind;

    // Per-channel debounce so dragging a fader writes to the DB once it settles.
    private readonly Dictionary<int, CancellationTokenSource> _saveDebounce = new();

    protected override Task OnInitializedAsync()
    {
        _dmxService.OnChannelValueChanged += HandleChannelValueChanged;

        return Task.CompletedTask;
    }

    private void HandleChannelValueChanged(Guid clientId, int channel, byte value)
    {
        // Blind or edit mode: the desk shows the operator's own buffer, so ignore
        // ingested live events (physical faders / a running scene) that would
        // otherwise overwrite what they are editing.
        if (IsBlindModeEnabled == true || IsEditModeEnabled == true)
        {
            return;
        }

        if (ClientId != null && clientId == ClientId)
        {
            channelValues[channel] = value;
            channelValuesAsBytes[channel] = value;

            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        bool bindingChanged = !_hasLoaded
            || _loadedClientId != ClientId
            || _loadedStepId != EditingStep?.Id;

        if (bindingChanged)
        {
            await LoadChannelValues();
        }

        if (ClientId != _loadedFixturesClientId)
        {
            await LoadFixtures();
        }

        if (PreviewingSceneId != _loadedPreviewSceneId)
        {
            _loadedPreviewSceneId = PreviewingSceneId;

            if (PreviewingSceneId != null && PreviewingSceneSteps != null && PreviewingSceneSteps.Count > 0)
            {
                StartScenePreview();
            }
            else
            {
                StopScenePreview();
            }
        }

        // Operator dropped blind mode while editing a step: push the whole step to
        // the client so the fixtures snap to it and further edits preview live.
        if (_previousBlind == true && !IsBlindModeEnabled && IsEditingStep && ClientId != null)
        {
            await PushBufferLive();
        }

        _previousBlind = IsBlindModeEnabled;
    }

    // Called by DmxDesk after the fixture-manager dialog closes, since adding/editing/deleting a
    // fixture there doesn't otherwise notify this component to reload the (unchanged) ClientId's list.
    public async Task RefreshFixturesAsync()
    {
        await LoadFixtures();

        StateHasChanged();
    }

    private async Task LoadFixtures()
    {
        _loadedFixturesClientId = ClientId;

        if (ClientId == null)
        {
            fixtures = [];

            return;
        }

        Result<IEnumerable<DmxFixture>> result = await _dmxFixtureService.GetFixturesForClientAsync(ClientId.Value);

        fixtures = result.IsSuccess && result.Data != null ? result.Data.ToList() : [];
    }

    // Client-side only: walks PreviewingSceneSteps and paints scenePreviewChannelValues, never
    // calling IDmxService/IDmxSceneRunnerService, so this can never touch real hardware or a
    // scene actually running on a client.
    private void StartScenePreview()
    {
        scenePreviewStepIndex = 0;
        scenePreviewChannelValues = [];

        ApplyPreviewStep(PreviewingSceneSteps![0]);

        StartPreviewPlayback();
    }

    private void StopScenePreview()
    {
        isScenePreviewPlaying = false;

        _scenePreviewCts?.Cancel();
        _scenePreviewCts?.Dispose();
        _scenePreviewCts = null;

        scenePreviewChannelValues = [];
    }

    private void TogglePreviewPlayback()
    {
        if (isScenePreviewPlaying)
        {
            _scenePreviewCts?.Cancel();
            _scenePreviewCts?.Dispose();
            _scenePreviewCts = null;

            isScenePreviewPlaying = false;
        }
        else
        {
            StartPreviewPlayback();
        }
    }

    private void StartPreviewPlayback()
    {
        if (PreviewingSceneSteps == null || PreviewingSceneSteps.Count == 0)
        {
            return;
        }

        isScenePreviewPlaying = true;

        _scenePreviewCts?.Cancel();
        _scenePreviewCts?.Dispose();

        CancellationTokenSource cts = new();
        _scenePreviewCts = cts;

        _ = RunScenePreviewLoopAsync(cts.Token);
    }

    private async Task RunScenePreviewLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (PreviewingSceneSteps == null || PreviewingSceneSteps.Count == 0)
                {
                    break;
                }

                if (scenePreviewStepIndex >= PreviewingSceneSteps.Count)
                {
                    scenePreviewStepIndex = 0;
                }

                DmxSceneStep step = PreviewingSceneSteps[scenePreviewStepIndex];

                ApplyPreviewStep(step);

                await InvokeAsync(StateHasChanged);

                // BPM-synced timing depends on the currently playing song's live position
                // (IDmxSceneRunnerService/IBeatClockService), which this client-side preview
                // has no access to and must not reach into -- approximate every step with its
                // fixed Duration regardless of BpmSyncEnabled.
                TimeSpan delay = step.Duration > TimeSpan.Zero ? step.Duration : TimeSpan.FromMilliseconds(200);

                await Task.Delay(delay, token);

                scenePreviewStepIndex++;

                if (scenePreviewStepIndex >= PreviewingSceneSteps.Count)
                {
                    if (!PreviewSceneLoop)
                    {
                        isScenePreviewPlaying = false;

                        break;
                    }

                    scenePreviewStepIndex = 0;
                }
            }
        }
        catch (TaskCanceledException)
        {
            // Expected on stop/scrub/dispose.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ScrubToPreviewStep(int index)
    {
        if (PreviewingSceneSteps == null || index < 0 || index >= PreviewingSceneSteps.Count)
        {
            return;
        }

        _scenePreviewCts?.Cancel();
        _scenePreviewCts?.Dispose();
        _scenePreviewCts = null;
        isScenePreviewPlaying = false;

        scenePreviewStepIndex = index;

        ApplyPreviewStep(PreviewingSceneSteps[index]);
    }

    private void ApplyPreviewStep(DmxSceneStep step)
    {
        foreach (DmxSceneStepChannelValue channelValue in step.ChannelValues)
        {
            scenePreviewChannelValues[channelValue.ChannelNumber] = channelValue.Value;
        }
    }

    private async Task LoadChannelValues()
    {
        if (IsEditingStep)
        {
            channelValues = Enumerable.Range(1, 512).ToDictionary(i => i, _ => 0);

            foreach (DmxSceneStepChannelValue channelValue in EditingStep!.ChannelValues)
            {
                channelValues[channelValue.ChannelNumber] = channelValue.Value;
            }
        }
        else
        {
            Result<IEnumerable<Infrastructure.Models.Dmx.DmxChannel>>? channelValuesResult = await _dmxService.GetDmxChannelsAsync(ClientId ?? Guid.Empty);

            if (channelValuesResult.IsSuccess && channelValuesResult.Data != null)
            {
                channelValues = channelValuesResult.Data.ToDictionary(kvp => kvp.Address, kvp => (int)kvp.Value);
            }
        }

        channelValuesAsBytes = channelValues.ToDictionary(kvp => kvp.Key, kvp => (byte)kvp.Value);

        _loadedStepId = EditingStep?.Id;
        _loadedClientId = ClientId;
        _hasLoaded = true;

        StateHasChanged();
    }

    private async Task PushBufferLive()
    {
        foreach (KeyValuePair<int, int> channel in channelValues)
        {
            await _dmxService.UpdateChannelValue(ClientId!.Value, channel.Key, (byte)channel.Value);
        }
    }

    public void CreateChannels()
    {
        channelValues = Enumerable.Range(1, 512)
            .ToDictionary(i => i, _ => 0);
        channelValuesAsBytes = Enumerable.Range(1, 512)
            .ToDictionary(i => i, _ => (byte)0);

        StateHasChanged();
    }

    private async Task UpdateChannelValue(int newValue, int channelNumber)
    {
        channelValues[channelNumber] = newValue;
        channelValuesAsBytes[channelNumber] = (byte)newValue;

        if (ClientId == null)
        {
            return;
        }

        if (IsEditingStep)
        {
            // Keep the in-memory step in sync so re-selecting it shows the edit
            // without a DB round trip, then persist (debounced).
            SyncStepChannelValue(channelNumber, (byte)newValue);
            DebounceSaveStepChannelValue(channelNumber, (byte)newValue);

            // Blind OFF = deliberate live preview on the client's DMX.
            if (!IsBlindModeEnabled)
            {
                await _dmxService.UpdateChannelValue(ClientId.Value, channelNumber, (byte)newValue);
            }
        }
        else if (IsBlindModeEnabled == false && IsEditModeEnabled == true)
        {
            await _dmxService.UpdateChannelValue(ClientId.Value, channelNumber, (byte)newValue);
        }
    }

    private void SyncStepChannelValue(int channelNumber, byte value)
    {
        DmxSceneStepChannelValue? existing = EditingStep!.ChannelValues.FirstOrDefault(c => c.ChannelNumber == channelNumber);

        if (existing != null)
        {
            existing.Value = value;
        }
        else
        {
            EditingStep.ChannelValues.Add(new DmxSceneStepChannelValue
            {
                SceneStepId = EditingStep.Id,
                ChannelNumber = channelNumber,
                Value = value,
                CreateByUserId = string.Empty
            });
        }
    }

    private void DebounceSaveStepChannelValue(int channelNumber, byte value)
    {
        if (_saveDebounce.TryGetValue(channelNumber, out CancellationTokenSource? existing))
        {
            existing.Cancel();
            existing.Dispose();
        }

        CancellationTokenSource cts = new();
        _saveDebounce[channelNumber] = cts;

        Guid stepId = EditingStep!.Id;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);

                Result<bool> result = await _dmxSceneService.SaveSceneStepChannelValueAsync(stepId, channelNumber, value);

                if (!result.IsSuccess)
                {
                    _toastService.ShowError($"Failed to save channel {channelNumber}: {result.Error}");
                }
            }
            catch (TaskCanceledException)
            {
                // Superseded by a newer edit to this channel; ignore.
            }
        });
    }

    public void Dispose()
    {
        _dmxService.OnChannelValueChanged -= HandleChannelValueChanged;

        foreach (CancellationTokenSource cts in _saveDebounce.Values)
        {
            cts.Cancel();
            cts.Dispose();
        }

        _saveDebounce.Clear();

        _scenePreviewCts?.Cancel();
        _scenePreviewCts?.Dispose();
    }
}