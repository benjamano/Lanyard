@using Lanyard.App.Services
@using Lanyard.App.Components.Kiosk
@using Lanyard.Infrastructure.DTO.VideoDevices
@using Lanyard.Infrastructure.Models
@using Lanyard.Application.Services
@using Lanyard.Application.Services.Projection
@using Lanyard.Application.Services.Projection.Bindings
@using Lanyard.App.Components.Dashboards.Designer.Settings
@using Lanyard.Infrastructure.Enum

@inject DragStateService DragState
@inject INotificationService _toastService
@inject IProjectionProgramService _projectionProgramService
@inject IDashboardService _dashboardService
@inject IClientService _clientService

<FluentStack class="text-center flow-scroll" Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Top" HorizontalAlignment="HorizontalAlignment.Center">
    <FluentCard Appearance="CardAppearance.Subtle" Class="py-4" draggable="false" @ondragover:preventDefault @ondrop="(e) => OnDropAtIndex(e, 0)">START</FluentCard>

    <FluentStack HorizontalAlignment="HorizontalAlignment.Center" class="w-100 h-auto overflow-scroll" @ondragover:preventDefault @ondrop="(e) => OnDropAtIndex(e, 0)">
        <FluentDivider Orientation="Orientation.Vertical" Style="height: 25px;"></FluentDivider>
    </FluentStack>

    @if (SelectedProgram?.ProjectionProgramSteps != null)
    {
        int index = 0;

        foreach (ProjectionProgramStep step in SelectedProgram.ProjectionProgramSteps.OrderBy(x=> x.SortOrder))
        {
            Dictionary<Guid, ProjectionProgramParameterValue> parameterValueDict = step.ParameterValues.ToDictionary(x => x.ParameterId);

            <ProjectionStepOptionsMenu AnchorId="@($"menu-btn-step-{step.Id}")" ProjectionProgramStep="step" OnDeleteButtonClicked="DeleteProjectionProgramStep"></ProjectionStepOptionsMenu>

            <FluentCard Appearance="CardAppearance.Filled" Class="py-4" draggable="false" @ondragover:preventDefault @ondrop="(e) => OnDropAtIndex(e, index)" id="@($"menu-btn-step-{step.Id}")">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
                    <div>
                        @step.Template?.Name
                    </div>
                    @if (step.ParameterValues.Any(x => x.BindingKey != null))
                    {
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Title="Shows live venue data">
                            Live data
                        </FluentBadge>
                    }
                </FluentStack>

                @if (GameWaitStepNames.IsWaitForGame(step.Template?.Name))
                {
                    <div class="step-summary">@GameWaitSummary(step)</div>
                }
                
                @if (step.Template?.Parameters.Any() == true)
                {
                    <FluentAccordion Size="@AccordionItemSize.Large">
                        @* A Wait for Game step can't play until its event and kiosk are chosen, so its
                           settings start open. *@
                        <FluentAccordionItem class="mt-2" Expanded="@GameWaitStepNames.IsWaitForGame(step.Template?.Name)">
                            <HeaderTemplate>
                                <FluentIcon Value="@(new Icons.Regular.Size20.TaskListRtl())"></FluentIcon>
                                Parameters (@VisibleParameterCount(step))
                            </HeaderTemplate>
                            <ChildContent>
                                <FluentGrid Spacing="3">
                                @foreach (ProjectionProgramStepTemplateParameter parameter in step.Template.Parameters)
                                {
                                    if (!parameterValueDict.TryGetValue(parameter.Id, out ProjectionProgramParameterValue? paramValue))
                                    {
                                        continue;
                                    }

                                    // Seconds Left only means something when waiting for the time left.
                                    if (parameter.Name == GameWaitStepNames.SecondsLeftParameter
                                        && GameWaitStepNames.IsWaitForGame(step.Template?.Name)
                                        && GameWaitEvent(step) != ProjectionGameEvent.TimeLeftBelow)
                                    {
                                        continue;
                                    }

                                    // The seeded template calls it "Video File"; this checked "VideoFile", so the
                                    // video-only filter never applied and any file could be chosen.
                                    bool isVideoParameter = string.Equals(parameter.Name, Lanyard.Shared.Projection.ProjectionParameterNames.Video, StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(parameter.Name, "VideoFile", StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(parameter.DataType, "VideoFile", StringComparison.OrdinalIgnoreCase);

                                    <FluentGridItem Xs="12">
                                        @if (parameter.DataType == GameWaitStepNames.GameEventDataType)
                                        {
                                            <FluentSelect Class="w-100"
                                                          @bind-Value="paramValue.Value"
                                                          TOption="string"
                                                          TValue="string"
                                                          Label="Wait until"
                                                          Required="true">
                                                <FluentOption Value="@string.Empty">Choose an event...</FluentOption>
                                                @foreach (ProjectionGameEvent gameEvent in GameWaitStepNames.Events)
                                                {
                                                    <FluentOption Value="@gameEvent.ToString()">@GameWaitStepNames.EventLabel(gameEvent)</FluentOption>
                                                }
                                            </FluentSelect>
                                        }
                                        else if (parameter.DataType == GameWaitStepNames.LaserKioskDataType)
                                        {
                                            <KioskPicker Value="@ParseKioskId(paramValue.Value)"
                                                         ValueChanged="@(id => paramValue.Value = id?.ToString() ?? string.Empty)"
                                                         Label="@parameter.Name"
                                                         LaserGameKiosksOnly="true"
                                                         Required="true" />
                                        }
                                        else if (string.Equals(parameter.DataType, "Integer", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <FluentTextInput @bind-Value="@paramValue.Value"
                                                             Label="@parameter.Name"
                                                             TextInputType="TextInputType.Number"
                                                             Appearance="TextInputAppearance.Outline"
                                                             Required="@(parameter.IsRequired || parameter.Name == GameWaitStepNames.SecondsLeftParameter)"></FluentTextInput>
                                            @if (!string.IsNullOrWhiteSpace(parameter.Description))
                                            {
                                                <div class="parameter-hint">@parameter.Description</div>
                                            }
                                        }
                                        else if (string.Equals(parameter.DataType, "Dashboard", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <FluentSelect Class="w-100"
                                                          @bind-Value="paramValue.Value"
                                                          TOption="string"
                                                          TValue="string"
                                                          Label="@parameter.Name">
                                                <FluentOption Value="@string.Empty">Select dashboard...</FluentOption>
                                                @foreach (Dashboard dashboard in dashboards)
                                                {
                                                    <FluentOption Value="@dashboard.Id.ToString()">@dashboard.Name</FluentOption>
                                                }
                                            </FluentSelect>
                                        }
                                        else if (string.Equals(parameter.DataType, "VideoDevice", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <FluentSelect Class="w-100"
                                                          @bind-Value="paramValue.Value"
                                                          TOption="string"
                                                          TValue="string"
                                                          Label="@parameter.Name">
                                                <FluentOption Value="@string.Empty">Default (first available)</FluentOption>
                                                @foreach (ActiveVideoDeviceInfoDTO device in videoDevices)
                                                {
                                                    <FluentOption Value="@VideoDeviceParameterValue.Format(device.ClientId, device.DeviceName)">@($"{device.ClientName}: {device.DeviceName}")</FluentOption>
                                                }
                                            </FluentSelect>
                                        }
                                        else if (string.Equals(parameter.DataType, "Boolean", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <FluentSwitch Label="@parameter.Name"
                                                          Value="@(bool.TryParse(paramValue.Value, out bool boolValue) && boolValue)"
                                                          ValueChanged="@(newValue => paramValue.Value = newValue.ToString().ToLowerInvariant())" />
                                        }
                                        else if (parameter.DataType == "File" || isVideoParameter)
                                        {
                                            <FilePicker SelectedFileId="@paramValue.Value"
                                                        AllowedExtensions="@(isVideoParameter ? VideoExtensions : null)"
                                                        OnFileSelected="id => paramValue.Value = id" />
                                        }
                                        else if (ProjectionBindingCatalogue.IsBindable(step.Template?.Name, parameter.Name))
                                        {
                                            <BoundTextParameterEditor ParameterValue="paramValue" Parameter="parameter" OnChanged="StateHasChanged" />
                                        }
                                        else
                                        {
                                            <FluentTextInput @bind-Value="@paramValue.Value" 
                                                        Label="@parameter.Name" 
                                                        Appearance="TextInputAppearance.Outline" 
                                                        Required="@parameter.IsRequired"></FluentTextInput>
                                        }
                                    </FluentGridItem>
                                }
                                </FluentGrid>
                            </ChildContent>
                        </FluentAccordionItem>
                    </FluentAccordion>
                }
            </FluentCard>
            <FluentDivider Orientation="Orientation.Vertical" Style="height: 25px;" @ondragover:preventDefault @ondrop="(e) => OnDropAtIndex(e, index + 1)"></FluentDivider>
            index++;
        }
    }

    <FluentCard Appearance="CardAppearance.Subtle" Class="py-4" draggable="false" @ondragover:preventDefault @ondrop="(e) => OnDropAtEnd(e)">END</FluentCard>
</FluentStack>

@code{
    [Parameter]
    public ProjectionProgram? SelectedProgram { get; set; }

    [Parameter]
    public EventCallback<ProjectionProgram> OnSave { get; set; }

    [Parameter]
    public EventCallback OnStepsChanged { get; set; }

    public bool CanSave => SelectedProgram?.ProjectionProgramSteps?.Count > 0;
    private static readonly string[] VideoExtensions = [".mp4", ".mkv", ".webm", ".mov", ".avi", ".m4v", ".wmv"];
    private List<Dashboard> dashboards = [];
    private List<ActiveVideoDeviceInfoDTO> videoDevices = [];
    private Dictionary<Guid, string> kioskNames = [];

    protected override async Task OnInitializedAsync()
    {
        Result<IEnumerable<Dashboard>> result = await _dashboardService.GetDashboardSummariesAsync();

        if (result.IsSuccess && result.Data is not null)
        {
            dashboards = result.Data.ToList();
        }
        else
        {
            dashboards = [];
        }

        Result<IEnumerable<ActiveVideoDeviceInfoDTO>> videoDeviceResult = await _clientService.GetAllActiveVideoDevicesWithClientNamesAsync();

        if (videoDeviceResult.IsSuccess && videoDeviceResult.Data is not null)
        {
            videoDevices = videoDeviceResult.Data.ToList();
        }
        else
        {
            videoDevices = [];
        }

        // Names for the Wait for Game summary line; the pickers load their own lists.
        Result<IEnumerable<ClientConnectedWithCapabilitiesDTO>> kioskResult = await _clientService.GetClientsWithCapabilitiesAsync();

        kioskNames = kioskResult.IsSuccess && kioskResult.Data is not null
            ? kioskResult.Data.ToDictionary(c => c.Id, c => c.Name)
            : [];
    }

    /// <summary>Adds a step at the end without dragging, from the toolbox's Add button.</summary>
    public async Task AddStepAtEndAsync(ProjectionProgramStepTemplate template)
    {
        if (SelectedProgram is null)
        {
            _toastService.ShowWarning("Please select a projection program to add steps to!");
            return;
        }

        int insertIndex = SelectedProgram.ProjectionProgramSteps.Count;
        InsertStepAt(insertIndex, CreateNewStep(template, insertIndex, SelectedProgram.Id));

        StateHasChanged();

        await NotifyStepsChangedAsync();
    }

    // Seconds Left is hidden unless a Wait for Game step waits for the time left, so don't count it.
    private static int VisibleParameterCount(ProjectionProgramStep step)
    {
        int count = step.Template?.Parameters.Count ?? 0;

        bool hidesSecondsLeft = GameWaitStepNames.IsWaitForGame(step.Template?.Name)
            && GameWaitEvent(step) != ProjectionGameEvent.TimeLeftBelow
            && step.Template!.Parameters.Any(p => p.Name == GameWaitStepNames.SecondsLeftParameter);

        return hidesSecondsLeft ? count - 1 : count;
    }

    private static Guid? ParseKioskId(string? value) =>
        Guid.TryParse(value, out Guid id) && id != Guid.Empty ? id : null;

    private static string? ParameterValueByName(ProjectionProgramStep step, string parameterName)
    {
        ProjectionProgramStepTemplateParameter? parameter = step.Template?.Parameters.FirstOrDefault(p => p.Name == parameterName);

        return parameter is null ? null : step.ParameterValues.FirstOrDefault(v => v.ParameterId == parameter.Id)?.Value;
    }

    private static ProjectionGameEvent? GameWaitEvent(ProjectionProgramStep step) =>
        Enum.TryParse(ParameterValueByName(step, GameWaitStepNames.GameEventParameter), out ProjectionGameEvent gameEvent)
            && Enum.IsDefined(gameEvent)
            ? gameEvent
            : null;

    private string GameWaitSummary(ProjectionProgramStep step)
    {
        ProjectionGameEvent? gameEvent = GameWaitEvent(step);

        if (gameEvent is null)
        {
            return "Choose what to wait for";
        }

        int? secondsLeft = int.TryParse(ParameterValueByName(step, GameWaitStepNames.SecondsLeftParameter), out int seconds) ? seconds : null;
        string summary = $"Waits for {GameWaitStepNames.WaitingFor(gameEvent.Value, secondsLeft)}";

        Guid? kioskId = ParseKioskId(ParameterValueByName(step, GameWaitStepNames.LaserKioskParameter));

        if (kioskId is null)
        {
            return $"{summary} · choose a laser kiosk";
        }

        return kioskNames.TryGetValue(kioskId.Value, out string? name) ? $"{summary} on {name}" : summary;
    }

    private void OnDropAtIndex(DragEventArgs e, int insertIndex)
    {
        if (!DragState.HasDrag || DragState.CurrentTemplate is null || SelectedProgram is null)
        {
            if (SelectedProgram is null)
            {
                _toastService.ShowWarning("Please select a projection program to add steps to!");
            }
            return;
        }

        ProjectionProgramStep newStep = CreateNewStep(DragState.CurrentTemplate, insertIndex, SelectedProgram.Id);
        InsertStepAt(insertIndex, newStep);

        DragState.Clear();
        _ = NotifyStepsChangedAsync();
    }

    private void OnDropAtEnd(DragEventArgs e)
    {
        if (!DragState.HasDrag || DragState.CurrentTemplate is null || SelectedProgram is null)
        {
            if (SelectedProgram is null)
            {
                _toastService.ShowWarning("Please select a projection program to add steps to!");
            }
            return;
        }

        int insertIndex = SelectedProgram.ProjectionProgramSteps.Count;
        ProjectionProgramStep newStep = CreateNewStep(DragState.CurrentTemplate, insertIndex, SelectedProgram.Id);
        InsertStepAt(insertIndex, newStep);

        DragState.Clear();
        _ = NotifyStepsChangedAsync();
    }

    private ProjectionProgramStep CreateNewStep(ProjectionProgramStepTemplate template, int sortOrder, Guid programId)
    {
        ProjectionProgramStep newStep = new()
        {
            Id = Guid.NewGuid(),
            Template = template,
            TemplateId = template.Id,
            SortOrder = sortOrder,
            IsActive = true,
            ProjectionProgramId = programId,
            ParameterValues = new List<ProjectionProgramParameterValue>()
        };

        if (template.Parameters?.Any() == true)
        {
            foreach (ProjectionProgramStepTemplateParameter parameter in template.Parameters)
            {
                newStep.ParameterValues.Add(new ProjectionProgramParameterValue
                {
                    Id = Guid.NewGuid(),
                    ParameterId = parameter.Id,
                    Parameter = parameter,
                    ProjectionProgramStepId = newStep.Id,
                    Value = string.Empty
                });
            }
        }

        return newStep;
    }

    private void InsertStepAt(int index, ProjectionProgramStep newStep)
    {
        if (SelectedProgram is null)
        {
            return;
        }

        index = Math.Clamp(index, 0, SelectedProgram.ProjectionProgramSteps.Count);

        SelectedProgram.ProjectionProgramSteps.Insert(index, newStep);

        for (int i = 0; i < SelectedProgram.ProjectionProgramSteps.Count; i++)
        {
            SelectedProgram.ProjectionProgramSteps[i].SortOrder = i;
        }
    }

    private async Task NotifyStepsChangedAsync()
    {
        await OnStepsChanged.InvokeAsync();
    }

    private async Task DeleteProjectionProgramStep(ProjectionProgramStep step)
    {
        if (SelectedProgram is null)
        {
            return;
        }

        Result<bool> deleteResult = await _projectionProgramService.DeleteProjectionProgramStepAsync(step.Id);

        if (!deleteResult.IsSuccess)
        {
            _toastService.ShowError($"Failed to delete projection program step: {deleteResult.Error}");
            return;
        }

        SelectedProgram.ProjectionProgramSteps.RemoveAll(x => x.Id == step.Id);

        for (int i = 0; i < SelectedProgram.ProjectionProgramSteps.Count; i++)
        {
            SelectedProgram.ProjectionProgramSteps[i].SortOrder = i;
        }

        _toastService.ShowSuccess("Projection program step deleted.");

        await NotifyStepsChangedAsync();
    }
}
