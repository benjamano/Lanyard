@using Lanyard.Infrastructure.Models
@using Lanyard.App.Components.Files

@inject IFileService FileService
@inject INotificationService ToastService

@if (ShowSelectionSummary)
{
    <div class="file-picker">
        <FluentTextInput Value="@selectedFileDisplayName"
                         Label="Selected File"
                         Appearance="TextInputAppearance.Outline"
                         ReadOnly />

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size20.FolderOpen())"
                          OnClick="OpenPickerAsync">
                Browse
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          IconStart="@(new Icons.Regular.Size20.Dismiss())"
                          Disabled="@string.IsNullOrWhiteSpace(selectedFileId)"
                          OnClick="ClearSelectionAsync">
                Clear
            </FluentButton>
        </FluentStack>
    </div>
}

<FluentDialog @ref="_pickerDialog" Modal="true">
    <FluentDialogBody>
        <TitleTemplate>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Value="@(new Icons.Regular.Size20.FolderOpen())" />
                <FluentText Typo="Typography.PaneHeader">Select File</FluentText>
            </FluentStack>
        </TitleTemplate>
        <ChildContent>
        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
                <FluentSpinner />
            </FluentStack>
        }
        else
        {
            <div class="file-picker-dialog-body">
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Center"
                             HorizontalGap="8"
                             Class="mb-2">
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(!currentFolderId.HasValue)"
                                  OnClick="NavigateUpAsync">
                        Up
                    </FluentButton>
                    <FluentText Class="file-picker-current-path">@GetCurrentPathText()</FluentText>
                </FluentStack>

                <FluentGrid Class="w-100">
                    <FluentGridItem Xs="4">
                        <FluentCard Appearance="CardAppearance.Subtle" Height="100%">
                            <FluentText>Folders</FluentText>
                            <FluentDivider class="my-1" />

                            @if (folders.Count == 0)
                            {
                                <FluentText>No folders</FluentText>
                            }
                            else
                            {
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                    @foreach (Folder folder in folders)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      OnClick="@(() => OpenFolderAsync(folder.Id))">
                                            @folder.Name
                                        </FluentButton>
                                    }
                                </FluentStack>
                            }
                        </FluentCard>
                    </FluentGridItem>

                    <FluentGridItem Xs="8">
                        <FluentCard Appearance="CardAppearance.Subtle" Height="100%">
                            <FluentText>Files</FluentText>
                            <FluentDivider class="my-1" />

                            @if (files.Count == 0)
                            {
                                <FluentText>No files in this folder</FluentText>
                            }
                            else
                            {
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                    @foreach (FileMetadata file in files)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      OnClick="@(() => SelectFileAsync(file))">
                                            @file.FileName
                                        </FluentButton>
                                    }
                                </FluentStack>
                            }
                        </FluentCard>
                    </FluentGridItem>
                </FluentGrid>

                <FluentDivider class="my-2" />

                <FluentText Typo="Typography.Body">Or upload a new file here</FluentText>
                <FileUploader Id="file-picker-uploader" SelectedFolderId="@currentFolderId"
                              MaximumFileCount="1" Label="Upload a file"
                              Accept="@BuildAcceptAttribute()"
                              OnFileUploaded="OnFileUploadedAsync" />
            </div>
        }
        </ChildContent>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="ClosePickerAsync">Close</FluentButton>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

@code {
    [Parameter]
    public string? SelectedFileId { get; set; }

    [Parameter]
    public EventCallback<string?> OnFileSelected { get; set; }

    [Parameter]
    public IReadOnlyList<string>? AllowedExtensions { get; set; }

    // Set false when the caller drives opening the dialog itself (via @ref + OpenAsync()) and
    // has nowhere sensible to show a persistent "currently selected" summary - e.g. adding one
    // of several attachments to a list, where there's no single ongoing selection to display.
    [Parameter]
    public bool ShowSelectionSummary { get; set; } = true;

    private readonly HashSet<string> allowedExtensions = [];
    private readonly Dictionary<Guid, Folder> folderLookup = [];

    private List<FileMetadata> files = [];
    private List<Folder> folders = [];
    private string? selectedFileId;
    private string selectedFileDisplayName = "No file selected";
    private FluentDialog? _pickerDialog;
    private bool isLoading;
    private Guid? currentFolderId;

    protected override async Task OnParametersSetAsync()
    {
        RefreshAllowedExtensions();

        if (SelectedFileId == selectedFileId)
        {
            return;
        }

        selectedFileId = SelectedFileId;

        if (!Guid.TryParse(selectedFileId, out Guid fileId))
        {
            selectedFileDisplayName = "No file selected";
            return;
        }

        Result<FileMetadata> metadataResult = await FileService.GetFileMetadataAsync(fileId, CancellationToken.None);

        if (metadataResult.Success && metadataResult.Data is not null)
        {
            selectedFileDisplayName = metadataResult.Data.FileName;
            return;
        }

        selectedFileDisplayName = "Unknown file";
    }

    // Public so a caller with ShowSelectionSummary="false" can open the dialog from its own
    // trigger button (via @ref) instead of the Browse button this component no longer renders.
    // The optional folder lets a caller land the browser straight in a specific folder (e.g. a
    // company's standing-attachments folder) instead of always starting at Root - seeded into
    // folderLookup too, so the breadcrumb and Up button resolve correctly on the very first
    // render, before that folder has ever appeared in a listing of its own children.
    public async Task OpenAsync(Folder? folder = null)
    {
        if (folder is not null)
        {
            folderLookup[folder.Id] = folder;
            currentFolderId = folder.Id;
        }
        else
        {
            // Otherwise a folder passed on a previous call (this component instance persists
            // across dialog close/reopen) would still be selected here, contradicting the "falls
            // back to Root" behavior callers rely on when they have no folder to pass (e.g. a
            // failed lookup/create upstream).
            currentFolderId = null;
        }

        await OpenPickerAsync();
    }

    private async Task OpenPickerAsync()
    {
        await _pickerDialog!.ShowAsync();
        await LoadFolderContentsAsync(currentFolderId);
    }

    private async Task ClosePickerAsync()
    {
        await _pickerDialog!.HideAsync();
    }

    private async Task LoadFolderContentsAsync(Guid? folderId)
    {
        isLoading = true;
        currentFolderId = folderId;

        Result<IReadOnlyList<Folder>> folderResult = await FileService.ListFoldersAsync(folderId, CancellationToken.None);
        if (folderResult.Success && folderResult.Data is not null)
        {
            folders = folderResult.Data.OrderBy(x => x.Name).ToList();
            foreach (Folder folder in folders)
            {
                folderLookup[folder.Id] = folder;
            }
        }
        else
        {
            folders = [];
            ToastService.ShowError($"Failed to load folders: {folderResult.Error}");
        }

        Result<IReadOnlyList<FileMetadata>> fileResult = await FileService.ListFilesAsync(folderId, CancellationToken.None);
        if (fileResult.Success && fileResult.Data is not null)
        {
            files = fileResult.Data
                .Where(IsAllowedFile)
                .OrderBy(x => x.FileName)
                .ToList();
        }
        else
        {
            files = [];
            ToastService.ShowError($"Failed to load files: {fileResult.Error}");
        }

        isLoading = false;

        // OpenAsync can be invoked via @ref from a different component's own event handler (e.g.
        // OnboardingSettingsManager's "Add Attachment" button) - Blazor's automatic post-event
        // re-render only covers the component that owns the triggering event, not an unrelated
        // component reached through a stored @ref, so without this explicit call the dialog can
        // open showing stale content (breadcrumb stuck on "Root") even though currentFolderId/
        // folders/files are all already correct here.
        StateHasChanged();
    }

    private async Task OpenFolderAsync(Guid folderId)
    {
        await LoadFolderContentsAsync(folderId);
    }

    private async Task NavigateUpAsync()
    {
        if (!currentFolderId.HasValue)
        {
            return;
        }

        if (!folderLookup.TryGetValue(currentFolderId.Value, out Folder? currentFolder))
        {
            await LoadFolderContentsAsync(null);
            return;
        }

        await LoadFolderContentsAsync(currentFolder.ParentFolderId);
    }

    private async Task SelectFileAsync(FileMetadata file)
    {
        string newFileId = file.Id.ToString();

        selectedFileId = newFileId;
        selectedFileDisplayName = file.FileName;

        // Notify the parent before any await: a render with the old SelectedFileId can
        // interleave at the first await and OnParametersSetAsync would clobber the selection.
        await OnFileSelected.InvokeAsync(newFileId);
        await _pickerDialog!.HideAsync();
    }

    // Uploads straight into whatever folder is currently open and immediately selects the result
    // - the whole point is that a caller never has to leave this dialog, go to the File Manager,
    // upload there, and come back to find the file they just added.
    private async Task OnFileUploadedAsync(FileMetadata file)
    {
        // The Accept attribute on the uploader is only a browser-level hint - a caller can still
        // pick a disallowed file via "All files", drag-and-drop, or a non-browser client. Without
        // this check it would bypass IsAllowedFile (which the existing Files browse list already
        // enforces) and become e.g. a video-only parameter's value uncontested.
        if (!IsAllowedFile(file))
        {
            await FileService.DeleteFileAsync(file.Id, CancellationToken.None);
            ToastService.ShowError($"\"{file.FileName}\" is not an allowed file type here and was not added.");
            await LoadFolderContentsAsync(currentFolderId);
            return;
        }

        await SelectFileAsync(file);
    }

    // Mirrors allowedExtensions (already normalized to ".ext" form by RefreshAllowedExtensions)
    // into the format <input accept> expects, so the browser's own file picker steers users away
    // from disallowed types before they even reach IsAllowedFile's after-the-fact check above.
    private string? BuildAcceptAttribute() =>
        allowedExtensions.Count == 0 ? null : string.Join(',', allowedExtensions);

    private async Task ClearSelectionAsync()
    {
        selectedFileId = null;
        selectedFileDisplayName = "No file selected";
        await OnFileSelected.InvokeAsync(null);
    }

    private string GetCurrentPathText()
    {
        if (!currentFolderId.HasValue)
        {
            return "Root";
        }

        if (!folderLookup.TryGetValue(currentFolderId.Value, out Folder? currentFolder))
        {
            return "Root";
        }

        List<string> segments = [currentFolder.Name];
        Guid? parentId = currentFolder.ParentFolderId;

        while (parentId.HasValue && folderLookup.TryGetValue(parentId.Value, out Folder? parentFolder))
        {
            segments.Add(parentFolder.Name);
            parentId = parentFolder.ParentFolderId;
        }

        segments.Reverse();
        return $"Root / {string.Join(" / ", segments)}";
    }

    private void RefreshAllowedExtensions()
    {
        allowedExtensions.Clear();

        if (AllowedExtensions is null || AllowedExtensions.Count == 0)
        {
            return;
        }

        foreach (string extension in AllowedExtensions.Where(x => !string.IsNullOrWhiteSpace(x)))
        {
            string normalized = extension.Trim().ToLowerInvariant();

            if (!normalized.StartsWith('.'))
            {
                normalized = $".{normalized}";
            }

            allowedExtensions.Add(normalized);
        }
    }

    private bool IsAllowedFile(FileMetadata file)
    {
        if (allowedExtensions.Count == 0)
        {
            return true;
        }

        string extension = Path.GetExtension(file.FileName).ToLowerInvariant();
        return allowedExtensions.Contains(extension);
    }
}
