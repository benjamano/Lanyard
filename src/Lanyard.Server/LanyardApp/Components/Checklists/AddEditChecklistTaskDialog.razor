@using Lanyard.Application.Services.Checklists

@inject IChecklistService _checklistService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentIcon Value="@(new Icons.Regular.Size24.TaskListLtr())" />
            <FluentText As="@TextTag.H3">@(Existing is null ? "Add task" : "Edit task")</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <div class="task-dialog">
            @if (errorMessage is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@errorMessage</FluentMessageBar>
            }

            <FluentTextInput @bind-Value="title" Label="Task" Placeholder="e.g. Unlock the fire exits" Required="true" Width="100%"
                             Maxlength="@ChecklistRules.MaxTaskTitleLength" />

            <FluentTextArea @bind-Value="detail" Label="Details (optional)" Rows="2" Width="100%"
                            Placeholder="Anything people need to know to do it"
                            Maxlength="@ChecklistRules.MaxTaskDetailLength" />

            <FluentSelect TOption="ResponseOption" TValue="string" Items="@responseOptions" OptionText="@(x => x.Label)" OptionValue="@(x => x.Value)"
                          @bind-Value="response" Label="Ticking it asks for" Width="100%" />

            @if (response == nameof(ChecklistResponse.Number))
            {
                <FluentTextInput @bind-Value="unit" Label="Unit (optional)" Placeholder="e.g. °C" Width="100%"
                                 Maxlength="@ChecklistRules.MaxUnitLength" />
                <div class="task-dialog-hint">People type the reading in when they tick it, such as the fridge temperature.</div>
            }
            else if (response == nameof(ChecklistResponse.TickWithNote))
            {
                <div class="task-dialog-hint">People can add a short note when they tick it. The note is optional.</div>
            }
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentStack HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8">
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@isBusy" OnClick="@SaveAsync">@(isBusy ? "Saving..." : "Save")</FluentButton>
            <FluentButton Disabled="@isBusy" OnClick="@(() => Dialog.CancelAsync())">Cancel</FluentButton>
        </FluentStack>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter, EditorRequired]
    public required Guid ChecklistId { get; set; }

    [Parameter]
    public ChecklistTask? Existing { get; set; }

    private record ResponseOption(string Value, string Label);

    private readonly List<ResponseOption> responseOptions =
    [
        new(nameof(ChecklistResponse.Tick), "Just a tick"),
        new(nameof(ChecklistResponse.TickWithNote), "A tick, with an optional note"),
        new(nameof(ChecklistResponse.Number), "A number reading")
    ];

    private string title = string.Empty;
    private string? detail;
    private string response = nameof(ChecklistResponse.Tick);
    private string? unit;
    private string? errorMessage;
    private bool isBusy;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            title = Existing.Title;
            detail = Existing.Detail;
            response = Existing.Response.ToString();
            unit = Existing.Unit;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        ChecklistTask task = new()
        {
            Id = Existing?.Id ?? Guid.Empty,
            ChecklistId = ChecklistId,
            Title = title,
            Detail = detail,
            Response = Enum.TryParse(response, out ChecklistResponse parsed) ? parsed : ChecklistResponse.Tick,
            Unit = unit
        };

        if (ChecklistRules.Validate(task) is string invalid)
        {
            errorMessage = invalid;
            return;
        }

        Result<LocationScope> scope = await _currentLocationContext.GetScopeAsync();
        Result<string> actingUser = await _securityService.GetCurrentUserIdAsync();

        if (!scope.IsSuccess || scope.Data is null || !actingUser.IsSuccess || string.IsNullOrEmpty(actingUser.Data))
        {
            errorMessage = "Couldn't confirm who you are - try reloading the page.";
            return;
        }

        isBusy = true;
        Result<ChecklistTask> result = await _checklistService.SaveTaskAsync(scope.Data, task, actingUser.Data);
        isBusy = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.Error ?? "Couldn't save the task.";
            return;
        }

        await Dialog.CloseAsync(true);
    }
}
