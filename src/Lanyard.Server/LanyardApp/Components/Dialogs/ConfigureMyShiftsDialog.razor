@using Lanyard.Infrastructure.Models

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
            <FluentIcon Value="@(new Icons.Regular.Size24.CalendarLtr())" />
            <FluentText Weight="TextWeight.Semibold" Color="Color.Default" Size="@TextSize.Size700">
                Configure My Shifts
            </FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentNumberInput TValue="int" @bind-Value="Widget.DaysAhead" Min="1" Max="MyShiftsWidget.MaxDaysAhead"
                               Label="Days ahead to show" />
            <FluentNumberInput TValue="int" @bind-Value="Widget.MaxItems" Min="1" Max="MyShiftsWidget.MaxSupportedItems"
                               Label="Maximum items to show" />
            <FluentCheckbox @bind-Value="Widget.ShowTimeOff" Label="Include my time off" />
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SaveAsync">Save</FluentButton>
        <FluentButton OnClick="@CancelAsync">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter]
    public required MyShiftsWidget Widget { get; set; }

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    // Snapshot so Cancel can revert the live-edited widget.
    private int _originalDaysAhead;
    private int _originalMaxItems;
    private bool _originalShowTimeOff;

    protected override void OnInitialized()
    {
        _originalDaysAhead = Widget.DaysAhead;
        _originalMaxItems = Widget.MaxItems;
        _originalShowTimeOff = Widget.ShowTimeOff;
    }

    private async Task SaveAsync()
    {
        // Min/Max only limit the stepper buttons; a typed value outside them would otherwise stick.
        Widget.DaysAhead = Math.Clamp(Widget.DaysAhead, 1, MyShiftsWidget.MaxDaysAhead);
        Widget.MaxItems = Math.Clamp(Widget.MaxItems, 1, MyShiftsWidget.MaxSupportedItems);

        await Dialog.CloseAsync(true);
    }

    private async Task CancelAsync()
    {
        Widget.DaysAhead = _originalDaysAhead;
        Widget.MaxItems = _originalMaxItems;
        Widget.ShowTimeOff = _originalShowTimeOff;

        await Dialog.CancelAsync();
    }
}
