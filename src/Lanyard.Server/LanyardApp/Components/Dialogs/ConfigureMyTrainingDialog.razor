@using Lanyard.Infrastructure.Models

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
            <FluentIcon Value="@(new Icons.Regular.Size24.BookOpen())" />
            <FluentText Weight="TextWeight.Semibold" Color="Color.Default" Size="@TextSize.Size700">
                Configure My Training
            </FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentCheckbox @bind-Value="Widget.IncludeCompleted" Label="Include completed courses" />
            <FluentNumberInput TValue="int" @bind-Value="Widget.MaxItems" Min="1" Max="50"
                               Label="Maximum courses to show" />
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SaveAsync">
            Save
        </FluentButton>
        <FluentButton OnClick="@CancelAsync">Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter]
    public required MyTrainingWidget Widget { get; set; }

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    // Snapshot so Cancel can revert the live-edited widget.
    private bool _originalIncludeCompleted;
    private int _originalMaxItems;

    protected override void OnInitialized()
    {
        _originalIncludeCompleted = Widget.IncludeCompleted;
        _originalMaxItems = Widget.MaxItems;
    }

    private async Task SaveAsync()
    {
        // Min on the input only constrains the stepper buttons - a typed-in 0 or negative
        // would otherwise persist and render an empty widget.
        Widget.MaxItems = Math.Clamp(Widget.MaxItems, 1, 50);

        await Dialog.CloseAsync(true);
    }

    private async Task CancelAsync()
    {
        Widget.IncludeCompleted = _originalIncludeCompleted;
        Widget.MaxItems = _originalMaxItems;

        await Dialog.CancelAsync();
    }
}
