@using Lanyard.App.Components.Clients
@using Lanyard.App.Components.Dmx

@inject IClientService _clientService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.Settings())" />
            <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">
                @(string.IsNullOrEmpty(_clientName) ? "Client Settings" : $"{_clientName} Settings")
            </FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <FluentTabs Orientation="Orientation.Horizontal" Size="TabsSize.Small" Height="min(600px, 70dvh)">
            <FluentTab Header="General" IconStart="@(new Icons.Regular.Size16.Person())">
                <EditForm Model="_updateClientModel" OnValidSubmit="SaveGeneralAsync">
                    <FluentTextInput @bind-Value="_updateClientModel.Name" class="w-100" Label="Client Name"
                                     Placeholder="Enter new client name..." />
                    @* Rendered once the locations are in: the dropdown doesn't reselect its value
                       when options arrive after it, so it would show "Not set" for a set kiosk. *@
                    @if (_locationsLoaded)
                    {
                        <FluentSelect TOption="string" TValue="string" @bind-Value="_updateClientModel.LocationValue"
                                      Label="Location" Class="mt-2 w-100">
                            <FluentOption Value="@NoLocationValue">Not set</FluentOption>
                            @foreach (Location location in _locations)
                            {
                                <FluentOption Value="@location.Id.ToString()">@location.Name</FluentOption>
                            }
                        </FluentSelect>
                    }
                    <div class="mt-1">
                        <FluentText Color="Color.Info" Size="TextSize.Size200">
                            The kiosk plays that location's music schedule.
                        </FluentText>
                    </div>
                    <FluentButton Class="mt-2" Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                  IconStart="@(new Icons.Regular.Size20.Save())">Save</FluentButton>
                </EditForm>
            </FluentTab>
            <FluentTab Header="Health" IconStart="@(new Icons.Regular.Size16.Heart())" DeferredLoading="true">
                <ClientHealthDetails ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Projection" IconStart="@(new Icons.Regular.Size16.ProjectionScreenText())" DeferredLoading="true">
                <ClientProjectionCapabilities ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Offline" IconStart="@(new Icons.Regular.Size16.CloudOff())" DeferredLoading="true">
                <ClientOfflineFallback ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Music" IconStart="@(new Icons.Regular.Size16.MusicNote2())" DeferredLoading="true">
                <ClientMusicCapabilities ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="DMX" IconStart="@(new Icons.Regular.Size16.Lightbulb())" DeferredLoading="true">
                <ClientDmxConfig ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Zone Scoreboard" IconStart="@(new Icons.Regular.Size16.Board())" DeferredLoading="true">
                <ClientZoneScoreboardSettings ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Auto Restart" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" DeferredLoading="true">
                <ClientRestartSchedule ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Updates" IconStart="@(new Icons.Regular.Size16.ArrowSync())" DeferredLoading="true">
                <ClientUpdateSettings ClientId="@ClientId" />
            </FluentTab>
            <FluentTab Header="Security" IconStart="@(new Icons.Regular.Size16.Shield())" DeferredLoading="true">
                <ClientSecuritySettings ClientId="@ClientId" ClientName="@_clientName" />
            </FluentTab>
        </FluentTabs>
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="CloseDialog">Close</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter]
    public Guid ClientId { get; set; }

    private const string NoLocationValue = "none";

    private UpdateClientModel _updateClientModel = new();
    private string? _clientName;
    private int? _savedLocationId;
    private List<Location> _locations = [];
    private bool _locationsLoaded;

    private class UpdateClientModel
    {
        public string Name { get; set; } = string.Empty;
        public string LocationValue { get; set; } = NoLocationValue;
    }

    protected override async Task OnInitializedAsync()
    {
        Result<Client?> result = await _clientService.GetClientFromIdAsync(ClientId);

        if (result.IsSuccess && result.Data != null)
        {
            _updateClientModel.Name = result.Data.Name;
            _clientName = result.Data.Name;
            _savedLocationId = result.Data.LocationId;

            Result<List<Location>> locations = await _companyLocationService.GetLocationsAsync(result.Data.CompanyId);
            _locations = locations.IsSuccess ? (locations.Data ?? []).Where(x => x.IsActive).OrderBy(x => x.Name).ToList() : [];

            _updateClientModel.LocationValue = result.Data.LocationId?.ToString() ?? NoLocationValue;
            _locationsLoaded = true;
        }
        else
        {
            _toastService.ShowError($"Failed to load client, {result.Error}");
        }
    }

    private async Task SaveGeneralAsync()
    {
        int? locationId = int.TryParse(_updateClientModel.LocationValue, out int parsed) ? parsed : null;

        // Without the list there's no picker on screen, so the value hasn't been chosen.
        if (_locationsLoaded && locationId != _savedLocationId)
        {
            Result<bool> locationResult = await _clientService.SetClientLocationAsync(ClientId, locationId);

            if (!locationResult.IsSuccess)
            {
                _toastService.ShowError($"Couldn't change the location: {locationResult.Error}");
                return;
            }

            _savedLocationId = locationId;
        }

        await SaveNewClientNameAsync();
    }

    private async Task SaveNewClientNameAsync()
    {
        Result<Client?> getResult = await _clientService.GetClientFromIdAsync(ClientId);

        if (!getResult.IsSuccess || getResult.Data == null)
        {
            _toastService.ShowError($"An error occured when updating the name of this client, {getResult.Error}");
            return;
        }

        Client client = getResult.Data;
        client.Name = _updateClientModel.Name;

        Result<Client?> updateResult = await _clientService.UpdateClientAsync(client);

        if (updateResult.IsSuccess)
        {
            _toastService.ShowSuccess("Saved!");
            _clientName = _updateClientModel.Name;
        }
        else
        {
            _toastService.ShowError($"An error occured when updating the name of this client, {updateResult.Error}");
        }
    }

    private async Task CloseDialog()
    {
        await Dialog.CloseAsync();
    }
}
