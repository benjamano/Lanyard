@* Module switches per location (what each venue pays for). Each switch saves as soon as it's
   flipped - there's no separate Save, so what's shown is always what staff get. Desktop shows a
   feature x location grid; on a phone each feature stacks its locations underneath it. *@

@inject ICompanyFeatureService CompanyFeatureService

<div class="cfm">
    <FluentCard Height="auto">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size400">Features for @CompanyName</FluentText>
                <FluentText Class="cfm-hint">
                    Each location only gets the features switched on for it here, and a new location starts
                    with everything off. Turning a feature off hides it from that location's menu, home screen
                    and dashboards, and blocks its pages. Nothing is deleted, so switching it back on brings
                    everything back. Admins always see every feature.
                </FluentText>
            </FluentStack>

            @if (_grid is null)
            {
                <FluentProgressBar />
            }
            else if (_grid.Locations.Count == 0)
            {
                <FluentText Class="cfm-hint">Add a location above to choose its features.</FluentText>
            }
            else
            {
                <div class="cfm-grid" role="table" aria-label="@($"Features for {CompanyName}")"
                     style="@($"--cfm-locations: {_grid.Locations.Count}")">
                    <div class="cfm-row cfm-head" role="row">
                        <div class="cfm-feature" role="columnheader">Feature</div>
                        @foreach (FeatureLocation location in _grid.Locations)
                        {
                            <div class="cfm-cell cfm-location-head" role="columnheader" @key="location.LocationId">
                                <FluentText Weight="TextWeight.Semibold">@location.Name</FluentText>
                                @if (!AllOn(location))
                                {
                                    <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                                  Disabled="@(_saving is not null || _savingAll is not null)"
                                                  OnClick="@(() => SwitchAllOnAsync(location))">
                                        All on
                                    </FluentButton>
                                }
                            </div>
                        }
                    </div>

                    @foreach (CompanyFeatureInfo feature in _grid.Features)
                    {
                        <div class="cfm-row" role="row" @key="feature.Feature">
                            <div class="cfm-feature" role="rowheader">
                                <FluentText Weight="TextWeight.Semibold">@feature.Name</FluentText>
                                <FluentText Class="cfm-hint">@feature.Description</FluentText>
                            </div>
                            @foreach (FeatureLocation location in _grid.Locations)
                            {
                                <div class="cfm-cell" role="cell" @key="location.LocationId">
                                    <span class="cfm-cell-label">@location.Name</span>
                                    <FluentSwitch Value="@_grid.IsEnabled(location.LocationId, feature.Feature)"
                                                  ValueChanged="@(value => SetEnabledAsync(location, feature, value))"
                                                  Disabled="@(_saving == (location.LocationId, feature.Feature) || _savingAll == location.LocationId)"
                                                  aria-label="@($"{feature.Name} at {location.Name}")" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </FluentStack>
    </FluentCard>
</div>

@code {
    [Parameter, EditorRequired]
    public int CompanyId { get; set; }

    [Parameter, EditorRequired]
    public string CompanyName { get; set; } = string.Empty;

    // Bumped by the page when a location is added or deactivated, so the columns reload.
    [Parameter]
    public int LocationsVersion { get; set; }

    private CompanyFeatureGrid? _grid;
    private (int LocationId, CompanyFeature Feature)? _saving;
    private int? _savingAll;
    private (int CompanyId, int Version)? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_grid is not null && _loadedFor == (CompanyId, LocationsVersion))
        {
            return;
        }

        _grid = null;
        _loadedFor = (CompanyId, LocationsVersion);

        Result<CompanyFeatureGrid> result = await CompanyFeatureService.GetFeatureGridAsync(CompanyId);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to load features: {result.Error}");
            _grid = new CompanyFeatureGrid([], [], []);
            return;
        }

        _grid = result.Data!;
    }

    private bool AllOn(FeatureLocation location) =>
        _grid is not null && _grid.Features.All(x => _grid.IsEnabled(location.LocationId, x.Feature));

    private async Task<Result<bool>> SaveAsync(FeatureLocation location, CompanyFeature feature, bool isEnabled)
    {
        Result<LocationScope> scope = await _currentLocationContext.GetScopeAsync();
        Result<string> userId = await _securityService.GetCurrentUserIdAsync();

        Result<bool> result = scope.IsSuccess
            ? await CompanyFeatureService.SetFeatureEnabledAsync(scope.Data!, location.LocationId, feature, isEnabled, userId.Data)
            : Result<bool>.Fail(scope.Error ?? "Couldn't work out who you are.");

        if (result.IsSuccess)
        {
            if (isEnabled)
            {
                _grid!.Enabled.Add((location.LocationId, feature));
            }
            else
            {
                _grid!.Enabled.Remove((location.LocationId, feature));
            }
        }

        return result;
    }

    private async Task SetEnabledAsync(FeatureLocation location, CompanyFeatureInfo feature, bool isEnabled)
    {
        if (_grid is null || _grid.IsEnabled(location.LocationId, feature.Feature) == isEnabled)
        {
            return;
        }

        _saving = (location.LocationId, feature.Feature);

        Result<bool> result = await SaveAsync(location, feature.Feature, isEnabled);

        _saving = null;

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to update {feature.Name} at {location.Name}: {result.Error}");
            return;
        }

        _toastService.ShowSuccess($"{feature.Name} turned {(isEnabled ? "on" : "off")} at {location.Name}.");
    }

    private async Task SwitchAllOnAsync(FeatureLocation location)
    {
        if (_grid is null)
        {
            return;
        }

        _savingAll = location.LocationId;

        foreach (CompanyFeatureInfo feature in _grid.Features.Where(x => !_grid.IsEnabled(location.LocationId, x.Feature)).ToList())
        {
            Result<bool> result = await SaveAsync(location, feature.Feature, true);

            if (!result.IsSuccess)
            {
                _savingAll = null;
                _toastService.ShowError($"Failed to turn on {feature.Name} at {location.Name}: {result.Error}");
                return;
            }
        }

        _savingAll = null;

        _toastService.ShowSuccess($"Every feature is on at {location.Name}.");
    }
}
