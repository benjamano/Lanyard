@using Lanyard.Infrastructure.Models
@using Lanyard.Infrastructure.DTO
@using Lanyard.Application.Services
@using System.Text.Json

@inject IClientService _clientService
@inject Lanyard.Application.Services.Parties.IPartyBookingService _partyBookingService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.Pen())" />
            <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">Execution Detail</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentText><strong>Rule:</strong> @Content.RuleName</FluentText>
            <FluentText><strong>Trigger Event:</strong> @Content.TriggerEvent</FluentText>
            @if (Content.IsTestRun)
            {
                <FluentText>
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand">Test</FluentBadge>
                    <span> Run by hand with Run now (test). It doesn't count as the rule's last run.</span>
                </FluentText>
            }
            <FluentText><strong>Executed At:</strong> @Content.ExecutedAt.ToLocalTime().ToString("g")</FluentText>
            <FluentText>
                <strong>Overall:</strong>
                @if (Content.SkipReason != null)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative">Skipped</FluentBadge>
                }
                else if (Content.OverallSuccess)
                {
                    <FluentIcon Icon="Icons.Regular.Size20.CheckmarkCircle" Color="Color.Success" />
                    <span> Success</span>
                }
                else
                {
                    <FluentIcon Icon="Icons.Regular.Size20.DismissCircle" Color="Color.Error" />
                    <span> Failed</span>
                }
            </FluentText>

            @if (Content.SkipReason != null)
            {
                <FluentText><strong>Why it was skipped:</strong> @Content.SkipReason</FluentText>
            }

            @if (Content.PartyBookingId is Guid partyId)
            {
                @* The log keeps only the party's id, so this is looked up now: a party since
                   removed just says so. *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Wrap="true">
                    <FluentText><strong>Party:</strong> @(_partyLoaded ? _partySummary ?? "This party no longer exists." : "Loading...")</FluentText>
                    @if (_partySummary is not null)
                    {
                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="@(() => OpenPartyAsync(partyId))">Open party</FluentButton>
                    }
                </FluentStack>
            }

            <FluentDivider />

            <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size400">Actions</FluentText>

            @foreach (AutomationRuleActionExecution ae in Content.ActionExecutions)
            {
                <AutomationActionResultCard Success="@ae.Success"
                                            Heading="@(ae.AutomationRuleAction?.ActionType ?? "Unknown action")"
                                            Detail="@($"Target: {ResolveTargetClient(ae)}")"
                                            Error="@ae.ErrorMessage" />
            }

            @if (Content.SkipReason != null)
            {
                <FluentText>No actions ran because a condition wasn't met.</FluentText>
            }
            else if (Content.ActionExecutions.Count == 0)
            {
                <FluentText>No action execution records.</FluentText>
            }
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="@CloseAsync" Appearance="ButtonAppearance.Outline">Close</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
#nullable enable

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter]
    public AutomationRuleExecution Content { get; set; } = default!;

    private IEnumerable<ClientConnectedDTO> _clients = [];

    private bool _partyLoaded;
    private string? _partySummary;

    protected override async Task OnInitializedAsync()
    {
        Result<IEnumerable<ClientConnectedDTO>> result = await _clientService.GetClientsAsync();
        if (result.IsSuccess)
        {
            _clients = result.Data ?? [];
        }

        if (Content.PartyBookingId is Guid partyId)
        {
            Result<LocationScope> scope = await _currentLocationContext.GetScopeAsync();

            if (scope.IsSuccess && scope.Data is not null)
            {
                Result<PartyBooking> party = await _partyBookingService.GetBookingAsync(scope.Data, partyId);

                if (party.IsSuccess && party.Data is PartyBooking booking)
                {
                    // When and where, not who: the same detail the log row itself is allowed to hold.
                    string when = $"{RotaTime.LocalDate(booking.StartUtc):ddd d MMM} at {RotaTime.LocalTime(booking.StartUtc):HH:mm}";
                    string room = string.IsNullOrWhiteSpace(booking.Room) ? string.Empty : $", {booking.Room}";
                    string cancelled = booking.Status == Lanyard.Infrastructure.Enum.PartyBookingStatus.Cancelled ? " (since cancelled)" : string.Empty;
                    _partySummary = $"{when}{room}{cancelled}";
                }
            }

            _partyLoaded = true;
        }
    }

    private async Task OpenPartyAsync(Guid partyId)
    {
        await Dialog.CancelAsync();
        _navigationManager.NavigateTo($"/manage/parties/{partyId}");
    }

    private string ResolveTargetClient(AutomationRuleActionExecution ae)
    {
        if (ae.AutomationRuleAction is null)
        {
            return "Unknown";
        }
        try
        {
            JsonDocument doc = JsonDocument.Parse(ae.AutomationRuleAction.ParametersJson);
            Guid targetId = doc.RootElement.GetProperty("TargetClientId").GetGuid();
            return _clients.FirstOrDefault(c => c.Id == targetId)?.Name ?? targetId.ToString();
        }
        catch
        {
            return "Unknown";
        }
    }

    private async Task CloseAsync()
    {
        await Dialog.CancelAsync();
    }
}
