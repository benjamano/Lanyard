@using Lanyard.Application.Services.StaffDocuments
@using Lanyard.Infrastructure.Models

@inject IStaffDocumentTypeService _staffDocumentTypeService
@inject INotificationService ToastService

<FluentCard Height="auto" Class="mt-2">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentText Typo="Typography.H4">Staff Document Types</FluentText>

        @if (documentTypes is null)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                <FluentSpinner />
                <FluentText>Loading...</FluentText>
            </FluentStack>
        }
        else if (documentTypes.Count == 0)
        {
            <FluentText Style="text-align: center; color: var(--neutral-foreground-hint);">
                No document types exist yet for this company.
            </FluentText>
        }
        else
        {
            <div class="document-type-list">
                @foreach (StaffDocumentType type in documentTypes.OrderBy(x => x.SortOrder))
                {
                    <div class="document-type-list-item">
                        <div class="document-type-list-info">
                            <div class="document-type-list-name">@type.Name</div>
                            @if (!string.IsNullOrWhiteSpace(type.Description))
                            {
                                <div class="document-type-list-description">@type.Description</div>
                            }
                            <div class="document-type-list-meta">
                                @(type.RequiresExpiryDate ? "Requires an expiry date" : "No expiry date required")
                            </div>
                            <div class="document-type-list-reminder-label">Reminder days before expiry</div>
                            <div class="document-type-list-reminder">
                                <FluentTextInput Value="@FormatIntervals(type)" ValueChanged="@((string v) => { intervalEdits[type.Id] = v; })"
                                                  Placeholder="e.g. 30,14,7" Width="100%" aria-label="Reminder days before expiry" />
                                <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.Save())"
                                              Title="Save reminder days" OnClick="@(() => SaveIntervalsAsync(type.Id))" />
                            </div>
                        </div>
                        <div class="document-type-list-actions">
                            <FluentButton IconStart="@(new Icons.Regular.Size16.Delete())" Title="Deactivate"
                                          OnClick="@(() => DeactivateAsync(type.Id))" />
                        </div>
                    </div>
                }
            </div>
        }

        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="OpenCreateDialogAsync">
            New Document Type
        </FluentButton>
    </FluentStack>
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public required int CompanyId { get; set; }

    private List<StaffDocumentType>? documentTypes;
    private readonly Dictionary<Guid, string> intervalEdits = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Result<List<StaffDocumentType>> result = await _staffDocumentTypeService.GetDocumentTypesAsync(CompanyId);

        documentTypes = result.IsSuccess ? result.Data : [];
    }

    private string FormatIntervals(StaffDocumentType type) =>
        intervalEdits.TryGetValue(type.Id, out string? edited)
            ? edited
            : string.Join(",", type.ReminderIntervals.OrderByDescending(x => x.DaysBeforeExpiry).Select(x => x.DaysBeforeExpiry));

    private async Task SaveIntervalsAsync(Guid documentTypeId)
    {
        string raw = intervalEdits.TryGetValue(documentTypeId, out string? edited)
            ? edited
            : FormatIntervals(documentTypes!.First(x => x.Id == documentTypeId));

        List<int> days = [.. raw
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => int.TryParse(x, out int value) ? value : (int?)null)
            .Where(x => x.HasValue)
            .Select(x => x!.Value)];

        Result<bool> result = await _staffDocumentTypeService.SaveReminderIntervalsAsync(documentTypeId, days);

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to save reminder days: {result.Error}");
            return;
        }

        ToastService.ShowSuccess("Reminder days saved.");
        intervalEdits.Remove(documentTypeId);
        await LoadAsync();
    }

    private async Task OpenCreateDialogAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<CreateDocumentTypeDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(CreateDocumentTypeDialog.CompanyId), CompanyId);
            options.Parameters.Add(nameof(CreateDocumentTypeDialog.NextSortOrder), documentTypes?.Count ?? 0);
        });

        if (result.Value is true)
        {
            await LoadAsync();
        }
    }

    private async Task DeactivateAsync(Guid documentTypeId)
    {
        Result<bool> result = await _staffDocumentTypeService.DeactivateDocumentTypeAsync(documentTypeId);

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to deactivate document type: {result.Error}");
            return;
        }

        ToastService.ShowSuccess("Document type deactivated.");
        await LoadAsync();
    }
}
