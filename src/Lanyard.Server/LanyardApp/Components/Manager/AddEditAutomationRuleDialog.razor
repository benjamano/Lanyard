@using Lanyard.App.Components.ProjectionPrograms
@using Lanyard.Application.Services
@using Lanyard.Infrastructure.Models
@using Lanyard.Infrastructure.Enum
@using Lanyard.Infrastructure.DTO
@using Lanyard.Infrastructure.DTO.Dmx
@using Lanyard.Shared.Enum
@using System.Text.Json

@inject INotificationService _toastService
@inject IAutomationRuleService _ruleService
@inject IClientService _clientService
@inject IPlaylistService _playlistService
@inject IProjectionProgramService _projectionProgramService
@inject IDmxSceneService _dmxSceneService
@inject ILogger<AddEditAutomationRuleDialog> _logger
@inject Lanyard.Application.Services.Tenancy.ITenantContext _tenant

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size20.Flash())" />
            <FluentText Weight="TextWeight.Semibold" Size="TextSize.Size500">@_steps[_currentStepIndex]</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @if (_currentStepIndex == 0)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentTextInput Label="Rule Name"
                                 @bind-Value="_ruleName"
                                 Required="true"
                                 Appearance="TextInputAppearance.Outline"
                                 Style="width: 100%;" />

                <FluentSelect Label="@(_triggerTypeString == AutomationTriggerType.Scheduled.ToString() ? "Associated Client" : "Trigger Client")"
                              TOption="ClientConnectedDTO"
                              TValue="string"
                              Items="@_clients"
                              OptionText="@(c => c?.Name ?? string.Empty)"
                              OptionValue="@(c => c?.Id.ToString())"
                              @bind-Value="_triggerClientIdString"
                              Style="width: 100%;" />

                @if (_triggerTypeString == AutomationTriggerType.Scheduled.ToString())
                {
                    <FluentText Color="Color.Default">
                        A scheduled rule isn't triggered by this client - it's only recorded as a label on the execution log.
                    </FluentText>
                }

                <FluentSelect Label="Trigger Type"
                              TOption="string"
                              TValue="string"
                              @bind-Value="_triggerTypeString"
                              Style="width: 100%;">
                    <FluentOption Value="@AutomationTriggerType.GameStatusTransition.ToString()">Game Status Change</FluentOption>
                    <FluentOption Value="@AutomationTriggerType.ClientIdle.ToString()">Client Idle</FluentOption>
                    <FluentOption Value="@AutomationTriggerType.Scheduled.ToString()">Scheduled</FluentOption>
                    <FluentOption Value="@AutomationTriggerType.TimeRemainingBelow.ToString()">Time remaining drops below</FluentOption>
                    <FluentOption Value="@AutomationTriggerType.ScoreThreshold.ToString()">Score reaches</FluentOption>
                </FluentSelect>

                @if (_triggerTypeString == AutomationTriggerType.ClientIdle.ToString())
                {
                    @* Trigger Event is meaningless for an idle rule, so it is hidden rather than
                       left on screen implying it still has an effect. *@
                    <FluentNumberInput TValue="int?"
                                       Label="Idle for (minutes)"
                                       Min="1"
                                       Value="@_idleThresholdMinutes"
                                       ValueChanged="@((int? minutes) => _idleThresholdMinutes = minutes)"
                                       Style="width: 100%;" />
                }
                else if (_triggerTypeString == AutomationTriggerType.Scheduled.ToString())
                {
                    @* Trigger Event and idle threshold are both meaningless for a scheduled rule. *@
                    <AnyTimePicker @bind-Value="_scheduledTimeOfDay"
                                   Label="At time (UK time)"
                                   Style="width: 100%;" />

                    <FluentText Color="Color.Default">Days of week (leave all unticked to run every day)</FluentText>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                        @foreach (DayOfWeek day in _allDaysOfWeek)
                        {
                            DayOfWeek capturedDay = day;
                            <FluentCheckbox Value="@_scheduledDays.Contains(capturedDay)"
                                            ValueChanged="@((bool ticked) => OnScheduledDayToggled(capturedDay, ticked))"
                                            Label="@(capturedDay.ToString()[..3])" />
                        }
                    </FluentStack>
                }
                else if (_triggerTypeString == AutomationTriggerType.TimeRemainingBelow.ToString())
                {
                    <FluentNumberInput TValue="int?"
                                       Label="Seconds remaining"
                                       Min="1"
                                       Width="100%"
                                       Value="@_timeRemainingSeconds"
                                       ValueChanged="@((int? seconds) => _timeRemainingSeconds = seconds)" />
                    <div class="condition-hint">
                        Runs once per game, when the trigger client's countdown passes this point. A game shorter than this never runs it.
                    </div>
                }
                else if (_triggerTypeString == AutomationTriggerType.ScoreThreshold.ToString())
                {
                    <FluentNumberInput TValue="int?"
                                       Label="Score"
                                       Min="1"
                                       Width="100%"
                                       Value="@_scoreThreshold"
                                       ValueChanged="@((int? score) => _scoreThreshold = score)" />
                    <div class="condition-fields">
                        <FluentSelect TOption="string"
                                      TValue="string"
                                      Label="Whose score"
                                      Width="100%"
                                      @bind-Value="_scoreScopeString">
                            <FluentOption Value="@AutomationScoreScope.AnyPlayer.ToString()">Any one player</FluentOption>
                            <FluentOption Value="@AutomationScoreScope.Team.ToString()">A team's total</FluentOption>
                        </FluentSelect>
                        <FluentSelect TOption="string"
                                      TValue="string"
                                      Label="Team"
                                      Width="100%"
                                      @bind-Value="_scoreTeamString">
                            <FluentOption Value="@("any")">Any team</FluentOption>
                            <FluentOption Value="@Team.Red.ToString()">Red</FluentOption>
                            <FluentOption Value="@Team.Green.ToString()">Green</FluentOption>
                        </FluentSelect>
                    </div>
                    <div class="condition-hint">
                        Runs once per game, the first time the score is reached on the trigger client.
                    </div>
                }
                else
                {
                    <FluentSelect Label="Trigger Event"
                                  TOption="string"
                                  TValue="string"
                                  @bind-Value="_triggerEventString"
                                  Style="width: 100%;">
                        <FluentOption Value="@GameStatus.InGame.ToString()">In Game</FluentOption>
                        <FluentOption Value="@GameStatus.NotStarted.ToString()">Not Started</FluentOption>
                    </FluentSelect>
                }
            </FluentStack>
        }
        else if (_currentStepIndex == 1)
        {
            <div class="conditions-step">
                <FluentText>
                    Optional. The rule only runs if every condition is true at the moment it's triggered. Times and days are UK venue time.
                </FluentText>

                @if (_conditionRows.Count == 0)
                {
                    <div class="conditions-empty">No conditions, so the rule runs every time it's triggered.</div>
                }

                @for (int i = 0; i < _conditionRows.Count; i++)
                {
                    int index = i;
                    ConditionRow row = _conditionRows[index];

                    <div class="condition-row">
                        <div class="condition-row-header">
                            <div class="condition-type">
                                <FluentSelect TOption="string"
                                              TValue="string"
                                              Label="Only if"
                                              Width="100%"
                                              Value="@row.ConditionType.ToString()"
                                              ValueChanged="@((string? type) => row.ConditionType = Enum.TryParse(type, out AutomationConditionType parsed) ? parsed : AutomationConditionType.TimeWindow)">
                                    <FluentOption Value="@AutomationConditionType.TimeWindow.ToString()">Time of day is between</FluentOption>
                                    <FluentOption Value="@AutomationConditionType.DaysOfWeek.ToString()">Day of week is</FluentOption>
                                    <FluentOption Value="@AutomationConditionType.ClientGameStatus.ToString()">A kiosk is or isn't in a game</FluentOption>
                                    <FluentOption Value="@AutomationConditionType.DuringOpeningHours.ToString()">A location is open or closed</FluentOption>
                                </FluentSelect>
                            </div>
                            <div class="condition-remove">
                                <FluentButton IconStart="new Icons.Regular.Size20.Dismiss()"
                                              Title="Remove condition"
                                              OnClick="@(() => _conditionRows.RemoveAt(index))" />
                            </div>
                        </div>

                        @if (row.ConditionType == AutomationConditionType.TimeWindow)
                        {
                            <div class="condition-fields">
                                <AnyTimePicker TValue="TimeOnly" @bind-Value="row.Start" Label="From" />
                                <AnyTimePicker TValue="TimeOnly" @bind-Value="row.End" Label="Until" />
                            </div>
                            @if (row.End < row.Start)
                            {
                                <div class="condition-hint">Runs past midnight, until @row.End.ToString("HH:mm") the next morning.</div>
                            }
                        }
                        else if (row.ConditionType == AutomationConditionType.DaysOfWeek)
                        {
                            <div class="condition-days">
                                @foreach (DayOfWeek day in _allDaysOfWeek)
                                {
                                    DayOfWeek capturedDay = day;
                                    <FluentCheckbox Value="@row.Days.Contains(capturedDay)"
                                                    ValueChanged="@((bool ticked) => OnConditionDayToggled(row, capturedDay, ticked))"
                                                    Label="@(capturedDay.ToString()[..3])" />
                                }
                            </div>
                        }
                        else if (row.ConditionType == AutomationConditionType.DuringOpeningHours)
                        {
                            <div class="condition-fields">
                                <FluentSelect TOption="Location"
                                              TValue="string"
                                              Label="Location"
                                              Placeholder="Select location"
                                              Width="100%"
                                              Items="@_locations"
                                              OptionText="@(l => l?.Name ?? string.Empty)"
                                              OptionValue="@(l => l?.Id.ToString())"
                                              @bind-Value="row.LocationIdString" />
                                <FluentSelect TOption="string"
                                              TValue="string"
                                              Label="State"
                                              Width="100%"
                                              Value="@(row.Open ? "open" : "closed")"
                                              ValueChanged="@((string? state) => row.Open = state != "closed")">
                                    <FluentOption Value="@("open")">is open</FluentOption>
                                    <FluentOption Value="@("closed")">is closed</FluentOption>
                                </FluentSelect>
                            </div>
                            <div class="condition-hint">Uses the location's opening hours, set under Manage &gt; Companies &amp; Locations. A location with no hours set counts as closed.</div>
                        }
                        else
                        {
                            <div class="condition-fields">
                                <FluentSelect TOption="ClientConnectedDTO"
                                              TValue="string"
                                              Label="Kiosk"
                                              Placeholder="Select kiosk"
                                              Width="100%"
                                              Items="@_clients"
                                              OptionText="@(c => c?.Name ?? string.Empty)"
                                              OptionValue="@(c => c?.Id.ToString())"
                                              @bind-Value="row.ClientIdString" />
                                <FluentSelect TOption="string"
                                              TValue="string"
                                              Label="State"
                                              Width="100%"
                                              Value="@(row.InGame ? "in" : "out")"
                                              ValueChanged="@((string? state) => row.InGame = state == "in")">
                                    <FluentOption Value="@("in")">is in a game</FluentOption>
                                    <FluentOption Value="@("out")">isn't in a game</FluentOption>
                                </FluentSelect>
                            </div>
                        }
                    </div>
                }

                <div>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  IconStart="new Icons.Regular.Size20.Add()"
                                  OnClick="AddConditionRow">
                        Add condition
                    </FluentButton>
                </div>

                @if (ConditionsError is string conditionsError)
                {
                    <FluentText Color="Color.Error">@conditionsError</FluentText>
                }
            </div>
        }
        else if (_currentStepIndex == 2)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                @for (int i = 0; i < _actionRows.Count; i++)
                {
                    int index = i;
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <div>
                            <FluentSelect TOption="string"
                                TValue="string"
                                Label="Action Type"
                                Value="@_actionRows[index].ActionType"
                                ValueChanged="@((string? type) => OnRowActionTypeChangedAsync(index, type))"
                                Style="width: 180px;">
                                <FluentOption Value="@AutomationActionTypes.MusicControl">Music Control</FluentOption>
                                <FluentOption Value="@AutomationActionTypes.StartProjectionProgram">Start Projection Program</FluentOption>
                                <FluentOption Value="@AutomationActionTypes.StopProjectionProgram">Stop Projection Program</FluentOption>
                                <FluentOption Value="@AutomationActionTypes.DmxSceneControl">DMX Scene Control</FluentOption>
                                <FluentOption Value="@AutomationActionTypes.ProjectionProgramControl">Projection Program Control</FluentOption>
                            </FluentSelect>
                        </div>
                        <div>
                            <FluentSelect TOption="ClientConnectedDTO"
                                TValue="string"
                                Label="Target Client"
                                Items="@_clients"
                                OptionText="@(c => c?.Name ?? string.Empty)"
                                OptionValue="@(c => c?.Id.ToString())"
                                Value="@_actionRows[index].TargetClientIdString"
                                ValueChanged="@((string? id) => OnRowClientChangedAsync(index, id))"
                                Style="flex: 1;" />
                        </div>
                        @if (_actionRows[index].ActionType == AutomationActionTypes.StopProjectionProgram)
                        {
                            @* No program picker: stopping targets whatever is on the display. *@
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Screen"
                                    Value="@_actionRows[index].DisplayIndexString"
                                    ValueChanged="@((string? screen) => _actionRows[index].DisplayIndexString = screen ?? "default")"
                                    Style="width: 160px;">
                                    <FluentOption TValue="string" Value="default">Client default</FluentOption>
                                    @foreach (ClientAvailableScreen screen in _actionRows[index].Screens)
                                    {
                                        <FluentOption TValue="string" Value="@screen.Index.ToString()">@($"{screen.Name} ({screen.Width}x{screen.Height})")</FluentOption>
                                    }
                                </FluentSelect>
                            </div>
                        }
                        else if (_actionRows[index].ActionType == AutomationActionTypes.StartProjectionProgram)
                        {
                            <div>
                                <FluentSelect TOption="ProjectionProgram"
                                    TValue="string"
                                    Label="Projection Program"
                                    Placeholder="Select Program"
                                    Items="@_programs"
                                    OptionText="@(p => p?.Name ?? string.Empty)"
                                    OptionValue="@(p => p?.Id.ToString())"
                                    Value="@_actionRows[index].ProjectionProgramIdString"
                                    ValueChanged="@((string? id) => _actionRows[index].ProjectionProgramIdString = id ?? string.Empty)"
                                    Style="flex: 1;" />
                            </div>
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Screen"
                                    Value="@_actionRows[index].DisplayIndexString"
                                    ValueChanged="@((string? screen) => _actionRows[index].DisplayIndexString = screen ?? "default")"
                                    Style="width: 160px;">
                                    <FluentOption TValue="string" Value="default">Client default</FluentOption>
                                    @foreach (ClientAvailableScreen screen in _actionRows[index].Screens)
                                    {
                                        <FluentOption TValue="string" Value="@screen.Index.ToString()">@($"{screen.Name} ({screen.Width}x{screen.Height})")</FluentOption>
                                    }
                                </FluentSelect>
                            </div>
                        }
                        else if (_actionRows[index].ActionType == AutomationActionTypes.ProjectionProgramControl)
                        {
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Operation"
                                    Value="@_actionRows[index].ProjectionControlOperation"
                                    ValueChanged="@((string? op) => _actionRows[index].ProjectionControlOperation = op ?? ProjectionProgramControlActionExecutor.Start)"
                                    Style="width: 150px;">
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.Start">Start</FluentOption>
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.Stop">Stop</FluentOption>
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.Pause">Pause</FluentOption>
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.Resume">Resume</FluentOption>
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.SkipToNext">Skip to Next Step</FluentOption>
                                    <FluentOption Value="@ProjectionProgramControlActionExecutor.SkipToPrevious">Skip to Previous Step</FluentOption>
                                </FluentSelect>
                            </div>
                            @if (_actionRows[index].ProjectionControlOperation == ProjectionProgramControlActionExecutor.Start)
                            {
                                <div>
                                    <FluentSelect TOption="ProjectionProgram"
                                        TValue="string"
                                        Label="Projection Program"
                                        Placeholder="Select Program"
                                        Items="@_programs"
                                        OptionText="@(p => p?.Name ?? string.Empty)"
                                        OptionValue="@(p => p?.Id.ToString())"
                                        Value="@_actionRows[index].ProjectionProgramIdString"
                                        ValueChanged="@((string? id) => _actionRows[index].ProjectionProgramIdString = id ?? string.Empty)"
                                        Style="flex: 1;" />
                                </div>
                            }
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Screen"
                                    Value="@_actionRows[index].DisplayIndexString"
                                    ValueChanged="@((string? screen) => _actionRows[index].DisplayIndexString = screen ?? "default")"
                                    Style="width: 160px;">
                                    <FluentOption TValue="string" Value="default">Client default</FluentOption>
                                    @foreach (ClientAvailableScreen screen in _actionRows[index].Screens)
                                    {
                                        <FluentOption TValue="string" Value="@screen.Index.ToString()">@($"{screen.Name} ({screen.Width}x{screen.Height})")</FluentOption>
                                    }
                                </FluentSelect>
                            </div>
                        }
                        else if (_actionRows[index].ActionType == AutomationActionTypes.DmxSceneControl)
                        {
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Operation"
                                    Value="@_actionRows[index].DmxOperation"
                                    ValueChanged="@((string? op) => _actionRows[index].DmxOperation = op ?? DmxSceneControlActionExecutor.StartScene)"
                                    Style="width: 150px;">
                                    <FluentOption Value="@DmxSceneControlActionExecutor.StartScene">Start Scene</FluentOption>
                                    <FluentOption Value="@DmxSceneControlActionExecutor.StopScene">Stop Scene</FluentOption>
                                    <FluentOption Value="@DmxSceneControlActionExecutor.StopAllScenes">Stop All Scenes</FluentOption>
                                </FluentSelect>
                            </div>
                            @if (_actionRows[index].DmxOperation != DmxSceneControlActionExecutor.StopAllScenes)
                            {
                                <div>
                                    <FluentSelect TOption="DmxSceneDTO"
                                        TValue="string"
                                        Label="Scene"
                                        Placeholder="Select Scene"
                                        Items="@_actionRows[index].Scenes"
                                        OptionText="@(s => s?.Name ?? string.Empty)"
                                        OptionValue="@(s => s?.Id.ToString())"
                                        Value="@_actionRows[index].SceneIdString"
                                        ValueChanged="@((string? id) => _actionRows[index].SceneIdString = id ?? string.Empty)"
                                        Style="flex: 1;" />
                                </div>
                            }
                            @if (_actionRows[index].DmxOperation == DmxSceneControlActionExecutor.StartScene)
                            {
                                <div>
                                    <FluentNumberInput TValue="int?"
                                        Label="Hold for (ms)"
                                        Placeholder="Runs until stopped"
                                        Min="1"
                                        Value="@_actionRows[index].HoldMilliseconds"
                                        ValueChanged="@((int? ms) => _actionRows[index].HoldMilliseconds = ms)"
                                        Style="width: 150px;" />
                                </div>
                            }
                        }
                        else
                        {
                            <div>
                                <FluentSelect TOption="string"
                                    TValue="string"
                                    Label="Operation"
                                    Value="@_actionRows[index].Operation"
                                    ValueChanged="@((string? op) => _actionRows[index].Operation = op ?? "Play")"
                                    Style="width: 120px;">
                                    <FluentOption Value="@("Play")">Play</FluentOption>
                                    <FluentOption Value="@("Pause")">Pause</FluentOption>
                                </FluentSelect>
                            </div>
                            <div>
                                <FluentSelect TOption="Playlist"
                                    TValue="string"
                                    Label="Playlist"
                                    Placeholder="Select Playlist"
                                    Items="@_playlists"
                                    OptionText="@(p => p?.Name ?? string.Empty)"
                                    OptionValue="@(p => p?.Id.ToString())"
                                    Value="@(_actionRows[index].PlaylistId?.ToString() ?? string.Empty)"
                                    ValueChanged="@((string? id) => _actionRows[index].PlaylistId = Guid.TryParse(id, out Guid playlistId) ? playlistId : (Guid?)null)"
                                    Style="flex: 1;" />
                            </div>
                        }
                        <FluentButton IconStart="new Icons.Regular.Size20.Dismiss()"
                            Disabled="@(_actionRows.Count <= 1)"
                            OnClick="@(() => RemoveActionRow(index))" />
                    </FluentStack>
                }

                <div>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  IconStart="new Icons.Regular.Size20.Add()"
                                  OnClick="AddActionRow">
                        Add Action
                    </FluentButton>
                </div>

                @if (_actionRows.Count == 0)
                {
                    <FluentText Color="Color.Error">At least one action is required.</FluentText>
                }
            </FluentStack>
        }
    </ChildContent>
    <ActionTemplate>
        @if (_currentStepIndex == 0)
        {
            <FluentButton Appearance="ButtonAppearance.Primary"
                          Disabled="@(string.IsNullOrWhiteSpace(_ruleName) || string.IsNullOrEmpty(_triggerClientIdString) || !IsTriggerConfigured)"
                          OnClick="@(() => _currentStepIndex = 1)">
                Next
            </FluentButton>
            <FluentButton OnClick="CancelDialogAsync">Cancel</FluentButton>
        }
        else if (_currentStepIndex == 1)
        {
            <FluentButton OnClick="@(() => _currentStepIndex = 0)">Previous</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary"
                          Disabled="@(ConditionsError is not null)"
                          OnClick="@(() => _currentStepIndex = 2)">
                Next
            </FluentButton>
            <FluentButton OnClick="CancelDialogAsync">Cancel</FluentButton>
        }
        else if (_currentStepIndex == 2)
        {
            <FluentButton OnClick="@(() => _currentStepIndex = 1)">Previous</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary"
                          Loading="@_isSaving"
                          Disabled="@(_actionRows.Count == 0 || _actionRows.Any(r => !IsRowValid(r)))"
                          OnClick="SaveRuleAsync">
                Save Rule
            </FluentButton>
            <FluentButton OnClick="CancelDialogAsync">Cancel</FluentButton>
        }
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter]
    public AutomationRule? Content { get; set; }

    private sealed class ActionRow
    {
        public Guid? ExistingActionId { get; set; }
        public string ActionType { get; set; } = AutomationActionTypes.MusicControl;
        public string TargetClientIdString { get; set; } = string.Empty;
        public string Operation { get; set; } = "Play";
        public Guid? PlaylistId { get; set; }
        public string ProjectionProgramIdString { get; set; } = string.Empty;
        public string DisplayIndexString { get; set; } = "default";
        public List<ClientAvailableScreen> Screens { get; set; } = [];
        public string DmxOperation { get; set; } = DmxSceneControlActionExecutor.StartScene;
        public string SceneIdString { get; set; } = string.Empty;
        public int? HoldMilliseconds { get; set; }
        public List<DmxSceneDTO> Scenes { get; set; } = [];
        public string ProjectionControlOperation { get; set; } = ProjectionProgramControlActionExecutor.Start;
    }

    private static bool IsRowValid(ActionRow row)
    {
        if (string.IsNullOrEmpty(row.TargetClientIdString))
        {
            return false;
        }

        return row.ActionType switch
        {
            AutomationActionTypes.StartProjectionProgram => !string.IsNullOrEmpty(row.ProjectionProgramIdString),
            // A stop action needs only the target client, already validated above.
            AutomationActionTypes.StopProjectionProgram => true,
            AutomationActionTypes.DmxSceneControl => row.DmxOperation == DmxSceneControlActionExecutor.StopAllScenes
                || !string.IsNullOrEmpty(row.SceneIdString),
            // Every operation but Start needs only the target client, already validated above.
            AutomationActionTypes.ProjectionProgramControl => row.ProjectionControlOperation != ProjectionProgramControlActionExecutor.Start
                || !string.IsNullOrEmpty(row.ProjectionProgramIdString),
            _ => true
        };
    }

    private int _currentStepIndex = 0;
    private List<string> _steps = ["Rule Details", "Conditions", "Actions"];

    private sealed class ConditionRow
    {
        public Guid? ExistingConditionId { get; set; }
        public AutomationConditionType ConditionType { get; set; } = AutomationConditionType.TimeWindow;
        public TimeOnly Start { get; set; } = new(18, 0);
        public TimeOnly End { get; set; } = new(22, 0);
        public HashSet<DayOfWeek> Days { get; set; } = [];
        public string ClientIdString { get; set; } = string.Empty;
        public bool InGame { get; set; }
        public string LocationIdString { get; set; } = string.Empty;
        public bool Open { get; set; } = true;
    }

    private IEnumerable<Location> _locations = [];

    private List<ConditionRow> _conditionRows = [];

    // Same validation CreateRuleAsync/UpdateRuleAsync apply, so a condition the service would
    // reject can't be carried through to the actions step.
    private string? ConditionsError => AutomationRuleService.ValidateConditions(BuildConditions());

    private void AddConditionRow()
    {
        _conditionRows.Add(new ConditionRow());
    }

    private static void OnConditionDayToggled(ConditionRow row, DayOfWeek day, bool ticked)
    {
        if (ticked)
        {
            row.Days.Add(day);
        }
        else
        {
            row.Days.Remove(day);
        }
    }

    private List<AutomationRuleCondition> BuildConditions()
    {
        List<AutomationRuleCondition> conditions = [];

        for (int i = 0; i < _conditionRows.Count; i++)
        {
            ConditionRow row = _conditionRows[i];

            string parametersJson = row.ConditionType switch
            {
                AutomationConditionType.TimeWindow => AutomationConditionParameters.Serialize(new TimeWindowConditionParameters(row.Start, row.End)),
                AutomationConditionType.DaysOfWeek => AutomationConditionParameters.Serialize(new DaysOfWeekConditionParameters(AutomationScheduleDays.Serialize(row.Days))),
                AutomationConditionType.DuringOpeningHours => AutomationConditionParameters.Serialize(new OpeningHoursConditionParameters(
                    int.TryParse(row.LocationIdString, out int locationId) ? locationId : 0,
                    row.Open)),
                _ => AutomationConditionParameters.Serialize(new ClientGameStatusConditionParameters(
                    Guid.TryParse(row.ClientIdString, out Guid clientId) ? clientId : Guid.Empty,
                    row.InGame))
            };

            conditions.Add(new AutomationRuleCondition
            {
                Id = row.ExistingConditionId ?? Guid.NewGuid(),
                ConditionType = row.ConditionType,
                ParametersJson = parametersJson,
                SortOrder = i,
                IsActive = true
            });
        }

        return conditions;
    }

    private static ConditionRow ToConditionRow(AutomationRuleCondition condition)
    {
        ConditionRow row = new()
        {
            ExistingConditionId = condition.Id,
            ConditionType = condition.ConditionType
        };

        switch (condition.ConditionType)
        {
            case AutomationConditionType.TimeWindow when AutomationConditionParameters.TryParse(condition.ParametersJson, out TimeWindowConditionParameters? window):
                row.Start = window.Start;
                row.End = window.End;
                break;

            case AutomationConditionType.DaysOfWeek when AutomationConditionParameters.TryParse(condition.ParametersJson, out DaysOfWeekConditionParameters? days)
                && !string.IsNullOrWhiteSpace(days.Days)
                && AutomationScheduleDays.TryParse(days.Days, out List<DayOfWeek> parsedDays):
                row.Days = [.. parsedDays];
                break;

            case AutomationConditionType.ClientGameStatus when AutomationConditionParameters.TryParse(condition.ParametersJson, out ClientGameStatusConditionParameters? kiosk):
                row.ClientIdString = kiosk.ClientId == Guid.Empty ? string.Empty : kiosk.ClientId.ToString();
                row.InGame = kiosk.InGame;
                break;

            case AutomationConditionType.DuringOpeningHours when AutomationConditionParameters.TryParse(condition.ParametersJson, out OpeningHoursConditionParameters? hours):
                row.LocationIdString = hours.LocationId > 0 ? hours.LocationId.ToString() : string.Empty;
                row.Open = hours.Open;
                break;
        }

        return row;
    }

    private string _ruleName = string.Empty;
    private string _triggerClientIdString = string.Empty;
    private string _triggerEventString = GameStatus.InGame.ToString();
    private string _triggerTypeString = AutomationTriggerType.GameStatusTransition.ToString();

    // Delegates to the same validation CreateRuleAsync/UpdateRuleAsync will apply, so a rule the
    // service would reject cannot be carried through to the actions step in the first place.
    private bool IsTriggerConfigured =>
        AutomationRuleService.ValidateTrigger(
            Enum.Parse<AutomationTriggerType>(_triggerTypeString),
            _idleThresholdMinutes,
            _scheduledTimeOfDay,
            AutomationScheduleDays.Serialize(_scheduledDays),
            Enum.Parse<AutomationTriggerType>(_triggerTypeString) == AutomationTriggerType.ScoreThreshold ? _scoreThreshold : _timeRemainingSeconds,
            Enum.Parse<AutomationScoreScope>(_scoreScopeString)) is null;

    private int? _timeRemainingSeconds = 60;
    private int? _scoreThreshold = 1000;
    private string _scoreScopeString = AutomationScoreScope.AnyPlayer.ToString();
    private string _scoreTeamString = "any";

    private int? _idleThresholdMinutes = 30;
    private static readonly List<DayOfWeek> _allDaysOfWeek = [DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday];
    private TimeOnly _scheduledTimeOfDay = new(9, 0);
    private HashSet<DayOfWeek> _scheduledDays = [];

    private void OnScheduledDayToggled(DayOfWeek day, bool ticked)
    {
        if (ticked)
        {
            _scheduledDays.Add(day);
        }
        else
        {
            _scheduledDays.Remove(day);
        }
    }
    private List<ActionRow> _actionRows = [];
    private IEnumerable<ClientConnectedDTO> _clients = [];
    private bool _isSaving = false;

    private IEnumerable<Playlist> _playlists { get; set; } = [];
    private IEnumerable<ProjectionProgram> _programs { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Result<IEnumerable<ClientConnectedDTO>> clientResult = await _clientService.GetClientsAsync();
        _clients = clientResult.Data ?? [];

        // The signed-in company's locations only: a platform admin would otherwise see every
        // company's, and a rule can only use its own company's (AutomationRuleService checks).
        Result<List<Location>> locationResult = await _companyLocationService.GetLocationsAsync(_tenant.CompanyId);
        _locations = locationResult.Data ?? [];

        if (Content != null)
        {
            _ruleName = Content.Name;
            _triggerClientIdString = Content.TriggerClientId.ToString();
            _triggerEventString = Content.TriggerEvent.ToString();
            _triggerTypeString = Content.TriggerType.ToString();
            _idleThresholdMinutes = Content.IdleThresholdMinutes ?? 30;
            _scheduledTimeOfDay = Content.ScheduledTimeOfDay ?? new TimeOnly(9, 0);
            if (Content.TriggerType == AutomationTriggerType.TimeRemainingBelow)
            {
                _timeRemainingSeconds = Content.TriggerThreshold ?? 60;
            }
            else if (Content.TriggerType == AutomationTriggerType.ScoreThreshold)
            {
                _scoreThreshold = Content.TriggerThreshold ?? 1000;
            }
            _scoreScopeString = (Content.TriggerScoreScope ?? AutomationScoreScope.AnyPlayer).ToString();
            _scoreTeamString = Content.TriggerTeam?.ToString() ?? "any";
            AutomationScheduleDays.TryParse(Content.ScheduledDaysOfWeek, out List<DayOfWeek> parsedDays);
            _scheduledDays = Content.TriggerType == AutomationTriggerType.Scheduled && !string.IsNullOrWhiteSpace(Content.ScheduledDaysOfWeek)
                ? [.. parsedDays]
                : [];

            _conditionRows = [.. Content.Conditions.Where(c => c.IsActive).OrderBy(c => c.SortOrder).Select(ToConditionRow)];

            foreach (AutomationRuleAction action in Content.Actions.Where(a => a.IsActive).OrderBy(a => a.SortOrder))
            {
                JsonDocument doc = JsonDocument.Parse(action.ParametersJson);

                ActionRow row = new ActionRow
                {
                    ExistingActionId = action.Id,
                    ActionType = action.ActionType
                };

                if (doc.RootElement.TryGetProperty("TargetClientId", out JsonElement targetClientElement) &&
                    targetClientElement.ValueKind == JsonValueKind.String &&
                    targetClientElement.TryGetGuid(out Guid targetId))
                {
                    row.TargetClientIdString = targetId.ToString();
                }

                if (action.ActionType == AutomationActionTypes.StopProjectionProgram)
                {
                    if (doc.RootElement.TryGetProperty("DisplayIndex", out JsonElement stopDisplayElement) &&
                        stopDisplayElement.ValueKind == JsonValueKind.Number)
                    {
                        row.DisplayIndexString = stopDisplayElement.GetInt32().ToString();
                    }
                }
                else if (action.ActionType == AutomationActionTypes.StartProjectionProgram)
                {
                    if (doc.RootElement.TryGetProperty("ProjectionProgramId", out JsonElement programElement) &&
                        programElement.ValueKind == JsonValueKind.String &&
                        programElement.TryGetGuid(out Guid programId))
                    {
                        row.ProjectionProgramIdString = programId.ToString();
                    }

                    if (doc.RootElement.TryGetProperty("DisplayIndex", out JsonElement displayElement) &&
                        displayElement.ValueKind == JsonValueKind.Number)
                    {
                        row.DisplayIndexString = displayElement.GetInt32().ToString();
                    }
                }
                else if (action.ActionType == AutomationActionTypes.DmxSceneControl)
                {
                    if (doc.RootElement.TryGetProperty("Operation", out JsonElement dmxOperationElement))
                    {
                        row.DmxOperation = dmxOperationElement.GetString() ?? DmxSceneControlActionExecutor.StartScene;
                    }

                    if (doc.RootElement.TryGetProperty("SceneId", out JsonElement sceneElement) &&
                        sceneElement.ValueKind == JsonValueKind.String &&
                        sceneElement.TryGetGuid(out Guid sceneId))
                    {
                        row.SceneIdString = sceneId.ToString();
                    }

                    // Absent on rules authored before hold support, which means no hold.
                    if (doc.RootElement.TryGetProperty("HoldMilliseconds", out JsonElement holdElement) &&
                        holdElement.ValueKind == JsonValueKind.Number &&
                        holdElement.TryGetInt32(out int holdMilliseconds))
                    {
                        row.HoldMilliseconds = holdMilliseconds;
                    }
                }
                else if (action.ActionType == AutomationActionTypes.ProjectionProgramControl)
                {
                    if (doc.RootElement.TryGetProperty("Operation", out JsonElement projectionOperationElement))
                    {
                        row.ProjectionControlOperation = projectionOperationElement.GetString() ?? ProjectionProgramControlActionExecutor.Start;
                    }

                    if (doc.RootElement.TryGetProperty("ProjectionProgramId", out JsonElement controlProgramElement) &&
                        controlProgramElement.ValueKind == JsonValueKind.String &&
                        controlProgramElement.TryGetGuid(out Guid controlProgramId))
                    {
                        row.ProjectionProgramIdString = controlProgramId.ToString();
                    }

                    if (doc.RootElement.TryGetProperty("DisplayIndex", out JsonElement controlDisplayElement) &&
                        controlDisplayElement.ValueKind == JsonValueKind.Number)
                    {
                        row.DisplayIndexString = controlDisplayElement.GetInt32().ToString();
                    }
                }
                else if (action.ActionType == AutomationActionTypes.MusicControl)
                {
                    if (doc.RootElement.TryGetProperty("Operation", out JsonElement operationElement))
                    {
                        row.Operation = operationElement.GetString() ?? "Play";
                    }

                    if (doc.RootElement.TryGetProperty("PlaylistId", out JsonElement playlistElement) &&
                        playlistElement.ValueKind == JsonValueKind.String &&
                        playlistElement.TryGetGuid(out Guid playlistId))
                    {
                        row.PlaylistId = playlistId;
                    }
                }

                _actionRows.Add(row);

                if (!string.IsNullOrEmpty(row.TargetClientIdString))
                {
                    if (row.ActionType is AutomationActionTypes.StartProjectionProgram or AutomationActionTypes.ProjectionProgramControl)
                    {
                        await LoadScreensForRowAsync(_actionRows.Count - 1);
                    }
                    else if (row.ActionType == AutomationActionTypes.DmxSceneControl)
                    {
                        await LoadScenesForRowAsync(_actionRows.Count - 1);
                    }
                }
            }
        }
        else
        {
            _triggerClientIdString = _clients.FirstOrDefault()?.Id.ToString() ?? string.Empty;
            _actionRows.Add(new ActionRow
            {
                TargetClientIdString = _clients.FirstOrDefault()?.Id.ToString() ?? string.Empty
            });
        }

        Result<IEnumerable<Playlist>> playlistResult = await _playlistService.GetActivePlaylistSummariesAsync();

        if (playlistResult.IsSuccess)
        {
            _playlists = playlistResult.Data ?? [];
        }
        else
        {
            _toastService.ShowError(playlistResult.Error ?? "Failed to load playlists.");
            _logger.LogError("Failed to load playlists: {Error}", playlistResult.Error);
        }

        Result<IEnumerable<ProjectionProgram>> programResult = await _projectionProgramService.GetProjectionProgramsAsync();

        if (programResult.IsSuccess)
        {
            _programs = programResult.Data ?? [];
        }
        else
        {
            _toastService.ShowError(programResult.Error ?? "Failed to load projection programs.");
            _logger.LogError("Failed to load projection programs: {Error}", programResult.Error);
        }
    }

    private async Task OnRowActionTypeChangedAsync(int index, string? newType)
    {
        ActionRow row = _actionRows[index];
        row.ActionType = newType ?? AutomationActionTypes.MusicControl;

        if (string.IsNullOrEmpty(row.TargetClientIdString))
        {
            return;
        }

        if (row.ActionType is AutomationActionTypes.StartProjectionProgram or AutomationActionTypes.StopProjectionProgram
            or AutomationActionTypes.ProjectionProgramControl
            && row.Screens.Count == 0)
        {
            await LoadScreensForRowAsync(index);
        }
        else if (row.ActionType == AutomationActionTypes.DmxSceneControl && row.Scenes.Count == 0)
        {
            await LoadScenesForRowAsync(index);
        }
    }

    private async Task OnRowClientChangedAsync(int index, string? newClientId)
    {
        ActionRow row = _actionRows[index];
        row.TargetClientIdString = newClientId ?? string.Empty;

        // Display indices are per-client, so reset the screen choice when the client changes.
        row.DisplayIndexString = "default";
        row.Screens = [];

        // Scenes are per-client too, so the same reset applies.
        row.SceneIdString = string.Empty;
        row.Scenes = [];

        if (string.IsNullOrEmpty(row.TargetClientIdString))
        {
            return;
        }

        if (row.ActionType is AutomationActionTypes.StartProjectionProgram or AutomationActionTypes.StopProjectionProgram
            or AutomationActionTypes.ProjectionProgramControl)
        {
            await LoadScreensForRowAsync(index);
        }
        else if (row.ActionType == AutomationActionTypes.DmxSceneControl)
        {
            await LoadScenesForRowAsync(index);
        }
    }

    private async Task LoadScreensForRowAsync(int index)
    {
        ActionRow row = _actionRows[index];

        if (!Guid.TryParse(row.TargetClientIdString, out Guid clientId))
        {
            row.Screens = [];
            return;
        }

        Result<IEnumerable<ClientAvailableScreen>> result = await _clientService.GetClientAvailableScreensAsync(clientId);

        if (result.IsSuccess && result.Data != null)
        {
            row.Screens = result.Data
                .Where(x => x.IsActive)
                .OrderBy(x => x.Index)
                .ToList();
        }
        else
        {
            row.Screens = [];
            _toastService.ShowError($"Failed to load screens, {result.Error}");
        }
    }

    private async Task LoadScenesForRowAsync(int index)
    {
        ActionRow row = _actionRows[index];

        if (!Guid.TryParse(row.TargetClientIdString, out Guid clientId))
        {
            row.Scenes = [];
            return;
        }

        Result<IEnumerable<DmxSceneDTO>> result = await _dmxSceneService.GetScenesForClientAsync(clientId);

        if (result.IsSuccess && result.Data != null)
        {
            row.Scenes = result.Data
                .OrderBy(x => x.Name)
                .ToList();
        }
        else
        {
            row.Scenes = [];
            _toastService.ShowError($"Failed to load DMX scenes, {result.Error}");
        }
    }

    private void AddActionRow()
    {
        _actionRows.Add(new ActionRow());
    }

    private void RemoveActionRow(int index)
    {
        if (_actionRows.Count > 1)
        {
            _actionRows.RemoveAt(index);
        }
    }

    private async Task SaveRuleAsync()
    {
        _isSaving = true;

        Guid triggerClientId = Guid.Parse(_triggerClientIdString);
        GameStatus triggerEvent = Enum.Parse<GameStatus>(_triggerEventString);
        AutomationTriggerType triggerType = Enum.Parse<AutomationTriggerType>(_triggerTypeString);
        int? idleThresholdMinutes = triggerType == AutomationTriggerType.ClientIdle ? _idleThresholdMinutes : null;
        TimeOnly? scheduledTimeOfDay = triggerType == AutomationTriggerType.Scheduled ? _scheduledTimeOfDay : null;
        string? scheduledDaysOfWeek = triggerType == AutomationTriggerType.Scheduled ? AutomationScheduleDays.Serialize(_scheduledDays) : null;
        int? triggerThreshold = triggerType switch
        {
            AutomationTriggerType.TimeRemainingBelow => _timeRemainingSeconds,
            AutomationTriggerType.ScoreThreshold => _scoreThreshold,
            _ => null
        };
        AutomationScoreScope? triggerScoreScope = triggerType == AutomationTriggerType.ScoreThreshold ? Enum.Parse<AutomationScoreScope>(_scoreScopeString) : null;
        Team? triggerTeam = triggerType == AutomationTriggerType.ScoreThreshold && Enum.TryParse(_scoreTeamString, out Team team) ? team : null;

        List<AutomationRuleAction> newActions = [];
        for (int i = 0; i < _actionRows.Count; i++)
        {
            ActionRow row = _actionRows[i];
            Guid targetClientId = Guid.Parse(row.TargetClientIdString);

            string parametersJson;
            if (row.ActionType == AutomationActionTypes.StopProjectionProgram)
            {
                parametersJson = JsonSerializer.Serialize(new
                {
                    TargetClientId = targetClientId,
                    DisplayIndex = int.TryParse(row.DisplayIndexString, out int stopDisplayIndex) ? stopDisplayIndex : (int?)null
                });
            }
            else if (row.ActionType == AutomationActionTypes.StartProjectionProgram)
            {
                parametersJson = JsonSerializer.Serialize(new
                {
                    TargetClientId = targetClientId,
                    ProjectionProgramId = Guid.Parse(row.ProjectionProgramIdString),
                    DisplayIndex = int.TryParse(row.DisplayIndexString, out int displayIndex) ? displayIndex : (int?)null
                });
            }
            else if (row.ActionType == AutomationActionTypes.DmxSceneControl)
            {
                parametersJson = JsonSerializer.Serialize(new
                {
                    TargetClientId = targetClientId,
                    Operation = row.DmxOperation,
                    SceneId = Guid.TryParse(row.SceneIdString, out Guid sceneId) ? sceneId : (Guid?)null,
                    HoldMilliseconds = row.DmxOperation == DmxSceneControlActionExecutor.StartScene && row.HoldMilliseconds > 0
                        ? row.HoldMilliseconds
                        : null
                });
            }
            else if (row.ActionType == AutomationActionTypes.ProjectionProgramControl)
            {
                parametersJson = JsonSerializer.Serialize(new
                {
                    TargetClientId = targetClientId,
                    Operation = row.ProjectionControlOperation,
                    ProjectionProgramId = row.ProjectionControlOperation == ProjectionProgramControlActionExecutor.Start
                        && Guid.TryParse(row.ProjectionProgramIdString, out Guid controlProgramId)
                        ? controlProgramId
                        : (Guid?)null,
                    DisplayIndex = int.TryParse(row.DisplayIndexString, out int controlDisplayIndex) ? controlDisplayIndex : (int?)null
                });
            }
            else
            {
                parametersJson = JsonSerializer.Serialize(new
                {
                    TargetClientId = targetClientId,
                    Operation = row.Operation,
                    PlaylistId = row.PlaylistId
                });
            }

            newActions.Add(new AutomationRuleAction
            {
                Id = row.ExistingActionId ?? Guid.NewGuid(),
                ActionType = row.ActionType,
                ParametersJson = parametersJson,
                SortOrder = i,
                IsActive = true
            });
        }

        Result<AutomationRule> saveResult;

        List<AutomationRuleCondition> newConditions = BuildConditions();

        if (Content != null)
        {
            // Actions and conditions missing from the rows are soft-deleted by UpdateRuleAsync.
            AutomationRule updatedRule = new AutomationRule
            {
                Id = Content.Id,
                Name = _ruleName,
                TriggerClientId = triggerClientId,
                TriggerType = triggerType,
                TriggerEvent = triggerEvent,
                IdleThresholdMinutes = idleThresholdMinutes,
                ScheduledTimeOfDay = scheduledTimeOfDay,
                ScheduledDaysOfWeek = scheduledDaysOfWeek,
                TriggerThreshold = triggerThreshold,
                TriggerScoreScope = triggerScoreScope,
                TriggerTeam = triggerTeam,
                IsActive = true,
                CreateDate = Content.CreateDate,
                Actions = newActions,
                Conditions = newConditions
            };
            foreach (AutomationRuleAction action in newActions)
            {
                action.AutomationRuleId = updatedRule.Id;
            }
            saveResult = await _ruleService.UpdateRuleAsync(updatedRule);
        }
        else
        {
            AutomationRule newRule = new AutomationRule
            {
                Id = Guid.NewGuid(),
                Name = _ruleName,
                TriggerClientId = triggerClientId,
                TriggerType = triggerType,
                TriggerEvent = triggerEvent,
                IdleThresholdMinutes = idleThresholdMinutes,
                ScheduledTimeOfDay = scheduledTimeOfDay,
                ScheduledDaysOfWeek = scheduledDaysOfWeek,
                TriggerThreshold = triggerThreshold,
                TriggerScoreScope = triggerScoreScope,
                TriggerTeam = triggerTeam,
                Actions = newActions,
                Conditions = newConditions
            };
            saveResult = await _ruleService.CreateRuleAsync(newRule);
        }

        if (saveResult.IsSuccess)
        {
            _toastService.ShowSuccess("Rule saved.");
            await Dialog.CloseAsync(true);
        }
        else
        {
            _toastService.ShowError(saveResult.Error ?? "Save failed.");
            _isSaving = false;
        }
    }

    private async Task CancelDialogAsync()
    {
        await Dialog.CancelAsync();
    }
