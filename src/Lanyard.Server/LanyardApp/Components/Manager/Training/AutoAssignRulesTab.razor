@using Lanyard.Application.Services.Training

@inject ICourseService _courseService

<div class="auto-assign-rules-tab">
    @if (scopeFailed)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="my-4">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                We couldn't work out which location you're working in, so the auto-assign rules
                can't be listed. This is usually temporary - try again, or sign out and back in.
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="LoadCoursesAsync">
                Reload
            </FluentButton>
        </FluentStack>
    }
    else if (isLoading)
    {
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
            <FluentSpinner />
        </FluentStack>
    }
    else if (courses.Count == 0)
    {
        <FluentText>No courses exist yet.</FluentText>
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="mt-2">
            @foreach (Course course in courses)
            {
                @* A course shared from a sibling location is listed (read access) but the save
                   behind this toggle is rejected server-side, so don't offer the switch. *@
                <FluentSwitch Value="@course.AutoAssignOnUserCreation"
                              ValueChanged="@((bool v) => ToggleAutoAssignAsync(course, v))"
                              Disabled="@(!CanWrite(course))"
                              Label="@(CanWrite(course) ? course.Name : $"{course.Name} (shared - owned by another location)")" />
            }
        </FluentStack>
    }
</div>

@code {
    private List<Course> courses = [];
    private bool isLoading;
    private bool scopeFailed;
    private LocationScope? currentScope;

    // Mirrors the service's write rule: Admins write anything; everyone else only writes
    // courses owned by their own location.
    private bool CanWrite(Course course) =>
        currentScope is not null
        && (currentScope.IsAdmin || course.LocationId == currentScope.LocationId);

    protected override Task OnInitializedAsync() => LoadCoursesAsync();

    private async Task LoadCoursesAsync()
    {
        isLoading = true;

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            courses = [];
            isLoading = false;
            return;
        }

        // allLocations: true is required here, not just preserved. SecurityService auto-assigns
        // on user creation from an unscoped admin scope, so a rule on another location's course
        // still fires for every new user - an Admin scoped to one location has to be able to see
        // and switch that rule off, or it would keep running with no way to reach it.
        Result<List<Course>> result = await _courseService.GetCoursesAsync(scope, allLocations: true);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load courses: {result.Error}");
            courses = [];
        }
        else
        {
            courses = result.Data;
        }

        isLoading = false;
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the tab would render "No courses exist
            // yet.", which is indistinguishable from the genuine empty state.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task ToggleAutoAssignAsync(Course course, bool newValue)
    {
        // Must be set before the await below so Blazor renders the new value first -
        // Blazor diffs against the previous render tree, not the live DOM, so if this
        // assignment is moved after the await, the revert on failure further down
        // becomes a silent no-op (there is no "old" rendered value left to diff back to).
        course.AutoAssignOnUserCreation = newValue;

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            course.AutoAssignOnUserCreation = !newValue;
            return;
        }

        Result<Course> result = await _courseService.SaveCourseAsync(course, scope);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to update auto-assign rule: {result.Error}");
            course.AutoAssignOnUserCreation = !newValue;
            return;
        }

        _toastService.ShowSuccess($"Auto-assign {(newValue ? "enabled" : "disabled")} for {course.Name}.");
    }
}
