@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.Enum

@inject ICourseAssignmentService _courseAssignmentService

<div class="by-person-tab">
    @if (scopeFailed)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="my-4">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                We couldn't work out which location you're working in, so this tab can't be
                loaded. This is usually temporary - try again, or sign out and back in.
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="LoadUsersAsync">
                Reload
            </FluentButton>
        </FluentStack>
    }
    else
    {
    <div class="person-picker-host">
        <FluentSelect TOption="UserProfile" TValue="string" Items="@users.OrderBy(x => x.GetName())"
                      OptionText="@(i => i?.GetName() ?? string.Empty)" OptionValue="@(i => i?.Id)"
                      Placeholder="Select a person..." Label="Person" @bind-Value="selectedUserId"
                      @bind-Value:after="LoadAssignmentsAsync" Width="100%">
        </FluentSelect>
    </div>

    @if (!string.IsNullOrEmpty(selectedUserId))
    {
        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
                <FluentSpinner />
            </FluentStack>
        }
        else
        {
            <FluentDataGrid Items="@groupedAssignments.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr 1fr" Class="w-100 mt-2"
                            RowSize="@DataGridRowSize.Medium" HasRowDetails="@(g => g.HasExpandableDetails)">
                <ChildContent>
                    <TemplateColumn Title="Course" Sortable="true">
                        @context.Label
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <FluentBadge Content="@context.Primary.GetStatusLabel()" Color="@context.Primary.GetStatusColor()"
                                     Appearance="BadgeAppearance.Filled" />
                    </TemplateColumn>
                    <TemplateColumn Title="Latest Score">
                        @GetLatestScore(context.Primary)
                    </TemplateColumn>
                    <TemplateColumn Title="Due Date">
                        @(context.Primary.DueDate?.ToString("d MMM yyyy") ?? "-")
                    </TemplateColumn>
                    <TemplateColumn Title="">
                        <div class="assignment-row-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(context.Primary))" />
                        </div>
                    </TemplateColumn>
                </ChildContent>
                <RowDetails>
                    <AssignmentGroupDetails Assignments="@context.Assignments">
                        <ActionsTemplate Context="assignment">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(assignment))" />
                        </ActionsTemplate>
                    </AssignmentGroupDetails>
                </RowDetails>
                <EmptyContent>
                    This person has no training assigned.
                </EmptyContent>
            </FluentDataGrid>
        }
    }
    }
</div>

@code {
    private IEnumerable<UserProfile> users = [];
    private List<CourseAssignment> assignments = [];
    private List<TrainingAssignmentGroup> groupedAssignments = [];
    private string selectedUserId = string.Empty;
    private bool isLoading;
    private bool scopeFailed;
    private LocationScope? currentScope;

    private void RebuildGroupedAssignments()
    {
        groupedAssignments = TrainingAssignmentGroup.BuildGroups(assignments, a => a.CourseId, g => g.First().Course?.Name ?? "Unknown Course");
    }

    protected override Task OnInitializedAsync() => LoadUsersAsync();

    private async Task LoadUsersAsync()
    {
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            users = [];
            selectedUserId = string.Empty;
            assignments = [];
            RebuildGroupedAssignments();
            return;
        }

        // GetActiveUsersAsync rather than GetAllUsersAsync so the GDPR deleted-user placeholder
        // row never appears as a selectable person.
        IEnumerable<UserProfile> allUsers = await _securityService.GetActiveUsersAsync();

        if (scope.IsAdmin)
        {
            users = allUsers;
            return;
        }

        Result<List<UserProfile>> locationUsersResult = await _companyLocationService.GetUsersInLocationAsync(scope.LocationId!.Value);

        if (!locationUsersResult.IsSuccess || locationUsersResult.Data is null)
        {
            _toastService.ShowError($"Failed to load location members: {locationUsersResult.Error}");
            users = [];
            return;
        }

        HashSet<string> locationUserIds = [.. locationUsersResult.Data.Select(u => u.Id)];
        users = allUsers.Where(u => locationUserIds.Contains(u.Id));
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the tab renders an empty person picker
            // with nothing left on screen explaining why.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task LoadAssignmentsAsync()
    {
        if (string.IsNullOrEmpty(selectedUserId))
        {
            assignments = [];
            RebuildGroupedAssignments();
            return;
        }

        isLoading = true;

        // Re-resolved per load rather than reusing currentScope: CurrentLocationContextService is
        // request-scoped and reads the claim fresh, so a scope that has since changed must not be
        // served from a field cached when the tab first rendered.
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            assignments = [];
            RebuildGroupedAssignments();
            isLoading = false;
            return;
        }

        Result<List<CourseAssignment>> result = await _courseAssignmentService.GetAssignmentsForUserAsync(selectedUserId, scope);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load training record: {result.Error}");
            assignments = [];
        }
        else
        {
            assignments = result.Data;
        }

        RebuildGroupedAssignments();

        isLoading = false;
    }

    private async Task OpenTimingDialogAsync(CourseAssignment assignment)
    {
        string personName = users.FirstOrDefault(x => x.Id == selectedUserId)?.GetName() ?? selectedUserId;

        await _dialogService.ShowDialogAsync<AssignmentTimingDialog>(options =>
        {
            options.Header.Title = "Training Timing";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignmentId), assignment.Id);
            options.Parameters.Add(nameof(AssignmentTimingDialog.PersonName), personName);
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignedDate), assignment.AssignedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.StartedDate), assignment.StartedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.CompletedDate), assignment.CompletedDate);
        });
    }

    private static string GetLatestScore(CourseAssignment assignment)
    {
        CourseQuizAttempt? latest = assignment.Attempts.OrderByDescending(x => x.AttemptNumber).FirstOrDefault();
        return latest is null ? "-" : $"{latest.ScorePercent}%";
    }

}
