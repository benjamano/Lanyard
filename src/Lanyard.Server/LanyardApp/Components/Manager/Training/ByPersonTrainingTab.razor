@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.Enum

@inject ICourseAssignmentService _courseAssignmentService

<div class="by-person-tab">
    <div class="person-picker-host">
        <FluentSelect TOption="UserProfile" TValue="string" Items="@users.OrderBy(x => x.GetName())"
                      OptionText="@(i => i?.GetName() ?? string.Empty)" OptionValue="@(i => i?.Id)"
                      Placeholder="Select a person..." Label="Person" @bind-Value="selectedUserId"
                      @bind-Value:after="LoadAssignmentsAsync" Width="100%">
        </FluentSelect>
    </div>

    @if (!string.IsNullOrEmpty(selectedUserId))
    {
        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
                <FluentSpinner />
            </FluentStack>
        }
        else
        {
            <FluentDataGrid Items="@groupedAssignments.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr 1fr" Class="w-100 mt-2"
                            RowSize="@DataGridRowSize.Medium" HasRowDetails="@(g => HasExpandableDetails(g))">
                <ChildContent>
                    <TemplateColumn Title="Course" Sortable="true">
                        @context.Label
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <FluentBadge Content="@GetStatusLabel(context.Primary)" Color="@GetStatusColor(context.Primary)"
                                     Appearance="BadgeAppearance.Filled" />
                    </TemplateColumn>
                    <TemplateColumn Title="Latest Score">
                        @GetLatestScore(context.Primary)
                    </TemplateColumn>
                    <TemplateColumn Title="Due Date">
                        @(context.Primary.DueDate?.ToString("d MMM yyyy") ?? "-")
                    </TemplateColumn>
                    <TemplateColumn Title="">
                        <div class="assignment-row-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(context.Primary))" />
                        </div>
                    </TemplateColumn>
                </ChildContent>
                <RowDetails>
                    <AssignmentGroupDetails Assignments="@context.Assignments">
                        <ActionsTemplate Context="assignment">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(assignment))" />
                        </ActionsTemplate>
                    </AssignmentGroupDetails>
                </RowDetails>
                <EmptyContent>
                    This person has no training assigned.
                </EmptyContent>
            </FluentDataGrid>
        }
    }
</div>

@code {
    private IEnumerable<UserProfile> users = [];
    private List<CourseAssignment> assignments = [];
    private List<TrainingAssignmentGroup> groupedAssignments = [];
    private string selectedUserId = string.Empty;
    private bool isLoading;

    // Built once whenever assignments changes, rather than recomputed on every render (a plain
    // `=>` property was here originally) - FluentDataGrid tracks which row is expanded by the
    // TrainingAssignmentGroup instance itself, and Blazor auto-rerenders a component after any
    // event handler on it completes (e.g. clicking any button in a row), so a property that
    // rebuilds fresh instances every render silently collapsed every expanded row on the very
    // next click, anywhere on the page.
    private void RebuildGroupedAssignments()
    {
        groupedAssignments = assignments
            .GroupBy(a => a.CourseId)
            .Select(g => new TrainingAssignmentGroup
            {
                Label = g.First().Course?.Name ?? "Unknown Course",
                Assignments = g.OrderByDescending(x => x.AssignedDate).ToList()
            })
            .OrderBy(g => g.Label)
            .ToList();
    }

    private static bool HasExpandableDetails(TrainingAssignmentGroup group) =>
        group.Assignments.Count > 1 || group.Primary.Attempts.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        users = await _securityService.GetAllUsersAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        if (string.IsNullOrEmpty(selectedUserId))
        {
            assignments = [];
            RebuildGroupedAssignments();
            return;
        }

        isLoading = true;

        Result<List<CourseAssignment>> result = await _courseAssignmentService.GetAssignmentsForUserAsync(selectedUserId);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load training record: {result.Error}");
            assignments = [];
        }
        else
        {
            assignments = result.Data;
        }

        RebuildGroupedAssignments();

        isLoading = false;
    }

    private async Task OpenTimingDialogAsync(CourseAssignment assignment)
    {
        string personName = users.FirstOrDefault(x => x.Id == selectedUserId)?.GetName() ?? selectedUserId;

        await _dialogService.ShowDialogAsync<AssignmentTimingDialog>(options =>
        {
            options.Header.Title = "Training Timing";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignmentId), assignment.Id);
            options.Parameters.Add(nameof(AssignmentTimingDialog.PersonName), personName);
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignedDate), assignment.AssignedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.StartedDate), assignment.StartedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.CompletedDate), assignment.CompletedDate);
        });
    }

    private static string GetLatestScore(CourseAssignment assignment)
    {
        CourseQuizAttempt? latest = assignment.Attempts.OrderByDescending(x => x.AttemptNumber).FirstOrDefault();
        return latest is null ? "-" : $"{latest.ScorePercent}%";
    }

    private static string GetStatusLabel(CourseAssignment assignment) => assignment.GetStatus() switch
    {
        CourseAssignmentStatus.NotStarted => "Not Started",
        CourseAssignmentStatus.InProgress => "In Progress",
        CourseAssignmentStatus.Completed => "Completed",
        CourseAssignmentStatus.Overdue => "Overdue",
        _ => "Unknown"
    };

    private static BadgeColor GetStatusColor(CourseAssignment assignment) => assignment.GetStatus() switch
    {
        CourseAssignmentStatus.NotStarted => BadgeColor.Subtle,
        CourseAssignmentStatus.InProgress => BadgeColor.Informative,
        CourseAssignmentStatus.Completed => BadgeColor.Success,
        CourseAssignmentStatus.Overdue => BadgeColor.Danger,
        _ => BadgeColor.Subtle
    };
}
