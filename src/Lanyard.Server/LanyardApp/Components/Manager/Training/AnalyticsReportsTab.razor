@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.DTO.Training
@using Lanyard.Infrastructure.DTO.Charts
@using Lanyard.App.Components.Charts

@inject ICourseService _courseService
@inject ITrainingAnalyticsService _analyticsService

<div class="analytics-reports-tab">
    @if (scopeFailed)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="my-4">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                We couldn't work out which location you're working in, so these reports can't be
                loaded. This is usually temporary - try again, or sign out and back in.
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="LoadCoursesAsync">
                Reload
            </FluentButton>
        </FluentStack>
    }
    else
    {
    <div class="course-picker-host">
        <FluentSelect TOption="Course" TValue="Guid" Items="@courses.OrderBy(x => x.Name)"
                      OptionText="@(i => i?.Name ?? string.Empty)" OptionValue="@(i => i!.Id)" Placeholder="Select a course..."
                      Label="Course" Value="@selectedCourseId" ValueChanged="@((Guid v) => OnCourseSelectedAsync(v))"
                      Width="100%">
        </FluentSelect>
    </div>

    @if (selectedCourseId != Guid.Empty)
    {
        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
                <FluentSpinner />
            </FluentStack>
        }
        else
        {
            <div class="analytics-grid">
                <FluentCard Height="100%">
                    <FluentText As="TextTag.H5">Top Scores (%)</FluentText>
                    <RankedBarChart Data="@scoreChartData" ValueSuffix="%" />
                </FluentCard>
                <FluentCard Height="100%">
                    <FluentText As="TextTag.H5">Fastest Completions (min)</FluentText>
                    <RankedBarChart Data="@fastestChartData" ValueSuffix=" min" SeriesColor="@ChartPalette.Success" />
                </FluentCard>
                <FluentCard Height="100%">
                    <FluentText As="TextTag.H5">Slowest Completions (min)</FluentText>
                    <RankedBarChart Data="@slowestChartData" ValueSuffix=" min" SeriesColor="@ChartPalette.Warning" />
                </FluentCard>
                <FluentCard Height="100%">
                    <FluentText As="TextTag.H5">Completion Status</FluentText>
                    <CategoryDonutChart Data="@statusChartData" />
                </FluentCard>
                <FluentCard Height="100%" Padding="@Padding.Bottom7">
                    <FluentText As="TextTag.H5">Pass / Fail (latest attempt)</FluentText>
                    <CategoryDonutChart Data="@passFailChartData" SeriesColors="@passFailColors" />
                </FluentCard>
            </div>
        }
    }
    }
</div>

@code {
    private List<Course> courses = [];
    private Guid selectedCourseId = Guid.Empty;
    private bool isLoading;

    private IEnumerable<UserProfile> users = [];
    private List<ChartCategoryValue> scoreChartData = [];
    private List<ChartCategoryValue> fastestChartData = [];
    private List<ChartCategoryValue> slowestChartData = [];
    private List<ChartCategoryValue> statusChartData = [];
    private List<ChartCategoryValue> passFailChartData = [];
    private readonly string[] passFailColors = [ChartPalette.Success, ChartPalette.Danger];
    private bool scopeFailed;
    private LocationScope? currentScope;

    protected override Task OnInitializedAsync() => LoadCoursesAsync();

    private async Task LoadCoursesAsync()
    {
        users = await _securityService.GetAllUsersAsync();

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            courses = [];
            return;
        }

        // allLocations: true keeps this tab exactly as it was before the Courses page gained a
        // location filter. Narrowing it is a separate change - the data behind this tab still
        // comes from services that are unfiltered for an Admin, so scoping only the course list
        // here would show a narrowed picker over company-wide figures.
        Result<List<Course>> coursesResult = await _courseService.GetCoursesAsync(scope, allLocations: true);

        if (!coursesResult.IsSuccess || coursesResult.Data is null)
        {
            _toastService.ShowError($"Failed to load courses: {coursesResult.Error}");
            courses = [];
        }
        else
        {
            courses = coursesResult.Data;
        }
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the tab renders an empty course picker
            // with nothing left on screen explaining why.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task OnCourseSelectedAsync(Guid value)
    {
        selectedCourseId = value;
        await LoadAnalyticsAsync();
    }

    private async Task LoadAnalyticsAsync()
    {
        if (selectedCourseId == Guid.Empty)
        {
            return;
        }

        isLoading = true;

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            scoreChartData = [];
            fastestChartData = [];
            slowestChartData = [];
            statusChartData = [];
            passFailChartData = [];
            isLoading = false;
            return;
        }

        Result<List<TraineeScoreRankingRow>> scores = await _analyticsService.GetTopScoringTraineesAsync(selectedCourseId, scope);
        Result<List<TraineeTimingRankingRow>> fastest = await _analyticsService.GetFastestCompletionsAsync(selectedCourseId, scope);
        Result<List<TraineeTimingRankingRow>> slowest = await _analyticsService.GetSlowestCompletionsAsync(selectedCourseId, scope);
        Result<CourseCompletionSummary> summary = await _analyticsService.GetCourseCompletionSummaryAsync(selectedCourseId, scope);

        scoreChartData = MapScores(scores);
        fastestChartData = MapTimings(fastest);
        slowestChartData = MapTimings(slowest);
        (statusChartData, passFailChartData) = MapSummary(summary);

        isLoading = false;
    }

    private string ResolveName(string userId) => users.FirstOrDefault(x => x.Id == userId)?.GetName() ?? userId;

    private List<ChartCategoryValue> MapScores(Result<List<TraineeScoreRankingRow>> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load top scores: {result.Error}");
            return [];
        }

        return [.. result.Data.Select(r => new ChartCategoryValue(ResolveName(r.UserId), r.ScorePercent))];
    }

    private List<ChartCategoryValue> MapTimings(Result<List<TraineeTimingRankingRow>> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load completion timings: {result.Error}");
            return [];
        }

        return [.. result.Data.Select(r => new ChartCategoryValue(ResolveName(r.UserId), Math.Round(r.DurationMinutes, 1)))];
    }

    private (List<ChartCategoryValue> Status, List<ChartCategoryValue> PassFail) MapSummary(Result<CourseCompletionSummary>
result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load completion summary: {result.Error}");
            return ([], []);
        }

        CourseCompletionSummary s = result.Data;

        List<ChartCategoryValue> status =
        [
            new("Not Started", s.NotStartedCount),
            new("In Progress", s.InProgressCount),
            new("Overdue", s.OverdueCount),
            new("Completed", s.CompletedCount)
        ];

        List<ChartCategoryValue> passFail =
        [
            new("Passed", s.LatestAttemptPassedCount),
            new("Failed", s.LatestAttemptFailedCount)
        ];

        return (status, passFail);
    }
}
