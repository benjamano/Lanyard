@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.Enum
@using Lanyard.App.Components.Manager

@inject ICourseService _courseService
@inject ICourseAssignmentService _courseAssignmentService
@inject IJSRuntime JS

<div class="by-course-tab">
    @if (scopeFailed)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Class="my-4">
            <FluentMessageBar Intent="MessageBarIntent.Error">
                We couldn't work out which location you're working in, so this tab can't be
                loaded. This is usually temporary - try again, or sign out and back in.
            </FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="LoadCoursesAsync">
                Reload
            </FluentButton>
        </FluentStack>
    }
    else
    {
    <div class="course-picker-host">
        <FluentSelect TOption="Course" TValue="Guid" Items="@courses.OrderBy(x => x.Name)"
                      OptionText="@(i => i?.Name ?? string.Empty)" OptionValue="@(i => i!.Id)" Placeholder="Select a course..."
                      Label="Course" Value="@selectedCourseId" ValueChanged="@((Guid v) => OnCourseSelectedAsync(v))"
                      Width="100%">
        </FluentSelect>
    </div>

    @if (selectedCourseId != Guid.Empty)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Class="mt-2 mb-2">
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.PersonAdd())"
                          OnClick="OpenBulkAssignDialogAsync">
                Bulk assign…
            </FluentButton>
        </FluentStack>

        @if (isLoadingAssignments)
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Class="my-4">
                <FluentSpinner />
            </FluentStack>
        }
        else
        {
            <FluentDataGrid Items="@groupedAssignments.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr 1fr" Class="w-100"
                            RowSize="@DataGridRowSize.Medium" HasRowDetails="@(g => g.HasExpandableDetails)">
                <ChildContent>
                    <TemplateColumn Title="Person">
                        @context.Label
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <FluentBadge Content="@context.Primary.GetStatusLabel()" Color="@context.Primary.GetStatusColor()"
                                     Appearance="BadgeAppearance.Filled" />
                    </TemplateColumn>
                    <TemplateColumn Title="Latest Score">
                        @GetLatestScore(context.Primary)
                    </TemplateColumn>
                    <TemplateColumn Title="Due Date">
                        @(context.Primary.DueDate?.ToString("d MMM yyyy") ?? "-")
                    </TemplateColumn>
                    <TemplateColumn Title="">
                        <div class="assignment-row-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Link())" IconOnly="true"
                                          Tooltip="Copy link to this assignment" Title="Copy link to this assignment"
                                          OnClick="@(() => CopyLinkAsync(context.Primary))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.CalendarEdit())" IconOnly="true"
                                          Tooltip="Edit due date" Title="Edit due date"
                                          OnClick="@(() => OpenEditDueDateDialogAsync(context.Primary))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(context.Primary))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.PersonDelete())" IconOnly="true"
                                          Tooltip="Unassign" Title="Unassign"
                                          OnClick="@(() => UnassignAsync(context.Primary))" />
                        </div>
                    </TemplateColumn>
                </ChildContent>
                <RowDetails>
                    <AssignmentGroupDetails Assignments="@context.Assignments">
                        <ActionsTemplate Context="assignment">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Link())" IconOnly="true"
                                          Tooltip="Copy link to this assignment" Title="Copy link to this assignment"
                                          OnClick="@(() => CopyLinkAsync(assignment))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.CalendarEdit())" IconOnly="true"
                                          Tooltip="Edit due date" Title="Edit due date"
                                          OnClick="@(() => OpenEditDueDateDialogAsync(assignment))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.Timer())" IconOnly="true"
                                          Tooltip="View timing" Title="View timing"
                                          OnClick="@(() => OpenTimingDialogAsync(assignment))" />
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.PersonDelete())" IconOnly="true"
                                          Tooltip="Unassign" Title="Unassign"
                                          OnClick="@(() => UnassignAsync(assignment))" />
                        </ActionsTemplate>
                    </AssignmentGroupDetails>
                </RowDetails>
                <EmptyContent>
                    No one is assigned to this course yet.
                </EmptyContent>
            </FluentDataGrid>
        }
    }
    }
</div>

@code {
    private List<Course> courses = [];
    private List<CourseAssignment> assignments = [];
    private Dictionary<string, string> userNamesById = [];
    private Guid selectedCourseId = Guid.Empty;
    private bool isLoadingAssignments;
    private bool scopeFailed;
    private LocationScope? currentScope;

    private List<TrainingAssignmentGroup> groupedAssignments = [];

    private void RebuildGroupedAssignments()
    {
        groupedAssignments = TrainingAssignmentGroup.BuildGroups(assignments, a => a.UserId, g => GetUserName(g.Key));
    }

    protected override Task OnInitializedAsync() => LoadCoursesAsync();

    private async Task LoadCoursesAsync()
    {
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            courses = [];
        }
        else
        {
            // allLocations: true keeps this tab exactly as it was before the Courses page gained a
            // location filter. Narrowing it is a separate change - the data behind this tab still
            // comes from services that are unfiltered for an Admin, so scoping only the course list
            // here would show a narrowed picker over company-wide figures.
            Result<List<Course>> coursesResult = await _courseService.GetCoursesAsync(scope, allLocations: true);

            if (!coursesResult.IsSuccess || coursesResult.Data is null)
            {
                _toastService.ShowError($"Failed to load courses: {coursesResult.Error}");
                courses = [];
            }
            else
            {
                courses = coursesResult.Data;
            }
        }

        IEnumerable<UserProfile> allUsers = await _securityService.GetAllUsersAsync();
        userNamesById = allUsers.ToDictionary(x => x.Id, x => x.GetName());
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the tab renders an empty course picker
            // with nothing left on screen explaining why.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task OnCourseSelectedAsync(Guid value)
    {
        selectedCourseId = value;
        await LoadAssignmentsAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        if (selectedCourseId == Guid.Empty)
        {
            assignments = [];
            RebuildGroupedAssignments();
            return;
        }

        isLoadingAssignments = true;

        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            assignments = [];
            RebuildGroupedAssignments();
            isLoadingAssignments = false;
            return;
        }

        Result<List<CourseAssignment>> result = await _courseAssignmentService.GetAssignmentsForCourseAsync(selectedCourseId, scope);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to load assignments: {result.Error}");
            assignments = [];
        }
        else
        {
            assignments = result.Data;
        }

        RebuildGroupedAssignments();
        isLoadingAssignments = false;
    }

    private string GetUserName(string userId) => userNamesById.TryGetValue(userId, out string? name) ? name : userId;

    private static string GetLatestScore(CourseAssignment assignment)
    {
        CourseQuizAttempt? latest = assignment.Attempts.OrderByDescending(x => x.AttemptNumber).FirstOrDefault();
        return latest is null ? "-" : $"{latest.ScorePercent}%";
    }

    private async Task CopyLinkAsync(CourseAssignment assignment)
    {
        string link = $"{_navigationManager.BaseUri}training/{assignment.Id}";
        bool success = await JS.TryCopyToClipboardAsync(link);

        if (success)
        {
            _toastService.ShowSuccess("Link copied to clipboard.");
        }
        else
        {
            _toastService.ShowError("Could not copy the link. Your browser may be blocking clipboard access.");
        }
    }

    private async Task OpenBulkAssignDialogAsync()
    {
        DialogResult result = await _dialogService.ShowDialogAsync<BulkAssignDialog>(options =>
        {
            options.Header.Title = "Bulk Assign Course";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(BulkAssignDialog.CourseId), selectedCourseId);
        });

        if (!result.Cancelled)
        {
            await LoadAssignmentsAsync();
        }
    }

    private async Task OpenEditDueDateDialogAsync(CourseAssignment assignment)
    {
        DialogResult result = await _dialogService.ShowDialogAsync<EditDueDateDialog>(options =>
        {
            options.Header.Title = "Edit Due Date";
            options.Width = "min(400px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(EditDueDateDialog.AssignmentId), assignment.Id);
            options.Parameters.Add(nameof(EditDueDateDialog.CurrentDueDate), assignment.DueDate);
        });

        if (!result.Cancelled)
        {
            await LoadAssignmentsAsync();
        }
    }

    private async Task OpenTimingDialogAsync(CourseAssignment assignment)
    {
        await _dialogService.ShowDialogAsync<AssignmentTimingDialog>(options =>
        {
            options.Header.Title = "Training Timing";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignmentId), assignment.Id);
            options.Parameters.Add(nameof(AssignmentTimingDialog.PersonName), GetUserName(assignment.UserId));
            options.Parameters.Add(nameof(AssignmentTimingDialog.AssignedDate), assignment.AssignedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.StartedDate), assignment.StartedDate);
            options.Parameters.Add(nameof(AssignmentTimingDialog.CompletedDate), assignment.CompletedDate);
        });
    }

    private async Task UnassignAsync(CourseAssignment assignment)
    {
        DialogResult confirmResult = await _dialogService.ShowDialogAsync<ConfirmDeleteUserDialog>(options =>
        {
            options.Header.Title = "Unassign course?";
            options.Width = "min(500px, 95vw)";
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.Message),
                $"Unassign this course from {GetUserName(assignment.UserId)}? They will lose access, but you can re-assign it at any time.");
            options.Parameters.Add(nameof(ConfirmDeleteUserDialog.ConfirmLabel), "Unassign");
        });

        if (confirmResult.Cancelled)
        {
            return;
        }

        Result<bool> result = await _courseAssignmentService.UnassignAsync(assignment.Id);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to unassign: {result.Error}");
            return;
        }

        _toastService.ShowSuccess("Unassigned.");
        await LoadAssignmentsAsync();
    }
}
