@using Lanyard.Infrastructure.Models

<div class="attempt-history-list">
    @if (Attempts.Count == 0)
    {
        <FluentText Color="Color.Disabled">No attempts yet.</FluentText>
    }
    else
    {
        <FluentDataGrid Items="@_sortedAttempts.AsQueryable()"
                        GridTemplateColumns="1fr 1fr 1fr 1fr" RowSize="@DataGridRowSize.Small">
            <ChildContent>
                <PropertyColumn Property="@(x => x.AttemptNumber)" Title="Attempt #" />
                <PropertyColumn Property="@(x => x.SubmittedDate.ToString("d MMM yyyy HH:mm"))" Title="Submitted" />
                <PropertyColumn Property="@(x => $"{x.ScorePercent}%")" Title="Score" />
                <TemplateColumn Title="Result">
                    <FluentBadge Content="@(context.Passed ? "Passed" : "Failed")"
                                 Color="@(context.Passed ? BadgeColor.Success : BadgeColor.Danger)"
                                 Appearance="BadgeAppearance.Filled" />
                </TemplateColumn>
            </ChildContent>
        </FluentDataGrid>
    }
</div>

@code {
    private List<CourseQuizAttempt> _sortedAttempts = [];
    private List<CourseQuizAttempt>? _sourceAttempts;

    [Parameter, EditorRequired]
    public required List<CourseQuizAttempt> Attempts { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_sourceAttempts, Attempts))
        {
            _sourceAttempts = Attempts;
            _sortedAttempts = [.. Attempts.OrderByDescending(x => x.AttemptNumber)];
        }
    }
}
