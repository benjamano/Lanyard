@using Lanyard.Application.Services.Training
@using Lanyard.Application.Services.ApplicationRoles
@using Lanyard.Infrastructure.DTO.Training

@inject ICourseAssignmentService _courseAssignmentService
@inject ApplicationRolesService _rolesService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.PersonAdd())" Margin="@Margin.End2" />
            <FluentText As=" TextTag.H4" Size="TextSize.Size500">Bulk Assign Course</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @if (scopeFailed)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
                <FluentMessageBar Intent="MessageBarIntent.Error">
                    We couldn't work out which location you're working in, so nobody can be
                    assigned right now. This is usually temporary - try again, or sign out and
                    back in.
                </FluentMessageBar>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.ArrowClockwise())" OnClick="LoadAsync">
                        Reload
                    </FluentButton>
                    <FluentButton OnClick="CancelAsync">Close</FluentButton>
                </FluentStack>
            </FluentStack>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                    <FluentButton
                        Appearance="@(mode == AssignMode.Individually ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                        OnClick="@(() => mode = AssignMode.Individually)">
                        Individually
                    </FluentButton>
                    <FluentButton
                        Appearance="@(mode == AssignMode.ByRole ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                        OnClick="@(() => mode = AssignMode.ByRole)">
                        By Role
                    </FluentButton>
                </FluentStack>

                @if (mode == AssignMode.Individually)
                {
                    <FluentListbox TOption="UserProfile" TValue="string" Items="@users.OrderBy(x => x.GetName())"
                                   OptionText="@(i => i?.GetName() ?? string.Empty)" OptionValue="@(i => i?.Id)"
                                   @bind-SelectedItems="selectedUsers" Multiple="true" Label="Select users" Height="220px" Width="100%">
                    </FluentListbox>
                }
                else
                {
                    <FluentSelect TOption="ApplicationRole" TValue="string" Items="@roles.OrderBy(x => x.Name)"
                                  OptionText="@(i => i?.Name ?? string.Empty)" OptionValue="@(i => i?.Id)" Placeholder="Select a role..."
                                  Label="Role" @bind-Value="selectedRoleId" Width="100%">
                    </FluentSelect>
                }

                <FluentDatePicker TValue="DateTime?" @bind-Value="dueDate" Label="Due Date (optional)" Width="100%" Margin="@Margin.Top0">
                </FluentDatePicker>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                    <FluentButton Appearance="ButtonAppearance.Primary" Loading="@isSubmitting" OnClick="SubmitAsync">
                        Assign
                    </FluentButton>
                    <FluentButton OnClick="CancelAsync" Disabled="@isSubmitting">Cancel</FluentButton>
                </FluentStack>
            </FluentStack>
        }
    </ChildContent>
</FluentDialogBody>

@code {
    private enum AssignMode { Individually, ByRole }

    [Parameter]
    public Guid CourseId { get; set; }

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private AssignMode mode = AssignMode.Individually;
    private IEnumerable<UserProfile> users = [];
    private IEnumerable<UserProfile> selectedUsers = [];
    private List<ApplicationRole> roles = [];
    private string? selectedRoleId;
    private DateTime? dueDate;
    private bool isSubmitting;
    private bool scopeFailed;
    private LocationScope? currentScope;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            return;
        }

        users = await _securityService.GetAllUsersAsync();

        if (!scope.IsAdmin)
        {
            Result<List<UserProfile>> locationUsersResult = await
_companyLocationService.GetUsersInLocationAsync(scope.LocationId!.Value);

            if (!locationUsersResult.IsSuccess || locationUsersResult.Data is null)
            {
                _toastService.ShowError($"Failed to load location members: {locationUsersResult.Error}");
                users = [];
            }
            else
            {
                HashSet<string> locationUserIds = [.. locationUsersResult.Data.Select(u => u.Id)];
                users = users.Where(u => locationUserIds.Contains(u.Id));
            }
        }

        Result<List<ApplicationRole>> rolesResult = await _rolesService.GetAllApplicationRolesAsync();

        if (rolesResult.IsSuccess && rolesResult.Data is not null)
        {
            roles = rolesResult.Data;
        }
    }

    private async Task<LocationScope?> ResolveScopeAsync()
    {
        Result<LocationScope> scopeResult = await _currentLocationContext.GetScopeAsync();

        if (!scopeResult.IsSuccess)
        {
            _toastService.ShowError(scopeResult.Error!);
            // The toast auto-dismisses. Without this flag the dialog offers an empty picker and
            // an Assign button that cannot succeed, with no explanation left on screen.
            scopeFailed = true;
            return null;
        }

        scopeFailed = false;
        currentScope = scopeResult.Data;
        return currentScope;
    }

    private async Task SubmitAsync()
    {
        LocationScope? scope = await ResolveScopeAsync();

        if (scope is null)
        {
            return;
        }

        List<string> userIds;

        if (mode == AssignMode.ByRole)
        {
            if (string.IsNullOrEmpty(selectedRoleId))
            {
                _toastService.ShowError("Select a role.");
                return;
            }

            Result<List<UserProfile>> usersInRoleResult = await _rolesService.GetUsersInRoleAsync(selectedRoleId);

            if (!usersInRoleResult.IsSuccess || usersInRoleResult.Data is null)
            {
                _toastService.ShowError($"Failed to resolve role members: {usersInRoleResult.Error}");
                return;
            }

            userIds = [.. usersInRoleResult.Data.Select(x => x.Id)];

            if (!scope.IsAdmin)
            {
                Result<List<UserProfile>> locationUsersResult = await
_companyLocationService.GetUsersInLocationAsync(scope.LocationId!.Value);

                if (!locationUsersResult.IsSuccess || locationUsersResult.Data is null)
                {
                    _toastService.ShowError($"Failed to load location members: {locationUsersResult.Error}");
                    return;
                }

                HashSet<string> locationUserIds = [.. locationUsersResult.Data.Select(u => u.Id)];
                userIds = [.. userIds.Where(locationUserIds.Contains)];
            }
        }
        else
        {
            userIds = [.. selectedUsers.Select(x => x.Id)];
        }

        if (userIds.Count == 0)
        {
            _toastService.ShowError("Select at least one person.");
            return;
        }

        isSubmitting = true;

        Result<string> currentUserResult = await _securityService.GetCurrentUserIdAsync();

        if (!currentUserResult.IsSuccess || currentUserResult.Data is null)
        {
            _toastService.ShowError("Could not determine the current user.");
            isSubmitting = false;
            return;
        }

        Result<BulkAssignResult> result = await _courseAssignmentService.AssignCourseToUsersAsync(
            CourseId, userIds, currentUserResult.Data, dueDate, scope);

        if (!result.IsSuccess || result.Data is null)
        {
            _toastService.ShowError($"Failed to assign course: {result.Error}");
            isSubmitting = false;
            return;
        }

        // Report the two skip reasons separately - a user filtered out for being outside this
        // manager's location is a different problem from one who already had the course, and
        // lumping them together (or omitting them) makes the totals look like they don't add up.
        List<string> skipNotes = [];

        if (result.Data.SkippedDuplicateCount > 0)
        {
            skipNotes.Add($"{result.Data.SkippedDuplicateCount} already had this course");
        }

        if (result.Data.SkippedOutsideLocationCount > 0)
        {
            skipNotes.Add($"{result.Data.SkippedOutsideLocationCount} skipped - not in your location");
        }

        string message = skipNotes.Count > 0
            ? $"Assigned to {result.Data.AssignedCount} people ({string.Join("; ", skipNotes)})."
            : $"Assigned to {result.Data.AssignedCount} people.";

        _toastService.ShowSuccess(message);
        await Dialog.CloseAsync(true);
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
}
