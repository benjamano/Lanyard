@using Lanyard.Application.Services.Locations
@using Lanyard.App.Components.Files

@inject INotificationService ToastService

@* The plain wrapper div is what carries this component's scoped-CSS attribute - FluentUI
   component roots do not receive it, so every rule in the sibling .razor.css reaches them
   via "::deep" from here. *@
<div class="company-location-manager">
<FluentCard Height="auto" Class="clm-root-card">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentText Typo="Typography.H4">Companies &amp; Locations</FluentText>

        <FluentGrid Class="w-100">
            <FluentGridItem Xs="12" Sm="4">
                <FluentCard Height="auto">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentText Typo="Typography.H6">Companies</FluentText>

                        <FluentText Typo="Typography.Body" Class="clm-form-heading">
                            @(selectedCompany is null ? "Add a company" : $"Editing {selectedCompany.Name}")
                        </FluentText>

                        <FluentTextInput @bind-Value="companyName" Label="Company name" Placeholder="Partyman" Class="clm-full-width" />
                        <FluentTextInput @bind-Value="companyThemeColor" Label="Theme color (hex)" Placeholder="#C8102E" Class="clm-full-width" />
                        @if (!string.IsNullOrWhiteSpace(companyThemeColor))
                        {
                            <div class="clm-color-swatch" style="background-color:@companyThemeColor;"></div>
                        }
                        <FileUploader Accept="image/*" MaximumFileSize="@(5*1024*1024)" OnFileUploaded="OnLogoUploaded" />
                        @if (companyLogoFileId is not null)
                        {
                            <FluentText Class="clm-empty-note">
                                A logo is set. Upload a file to replace it, or clear it.
                            </FluentText>
                        }

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                            @if (selectedCompany is null)
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveCompany">Add Company</FluentButton>
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveCompany">Save Changes</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="StartNewCompany">New Company</FluentButton>
                            }

                            @if (companyLogoFileId is not null)
                            {
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="ClearLogo">Clear Logo</FluentButton>
                            }
                        </FluentStack>

                        <FluentDataGrid Items="@companies.AsQueryable()" GridTemplateColumns="2fr 1fr" Class="clm-full-width">
                            <TemplateColumn Title="Name">
                                @context.Name
                            </TemplateColumn>
                            <TemplateColumn Title="Actions">
                                <FluentButton Appearance="@(selectedCompany?.Id == context.Id ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                                              OnClick="@(() => SelectCompany(context))">
                                    Select
                                </FluentButton>
                            </TemplateColumn>
                        </FluentDataGrid>
                    </FluentStack>
                </FluentCard>
            </FluentGridItem>

            <FluentGridItem Xs="12" Sm="8">
                @if (selectedCompany is not null)
                {
                    <FluentCard Height="auto">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentText Typo="Typography.H6">Locations for @selectedCompany.Name</FluentText>

                            <FluentTextInput @bind-Value="newLocationName" Label="New location name" Placeholder="Ipswich" Class="clm-full-width" />
                            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="AddLocation">Add Location</FluentButton>

                            @if (!locationsForSelectedCompany.Any())
                            {
                                <FluentText Class="clm-empty-note">
                                    No locations yet for this company.
                                </FluentText>
                            }
                            else
                            {
                                <FluentDataGrid Items="@locationsForSelectedCompany.AsQueryable()" GridTemplateColumns="2fr 1fr" Class="clm-full-width">
                                    <TemplateColumn Title="Name">
                                        @context.GetDisplayName()
                                    </TemplateColumn>
                                    <TemplateColumn Title="Actions">
                                        <FluentButton IconEnd="@(new Icons.Regular.Size20.Delete())" OnClick="@(() => DeactivateLocation(context.Id))" />
                                    </TemplateColumn>
                                </FluentDataGrid>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            </FluentGridItem>
        </FluentGrid>
    </FluentStack>
</FluentCard>
</div>

@code {
    [Parameter]
    public EventCallback OnLocationsChanged { get; set; }

    private List<Company> companies = [];
    private List<Location> locationsForSelectedCompany = [];
    private Company? selectedCompany;

    // One form, two modes: with no company selected it creates, with one selected it edits that
    // company in place. Selecting a company round-trips its complete current branding into these
    // fields, so a save always sends the full state back (see SaveCompanyAsync's update branch).
    private string companyName = string.Empty;
    private string companyThemeColor = string.Empty;
    private Guid? companyLogoFileId;
    private string newLocationName = string.Empty;

    private void OnLogoUploaded(FileMetadata file)
    {
        companyLogoFileId = file.Id;
    }

    private void ClearLogo()
    {
        companyLogoFileId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCompaniesAsync();
    }

    private async Task LoadCompaniesAsync()
    {
        Result<List<Company>> result = await _companyLocationService.GetCompaniesAsync();

        if (result.IsSuccess)
        {
            companies = result.Data!;
        }
        else
        {
            ToastService.ShowError($"Failed to load companies: {result.Error}");
        }
    }

    private async Task SaveCompany()
    {
        if (string.IsNullOrWhiteSpace(companyName))
        {
            return;
        }

        bool isEdit = selectedCompany is not null;

        // Id 0 routes SaveCompanyAsync down its create branch; a real id routes it down the
        // update branch, which is what makes an already-seeded company (e.g. Play2Day) brandable.
        Result<Company> result = await _companyLocationService.SaveCompanyAsync(new Company
        {
            Id = selectedCompany?.Id ?? 0,
            Name = companyName,
            ThemeColorHex = companyThemeColor,
            LogoFileId = companyLogoFileId
        });

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to {(isEdit ? "save" : "add")} company: {result.Error}");
            return;
        }

        await LoadCompaniesAsync();

        if (isEdit)
        {
            // Re-point at the freshly loaded row so the form and the Locations panel keep
            // showing the saved state rather than the now-stale pre-save instance.
            Company? reloaded = companies.FirstOrDefault(x => x.Id == result.Data!.Id);

            if (reloaded is not null)
            {
                selectedCompany = reloaded;
                PopulateFormFrom(reloaded);
            }

            ToastService.ShowSuccess("Company updated.");
            return;
        }

        ClearForm();
        ToastService.ShowSuccess("Company added.");
    }

    private void StartNewCompany()
    {
        selectedCompany = null;
        locationsForSelectedCompany = [];
        ClearForm();
    }

    private void ClearForm()
    {
        companyName = string.Empty;
        companyThemeColor = string.Empty;
        companyLogoFileId = null;
    }

    private void PopulateFormFrom(Company company)
    {
        companyName = company.Name;
        companyThemeColor = company.ThemeColorHex ?? string.Empty;
        companyLogoFileId = company.LogoFileId;
    }

    private async Task SelectCompany(Company company)
    {
        selectedCompany = company;
        PopulateFormFrom(company);
        await LoadLocationsAsync();
    }

    private async Task LoadLocationsAsync()
    {
        if (selectedCompany is null)
        {
            return;
        }

        Result<List<Location>> result = await _companyLocationService.GetLocationsAsync(selectedCompany.Id);

        if (result.IsSuccess)
        {
            locationsForSelectedCompany = result.Data!;
        }
        else
        {
            ToastService.ShowError($"Failed to load locations: {result.Error}");
        }
    }

    private async Task AddLocation()
    {
        if (selectedCompany is null || string.IsNullOrWhiteSpace(newLocationName))
        {
            return;
        }

        Result<Location> result = await _companyLocationService.SaveLocationAsync(new Location { CompanyId = selectedCompany.Id, Name = newLocationName });

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to add location: {result.Error}");
            return;
        }

        newLocationName = string.Empty;
        await LoadLocationsAsync();
        await OnLocationsChanged.InvokeAsync();
    }

    private async Task DeactivateLocation(int locationId)
    {
        Result<bool> result = await _companyLocationService.DeactivateLocationAsync(locationId);

        if (!result.IsSuccess)
        {
            ToastService.ShowError($"Failed to deactivate location: {result.Error}");
            return;
        }

        await LoadLocationsAsync();
        await OnLocationsChanged.InvokeAsync();
    }
}
