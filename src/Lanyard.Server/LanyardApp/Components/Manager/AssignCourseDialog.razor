@using Lanyard.Application.Services.Training
@using Lanyard.Infrastructure.Models

@inject ICourseAssignmentService _courseAssignmentService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.PersonAdd())" />
            <FluentText Typo="Typography.PaneHeader">Assign Course</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <EditForm EditContext="@_editContext" OnValidSubmit="HandleAssignAsync">
            <DataAnnotationsValidator />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
                <FluentSelect TOption="UserProfile"
                              TValue="string"
                              Items="@userProfiles.OrderBy(x => x.GetName())"
                              OptionText="@(i => i?.GetName() ?? string.Empty)"
                              OptionValue="@(i => i?.Id)"
                              Placeholder="Select a user..."
                              Label="Assign to"
                              @bind-Value="model.UserId"
                              Width="100%">
                </FluentSelect>
                <FluentDatePicker TValue="DateTime?" @bind-Value="model.DueDate"
                                  Label="Due Date (optional)"
                                  Width="100%">
                </FluentDatePicker>

                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Type="ButtonType.Submit"
                                  Disabled="@isSubmitting"
                                  Loading="@isSubmitting"
                                  IconStart="@(new Icons.Regular.Size20.PersonAdd())">
                        Assign
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelDialog" Disabled="@isSubmitting">
                        Cancel
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </EditForm>
    </ChildContent>
</FluentDialogBody>

@code {
    [Parameter]
    public Guid CourseId { get; set; }

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private IEnumerable<UserProfile> userProfiles = [];
    private bool isSubmitting;
    private AssignCourseModel model = new();
    private EditContext _editContext = default!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(model);
    }

    protected override async Task OnInitializedAsync()
    {
        userProfiles = await _securityService.GetAllUsersAsync();
    }

    private async Task HandleAssignAsync()
    {
        if (string.IsNullOrEmpty(model.UserId))
        {
            _toastService.ShowError("Select a user to assign this course to.");
            return;
        }

        isSubmitting = true;

        Result<string> currentUserResult = await _securityService.GetCurrentUserIdAsync();

        if (!currentUserResult.IsSuccess || currentUserResult.Data is null)
        {
            _toastService.ShowError("Could not determine the current user.");
            isSubmitting = false;
            return;
        }

        Result<CourseAssignment> result = await _courseAssignmentService.AssignCourseAsync(
            CourseId, model.UserId, currentUserResult.Data, model.DueDate);

        if (!result.IsSuccess)
        {
            _toastService.ShowError($"Failed to assign course: {result.Error}");
            isSubmitting = false;
            return;
        }

        _toastService.ShowSuccess("Course assigned.");
        await Dialog.CloseAsync(true);
    }

    private async Task CancelDialog()
    {
        await Dialog.CancelAsync();
    }

    private class AssignCourseModel
    {
        public string? UserId { get; set; }
        public DateTime? DueDate { get; set; }
    }
}
