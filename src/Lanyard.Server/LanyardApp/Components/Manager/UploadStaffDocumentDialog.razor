@using System.Globalization
@using Lanyard.Application.Services.StaffDocuments
@using Microsoft.AspNetCore.Http

@inject INotificationService ToastService
@inject IStaffDocumentService _staffDocumentService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Margin="@Margin.End2" Value="@(new Icons.Regular.Size24.ArrowUpload())" />
            <FluentText As="@TextTag.H3">Upload Document</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        <div class="upload-dialog-content">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentSelect TOption="StaffDocumentType" TValue="string" Items="@DocumentTypes" OptionText="@(x => x.Name)"
                          OptionValue="@(x => x.Id.ToString())" @bind-Value="selectedDocumentTypeId"
                          Label="Document Type" Placeholder="Select a document type" Style="width: 100%;" />

            @if (selectedDocumentType?.RequiresExpiryDate == true)
            {
                <FluentDatePicker TValue="DateTime?" @bind-Value="expiryDate" Label="Expiry Date"
                                  Culture="@UkCulture" Style="width: 100%;" />
                <FluentDatePicker TValue="DateTime?" @bind-Value="reminderDate" Label="Reminder Date"
                                  Culture="@UkCulture" Style="width: 100%;" />
            }

            <FluentInputFile Id="staff-document-upload" Mode="InputFileMode.SaveToTemporaryFolder" Multiple="false"
                              MaximumFileCount="1" MaximumFileSize="@(50 * 1024 * 1024)"
                              @bind-ProgressPercent="@uploadProgressPercent" OnCompleted="@OnDocumentUploadedAsync">
                <ChildContent>
                    <label for="staff-document-upload">Choose a file, or drag it here.</label>
                </ChildContent>
            </FluentInputFile>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Margin="@Margin.Top2">
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelDialog" Disabled="@isUploading">
                    Cancel
                </FluentButton>
            </FluentStack>
        </FluentStack>
        </div>
    </ChildContent>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    [Parameter]
    public List<StaffDocumentType> DocumentTypes { get; set; } = [];

    // en-GB's short date pattern is dd/MM/yyyy - the FluentDatePicker's displayed format
    // follows whatever Culture it's given, there's no separate format-string parameter.
    private static readonly CultureInfo UkCulture = new("en-GB");

    private string? selectedDocumentTypeId;
    private DateTime? expiryDate;
    private DateTime? reminderDate;
    private int uploadProgressPercent;
    private bool isUploading;

    private StaffDocumentType? selectedDocumentType => DocumentTypes.FirstOrDefault(x => x.Id.ToString() == selectedDocumentTypeId);

    protected override void OnInitialized()
    {
        selectedDocumentTypeId = DocumentTypes.FirstOrDefault()?.Id.ToString();
    }

    private async Task OnDocumentUploadedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        if (selectedDocumentType is null)
        {
            ToastService.ShowError("Select a document type before uploading.");
            return;
        }

        if (selectedDocumentType.RequiresExpiryDate)
        {
            if (expiryDate is null || reminderDate is null)
            {
                ToastService.ShowError("Set both an expiry date and a reminder date before uploading.");
                return;
            }

            if (reminderDate.Value.Date > expiryDate.Value.Date)
            {
                ToastService.ShowError("The reminder date must be on or before the expiry date.");
                return;
            }
        }

        FluentInputFileEventArgs? file = files.FirstOrDefault();

        if (file is null)
        {
            return;
        }

        if (file.ErrorMessage is not null)
        {
            ToastService.ShowError($"Error uploading {file.Name}: {file.ErrorMessage}");
            return;
        }

        isUploading = true;

        Result<string> currentUserResult = await _securityService.GetCurrentUserIdAsync();

        if (!currentUserResult.IsSuccess || currentUserResult.Data is null)
        {
            ToastService.ShowError("Could not determine the current user.");
            isUploading = false;
            return;
        }

        using FileStream fileStream = file.LocalFile!.OpenRead();

        IFormFile formFile = new FormFile(fileStream, 0, fileStream.Length, "file", file.Name)
        {
            Headers = new HeaderDictionary(),
            ContentType = file.ContentType
        };

        Result<StaffDocument> uploadResult = await _staffDocumentService.UploadStaffDocumentAsync(
            UserId, selectedDocumentType.Id, formFile, expiryDate, reminderDate, currentUserResult.Data, CancellationToken.None);

        uploadProgressPercent = 0;
        isUploading = false;

        if (!uploadResult.IsSuccess)
        {
            ToastService.ShowError($"Failed to upload document: {uploadResult.Error}");
            return;
        }

        ToastService.ShowSuccess("Document uploaded.");
        await Dialog.CloseAsync(true);
    }

    private async Task CancelDialog()
    {
        await Dialog.CancelAsync();
    }
}
