@using Lanyard.Application.Services.Authentication
@using Lanyard.Infrastructure.Models

@inject INotificationService ToastService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Margin="@Margin.End2" Value="@(new Icons.Regular.Size24.PersonAdd())" />
            <FluentText As="@TextTag.H3">Register a New User</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @if (createdUserResult is null)
        {
            <EditForm EditContext="@_editContext" OnValidSubmit="HandleRegisterUser">
                <DataAnnotationsValidator />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentTextInput @bind-Value="model.FirstName" Label="First Name" Required="true" Placeholder="Ben"
                                     Style="width: 100%;" Message="@_editContext.GetValidationMessage(() => model.FirstName)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                    </FluentTextInput>
                    <FluentTextInput @bind-Value="model.LastName" Label="Last Name" Required="true" Placeholder="Mercer"
                                     Style="width: 100%;" Message="@_editContext.GetValidationMessage(() => model.LastName)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                    </FluentTextInput>
                    <FluentTextInput @bind-Value="model.Email" Label="Email" Required="true"
                                     Placeholder="ben.mercer@lanyard.com" Style="width: 100%;"
                                     Message="@_editContext.GetValidationMessage(() => model.Email)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Mail())" Slot="start" />
                    </FluentTextInput>
                    <FluentSelect TOption="Lanyard.Infrastructure.Models.Location" TValue="int" Multiple="true"
                                  Items="@availableLocations"
                                  OptionText="@(l => l?.GetDisplayName() ?? string.Empty)"
                                  OptionValue="@(l => l?.Id ?? 0)"
                                  @bind-SelectedItems="selectedLocations"
                                  Label="Location(s)" Required="true" Style="width: 100%;" />

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Margin="@Margin.Top2">
                        <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                      Disabled="@isSubmitting" IconStart="@(new Icons.Regular.Size20.PersonAdd())">
                            @if (isSubmitting)
                            {
                                <FluentSpinner Style="width: 16px; height: 16px;" />
                                <span class="ms-2">Creating...</span>
                            }
                            else
                            {
                                <span>Create User</span>
                            }
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelDialog"
                                      Disabled="@isSubmitting">
                            Cancel
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                @if (createdUserResult.EmailSent)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Success">
                        Invite sent to @createdUserResult.User.Email. They'll receive a link to set their password.
                    </FluentMessageBar>
                }
                else
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning">
                        User '@createdUserResult.User.UserName' was created, but the invite email couldn't be sent
                        (@createdUserResult.EmailError). Use "Resend Invite" from the user list to try again.
                    </FluentMessageBar>
                }
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CloseDialog">
                        Done
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        }
    </ChildContent>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private bool isSubmitting;
    private RegisterUserModel model = new();
    private EditContext _editContext = default!;
    private UserCreationResult? createdUserResult;
    private List<Location> availableLocations = [];
    private IEnumerable<Location> selectedLocations = [];

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(model);

        Result<List<Location>> locationsResult = await _companyLocationService.GetLocationsAsync();

        if (locationsResult.IsSuccess)
        {
            availableLocations = locationsResult.Data!;
        }
    }

    private async Task HandleRegisterUser()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            UserProfile newUser = new UserProfile
            {
                Email = model.Email,
                FirstName = model.FirstName,
                LastName = model.LastName
            };

            if (!selectedLocations.Any())
            {
                ToastService.ShowError("Select at least one location.");
                isSubmitting = false;
                StateHasChanged();
                return;
            }

            Result<UserCreationResult> result = await _securityService.CreateUserAsync(newUser, selectedLocations.Select(l => l.Id).ToList());

            if (result.IsSuccess)
            {
                createdUserResult = result.Data;
            }
            else
            {
                ToastService.ShowError($"Failed to create user: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error creating user: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task CancelDialog()
    {
        await Dialog.CancelAsync();
    }

    private async Task CloseDialog()
    {
        await Dialog.CloseAsync(true);
    }

    private class RegisterUserModel
    {
        [Required(ErrorMessage = "First Name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last Name is required.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
