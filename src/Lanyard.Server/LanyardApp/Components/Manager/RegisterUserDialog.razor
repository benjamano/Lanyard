@using Lanyard.Application.Services.Authentication
@using Lanyard.Application.Services.Onboarding
@using Lanyard.Infrastructure.Models

@inject INotificationService ToastService
@inject IOnboardingService _onboardingService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Margin="@Margin.End2" Value="@(new Icons.Regular.Size24.PersonAdd())" />
            <FluentText As="@TextTag.H3">Register a New User</FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @if (createdUserResult is null)
        {
            <EditForm EditContext="@_editContext" OnValidSubmit="HandleRegisterUser">
                <DataAnnotationsValidator />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentTextInput @bind-Value="model.FirstName" Label="First Name" Required="true" Placeholder="Ben"
                                     Style="width: 100%;" Message="@_editContext.GetValidationMessage(() => model.FirstName)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                    </FluentTextInput>
                    <FluentTextInput @bind-Value="model.LastName" Label="Last Name" Required="true" Placeholder="Mercer"
                                     Style="width: 100%;" Message="@_editContext.GetValidationMessage(() => model.LastName)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Slot="start" />
                    </FluentTextInput>
                    <FluentTextInput @bind-Value="model.Email" Label="Email" Required="true"
                                     Placeholder="ben.mercer@lanyard.com" Style="width: 100%;"
                                     Message="@_editContext.GetValidationMessage(() => model.Email)"
                                     MessageCondition="@(f => !string.IsNullOrEmpty(f.Message))" MessageState="MessageState.Error">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Mail())" Slot="start" />
                    </FluentTextInput>
                    <FluentSelect TOption="Lanyard.Infrastructure.Models.Location" TValue="int" Multiple="true"
                                  Items="@availableLocations"
                                  OptionText="@(l => l?.GetDisplayName() ?? string.Empty)"
                                  OptionValue="@(l => l?.Id ?? 0)"
                                  SelectedItems="@selectedLocations" SelectedItemsChanged="OnSelectedLocationsChangedAsync"
                                  Label="Location(s)" Required="true" Style="width: 100%;" />

                    @if (selectedLocations.Any())
                    {
                        @if (isLoadingWelcomeEmailDefaults)
                        {
                            <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                                <FluentSpinner Style="width: 16px; height: 16px;" />
                            </FluentStack>
                        }
                        else if (welcomeEmailDefaultsLoadFailed)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Error">
                                Couldn't check welcome email settings for the selected location(s). Reselect the location to try again.
                            </FluentMessageBar>
                        }
                        else if (resolvedDefaultSettings is null || !resolvedDefaultSettings.SendWelcomeEmail)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Info">
                                Welcome emails aren't enabled for the selected location(s) - there's nothing to customize.
                            </FluentMessageBar>
                        }
                        else
                        {
                            <FluentSwitch Value="customizeWelcomeEmail" ValueChanged="OnCustomizeWelcomeEmailChanged" Label="Customize welcome email for this user" />

                            @if (customizeWelcomeEmail)
                            {
                                <FluentTextInput @bind-Value="welcomeEmailSubject" Label="Welcome email subject" Width="100%"
                                                  Placeholder="Welcome to Lanyard" />

                                <FluentText Typo="Typography.Body">Welcome email body</FluentText>
                                <div class="onboarding-editor-host">
                                    <BlazoredTextEditor @ref="_editor" Placeholder="Write a welcome message...">
                                        <ToolbarContent>
                                            <span class="ql-formats">
                                                <button class="ql-bold"></button>
                                                <button class="ql-italic"></button>
                                                <button class="ql-underline"></button>
                                            </span>
                                            <span class="ql-formats">
                                                <button class="ql-list" value="ordered"></button>
                                                <button class="ql-list" value="bullet"></button>
                                            </span>
                                        </ToolbarContent>
                                        <EditorContent></EditorContent>
                                    </BlazoredTextEditor>
                                </div>
                            }
                        }
                    }

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Margin="@Margin.Top2">
                        <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                                      Disabled="@isSubmitting" IconStart="@(new Icons.Regular.Size20.PersonAdd())">
                            @if (isSubmitting)
                            {
                                <FluentSpinner Style="width: 16px; height: 16px;" />
                                <span class="ms-2">Creating...</span>
                            }
                            else
                            {
                                <span>Create User</span>
                            }
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelDialog"
                                      Disabled="@isSubmitting">
                            Cancel
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                @if (createdUserResult.EmailSent)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Success">
                        Invite sent to @createdUserResult.User.Email. They'll receive a link to set their password.
                    </FluentMessageBar>
                }
                else
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning">
                        User '@createdUserResult.User.UserName' was created, but the invite email couldn't be sent
                        (@createdUserResult.EmailError). Use "Resend Invite" from the user list to try again.
                    </FluentMessageBar>
                }
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CloseDialog">
                        Done
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        }
    </ChildContent>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private bool isSubmitting;
    private RegisterUserModel model = new();
    private EditContext _editContext = default!;
    private UserCreationResult? createdUserResult;
    private List<Location> availableLocations = [];
    private IEnumerable<Location> selectedLocations = [];

    private bool customizeWelcomeEmail;
    private string welcomeEmailSubject = string.Empty;
    private CompanyOnboardingSettings? resolvedDefaultSettings;
    private bool isLoadingWelcomeEmailDefaults;
    private bool welcomeEmailDefaultsLoadFailed;
    private BlazoredTextEditor? _editor;
    private Guid? _loadedSettingsId;

    // Bumped on every RefreshWelcomeEmailDefaultsAsync call so a stale response (e.g. from
    // quickly switching locations) can detect it's no longer the latest and discard itself
    // instead of overwriting a newer result.
    private int _welcomeEmailDefaultsRequestId;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(model);

        Result<List<Location>> locationsResult = await _companyLocationService.GetLocationsAsync();

        if (locationsResult.IsSuccess)
        {
            availableLocations = locationsResult.Data!;
        }
    }

    private async Task OnSelectedLocationsChangedAsync(IEnumerable<Location> newSelection)
    {
        selectedLocations = newSelection;
        customizeWelcomeEmail = false;
        _loadedSettingsId = null;
        await RefreshWelcomeEmailDefaultsAsync();
    }

    // Mirrors TriggerOnboardingAsync's own "first of the selected locations" lookup key, so the
    // previewed default here is exactly what would actually be sent on submit.
    private async Task RefreshWelcomeEmailDefaultsAsync()
    {
        int requestId = ++_welcomeEmailDefaultsRequestId;
        Location? firstLocation = selectedLocations.FirstOrDefault();

        if (firstLocation is null)
        {
            resolvedDefaultSettings = null;
            welcomeEmailDefaultsLoadFailed = false;
            return;
        }

        isLoadingWelcomeEmailDefaults = true;
        StateHasChanged();

        // Debounce rapid successive location changes (e.g. selecting several locations one at a
        // time in the multi-select) so only the final selection pays for a DB round trip.
        await Task.Delay(300);

        if (requestId != _welcomeEmailDefaultsRequestId)
        {
            return;
        }

        Result<CompanyOnboardingSettings?> result = await _onboardingService.GetEffectiveSettingsAsync(firstLocation.CompanyId, firstLocation.Id);

        if (requestId != _welcomeEmailDefaultsRequestId)
        {
            // A newer location selection fired its own request while this one was in flight -
            // that result already won or is still pending, so applying this stale one now would
            // overwrite it with the wrong location's defaults.
            return;
        }

        welcomeEmailDefaultsLoadFailed = !result.IsSuccess;
        resolvedDefaultSettings = result.IsSuccess ? result.Data : null;
        welcomeEmailSubject = resolvedDefaultSettings?.WelcomeEmailSubject ?? "Welcome to Lanyard";
        isLoadingWelcomeEmailDefaults = false;
        StateHasChanged();
    }

    private void OnCustomizeWelcomeEmailChanged(bool value)
    {
        customizeWelcomeEmail = value;

        if (value)
        {
            // The editor sits inside an @if(customizeWelcomeEmail) block, so turning this back on
            // remounts a fresh BlazoredTextEditor instance. Without resetting this, the guard in
            // OnAfterRenderAsync sees the same resolvedDefaultSettings.Id as before and skips
            // LoadHTMLContent, leaving the new instance blank even though state still thinks
            // content was already loaded.
            _loadedSettingsId = null;
        }
    }

    // BlazoredTextEditor does not accept initial content as a bound parameter - content must be
    // pushed in via LoadHTMLContent() after the component has mounted, same as
    // OnboardingSettingsManager.razor.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (customizeWelcomeEmail && _editor is not null && resolvedDefaultSettings is not null
            && _loadedSettingsId != resolvedDefaultSettings.Id)
        {
            try
            {
                await _editor.LoadHTMLContent(resolvedDefaultSettings.WelcomeEmailBodyHtml ?? string.Empty);
                _loadedSettingsId = resolvedDefaultSettings.Id;
            }
            catch (Microsoft.JSInterop.JSException)
            {
                StateHasChanged();
            }
        }
    }

    private async Task HandleRegisterUser()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            UserProfile newUser = new UserProfile
            {
                Email = model.Email,
                FirstName = model.FirstName,
                LastName = model.LastName
            };

            if (!selectedLocations.Any())
            {
                ToastService.ShowError("Select at least one location.");
                isSubmitting = false;
                StateHasChanged();
                return;
            }

            string? subjectOverride = null;
            string? bodyHtmlOverride = null;

            if (customizeWelcomeEmail)
            {
                subjectOverride = welcomeEmailSubject;

                if (_editor is not null)
                {
                    // The default body is loaded into the editor asynchronously in
                    // OnAfterRenderAsync, which may not have completed yet if the switch was
                    // only just turned on - make sure it has before reading the content back
                    // out, or GetHTML() can return blank.
                    if (resolvedDefaultSettings is not null && _loadedSettingsId != resolvedDefaultSettings.Id)
                    {
                        await _editor.LoadHTMLContent(resolvedDefaultSettings.WelcomeEmailBodyHtml ?? string.Empty);
                        _loadedSettingsId = resolvedDefaultSettings.Id;
                    }

                    bodyHtmlOverride = await _editor.GetHTML();
                }
            }

            Result<UserCreationResult> result = await _securityService.CreateUserAsync(
                newUser, selectedLocations.Select(l => l.Id).ToList(), subjectOverride, bodyHtmlOverride);

            if (result.IsSuccess)
            {
                createdUserResult = result.Data;
            }
            else
            {
                ToastService.ShowError($"Failed to create user: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error creating user: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task CancelDialog()
    {
        await Dialog.CancelAsync();
    }

    private async Task CloseDialog()
    {
        await Dialog.CloseAsync(true);
    }

    private class RegisterUserModel
    {
        [Required(ErrorMessage = "First Name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last Name is required.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
