@inject IDashboardService DashboardService

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Start" VerticalGap="8" Width="100%">
    <FluentText>
        Choose a dashboard to show when you open Lanyard. It replaces the standard home page and its widgets stay live, so
        you can use them without leaving this screen.
    </FluentText>

    @if (_isLoading)
    {
        <FluentSpinner />
    }
    else
    {
        <FluentSelect TOption="string"
                      TValue="string"
                      Label="Home Screen"
                      Value="@_selectedValue"
                      ValueChanged="OnSelectionChanged"
                      Disabled="@(!_dashboards.Any())"
                      Style="width: 61%;">
            @if (_organisationDefaultName is not null)
            {
                <FluentOption TValue="string" Value="@FollowOrganisationValue">
                    Follow the organisation default (@_organisationDefaultName)
                </FluentOption>
            }
            <FluentOption TValue="string" Value="@StandardHomePageValue">Use the standard home page</FluentOption>
            @foreach (Dashboard dashboard in _dashboards)
            {
                <FluentOption TValue="string" Value="@dashboard.Id.ToString()">@dashboard.Name</FluentOption>
            }
        </FluentSelect>

        @if (_organisationDefaultName is not null)
        {
            <FluentText Color="Color.Disabled">
                An admin has set "@_organisationDefaultName" as everyone's home screen. Anything you choose here applies
                to you only.
            </FluentText>
        }

        @if (!_dashboards.Any())
        {
            <FluentText Color="Color.Disabled">There are no dashboards to choose from yet.</FluentText>
        }
    }
</FluentStack>

@code {
    // Three distinct choices, only two of which are a dashboard id, so the select is driven by
    // strings rather than a Guid?: "follow whatever an admin set" and "always give me the standard
    // home page" are different intentions that both resolve to no dashboard of the user's own.
    private const string StandardHomePageValue = "standard";
    private const string FollowOrganisationValue = "organisation";

    private IEnumerable<Dashboard> _dashboards = [];
    private string _selectedValue = StandardHomePageValue;
    private string? _userId;
    private string? _organisationDefaultName;
    private bool _isLoading = true;
    private bool _loadFailed = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Result<string> userIdResult = await _securityService.GetCurrentUserIdAsync();

        if (!userIdResult.IsSuccess || string.IsNullOrEmpty(userIdResult.Data))
        {
            _toastService.ShowError($"Failed to load your home screen setting, {userIdResult.Error}");
            _loadFailed = true;
            _isLoading = false;
            return;
        }

        _userId = userIdResult.Data;

        Result<IEnumerable<Dashboard>> dashboardsResult = await DashboardService.GetDashboardsAsync();

        if (dashboardsResult.IsSuccess && dashboardsResult.Data is not null)
        {
            _dashboards = dashboardsResult.Data;
        }
        else
        {
            _toastService.ShowError($"Failed to load dashboards, {dashboardsResult.Error}");
            _loadFailed = true;
        }

        Result<Guid?> organisationResult = await DashboardService.GetOrganisationDefaultDashboardIdAsync();

        if (!organisationResult.IsSuccess)
        {
            _toastService.ShowError($"Failed to load the organisation home screen, {organisationResult.Error}");
            _loadFailed = true;
            _isLoading = false;
            return;
        }

        // Left null when an admin set a dashboard that has since been deleted, which hides the
        // "follow the organisation default" option rather than offering a dead choice.
        _organisationDefaultName = organisationResult.Data is Guid organisationDashboardId
            ? _dashboards.FirstOrDefault(x => x.Id == organisationDashboardId)?.Name
            : null;

        Result<HomeScreenDashboardSelection> selectionResult = await DashboardService.GetHomeScreenDashboardAsync(_userId);

        if (!selectionResult.IsSuccess || selectionResult.Data is null)
        {
            _toastService.ShowError($"Failed to load your home screen setting, {selectionResult.Error}");
            _loadFailed = true;
            _isLoading = false;
            return;
        }

        _selectedValue = ResolveSelectedValue(selectionResult.Data);

        _isLoading = false;
    }

    private string ResolveSelectedValue(HomeScreenDashboardSelection selection)
    {
        if (selection.IsOrganisationDefault)
        {
            // The option only exists while the organisation's dashboard is still there.
            return _organisationDefaultName is null ? StandardHomePageValue : FollowOrganisationValue;
        }

        // A dashboard the user chose that has since been deleted is stored but no longer
        // selectable, so fall back to the standard home page - what the home page itself shows.
        return selection.DashboardId is Guid dashboardId && _dashboards.Any(x => x.Id == dashboardId)
            ? dashboardId.ToString()
            : StandardHomePageValue;
    }

    private void OnSelectionChanged(string? newValue)
    {
        _selectedValue = newValue ?? StandardHomePageValue;
    }

    public async Task HandleSave()
    {
        if (_userId is null)
        {
            return;
        }

        // The selection falls back to "Use the standard home page" whenever loading failed, so
        // saving on top of a failed load would silently wipe a setting the user never touched.
        if (_loadFailed)
        {
            _toastService.ShowError("Your home screen setting could not be loaded, so it was not saved. Reload the page and try again.");
            return;
        }

        Result<bool> result = await SaveSelectionAsync();

        if (result.IsSuccess)
        {
            _toastService.ShowSuccess("Home Screen Saved!");
        }
        else
        {
            _toastService.ShowError($"Failed to save your home screen, {result.Error}");
        }
    }

    private async Task<Result<bool>> SaveSelectionAsync()
    {
        if (_selectedValue == StandardHomePageValue)
        {
            // Also clears any dashboard of the user's own, so the flag cannot be shadowed by a
            // stale id.
            return await DashboardService.SetUseStandardHomePageAsync(_userId!, true);
        }

        if (_selectedValue == FollowOrganisationValue)
        {
            // "No choice of my own" is the absence of both settings, so both have to be cleared.
            Result<bool> clearOwnResult = await DashboardService.SetDefaultDashboardIdAsync(_userId!, null);

            if (!clearOwnResult.IsSuccess)
            {
                return clearOwnResult;
            }

            return await DashboardService.SetUseStandardHomePageAsync(_userId!, false);
        }

        Guid? dashboardId = Guid.TryParse(_selectedValue, out Guid parsedId) ? parsedId : null;

        return await DashboardService.SetDefaultDashboardIdAsync(_userId!, dashboardId);
    }
}
