<Window x:Class="Lanyard.Client.Enrolment.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair this kiosk"
        Background="#111111"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1100">
            <TextBlock Text="Pair this kiosk" Foreground="White" FontSize="48" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />
            <TextBlock Foreground="#CCCCCC" FontSize="26" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,40">
                In Lanyard, go to Manage, then Clients, press Add kiosk and type in this code.
            </TextBlock>
            <Border Background="#1F1F1F" CornerRadius="16" Padding="56,28" HorizontalAlignment="Center">
                <TextBlock x:Name="CodeText" Text="…" Foreground="White" FontSize="120" FontWeight="Bold"
                           FontFamily="Consolas, Cascadia Mono, Courier New" HorizontalAlignment="Center" />
            </Border>
            <TextBlock x:Name="ExpiryText" Foreground="#AAAAAA" FontSize="22" HorizontalAlignment="Center" Margin="0,24,0,0" />
            <TextBlock x:Name="StatusText" Foreground="#FFC857" FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
        <TextBlock x:Name="FooterText" Foreground="#777777" FontSize="16" Margin="24"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Grid>
</Window>
